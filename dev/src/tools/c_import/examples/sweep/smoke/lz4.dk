import core.builtins.*;
import lz4.*;

fun main() -> i64 = {
    var src: u8[1024];
    var i: i64 = 0i64;
    while (i < 1024i64) { src[i] = (i % 13i64) as u8; i = i + 1i64; }
    var packed: u8[2048];
    let packed_len = LZ4_compress_default(&src as cptr char, &packed as cptr char, 1024i32, 2048i32);
    if (packed_len <= 0i32) { return 1i64; }
    if (packed_len >= 1024i32) { return 2i64; }
    var back: u8[1024];
    let back_len = LZ4_decompress_safe(&packed as cptr char, &back as cptr char, packed_len, 1024i32);
    if (back_len != 1024i32) { return 3i64; }
    if (back[1000] != src[1000]) { return 4i64; }
    return 0i64;
}
