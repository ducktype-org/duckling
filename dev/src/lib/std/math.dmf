#{
    Standard mathematical functions.
#}
namespace libm_forward {
    extern("C") {
        #{
            These are marked `fundecl` since the definition
            is for now not generated by the compiler, but it is linked
            from the compiled library. The library is written in "C"
            and it requires the C-ABI.


            Forward interface from libc (cstdlib) and libm (cmath).
            See: https://en.cppreference.com/c/header/math
        #}

        # Basic operations
        {
            # Absolute value
            funcdecl fabsf(x: f32) -> f32;
            funcdecl fabs(x: f64) -> f64;

            # Division floating-point reminder
            funcdecl fmodf(x: f32, y: f32) -> f32;
            funcdecl fmod(x: f64, y: f64) -> f64;


            # Division IEEE floating-point reminder
            funcdecl reminderf(x: f32, y: f32) -> f32;
            funcdecl reminder(x: f64, y: f64) -> f64;

            # Division floating-point reminder
            # funcdecl remquof(x: f32, y: f32, quo: *i32) -> f32;
            # funcdecl remquo(x: f64, y: f64, quo: *i32) -> f64;

            # Multiply-add
            # (x * y) + z
            funcdecl fmaf(x: f32, y: f32, z: f32) -> f32;
            funcdecl fma(x: f64, y: f64, z: f64) -> f64;

            # Maximum
            funcdecl fmaxf(x: f32, y: f32) -> f32;
            funcdecl fmax(x: f64, y: f64) -> f64;

            # Minimum
            funcdecl fminf(x: f32, y: f32) -> f32;
            funcdecl fmin(x: f64, y: f64) -> f64;

            # Positive difference
            # x-y if x > y, else 0
            funcdecl fdimf(x: f32, y: f32) -> f32;
            funcdecl fdim(x: f64, y: f64) -> f64;

            # NaN
            # funcdecl nanf(arg: *c_char) -> f32;
            # funcdecl nan(arg: *c_char) -> f64;
        }

        # Exponential functions 
        {
            # Exp
            # e**x
            funcdecl expf(x: f32) -> f32;
            funcdecl exp(x: f64) -> f64;

            # Exp 2
            # 2**x
            funcdecl exp2f(x: f32) -> f32;
            funcdecl exp2(x: f64) -> f64;

            # Exp minus 1
            # e**x - 1
            funcdecl expm1f(x: f32) -> f32;
            funcdecl expm1(x: f64) -> f64;

            # Log base e
            funcdecl logf(x: f32) -> f32;
            funcdecl log(x: f64) -> f64;

            # Log base 10
            funcdecl log10f(x: f32) -> f32;
            funcdecl log10(x: f64) -> f64;

            # Log base 2
            funcdecl log2f(x: f32) -> f32;
            funcdecl log2(x: f64) -> f64;

            # Log 1 plus x
            # ln(1+x)
            funcdecl log1pf(x: f32) -> f32;
            funcdecl log1p(x: f64) -> f64;
        }

        # Power functions
        {
            # Power
            # x**y
            funcdecl powf(x: f32, y: f32) -> f32;
            funcdecl pow(x: f64, y: f64) -> f64;

            # Square root
            # x**1/2
            funcdecl sqrtf(x: f32) -> f32;
            funcdecl sqrt(x: f64) -> f64;

            # Cube root
            # x**1/3
            funcdecl cbrtf(x: f32) -> f32;
            funcdecl cbrt(x: f64) -> f64;

            # Hypotenuse
            # sqrt(x**2 + y**2)
            funcdecl hypotf(x: f32, y: f32) -> f32;
            funcdecl hypot(x: f64, y: f64) -> f64;
        }

        # Trigonometric functions
        {
            # Sine
            funcdecl sinf(x: f32) -> f32;
            funcdecl sin(x: f64) -> f64;

            # Cosine
            funcdecl cosf(x: f32) -> f32;
            funcdecl cos(x: f64) -> f64;

            # Tangent
            funcdecl tanf(x: f32) -> f32;
            funcdecl tan(x: f64) -> f64;

            # Arcsine
            funcdecl asinf(x: f32) -> f32;
            funcdecl asin(x: f64) -> f64;

            # Arccosine
            funcdecl acosf(x: f32) -> f32;
            funcdecl acos(x: f64) -> f64;

            # Arctangent
            funcdecl atanf(x: f32) -> f32;
            funcdecl atan(x: f64) -> f64;

            # Arctangent using signs to determine quadrants
            funcdecl atan2f(y: f32, x: f32) -> f32;
            funcdecl atan2(y: f64, x: f64) -> f64;
        }

        # Hyperbolic functions
        {
            # Hyperbolic sine
            funcdecl sinhf(x: f32) -> f32;
            funcdecl sinh(x: f64) -> f64;

            # Hyperbolic cosine
            funcdecl coshf(x: f32) -> f32;
            funcdecl cosh(x: f64) -> f64;

            # Hyperbolic tangent
            funcdecl tanhf(x: f32) -> f32;
            funcdecl tanh(x: f64) -> f64;

            # Inverse hyperbolic sine
            funcdecl asinhf(x: f32) -> f32;
            funcdecl asinh(x: f64) -> f64;

            # Inverse hyperbolic cosine
            funcdecl acoshf(x: f32) -> f32;
            funcdecl acosh(x: f64) -> f64;

            # Inverse hyperbolic tangent
            funcdecl atanhf(x: f32) -> f32;
            funcdecl atanh(x: f64) -> f64;}
    }
}

# Basic operations
{
    fun abs(x: f32) -> f32 = libm_forward.fabsf(x);
    fun abs(x: f64) -> f64 = libm_forward.fabs(x);

    fun mod(x: f32, y: f32) -> f32 = libm_forward.fmodf(x, y);
    fun mod(x: f64, y: f64) -> f64 = libm_forward.fmod(x, y);

    fun reminder(x: f32, y: f32) -> f32 = libm_forward.reminderf(x, y);
    fun reminder(x: f64, y: f64) -> f64 = libm_forward.reminder(x, y);

    fun ma(x: f32, y: f32, z: f32) -> f32 = libm_forward.fmaf(x, y, z);
    fun ma(x: f64, y: f64, z: f64) -> f64 = libm_forward.fma(x, y, z);

    fun max(x: f32, y: f32) -> f32 = libm_forward.fmaxf(x, y);
    fun max(x: f64, y: f64) -> f64 = libm_forward.fmax(x, y);

    fun min(x: f32, y: f32) -> f32 = libm_forward.fminf(x, y);
    fun min(x: f64, y: f64) -> f64 = libm_forward.fmin(x, y);

    fun dim(x: f32, y: f32) -> f32 = libm_forward.fdimf(x, y);
    fun dim(x: f64, y: f64) -> f64 = libm_forward.fdim(x, y);
}

# Exponential functions 
{
    fun exp(x: f32) -> f32 = libm_forward.expf(x);
    fun exp(x: f64) -> f64 = libm_forward.exp(x);

    fun exp2(x: f32) -> f32 = libm_forward.exp2f(x);
    fun exp2(x: f64) -> f64 = libm_forward.exp2(x);

    fun expm1(x: f32) -> f32 = libm_forward.expm1f(x);
    fun expm1(x: f64) -> f64 = libm_forward.expm1(x);

    fun log(x: f32) -> f32 = libm_forward.logf(x);
    fun log(x: f64) -> f64 = libm_forward.log(x);

    fun log10(x: f32) -> f32 = libm_forward.log10f(x);
    fun log10(x: f64) -> f64 = libm_forward.log10(x);

    fun log2(x: f32) -> f32 = libm_forward.log2f(x);
    fun log2(x: f64) -> f64 = libm_forward.log2(x);

    fun log1p(x: f32) -> f32 = libm_forward.log1pf(x);
    fun log1p(x: f64) -> f64 = libm_forward.log1p(x);
}

namespace constants {
    #{
        Mathematical constants.
    #}
}