#{
    Standard mathematical functions.
#}

# int -> i32
# long -> i64
# float -> f32
# double -> f64

import core.panicking;
import core.containers;
import core.builtins;

# Integer type minimum causes overflow when negated, hence it is not suported.
fun abs(x: i32) -> i32 = libm_forward.int_funcs.abs(x);
fun abs(x: i64) -> i64 = libm_forward.int_funcs.labs(x);
fun abs(x: f32) -> f32 = libm_forward.basic_ops.fabsf(x);
fun abs(x: f64) -> f64 = libm_forward.basic_ops.fabs(x);

fun max(x: i32, y: i32) -> i32 = impl.max:{i32}(x, y);
fun max(x: i64, y: i64) -> i64 = impl.max:{i64}(x, y);
fun max(x: f32, y: f32) -> f32 = libm_forward.basic_ops.fmaxf(x, y);
fun max(x: f64, y: f64) -> f64 = libm_forward.basic_ops.fmax(x, y);

fun min(x: i32, y: i32) -> i32 = impl.min:{i32}(x, y);
fun min(x: i64, y: i64) -> i64 = impl.min:{i64}(x, y);
fun min(x: f32, y: f32) -> f32 = libm_forward.basic_ops.fminf(x, y);
fun min(x: f64, y: f64) -> f64 = libm_forward.basic_ops.fmin(x, y);

fun exp(x: f32) -> f32 = libm_forward.exp_funcs.expf(x);
fun exp(x: f64) -> f64 = libm_forward.exp_funcs.exp(x);

fun log(x: f32) -> f32 = libm_forward.exp_funcs.logf(x);
fun log(x: f64) -> f64 = libm_forward.exp_funcs.log(x);

fun pow(x: i32, y: i32) -> i32 = impl.powi:{i32}(x, y);
fun pow(x: i64, y: i64) -> i64 = impl.powi:{i64}(x, y);
fun pow(x: f32, y: f32) -> f32 = libm_forward.pow_funcs.powf(x, y);
fun pow(x: f64, y: f64) -> f64 = libm_forward.pow_funcs.pow(x, y);

fun sqrt(x: f32) -> f32 = libm_forward.pow_funcs.sqrtf(x);
fun sqrt(x: f64) -> f64 = libm_forward.pow_funcs.sqrt(x);

fun sin(x: f32) -> f32 = libm_forward.trig_funcs.sinf(x);
fun sin(x: f64) -> f64 = libm_forward.trig_funcs.sin(x);

fun cos(x: f32) -> f32 = libm_forward.trig_funcs.cosf(x);
fun cos(x: f64) -> f64 = libm_forward.trig_funcs.cos(x);

namespace libm_forward {
    #{
        These are marked `fundecl` since the definition
        is for now not generated by the compiler, but it is linked
        from the compiled library. The library is written in "C"
        and it requires the C-ABI.


        Forward interface from libc (cstdlib) and libm (cmath).
        See: https://en.cppreference.com/c/header/math
        and: https://en.cppreference.com/c/numeric/math
    #}

    namespace int_funcs { extern("C") {
        class div_t {
            quot: i32;
            rem: i32;
        }

        class ldiv_t {
            quot: i64;
            rem: i64;
        }

        # Computes absolute value of an integral value
        # Note that it is undefined for the most negative value of the type (e.g. -2^31 for i32) since the positive value does not fit in the type.
        fundecl abs(x: i32) -> i32;
        fundecl labs(x: i64) -> i64;

        # Computes quotient and remainder of integer division
        fundecl div(x: i32, y: i32) -> div_t;
        fundecl ldiv(x: i64, y: i64) -> ldiv_t;
    }}

    # Basic operations
    namespace basic_ops { extern("C") {
        # Computes absolute value of a floating-point value
        fundecl fabsf(x: f32) -> f32;
        fundecl fabs(x: f64) -> f64;

        # Computes remainder of the floating-point division operation
        fundecl fmodf(x: f32, y: f32) -> f32;
        fundecl fmod(x: f64, y: f64) -> f64;

        # Computes signed remainder of the floating-point division operation
        fundecl remainderf(x: f32, y: f32) -> f32;
        fundecl remainder(x: f64, y: f64) -> f64;

        # Computes signed remainder as well as the three last bits of the division operation
        fundecl remquof(x: f32, y: f32, quo: cptr i32) -> f32;
        fundecl remquo(x: f64, y: f64, quo: cptr i32) -> f64;

        # Computes fused multiply-add operation
        # (x * y) + z
        fundecl fmaf(x: f32, y: f32, z: f32) -> f32;
        fundecl fma(x: f64, y: f64, z: f64) -> f64;

        # Determines larger of two floating-point values
        fundecl fmaxf(x: f32, y: f32) -> f32;
        fundecl fmax(x: f64, y: f64) -> f64;

        # Determines smaller of two floating-point values
        fundecl fminf(x: f32, y: f32) -> f32;
        fundecl fmin(x: f64, y: f64) -> f64;

        # Determines positive difference of two floating-point values
        # x-y if x > y, else 0
        fundecl fdimf(x: f32, y: f32) -> f32;
        fundecl fdim(x: f64, y: f64) -> f64;

        # Returns a NaN (not-a-number)
        fundecl nanf(arg: cptr char) -> f32;
        fundecl nan(arg: cptr char) -> f64;
    }}

    # Exponential functions 
    namespace exp_funcs { extern("C") {
        # Computes e raised to the given power
        # e**x
        fundecl expf(x: f32) -> f32;
        fundecl exp(x: f64) -> f64;

        # Computes 2 raised to the given power
        # 2**x
        fundecl exp2f(x: f32) -> f32;
        fundecl exp2(x: f64) -> f64;

        # Computes e raised to the given power, minus one
        # e**x - 1
        fundecl expm1f(x: f32) -> f32;
        fundecl expm1(x: f64) -> f64;

        # Computes natural (base-e) logarithm
        # ln(x)
        fundecl logf(x: f32) -> f32;
        fundecl log(x: f64) -> f64;

        # Computes common (base-10) logarithm
        fundecl log10f(x: f32) -> f32;
        fundecl log10(x: f64) -> f64;

        # Computes base-2 logarithm
        fundecl log2f(x: f32) -> f32;
        fundecl log2(x: f64) -> f64;

        # Computes natural (base-e) logarithm of 1 plus the given number
        # ln(1+x)
        fundecl log1pf(x: f32) -> f32;
        fundecl log1p(x: f64) -> f64;
    }}

    # Power functions
    namespace pow_funcs { extern("C") {
        # Computes a number raised to the given power
        # x**y
        fundecl powf(x: f32, y: f32) -> f32;
        fundecl pow(x: f64, y: f64) -> f64;

        # Computes square root
        # x**1/2
        fundecl sqrtf(x: f32) -> f32;
        fundecl sqrt(x: f64) -> f64;

        # Computes cube root
        # x**1/3
        fundecl cbrtf(x: f32) -> f32;
        fundecl cbrt(x: f64) -> f64;

        # Computes square root of the sum of the squares of two given numbers
        # sqrt(x**2 + y**2)
        fundecl hypotf(x: f32, y: f32) -> f32;
        fundecl hypot(x: f64, y: f64) -> f64;
    }}

    # Trigonometric functions
    namespace trig_funcs { extern("C") {
        # Computes sine
        fundecl sinf(x: f32) -> f32;
        fundecl sin(x: f64) -> f64;

        # Computes cosine
        fundecl cosf(x: f32) -> f32;
        fundecl cos(x: f64) -> f64;

        # Computes tangent
        fundecl tanf(x: f32) -> f32;
        fundecl tan(x: f64) -> f64;

        # Computes arc sine
        fundecl asinf(x: f32) -> f32;
        fundecl asin(x: f64) -> f64;

        # Computes arc cosine
        fundecl acosf(x: f32) -> f32;
        fundecl acos(x: f64) -> f64;

        # Computes arc tangent
        fundecl atanf(x: f32) -> f32;
        fundecl atan(x: f64) -> f64;

        # Computes arc tangent, using signs to determine quadrants
        fundecl atan2f(y: f32, x: f32) -> f32;
        fundecl atan2(y: f64, x: f64) -> f64;
    }}

    # Hyperbolic functions
    namespace hyperbolic_funcs { extern("C") {
        # Computes hyperbolic sine
        fundecl sinhf(x: f32) -> f32;
        fundecl sinh(x: f64) -> f64;

        # Computes hyperbolic cosine
        fundecl coshf(x: f32) -> f32;
        fundecl cosh(x: f64) -> f64;

        # Computes hyperbolic tangent
        fundecl tanhf(x: f32) -> f32;
        fundecl tanh(x: f64) -> f64;

        # Computes inverse hyperbolic sine
        fundecl asinhf(x: f32) -> f32;
        fundecl asinh(x: f64) -> f64;

        # Computes inverse hyperbolic cosine
        fundecl acoshf(x: f32) -> f32;
        fundecl acosh(x: f64) -> f64;

        # Computes inverse hyperbolic tangent
        fundecl atanhf(x: f32) -> f32;
        fundecl atanh(x: f64) -> f64;
    }}

    # Error and gamma functions
    namespace error_gamma_funcs { extern("C") {
        # Computes error function
        fundecl erff(x: f32) -> f32;
        fundecl erf(x: f64) -> f64;

        # Computes complementary error function
        fundecl erfcf(x: f32) -> f32;
        fundecl erfc(x: f64) -> f64;

        # Computes gamma function
        fundecl tgammaf(x: f32) -> f32;
        fundecl tgamma(x: f64) -> f64;

        # Computes natural (base-e) logarithm of the gamma function
        fundecl lgammaf(x: f32) -> f32;
        fundecl lgamma(x: f64) -> f64;
    }}

    # Nearest integer floating-point operations
    namespace nearest_int_funcs { extern("C") {
        # Computes smallest integer not less than the given value
        fundecl ceilf(x: f32) -> f32;
        fundecl ceil(x: f64) -> f64;

        # Computes largest integer not greater than the given value
        fundecl floorf(x: f32) -> f32;
        fundecl floor(x: f64) -> f64;

        # Rounds to nearest integer not greater in magnitude than the given value
        fundecl truncf(x: f32) -> f32;
        fundecl trunc(x: f64) -> f64;

        # Rounds to nearest integer, rounding away from zero in halfway cases
        fundecl roundf(x: f32) -> f32;
        fundecl round(x: f64) -> f64;
        fundecl lroundf(x: f32) -> i64;
        fundecl lround(x: f64) -> i64;

        # Rounds to an integer using current rounding mode
        fundecl nearbyintf(x: f32) -> f32;
        fundecl nearbyint(x: f64) -> f64;

        # Rounds to an integer using current rounding mode with exception if the result differs
        fundecl rintf(x: f32) -> f32;
        fundecl rint(x: f64) -> f64;
        fundecl lrintf(x: f32) -> i64;
        fundecl lrint(x: f64) -> i64;
    }}

    # Floating-point manipulation functions
    namespace floating_point_funcs { extern("C") {
        # Breaks a number into significand and a power of 2
        fundecl frexpf(x: f32, exp: cptr i32) -> f32;
        fundecl frexp(x: f64, exp: cptr i32) -> f64;

        # Multiplies a number by 2 raised to a power
        fundecl ldexpf(x: f32, exp: i32) -> f32;
        fundecl ldexp(x: f64, exp: i32) -> f64;

        # Breaks a number into integer and fractional parts
        fundecl modff(arg: f32, iptr: cptr f32) -> f32;
        fundecl modf(arg: f64, iptr: cptr f64) -> f64;

        # Computes efficiently a number times FLT_RADIX raised to a power
        fundecl scalbnf(x: f32, exp: i32) -> f32;
        fundecl scalbn(x: f64, exp: i32) -> f64;
        fundecl scalblnf(x: f32, exp: i64) -> f32;
        fundecl scalbln(x: f64, exp: i64) -> f64;

        # Extracts exponent of the given number
        fundecl ilogbf(x: f32) -> i32;
        fundecl ilogb(x: f64) -> i32;
        fundecl logbf(x: f32) -> f32;
        fundecl logb(x: f64) -> f64;

        # Determines next representable floating-point value towards the given value
        fundecl nextafterf(from_: f32, to: f32) -> f32;
        fundecl nextafter(from_: f64, to: f64) -> f64;
        # This takes `long double` in `to`
        # fundecl nexttowardf(from_: f32, to: ) -> f32;
        # fundecl nexttoward(from_: f64, to: ) -> f64;

        # Determines next representable floating-point value greater or less than the given value
        fundecl nextupf(x: f32) -> f32;
        fundecl nextup(x: f64) -> f64;
        fundecl nextdownf(x: f32) -> f32;
        fundecl nextdown(x: f64) -> f64;

        # Produces a value with the magnitude of a given value and the sign of another given value
        fundecl copysignf(x: f32, y: f32) -> f32;
        fundecl copysign(x: f64, y: f64) -> f64;
    }}

    # Classification and comparison
    namespace classification_and_comparison { extern("C") {
        # Probably not needed, but we can add it later.
        # Note that these are macros, not functions, so external C implementation is needed.
    }}

    # Bessel functions
    namespace bessel_funcs { extern("C") {
        # Computes the cylindrical Bessel function of the first kind
        fundecl jnf(n: i32, x: f32) -> f32;
        fundecl jn(n: i32, x: f64) -> f64;

        # Computes the cylindrical Neumann function
        # (also known as Bessel function of the second kind or Weber function)
        fundecl ynf(n: i32, x: f32) -> f32;
        fundecl yn(n: i32, x: f64) -> f64;
    }}
}

namespace impl {
    #{
        These are the functions not provided by the C standard library.
    #}

    # Computes absolute value of an integral value
    # Note that it returnes the same value for the most negative value of the type (e.g. -2^31 for i32)
    template(T: type)
    fun abs(x: T) -> T = {
        if (x < 0 as T) return -x;
        return x;
    }

    # Determines larger of two numbers
    template(T: type)
    fun max(x: T, y: T) -> T = {
        if (x < y) return y;
        return x;
    }

    # Determines smaller of two numbers
    template(T: type)
    fun min(x: T, y: T) -> T = {
        if (x < y) return x;
        return y;
    }

    # Computes an integer raised to the given integer power
    # Panics on a negative exponent
    # Wraps on overflow
    template(T: type)
    fun powi(x: T, y: T) -> T = {
        if (y < 0 as T) panicking.panic();

        var result: T = 1 as T;
        var base: T = x;
        while (y > 0 as T) {
            if (y % 2 as T == 1) {
                result = result * base;
            }
            y = y / (2 as T);
            base = base * base;
        }
        return result;
    }

    # Computes the greatest common divisor of two integers
    template(T: type)
    fun gcd(x: T, y: T) -> T = {
        var a: T = impl.abs:{T}(x);
        var b: T = impl.abs:{T}(y);

        while (b != 0 as T) {
            var t: T = b;
            b = a % b;
            a = t;
        }
        return a;
    }

    # Extended Euclidean algorithm
    # Returns a and b such that ax + by = gcd(x, y)
    template(T: type)
    fun extended_euclid(x: T, y: T) -> (T, T) = {
        var old_r: T = impl.abs:{T}(x);
        var r: T = impl.abs:{T}(y);

        var old_s: T = 1;
        var s: T = 0;

        var old_t: T = 0;
        var t: T = 1;

        while (r != 0 as T) {
            var quotient: T = old_r / r;

            var temp_r: T = r;
            r = old_r - quotient * temp_r;
            old_r = temp_r;

            var temp_s: T = s;
            s = old_s - quotient * temp_s;
            old_s = temp_s;

            var temp_t: T = t;
            t = old_t - quotient * temp_t;
            old_t = temp_t;
        }

        # Adjust coefficient signs based on original input signs
        if (x < 0 as T) {
            old_s = -old_s;
        }
        if (y < 0 as T) {
            old_t = -old_t;
        }

        # Returns coefficients (a, b) corresponding to ax + by = gcd(x, y)
        return (old_s, old_t);
    }

    # Computes the modulo inverse using the Extended Euclidean Algorithm
    # Returns y such that (x * y) % m == 1, it assumes that x and m are coprime
    template(T: type)
    fun mod_inverse(x: T, m: T) -> T = {
        var coefs = extended_euclid:{T}(x, m);
        # a is the modular inverse of x modulo m
        return (coefs._1 % m + m) % m;  # Ensure the result is positive
    }

    # Computes the least common multiple of two integers
    template(T: type)
    fun lcm(x: T, y: T) -> T = {
        if ((x == 0 as T) or (y == 0 as T)) return 0 as T;
        return impl.abs:{T}(x) / gcd:{T}(x, y) * impl.abs:{T}(y);
    }

    # Performs linear interpolation between a and b based on t.
    fun lerpf(a: f32, b: f32, t: f32) -> f32 = a + (b - a) * t;
    fun lerp(a: f64, b: f64, t: f64) -> f64 = a + (b - a) * t;

    # Computes the number of ways to choose k items from n items without repetition and without order
    # Uses Pascal's Triangle identity to compute the result - O(n*k) time but avoids overflows safely on big numbers
    # Wraps on overflow
    template(T: type)
    fun comb(n: T, k: T) -> T = {
        if (k > n or k < 0 as T) return 0 as T;
        if ((k == 0 as T) or (k == n)) return 1 as T;
        if (k > n - k) k = n - k;

        var dp: containers.listType:{T}();
        dp.reserve(k + 1);
        dp.push(1 as T);

        var i: T = 1;
        while (i <= n) {
            if (i <= k) {
                dp.push(0 as T);
            }
            var j: T = impl.min:{T}(i, k);
            while (j > 0) {
                dp.at(j) = dp.at(j) + dp.at(j - 1);
                j = j - 1;
            }
            i = i + 1;
        }

        return dp.at(k);
    }

    # Computes the factorial of a non-negative integer n
    # Wraps on overflow
    # Panics on negative n
    template(T: type)
    fun factorial(n: T) -> T = {
        if (n < 0 as T) panicking.panic();
        if (n == 0 as T) return 1 as T;

        var result: T = 1 as T;
        while (n > 1 as T) {
            result = result * n;
            n = n - 1 as T;
        }
        return result;
    }

    # Computes the number of ways to choose k items from n items without repetition and with order
    # Wraps on overflow
    template(T: type)
    fun perm(n: T, k: T) -> T = {
        if (k > n or k < 0 as T) return 0 as T;
        if (k == 0 as T) return 1 as T;

        var result: T = 1 as T;
        while (k > 0 as T) {
            result = result * (n - k + 1 as T);
            k = k - 1 as T;
        }

        return result;
    }
}

namespace constants {
    #{
        Mathematical constants.
    #}
    
    # Ratio of a circle's circumference to its diameter and derived constants
    const PI:             f64 = 3.141592653589793238462643;
    const SQRT_PI:        f64 = 1.772453850905516027298167;
    const FRAC_1_PI:      f64 = 0.3183098861837906715377675;
    const FRAC_1_SQRT_PI: f64 = 0.5641895835477562869480795;

    const FRAC_PI_2: f64 = 1.570796326794896619231322;
    const FRAC_PI_3: f64 = 1.047197551196597746154214;
    const FRAC_PI_4: f64 = 0.7853981633974483096156608;
    const FRAC_PI_6: f64 = 0.5235987755982988730771072;
    const FRAC_PI_8: f64 = 0.3926990816987241548078304;

    const FRAC_1_SQRT_2PI: f64 = 0.3989422804014326779399461;
    const FRAC_2_SQRT_PI:  f64 = 1.128379167095512573896159;

    # Ratio of a circle's circumference to its radius
    const TAU: f64 = 6.283185307179586476925287;

    # Euler's number and derived constants
    const E:         f64 = 2.718281828459045235360287;
    const SQRT_E:    f64 = 1.648721270700128146848651;
    const FRAC_1_E:  f64 = 0.3678794411714423215955238;
    const LOG2_E:    f64 = 1.442695040888963407359925;
    const LOG10_E:   f64 = 0.4342944819032518276511289;

    # Euler–Mascheroni constant
    const EGAMMA: f64 = 0.5772156649015328606065121;

    # Golden ratio and derived constants
    const PHI:         f64 = 1.618033988749894848204587;
    const SQRT_PHI:    f64 = 1.272019649514068964252422;
    const FRAC_1_PHI:  f64 = 0.6180339887498948482045868;
    const LN_PHI:      f64 = 0.4812118250596034474977589;

    # Radians and degrees conversion
    const RAD_TO_DEG: f64 = 57.29577951308232087679815;
    const DEG_TO_RAD: f64 = 0.01745329251994329576923691;

    # Other
    const LN_2:    f64 = 0.6931471805599453094172321;
    const LN_10:   f64 = 2.302585092994045684017991;
    const LOG2_10: f64 = 3.321928094887362347870319;

    const SQRT2:        f64 = 1.414213562373095048801689;
    const SQRT3:        f64 = 1.732050807568877293527446;
    const SQRT5:        f64 = 2.236067977499789696409174;
    const FRAC_1_SQRT2: f64 = 0.7071067811865475244008444;
    const FRAC_1_SQRT3: f64 = 0.5773502691896257645091488;
    const FRAC_1_SQRT5: f64 = 0.4472135954999579392818347;
}

