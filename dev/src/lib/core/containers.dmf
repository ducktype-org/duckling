import core.builtins as builtins;
import core.panicking as panicking;
import core.runtime as runtime;
import core.clib as clib;

namespace allocation {

    @backend_dependent
    fundecl alloc(len: u64) -> manyptr char;

    @dvm_only_impl
    fun alloc(len: u64) -> manyptr char = {
        return builtins.dvm_char_alloc(len);
    }

    @native_only_impl
    fun alloc(len: u64) -> manyptr char = {
        return clib.malloc(len) as manyptr char;
    }

    @backend_dependent
    fundecl free(p: manyptr char) -> ();

    @dvm_only_impl
    fun free(p: manyptr char) -> () = {
        builtins.dvm_char_free(p);
    }

    @native_only_impl
    fun free(p: manyptr char) -> () = {
        clib.free(p as cptr u8);
    }

    @backend_dependent
    fundecl realloc(p: manyptr char, new_size: u64) -> manyptr char;

    #{
        `dvm_char_realloc` resizes the dynamic table in place and reseats the
        handle held by `p`, so the parameter itself is the reallocated buffer.
    #}
    @dvm_only_impl
    fun realloc(p: manyptr char, new_size: u64) -> manyptr char = {
        builtins.dvm_char_realloc(p, new_size);
        return p;
    }

    @native_only_impl
    fun realloc(p: manyptr char, new_size: u64) -> manyptr char = {
        return clib.realloc(p as cptr u8, new_size) as manyptr char;
    }
}

class DuckString {
    pointer: manyptr char;
    len: u64;
    cap: u64;

    #{
        Makes sure at least `required` characters fit into the buffer.
        The capacity is doubled instead of trimmed to `required`, which keeps a
        sequence of `append`s amortized O(1).
    #}
    fun reserve(required: u64) -> () = {
        if (required > cap) {
            var new_cap = cap;
            if (new_cap == 0u64) new_cap = 1u64;
            while (new_cap < required) new_cap = new_cap * 2u64;

            # A default constructed string has no buffer to reallocate yet.
            if (cap == 0u64) pointer = allocation.alloc(new_cap);
            else pointer = allocation.realloc(pointer, new_cap);
            cap = new_cap;
        }
    }

    fun append(c: char) -> () = {
        reserve(len + 1u64);
        pointer[i64(len)] = c;
        len               = len + 1u64;
    }

    fun append(other: ref DuckString) -> () = {
        let other_len = other.length();
        reserve(len + other_len);

        # `other.pointer` is read after `reserve`, growing self may have moved
        # the buffer `other` refers to when both are the same string.
        copyCharsAt(other.pointer, pointer, len, other_len);
        len = len + other_len;
    }

    fun prepend(c: char) -> () = {
        reserve(len + 1u64);

        # Shift right back to front, so moved characters are never clobbered.
        var i = i64(len);
        while (i > 0i64) {
            pointer[i] = pointer[i - 1i64];
            i          = i - 1i64;
        }
        pointer[0] = c;
        len        = len + 1u64;
    }

    #{
        Drops the contents but keeps the buffer, so it can be refilled without
        allocating again.
    #}
    fun clear() -> () = {
        len = 0u64;
    }

    #{
        Releases the buffer. The string is left empty and reusable.
    #}
    fun dispose() -> () = {
        if (cap > 0u64) allocation.free(pointer);
        len = 0u64;
        cap = 0u64;
    }

    fun length() -> u64 = len;

    #{
        `toCString` is missing on purpose. It has to hand out a `cptr char`, and
        DVM code generation rejects `cptr` anywhere in a module, so having it
        here would make `core.containers` uncompilable for the DVM. Reintroduce
        it once the DVM supports C pointers.
    #}
    fun asSlice() -> str = {
        return builtins.char_slice_from_ptr_len(pointer, len);
    }

    fun at(i: i64) -> ref char = {
        if (i < 0i64 or i >= i64(len)) panicking.panic();
        return &pointer[i];
    }
}

fun duckStringReserve(cap: u64) -> DuckString = {
    # Never allocate an empty buffer, `reserve` treats `cap == 0` as "there is
    # nothing to reallocate yet".
    var initial_cap = cap;
    if (initial_cap == 0u64) initial_cap = 1u64;

    var result: DuckString;
    result.pointer = allocation.alloc(initial_cap);
    result.len     = 0u64;
    result.cap     = initial_cap;
    return result;
}

fun copyCharsAt(source: manyptr char, dest: manyptr char, dest_offset: u64, count: u64) -> () = {
    let offset = i64(dest_offset);
    var i      = 0i64;
    while (i < i64(count)) {
        dest[offset + i] = source[i];
        i                = i + 1i64;
    }
}

fun copyChars(source: manyptr char, dest: manyptr char, count: u64) -> () = {
    copyCharsAt(source, dest, 0u64, count);
}

fun stringify_str(x: str) -> DuckString = {
    let size   = x.length();
    var result = duckStringReserve(size);
    copyChars(builtins.char_ptr_from_slice(x), result.pointer, size);
    result.len = size;
    return result;
}

fun stringify_char(x: char) -> DuckString = {
    var result        = duckStringReserve(1u64);
    result.pointer[0] = x;
    result.len        = 1u64;
    return result;
}

fun stringify_bool(x: bool) -> DuckString = {
    if (x) return stringify_str("true");
    return stringify_str("false");
}

fun stringify_i64(x: i64) -> DuckString = {
    let max_size = 21u64;
    var result   = duckStringReserve(max_size);
    result.len   = runtime.i64_to_string(x, result.pointer, max_size);
    return result;
}

fun stringify_u64(x: u64) -> DuckString = {
    let max_size = 21u64;
    var result   = duckStringReserve(max_size);
    result.len   = runtime.u64_to_string(x, result.pointer, max_size);
    return result;
}

fun stringify_f64(x: f64) -> DuckString = {
    let max_size = 20u64;
    var result   = duckStringReserve(max_size);
    result.len   = runtime.float_to_string(x, result.pointer, max_size);
    return result;
}

