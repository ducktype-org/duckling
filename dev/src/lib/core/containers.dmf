import core.builtins as builtins;
import core.panicking as panicking;
import core.runtime as runtime;
import core.clib as clib;

template(T: type)
namespace allocation {
    const LLVM_ELEM_SIZE = builtins.size_of(T) as u64;

    @backend_dependent
    fundecl alloc(len: u64) -> manyptr T;

    @dvm_only_impl
    fun alloc(len: u64) -> manyptr T = {
        return builtins.dvm_alloc_arr:{T}(len);
    }

    @native_only_impl
    fun alloc(len: u64) -> manyptr T = {
        return clib.malloc(len * LLVM_ELEM_SIZE) as manyptr T;
    }

    @backend_dependent
    fundecl free(p: manyptr T) -> ();

    @dvm_only_impl
    fun free(p: manyptr T) -> () = {
        builtins.dvm_free_arr:{T}(p);
    }

    @native_only_impl
    fun free(p: manyptr T) -> () = {
        clib.free(p as cptr u8);
    }

    @backend_dependent
    fundecl realloc(p: manyptr T, new_size: u64) -> manyptr T;

    #{
        `dvm_realloc_arr` resizes the dynamic table in place and reseats the
        handle held by `p`, so the parameter itself is the reallocated buffer.
    #}
    @dvm_only_impl
    fun realloc(p: manyptr T, new_size: u64) -> manyptr T = {
        builtins.dvm_realloc_arr:{T}(p, new_size);
        return p;
    }

    @native_only_impl
    fun realloc(p: manyptr T, new_size: u64) -> manyptr T = {
        return clib.realloc(p as cptr u8, new_size * LLVM_ELEM_SIZE) as manyptr T;
    }
}

class String {
    pointer: manyptr char;
    len: u64;
    cap: u64;
    offset: u64;

    #{
        Makes sure at least `required` characters fit into the buffer.
        The capacity is doubled instead of trimmed to `required`, which keeps a
        sequence of `append`s amortized O(1).
    #}
    fun reserve(required: u64) -> () = {
        if (required > cap) {
            var new_cap = cap;
            if (new_cap == 0u64) new_cap = 1u64;
            while (new_cap < required) new_cap = new_cap * 2u64;

            if (cap == 0u64) pointer = allocation:{char}.alloc(new_cap);
            else pointer = allocation:{char}.realloc(pointer, new_cap);
            cap = new_cap;
        }
    }

    fun append(c: char) -> ref String = {
        reserve(len + 1u64);
        pointer[len as i64] = c;
        len               = len + 1u64;
        return self;
    }

    fun append(other: ref String) -> ref String = {
        let other_len = other.length();
        reserve(len + other_len);

        # `other.pointer` is read after `reserve`, growing self may have moved
        # the buffer `other` refers to when both are the same string.
        copyCharsAt(other.pointer, pointer, len, other_len);
        len = len + other_len;
        return self;
    }

    fun append(other: String) -> ref String = {
        append(&other);
        other.dispose();
        return self;
    }

    fun append(other: str) -> ref String = {
        let other_len = other.length();
        reserve(len + other_len);
        copyCharsAt(builtins.ptr_from_slice:{char}(other), pointer, len, other_len);
        len = len + other_len;
        return self;
    }

    fun prepend(c: char) -> ref String = {
        reserve(len + 1u64);

        # Shift right back to front, so moved characters are never clobbered.
        var i = len as i64;
        while (i > 0i64) {
            pointer[i] = pointer[i - 1i64];
            i          = i - 1i64;
        }
        pointer[0] = c;
        len        = len + 1u64;
        return self;
    }

    #{
        Drops the contents but keeps the buffer, so it can be refilled without
        allocating again.
    #}
    fun clear() -> () = {
        len = 0u64;
    }

    #{
        Releases the buffer. The string is left empty and reusable.
    #}
    fun dispose() -> () = {
        if (cap > 0u64) allocation:{char}.free(pointer);
        len = 0u64;
        cap = 0u64;
    }

    fun length() -> u64 = len;
    
    fun asSlice() -> str = {
        return builtins.slice_from_ptr_len:{char}(pointer, len);
    }

    fun at(i: i64) -> ref char = {
        if (i < 0i64 or i >= len as i64) panicking.panic();
        return &pointer[i];
    }

    fun toString() -> String = {
        return copy *(self as ptr String);
    }

    String.copy(other: const ref String) = {
        var result = stringReserve(other.length());
        copyChars(other.pointer, result.pointer, other.length());
        result.len = other.length();
        return move result;
    }

    String.destroy() = {
        allocation:{char}.free(pointer);   
    }
}

fun stringReserve(cap: u64) -> String = {
    var result: String;
    result.reserve(cap);
    return move result;
}

fun copyCharsAt(source: manyptr char, dest: manyptr char, dest_offset: u64, count: u64) -> () = {
    let offset = dest_offset as i64;
    var i      = 0i64;
    while (i < count as i64) {
        dest[offset + i] = source[i];
        i                = i + 1i64;
    }
}

fun copyChars(source: manyptr char, dest: manyptr char, count: u64) -> () = {
    copyCharsAt(source, dest, 0u64, count);
}

fun ++(a: String, b: String) -> String = {
    var result = stringReserve(a.length() + b.length());
    result.append(&a);
    result.append(&b);
    a.dispose();
    b.dispose();
    return move result;
}

fun ++(a: ref String, b: ref String) -> String = {
    var result = stringReserve(a.length() + b.length());
    result.append(&a);
    result.append(&b);
    return move result;
}

fun +:(c: char, s: String) -> String = {
    var result = stringReserve(s.length() + 1u64);
    result.append(c);
    result.append(&s);
    s.dispose();
    return move result;
}

fun +:(c: char, s: ref String) -> String = {
    var result = stringReserve(s.length() + 1u64);
    result.append(c);
    result.append(&s);
    return move result;
}

fun :+(s: String, c: char) -> String = {
    var result = stringReserve(s.length() + 1u64);
    result.append(&s);
    result.append(c);
    s.dispose();
    return move result;
}

fun :+(s: ref String, c: char) -> String = {
    var result = stringReserve(s.length() + 1u64);
    result.append(&s);
    result.append(c);
    return move result;
}

fun stringifyStr(x: str) -> String = {
    let size   = x.length();
    var result = stringReserve(size);
    copyChars(builtins.ptr_from_slice:{char}(x), result.pointer, size);
    result.len = size;
    return move result;
}

fun stringifyChar(x: char) -> String = {
    var result        = stringReserve(1u64);
    result.pointer[0] = x;
    result.len        = 1u64;
    return move result;
}

fun stringifyBool(x: bool) -> String = {
    if (x) return stringifyStr("true");
    return stringifyStr("false");
}

# The `*_to_string` runtime builtins write via `snprintf`, which appends a terminating
# NUL, so `buffer_cap` is the total buffer size: it fits at most `buffer_cap - 1`
# characters. 21 bytes hold the 20-character extremes of `i64`/`u64` plus the NUL, and
# `%g` never exceeds that for a double.
fun stringifyI64(x: i64) -> String = {
    let buffer_cap = 21u64;
    var result     = stringReserve(buffer_cap);
    result.len     = runtime.i64_to_string(x, result.pointer, buffer_cap);
    return move result;
}

fun stringifyU64(x: u64) -> String = {
    let buffer_cap = 21u64;
    var result     = stringReserve(buffer_cap);
    result.len     = runtime.u64_to_string(x, result.pointer, buffer_cap);
    return move result;
}

fun stringifyF64(x: f64) -> String = {
    let buffer_cap = 21u64;
    var result     = stringReserve(buffer_cap);
    result.len     = runtime.float_to_string(x, result.pointer, buffer_cap);
    return move result;
}

#{
    Growable array of `T`. Capacity doubles on growth, so a sequence of
    `push`es is amortized O(1).
#}
template(T: type)
class DuckList {
    pointer: manyptr T;
    len: u64;
    cap: u64;

    #{
        Makes sure at least `required` elements fit into the buffer.
    #}
    fun reserve(required: u64) -> () = {
        if (required > cap) {
            var new_cap = cap;
            if (new_cap == 0u64) new_cap = 1u64;
            while (new_cap < required) new_cap = new_cap * 2u64;

            if (cap == 0u64) pointer = allocation:{T}.alloc(new_cap);
            else pointer = allocation:{T}.realloc(pointer, new_cap);
            cap = new_cap;
        }
    }

    fun push(value: T) -> () = {
        reserve(len + 1u64);
        pointer[len as i64] = value;
        len                 = len + 1u64;
    }

    fun pop() -> T = {
        if (len == 0u64) panicking.panic();
        len = len - 1u64;
        return pointer[len as i64];
    }

    fun at(i: i64) -> ref T = {
        if (i < 0i64 or i >= len as i64) panicking.panic();
        return &pointer[i];
    }

    fun length() -> u64 = len;

    #{
        Drops the contents but keeps the buffer, so it can be refilled without
        allocating again.
    #}
    fun clear() -> () = {
        len = 0u64;
    }

    #{
        Releases the buffer. The list is left empty and reusable.
    #}
    fun dispose() -> () = {
        if (cap > 0u64) allocation:{T}.free(pointer);
        len = 0u64;
        cap = 0u64;
    }

    DuckList.destroy() = {
        allocation:{T}.free(pointer);
    }
}
