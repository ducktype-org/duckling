#{
    Builtin intput and output functions.
    These are temporary and to be removed in the future.
#}
import core.containers;
import core.io;

template(T: type)
@builtin("ptr_from_slice")
fundecl ptr_from_slice(s: slice T) -> manyptr T;

template(T: type)
@builtin("slice_from_ptr_len")
fundecl slice_from_ptr_len(p: manyptr T, l: u64) -> slice T;

template(T: type)
@builtin("dvm_alloc_arr")
fundecl dvm_alloc_arr(size: u64) -> manyptr T;

template(T: type)
@builtin("dvm_realloc_arr")
fundecl dvm_realloc_arr(p: manyptr T, size: u64);

template(T: type)
@builtin("dvm_free_arr")
fundecl dvm_free_arr(p: manyptr T);

template(T: type)
@builtin("dvm_alloc")
fundecl dvm_alloc() -> ptr T;

template(T: type)
@builtin("dvm_free")
fundecl dvm_free(p: ptr T);

#{
    Reads the value under `pointer` without copying or moving it. The storage
    under `pointer` is left untouched, its ownership is taken over by the caller.
#}
template(T: type)
@builtin("move_out")
fundecl move_out(pointer: ptr T) -> T;

#{
    Writes `value` into the storage under `pointer`, treating that storage as
    uninitialized: whatever was there before is not destroyed.
#}
template(T: type)
@builtin("move_in")
fundecl move_in(pointer: ptr T, value: T) -> ();

#{
    Decomposes a pointer into the id of the block it points into and the byte offset within
    that block.

    Fails on a null pointer, which points into no block, so guard with `dvm_is_nullptr`.
#}
template(T: type)
@builtin("dvm_ptr_parts")
fundecl dvm_ptr_parts(pointer: ptr T) -> u64[2];

#{
    Whether `pointer` points into no block. DVM only.
#}
template(T: type)
@builtin("dvm_is_nullptr")
fundecl dvm_is_nullptr(pointer: ptr T) -> bool;

#{
    A pointer into no block. DVM only.
#}
template(T: type)
@builtin("dvm_nullptr")
fundecl dvm_nullptr() -> ptr T;

#{
    The `manyptr` counterpart of `dvm_is_nullptr`.
#}
template(T: type)
@builtin("dvm_is_nullptr")
fundecl dvm_is_nullmanyptr(pointer: manyptr T) -> bool;

#{
    The `manyptr` counterpart of `dvm_nullptr`.
#}
template(T: type)
@builtin("dvm_nullptr")
fundecl dvm_nullmanyptr() -> manyptr T;

@builtin("alignment_of")
fundecl alignment_of(v: type) -> i64;

@builtin("size_of")
fundecl size_of(v: type) -> i64;



#{
    Old entry points
#}
fun builtin_input_char() -> char = io.readChar();
fun builtin_input_i64() -> i64 = io.readI64();
fun builtin_input_u64() -> u64 = io.readU64();
fun builtin_input_f64() -> f64 = io.readF64();
fun builtin_input_string() -> containers.String = io.readString();

fun builtin_output_char(c: char) -> i64 = io.writeChar(c) as i64;
fun builtin_output_i64(v: i64) -> i64 = io.writeI64(v) as i64;
fun builtin_output_u64(v: u64) -> i64 = io.writeU64(v) as i64;
fun builtin_output_f64(v: f64) -> i64 = io.writeF64(v) as i64;
fun builtin_output_str(v: str) -> i64 = io.writeStr(v) as i64;

fun print(v: str) -> u64 = io.writeStr(v);

fun print(v: ref containers.String) -> u64 = io.writeString(v);

fun print(s: containers.String) -> u64 = {
    let result = io.writeString(&s);
    s.dispose();
    return result;
}
