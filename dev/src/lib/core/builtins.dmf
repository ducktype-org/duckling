#{
    Builtin intput and output functions.
    These are temporary and to be removed in the future.
#}
extern("C") {
    #{
        These are marked `fundecl` since the definition
        is for now not generated by the compiler, but it is linked
        from the compiled library. The library is written in "C"
        and it requires the C-ABI.
    #}
    fundecl builtin_input_char() -> char;
    fundecl builtin_output_char(c: char) -> i64;

    fundecl builtin_input_i64() -> i64;
    fundecl builtin_output_i64(x: i64) -> i64;

    fundecl builtin_input_u64() -> u64;
    fundecl builtin_output_u64(x: u64) -> i32;

    fundecl builtin_input_f64() -> f64;
    fundecl builtin_output_f64(x: f64) -> i32;

    fundecl builtin_input_string() -> String;
    fundecl print(x: String) -> i32;
}

fun builtin_output_str(s: str) -> i32 = {
    var i = 0u32;
    while (i < s.length()) {
        builtin_output_char(s[i]);
        i = i + 1u32;
    }
    return i as i32;
}

fun print(x: str) -> i32 = builtin_output_str(x);

@builtin("char_ptr_from_slice")
fundecl char_ptr_from_slice(s: slice char) -> manyptr char;

@builtin("char_slice_from_ptr_len")
fundecl char_slice_from_ptr_len(p: manyptr char, l: u64) -> slice char;

@builtin("dvm_char_alloc")
fundecl dvm_char_alloc(size: u64) -> manyptr char;

@builtin("dvm_char_realloc")
fundecl dvm_char_realloc(p: manyptr char, size: u64);

@builtin("dvm_char_free")
fundecl dvm_char_free(p: manyptr char);
