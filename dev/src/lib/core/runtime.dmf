#{
    Language runtime library.
    Things we can't implement in Duckling.
#}
extern("C") {
    #{
        Number formatting. Each one writes the decimal representation of `value` into the
        buffer `p` and returns how many characters it wrote, or `0` when the representation
        does not fit into `max_len` characters.

        These are `fundecl` since the definition is not generated by the compiler. The native
        backend links them from the builtin library (`builtins_source.cpp`), the DVM lowers
        them to `call_builtinfunc` (`vm::builtins::getBuiltinFunctions`).
    #}
    fundecl builtin_float_to_string(value: f64, p: manyptr char, max_len: u64) -> u64;
    fundecl builtin_u64_to_string(value: u64, p: manyptr char, max_len: u64) -> u64;
    fundecl builtin_i64_to_string(value: i64, p: manyptr char, max_len: u64) -> u64;
}

fun float_to_string(value: f64, p: manyptr char, max_len: u64) -> u64 = {
    return builtin_float_to_string(value, p, max_len);
}

fun u64_to_string(value: u64, p: manyptr char, max_len: u64) -> u64 = {
    return builtin_u64_to_string(value, p, max_len);
}

fun i64_to_string(value: i64, p: manyptr char, max_len: u64) -> u64 = {
    return builtin_i64_to_string(value, p, max_len);
}
