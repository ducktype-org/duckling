#{
    Language runtime library.
    Things we can't implement in Duckling.
#}
namespace native {
    extern("C") {
        #{
            Number formatting. Each one writes the decimal representation of `value` into the
            buffer `p` and returns how many characters it wrote, or `0` when the representation
            does not fit into `max_len` characters.

            The native backend links these from the builtin library (`builtins_source.cpp`).
            They use the C ABI, so the buffer is passed as a `cptr`.
        #}
        fundecl float_to_string(value: f64, p: cptr char, max_len: u64) -> u64;
        fundecl u64_to_string(value: u64, p: cptr char, max_len: u64) -> u64;
        fundecl i64_to_string(value: i64, p: cptr char, max_len: u64) -> u64;
    }
}

namespace dvm {
    extern("DVM") {
        #{
            The same functions for the DVM backend, which lowers a call to these to
            `call_builtinfunc` (`vm::builtins::getBuiltinFunctions`). The "DVM" ABI keeps the
            names unmangled so they match the builtin registry, but unlike the C ABI it does
            not require C pointers, which the DVM does not support.
        #}
        fundecl float_to_string(value: f64, p: manyptr char, max_len: u64) -> u64;
        fundecl u64_to_string(value: u64, p: manyptr char, max_len: u64) -> u64;
        fundecl i64_to_string(value: i64, p: manyptr char, max_len: u64) -> u64;
    }
}

@backend_dependent
fundecl float_to_string(value: f64, p: manyptr char, max_len: u64) -> u64;

@native_only_impl
fun float_to_string(value: f64, p: manyptr char, max_len: u64) -> u64 = {
    return native.float_to_string(value, p as cptr char, max_len);
}

@dvm_only_impl
fun float_to_string(value: f64, p: manyptr char, max_len: u64) -> u64 = {
    return dvm.float_to_string(value, p, max_len);
}

@backend_dependent
fundecl u64_to_string(value: u64, p: manyptr char, max_len: u64) -> u64;

@native_only_impl
fun u64_to_string(value: u64, p: manyptr char, max_len: u64) -> u64 = {
    return native.u64_to_string(value, p as cptr char, max_len);
}

@dvm_only_impl
fun u64_to_string(value: u64, p: manyptr char, max_len: u64) -> u64 = {
    return dvm.u64_to_string(value, p, max_len);
}

@backend_dependent
fundecl i64_to_string(value: i64, p: manyptr char, max_len: u64) -> u64;

@native_only_impl
fun i64_to_string(value: i64, p: manyptr char, max_len: u64) -> u64 = {
    return native.i64_to_string(value, p as cptr char, max_len);
}

@dvm_only_impl
fun i64_to_string(value: i64, p: manyptr char, max_len: u64) -> u64 = {
    return dvm.i64_to_string(value, p, max_len);
}
