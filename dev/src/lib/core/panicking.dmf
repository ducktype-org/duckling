import core.builtins.*;
import core.clib;
import core.runtime;

fun panic() -> () = {
    builtin_output_str("Program panicked!\n");
    doPanic();
}

@backend_dependent
fundecl doPanic() -> ();

@native_only_impl
fun doPanic() -> () = {
    clib.abort();
}

@dvm_only_impl
fun doPanic() -> () = {
    runtime.dvm.abort();
}