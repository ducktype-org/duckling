{
    "name": "duckling-language-support",
    "displayName": "Duckling",
    "description": "Duckling Language Support",
    "version": "0.0.1",
    "icon": "images/icon.png",
    "author": "DuckType",
    "publisher": "DuckType",
    "categories": [
        "Programming Languages"
    ],
    "engines": {
        "vscode": "^1.84.0"
    },
    "main": "./client/out/extension",
    "activationEvents": [
        "onLanguage:duckling"
    ],
    "files": [
        "client/out/",
        "client/node_modules/",
        "images/",
        "syntaxes/",
        "language-configuration.json",
        "README.md"
    ],
    "contributes": {
        "commands": [
            {
                "command": "duckling.restartServer",
                "title": "Duckling: Restart language server"
            }
        ],
        "languages": [
            {
                "id": "duckling",
                "aliases": [
                    "Duckling",
                    "duckling"
                ],
                "extensions": [
                    ".dl",
                    ".duck",
                    ".🦆",
                    ".dk",
                    ".dks"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "duckling",
                "scopeName": "source.duckling",
                "path": "./syntaxes/duckling.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Duckling Language Configuration",
            "properties": {
                "DucklingLanguageSupport.enable": {
                    "scope": "window",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Run the `duck_ls` language server. Turn this off to keep syntax highlighting, bracket matching and the other editor features the extension contributes on its own, without starting a server."
                },
                "DucklingLanguageSupport.executablePath": {
                    "scope": "machine",
                    "type": "string",
                    "default": "~/.local/bin/duck_ls",
                    "markdownDescription": "Path to the `duck_ls` binary. Supports `~` for the home directory. Defaults to `~/.local/bin/duck_ls`. Run `comp-copy.py` to install the binary there, or set this to a custom path if you installed it elsewhere."
                },
                "DucklingLanguageSupport.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "messages",
                    "description": "Traces the communication between VS Code and the Duckling language server."
                }
            }
        },
        "configurationDefaults": {
            "[duckling]": {
                "editor.semanticHighlighting.enabled": true
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -b",
        "watch": "tsc -b -w",
        "lint": "eslint ./client/src --ext .ts,.tsx",
        "postinstall": "cd client && npm install && cd .."
    },
    "devDependencies": {
        "@types/node": "^16.18.34",
        "@typescript-eslint/eslint-plugin": "^6.7.0",
        "@typescript-eslint/parser": "^6.7.0",
        "eslint": "^8.35.0",
        "typescript": "^5.2.2"
    },
    "keywords": [
        "Duckling",
        "language server",
        "programming language",
        "lsp",
        "syntax highlighting"
    ],
    "dependencies": {}
}
