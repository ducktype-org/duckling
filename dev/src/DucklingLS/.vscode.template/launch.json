{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "extensionHost",
			"request": "launch",
			"name": "Launch Client",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceRoot}/dev/src/DucklingLS"
			],
			"outFiles": [
				"${workspaceRoot}/dev/src/DucklingLS/client/out/**/*.js"
			],
			"preLaunchTask": "npm: watch"
		}
	]
}
