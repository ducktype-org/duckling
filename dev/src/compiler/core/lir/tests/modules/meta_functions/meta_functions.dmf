fun createBox(t: type) -> type = box t;
fun createRef(t: type) -> type = ref t;
fun createVariant(a: type, b: type, c: type, d: type) -> type = a | b | c | d;
fun createTuple(a: type, b: type, c: type, d: type) -> type = {
    var new: type = (a, b, c, d);
    return new;
}

fun megaType(a: type) -> type = {
    var c: type = ((), a, createBox(i32), (i16, f16), i64 | (f64, f128));
    return c;
}

# fun createOpt(t: type) -> type = ?t;
# fun createConst(t: type) -> type = const t;
# fun getTypeSize(a: type) -> i64 = a::size;
