extern("C") {
    # `match` and `in` are keywords, so these C functions can only be declared under another name.
    @c_symbol_name("match") fundecl c_match(a: i64) -> i64;

    namespace inner {
        @c_symbol_name("in") fundecl c_in(a: i64) -> i64;
    }

    # Without the attribute the declared name is the linked one.
    fundecl plain_c(a: i64) -> i64;
}

fun caller() -> i64 = {
    return c_match(1i64) + inner::c_in(2i64) + plain_c(3i64);
}

# The attribute only applies to extern("C"): here it is ignored and the usual name is linked.
@c_symbol_name("not_extern") fundecl notExternC(a: i64) -> i64;

extern("DVM") {
    @c_symbol_name("dvm_decl") fundecl dvmDecl(a: i64) -> i64;
}

fun ignored_caller() -> i64 = {
    return notExternC(1i64) + dvmDecl(2i64);
}
