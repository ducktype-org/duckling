class Point {
	x: i32;
	y: i32;
}
class RefPoint {
	x: ref mut i32;
	y: ref mut i32;
}
class RefWrapper {
	p: ref mut RefPoint;
}

fun references(p: ref Point) -> () = {
	var x: i32 = 123;
	var y: i32 = 456;

	var rx: ref mut i32 = &x;
	var rpx: ref i32 = &p.x; # AddressOf from [Deref, FieldProjection].

	var point = RefPoint(&x, &y);
	var ref_point: ref mut RefPoint = &point;
	var wrapper = RefWrapper(&point);
	var ref_wrapper: ref mut RefWrapper = &wrapper;

	ref_wrapper.p.x = 999; # [Deref, Field, Deref, Field, Deref]
}
