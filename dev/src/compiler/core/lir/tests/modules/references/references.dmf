class Point { x: i32; y: i32; }
class RefPoint { x: ref i32; y: ref i32; }
class RefWrapper { p: ref RefPoint; }

fun references(p: ref Point) -> () = {
    var x: i32 = 123;
    var y: i32 = 456;

    var r = refof x;
    var r = refof p.x; # AddressOf from [Deref, FieldProjection].

    var point = RefPoint(refof x, refof y);
    var ref_point = refof point;
    var wrapper = RefWrapper(refof point);
    var ref_wrapper = refof wrapper;
    
    ref_wrapper.p.x = 999; # [Deref, Field, Deref, Field, Deref]
}
