class RecordClass {
    a: i64 = 0i64;
    b: f32 = 0.0f32;
    c: i16 = 0i16;
}

class BiggerRecordClass {
    y: RecordClass = RecordClass(1i64, 2.0f32, 3i16);
    z: f64 = 0.0f64;
}

fun printRecordClass(r: RecordClass) = {
    builtin_output_i64(r.a);
    builtin_output_i64(r.c);
}

let a: RecordClass = RecordClass(1i64, 2.0f32, 3i16);

let big = BiggerRecordClass(RecordClass(2i64, 3.0f32, 4i16), 5f64);

fun main() -> i64 = {
    var b = a;
    printRecordClass(a);
    a.a = 42i64;
    a.c = 6i16 * 9i16;
    printRecordClass(a);
    printRecordClass(b);
    b = a;
    printRecordClass(b);

    builtin_output_i64(big.y.c); # 4

    return 0i64;
}
