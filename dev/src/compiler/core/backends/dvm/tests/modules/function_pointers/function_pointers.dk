fun add(a: i64, b: i64) -> i64 = a + b;
fun mul(a: i64, b: i64) -> i64 = a * b;

fun scale(t: (i64, i64, i64)) -> (i64, i64, i64) = (t._1 * 2, t._2 * 2, t._3 * 2);

fun show(x: i64) = {
    builtin_output_i64(x);
}

fun apply(f: funptr(i64, i64) -> i64, x: i64) -> i64 = f(x, x);

fun pick(m: bool) -> funptr(i64, i64) -> i64 = {
    if (m) { return mul; }
    return add;
}

class Holder {
    cb: funptr(i64, i64) -> i64;
}

fun main() -> i64 = {
    let f = add;
    builtin_output_i64(f(1, 2));
    builtin_output_i64(apply(mul, 5));
    builtin_output_i64(pick(true)(3, 4));

    let g: funptr((i64, i64, i64)) -> (i64, i64, i64) = scale;
    let t = g((1, 2, 3));
    builtin_output_i64(t._1 + t._2 + t._3);

    let s = show;
    s(7);

    var h = Holder(add);
    h.cb = mul;
    return h.cb(6, 7);
}
