fun test_64(a: i64, b: i64, s: i64) -> i64 = {

    if ((a & b) != 8)   { return 1; }
    if ((a | b) != 14)  { return 2; }
    if ((a ^ b) != 6)   { return 3; }
    if ((a << s) != 48) { return 4; }
    if ((a >> s) != 3)  { return 5; }

    if ((a & 10) != 8)  { return 6; }
    if ((a | 10) != 14) { return 7; }
    if ((a ^ 10) != 6)  { return 8; }
    if ((a << 2) != 48) { return 9; }
    if ((a >> 2) != 3)  { return 10; }

    if (~a != -13)      { return 11; }
    return 0;
}

fun test_32(a: i32, b: i32, s: i32) -> i32 = {
    if ((a & b) != 8i32)   { return 1i32; }
    if ((a | b) != 14i32)  { return 2i32; }
    if ((a ^ b) != 6i32)   { return 3i32; }
    if ((a << s) != 48i32) { return 4i32; }
    if ((a >> s) != 3i32)  { return 5i32; }

    if ((a & 10i32) != 8i32)  { return 6i32; }
    if ((a | 10i32) != 14i32) { return 7i32; }
    if ((a ^ 10i32) != 6i32)  { return 8i32; }
    if ((a << 2i32) != 48i32) { return 9i32; }
    if ((a >> 2i32) != 3i32)  { return 10i32; }

    if (~a != -13i32)         { return 11i32; }
    return 0i32;
}

fun test_16(a: i16, b: i16, s: i16) -> i16 = {
    if ((a & b) != 8i16)   { return 1i16; }
    if ((a | b) != 14i16)  { return 2i16; }
    if ((a ^ b) != 6i16)   { return 3i16; }
    if ((a << s) != 48i16) { return 4i16; }
    if ((a >> s) != 3i16)  { return 5i16; }

    if ((a & 10i16) != 8i16)  { return 6i16; }
    if ((a | 10i16) != 14i16) { return 7i16; }
    if ((a ^ 10i16) != 6i16)  { return 8i16; }
    if ((a << 2i16) != 48i16) { return 9i16; }
    if ((a >> 2i16) != 3i16)  { return 10i16; }

    if (~a != -13i16)         { return 11i16; }
    return 0i16;
}

fun test_8(a: i8, b: i8, s: i8) -> i8 = {
    if ((a & b) != 8i8)   { return 1i8; }
    if ((a | b) != 14i8)  { return 2i8; }
    if ((a ^ b) != 6i8)   { return 3i8; }
    if ((a << s) != 48i8) { return 4i8; }
    if ((a >> s) != 3i8)  { return 5i8; }

    if ((a & 10i8) != 8i8)  { return 6i8; }
    if ((a | 10i8) != 14i8) { return 7i8; }
    if ((a ^ 10i8) != 6i8)  { return 8i8; }
    if ((a << 2i8) != 48i8) { return 9i8; }
    if ((a >> 2i8) != 3i8)  { return 10i8; }

    if (~a != -13i8)        { return 11i8; }
    return 0i8;
}

fun main() -> i64 = {
    let r64 = test_64(12, 10, 2);
    if (r64 != 0) { return r64; }

    let r32 = test_32(12i32, 10i32, 2i32);
    if (r32 != 0i32) { return 100; }

    let r16 = test_16(12i16, 10i16, 2i16);
    if (r16 != 0i16) { return 200; }

    let r8 = test_8(12i8, 10i8, 2i8);
    if (r8 != 0i8) { return 300; }

    return 0;
}
