fun valueSwap(a: ref i32, b: ref i32) -> () = {
    let tmp: i32 = a;
    a = b;
    b = tmp;
}

fun max(a: ref i32, b: ref i32) -> ref i32 = {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

fun main() -> i64 = {
    # ===== Basic =====
    var a: i32 = 10;
    var r_a = &a;
    builtin_output_i64(a);      # 10
    r_a = 20;
    builtin_output_i64(a);      # 20
    var b: i32 = r_a;
    builtin_output_i64(b);      # 20
    builtin_output_i64(r_a);    # 20

    # ===== Unary ===== 
    r_a = -r_a;
    builtin_output_i64(a);      # -20
    builtin_output_i64(r_a);    # -20

    # ===== Binary ===== 
    var c: i32 = 10;
    r_a = r_a + r_a;
    builtin_output_i64(r_a);    # -40
    r_a = r_a + c;
    builtin_output_i64(r_a);    # -30

    # ===== Function passing ===== 
    var d = 111;
    var e = 222;
    valueSwap(&d, &e);
    builtin_output_i64(d);      # 222
    builtin_output_i64(e);      # 111

    var f = max(&d, &e);
    builtin_output_i64(f);      # 222

    # ===== Ref To Ref ===== 
    var g = 300;
    var h = 400;
    var r_g = &a;
    var r_h = &b;
    
    r_g = r_h;
    
    builtin_output_i64(g);      # 300
    builtin_output_i64(h);      # 400
    
    r_h = 500;
    
    builtin_output_i64(g);      # 300
    builtin_output_i64(r_h);    # 500

    return 0;
}
