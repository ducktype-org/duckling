import core.builtins.*;
import core.runtime;

fun valueSwap(a: ref i32, b: ref i32) -> () = {
    let tmp: i32 = a;
    a = b;
    b = tmp;
}

fun max(a: ref i32, b: ref i32) -> ref i32 = {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

fun localsTest() -> () = {
    # ===== Basic =====
    var a: i32 = 10;
    var r_a = &a;
    runtime.dvm.builtin_output_i64(a);      # 10
    r_a = 20;
    runtime.dvm.builtin_output_i64(a);      # 20
    var b: i32 = r_a;
    runtime.dvm.builtin_output_i64(b);      # 20
    runtime.dvm.builtin_output_i64(r_a);    # 20
    
    # ===== Cast with ref source ===== 
    var big_a: i64 = a;
    runtime.dvm.builtin_output_i64(big_a);    # 20
    r_a = r_a + 1;
    big_a = r_a;
    runtime.dvm.builtin_output_i64(big_a);    # 21
    
    # ===== Cast with ref dest ===== 
    r_a = 16i16;
    runtime.dvm.builtin_output_i64(r_a);    # 16
    r_a = b;
    runtime.dvm.builtin_output_i64(r_a);    # 20

    # ===== Unary ===== 
    r_a = -r_a;
    runtime.dvm.builtin_output_i64(a);      # -20
    runtime.dvm.builtin_output_i64(r_a);    # -20

    # ===== Binary ===== 
    var c: i32 = 10;
    r_a = r_a + r_a;
    runtime.dvm.builtin_output_i64(r_a);    # -40
    r_a = r_a + c;
    runtime.dvm.builtin_output_i64(r_a);    # -30

    # ===== Function passing ===== 
    var d = 111;
    var e = 222;
    valueSwap(&d, &e);
    runtime.dvm.builtin_output_i64(d);      # 222
    runtime.dvm.builtin_output_i64(e);      # 111

    var f = max(&d, &e);
    runtime.dvm.builtin_output_i64(f);      # 222

    # ===== Ref To Ref ===== 
    var g = 300;
    var h = 400;
    var r_g = &g;
    var r_h = &h;
    
    r_g = r_h;
    
    runtime.dvm.builtin_output_i64(g);      # 400
    runtime.dvm.builtin_output_i64(h);      # 400
    
    r_h = 500;
    
    runtime.dvm.builtin_output_i64(g);      # 400
    runtime.dvm.builtin_output_i64(r_h);    # 500
}

fun main() -> i64 = {
    localsTest();
    return 0;
}
