import core.builtins.*;

fun main() -> i64 = {
    var value = 0;
    var ref_value = &value;
    var box_value : box i32 = value;

    var p1 = ref_value as ptr i32;
    var p2 = box_value as ptr i32;

    *p1 = 30;
    var tmp1 = *p2;

    # A `manyptr T` is lowered to a pointer to a dynamic table of `T`, so narrowing it to a `ptr T`
    # must take the address of the table's first element (`dynTableLea` on index 0), not reuse the
    # table pointer as-is.
    var table = dvm_alloc_arr:{i32}(3u64);
    table[0] = 11i32;
    table[1] = 22i32;
    table[2] = 33i32;

    var first: ptr i32 = table as ptr i32;
    builtin_output_i64(*first as i64);      # 11

    # Writing through the narrowed pointer is visible through the many-pointer.
    *first = 44i32;
    builtin_output_i64(table[0] as i64);    # 44
    # The other elements are untouched.
    builtin_output_i64(table[1] as i64);    # 22

    dvm_free_arr:{i32}(table);

    var mp1 : manyptr i32;
    mp1[0] = 30;
    let tmp2 = mp1[0];
    var ref_mp1 = &mp1[0];
    var ref_p1 = &(*p1);
    return 0;
}
