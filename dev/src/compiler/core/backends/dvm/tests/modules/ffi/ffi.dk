import core.builtins.*;

extern("C") {
    # A `cptr` pointee is laid out by the C ABI, so every class one points at - including the
    # nested ones - has to be declared here.
    class Inner { a: i32 = 0; b: i32 = 0; }

    class Vec { tag: i64 = 0; nums: i32[4]; inner: Inner = Inner(); }

    # `div_t` of <stdlib.h>: two ints, returned by value. A type crossing the boundary by value
    # has to be declared here, so it is laid out and passed by the C ABI.
    class DivT { quot: i32 = 0; rem: i32 = 0; }

    fundecl abs(x: i32) -> i32;
    fundecl labs(x: i64) -> i64;
    fundecl div(num: i32, den: i32) -> DivT;

    fundecl strlen(s: cptr char) -> u64;
    fundecl strcmp(a: cptr char, b: cptr char) -> i32;

    # The pointee of a `cptr` never reaches C, so these are declared with the types actually
    # passed at each call site instead of `void*`.
    fundecl memcpy(dst: cptr Vec, src: cptr Vec, n: u64) -> cptr Vec;
    fundecl memset(p: cptr i32, value: i32, n: u64) -> cptr i32;

    # libm
    fundecl sqrt(x: f64) -> f64;
    fundecl frexp(x: f64, exp: cptr i32) -> f64;
}

fun cstr(s: str) -> cptr char = {
    return ptr_from_slice:{char}(s) as cptr char;
}

# NUL-terminated string literals handed to C as `cptr char`.
fun stringsTest() = {
    builtin_output_i64(strlen(cstr("duckling\0")) as i64);              # 8
    builtin_output_i64(strcmp(cstr("duck\0"), cstr("duck\0")) as i64);  # 0
}

# Projections through a `cptr` to a struct: field, nested field, and static array element.
# Each one is an address computation the DVM does itself, without calling into C.
fun cPointerProjectionsTest() = {
    var v: Vec;
    let p = &v as cptr Vec;

    (*p).tag = 7i64;
    (*p).nums[2] = 33;
    (*p).inner.b = 9;

    builtin_output_i64((*p).tag);                       # 7
    builtin_output_i64((*p).nums[2] as i64);            # 33
    builtin_output_i64((*p).inner.b as i64);            # 9

    # The writes went to the original local, not to a copy.
    builtin_output_i64(v.nums[2] as i64);               # 33
    builtin_output_i64(v.inner.b as i64);               # 9

    # A `cptr` to a field, and a `cptr` to an element of a static array field.
    let ip = &v.inner as cptr Inner;
    (*ip).a = 4;
    builtin_output_i64(v.inner.a as i64);               # 4

    let ep = &v.nums[1] as cptr i32;
    (*ep) = 21;
    builtin_output_i64(v.nums[1] as i64);               # 21

    # Indexing the `cptr` itself, which is pointer arithmetic over the pointee, so `ep[1]` is
    # the array element after the one `ep` points at.
    let ap = &v.nums[0] as cptr i32;
    builtin_output_i64(ap[1] as i64);                   # 21
    ap[3] = 15;
    builtin_output_i64(v.nums[3] as i64);               # 15

    var i: i64 = 2;
    builtin_output_i64(ap[i] as i64);                   # 33
}

# The same `cptr`s handed to C, which writes through them.
fun cPointerToCTest() = {
    var src: Vec;
    src.tag = 100i64;
    src.nums[0] = 1;
    src.nums[1] = 2;
    src.nums[2] = 3;
    src.inner.a = 50;

    var dst: Vec;
    # `Vec` is i64 + i32[4] + {i32, i32}, so 32 bytes.
    memcpy(&dst as cptr Vec, &src as cptr Vec, 32u64);

    builtin_output_i64(dst.tag);                        # 100
    builtin_output_i64(dst.nums[1] as i64);             # 2
    builtin_output_i64(dst.inner.a as i64);             # 50

    # A `cptr` to the first element of a static array field: zero two of the four elements.
    memset(&dst.nums[0] as cptr i32, 0i32, 8u64);
    builtin_output_i64(dst.nums[0] as i64);             # 0
    builtin_output_i64(dst.nums[1] as i64);             # 0
    builtin_output_i64(dst.nums[2] as i64);             # 3

    # The same memory read back by indexing the `cptr` handed to C.
    let np = &dst.nums[0] as cptr i32;
    builtin_output_i64(np[2] as i64);                   # 3
}

# A cast to a `cptr` may change the pointee: the source is taken as a native address and then
# reinterpreted, the way a C cast would.
fun cPointerRepointingTest() = {
    var v: Vec;
    v.tag = 5i64;

    # `ptr Vec` -> `cptr i64`: the address of `v`, read as its first field.
    let vp = &v as ptr Vec;
    let tag_p = vp as cptr i64;
    builtin_output_i64(*tag_p);                         # 5

    # `manyptr i32` -> `cptr Inner`: a many-pointer is a dynamic table handle, so it first has
    # to become the address of element 0, and only then change pointee. `Inner` is two i32s,
    # so it reads the first two elements of the table.
    var table = dvm_alloc_arr:{i32}(2i64);
    table[0] = 6i32;
    table[1] = 7i32;

    let head_p = table as cptr Inner;
    builtin_output_i64((*head_p).a as i64);             # 6
    builtin_output_i64((*head_p).b as i64);             # 7

    dvm_free_arr:{i32}(table);
}

# libm, and a `cptr` used as an out parameter.
fun mathTest() = {
    builtin_output_i64(sqrt(16.0) as i64);              # 4

    var exponent: i32 = 0;
    let fraction = frexp(8.0, &exponent as cptr i32);
    builtin_output_i64((fraction * 100.0) as i64);      # 50
    builtin_output_i64(exponent as i64);                # 4
}

fun main() -> i64 = {
    stringsTest();
    cPointerProjectionsTest();
    cPointerToCTest();
    cPointerRepointingTest();
    mathTest();
    return 0;
}
