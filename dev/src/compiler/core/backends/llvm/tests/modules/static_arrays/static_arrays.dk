class Point {
    x: i32;
    y: i32;
}

fun array_test() -> i32 = {
    var arr: i32[10];
    arr[3] = 42;
    return arr[3];
}

fun nested_test() -> i32 = {
    var matrix: i32[2][3];
    matrix[1][2] = 7;
    return matrix[1][2];
}

fun struct_array_test() -> i32 = {
    var points: Point[5];
    points[1].y = 50;
    return points[1].y;
}
