fun float64_ops(a: f64, b: f64) -> f64 = {
    let add = a + b;
    let sub = a - b;
    let mul = a * b;
    let div = a / b;
    let neg = -a;
    return add + sub + mul + div + neg;
}

fun float32_ops(a: f32, b: f32) -> f32 = {
    let add = a + b;
    let sub = a - b;
    let mul = a * b;
    let div = a / b;
    let neg = -a;
    return add + sub + mul + div + neg;
}

fun float_comparisons(a: f64, b: f64) -> bool = {
    let lt = a < b;
    let gt = a > b;
    let le = a <= b;
    let ge = a >= b;
    let eq = a == b;
    let ne = a != b;
    return lt and gt and le and ge and eq and ne;
}
