fundecl builtin_output_i64(x: i64) -> i64;

class RecordClass {
    a: i64 = 0;
    b: f32 = 0.0;
    c: i16 = 0i16;
}

class BiggerRecordClass {
    x: i8 = i8(0);
    y: RecordClass = RecordClass(1, f32(2.0), i16(3));
    z: f64 = 0.0;
}

fun printRecordClass(r: RecordClass) = {
    builtin_output_i64(r.a);
    builtin_output_i64(r.c);
}

let a: RecordClass = RecordClass(1, f32(2.0), i16(3));

let big = BiggerRecordClass(i8(1), RecordClass(i64(2), f32(3.0), i16(4)), f64(5));

fun main() -> i64 = {
    var b = a;
    printRecordClass(a);
    a.a = 42;
    a.c = i16(6 * 9);
    printRecordClass(a);
    printRecordClass(b);
    b = a;
    printRecordClass(b);

    builtin_output_i64(big.y.c); # 4

    return 0i64;
}
