fun main() -> i64 = {
    0;                                      # 0, ExprStmt
    var a : i64 = 3i64;                     # 3
    let b : i64 = 2i64;                     # 2
    a = a + b;                              # 5
    var c : i64 = a - 2i64 * (1i64 + 6i64); # -9
    c = -c;                                 # 9
    var d : i64 = c / 2i64;                 # 4
    d = d * 16i64;                          # 64
    # ^ Change this to d ** 3 when exponentiation is implemented.
    return a % 7i64;                        # 1
}
