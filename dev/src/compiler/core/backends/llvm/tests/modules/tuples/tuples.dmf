class Wrapper {
    a: (i64, i64);
}

fun makeTuple(x:i32, y:i32) -> (i32, i32) = {
    return (x, y);
}

fun makeWrapper(x:i32, y:i32) -> Wrapper = {
    return Wrapper((x, y));
}

fun unwrap(x: Wrapper) = {
    return x.a;
}

class SomeClass {
    a: i32;
    b: str;

    fun count(x: i32) = {
        a = a+x;
        return a;
    }
}

fun someFunction(x: i64) = {
    return x*2 + 7;
}

fun main() = {
    var a = ();
    var b = (1, -2, 3, 4);
    var c = (false, 1, 2., "3");
    var d = ((1, 0.), (3.5, 4));
    var e = (0, 0);
    var f = ("Hello");

    var x = (1+2, 3-4, 1+2-3*4, 2.5/5.*100.-1.333);
    var y = (3*4 > 4*3, 1<2<3<4, 1 == 1 != 1, 1 < 2 and not 2 < 3 or 3 > 4);
    var z = (
        i16(12345),
        if true then 67 else 76,
        if true then (
            if false then
                1
            else (
                if false then (
                    2
                ) else (
                    4      
                )
            )
        ) else (
            8
        )
    );

    var sc = SomeClass(0, "zero");
    var w1 = Wrapper((0, 0));
    var w2 = makeWrapper(6, 7);

    var tup1 = (someFunction(2+2) + 3, sc, SomeClass(6, "seven"));
    var tup2: (i32, i32) = makeTuple(1, 2);
    var tup3: (i64, i64) = unwrap(w1);
    var tup4: (i64, i64) = w2.a;

    return 0;
}
