class Point {
    x: i32 = 0;
    y: i32 = 0;
}

fun array_test() -> i32 = {
    var arr: i32[10i64];
    arr[3i64] = 42;
    return arr[3i64];
}

fun nested_test() -> i32 = {
    var matrix: i32[2i64][3i64];
    matrix[1i64][2i64] = 7;
    return matrix[1i64][2i64];
}

fun struct_array_test() -> i32 = {
    var points: Point[5];
    points[1i64].y = 50;
    return points[1i64].y;
}
