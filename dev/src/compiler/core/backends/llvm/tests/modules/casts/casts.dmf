fun int_float_saturate() -> i64 = {
    var v: i64 = 3000000000;
    var vf: f64 = v as f64;
    var vi: i32 = vf as i32;
    return 0i64;
}

fun int_trunc_widen() -> i64 = {
    var big: i64 = 4294967295;
    var t32: i32 = big as i32;
    var back: i64 = t32 as i64;
    return 0i64;
}

fun bool_to_i32() -> i64 = {
    var b: bool = true;
    var i: i32 = b as i32;
    var back: bool = i as bool;
    return 0i64;
}

fun widen_implicit() -> i64 = {
    var s16: i16 = 7 as i16;
    var w64: i64 = s16; # implicit widening
    return 0i64;
}

# A `bool` is an `i1`, so an explicit numeric -> bool cast must be a "is it non-zero" test and not
# a truncation, which would only keep the lowest bit (`64 as bool` would be `false`).
fun int_to_bool_explicit() -> i64 = {
    var big: i64 = 64;
    var flag: bool = big as bool;
    return 0i64;
}

# The float source is compared with the UNordered predicate, matching the DVM's `fcmpNeq`, so a
# NaN is `true`.
fun float_to_bool_explicit() -> i64 = {
    var half: f64 = 0.5;
    var flag: bool = half as bool;
    var small: f32 = 0.5f32;
    var flag32: bool = small as bool;
    return 0i64;
}

fun float_narrow_widen() -> i64 = {
    var wide: f64 = 9.0;
    var narrow: f32 = wide as f32;
    var back: f64 = narrow as f64;
    return 0i64;
}

fun bool_implicit() -> i64 = {
    var a: i64 = 10;
    var b: bool = a;
    var c: i64 = b;
    return 0i64;
}
