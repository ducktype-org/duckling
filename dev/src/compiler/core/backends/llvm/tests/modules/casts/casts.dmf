fun int_float_saturate() -> i64 = {
    var v: i64 = 3000000000;
    var vf: f64 = f64(v);
    var vi: i32 = i32(vf);
    return 0;
}

fun int_trunc_widen() -> i64 = {
    var big: i64 = 4294967295;
    var t32: i32 = i32(big);
    var back: i64 = i64(t32);
    return 0;
}

fun bool_to_i32() -> i64 = {
    var b: bool = true;
    var i: i32 = i32(b);
    var back: bool = bool(i);
    return 0;
}

fun widen_implicit() -> i64 = {
    var s16: i16 = i16(7);
    var w64: i64 = s16; # implicit widening
    return 0;
}

fun bool_implicit() -> i64 = {
    var a: i64 = 10;
    var b: bool = a;
    var c: i64 = b;
    return 0;
}
