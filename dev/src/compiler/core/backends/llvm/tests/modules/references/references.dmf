fun test_simple_ref() -> i64 = {
    var x: i32 = 10;
    var r: ref i32 = refof x;
    r = 42;
    return x;
}

fun adder(v: ref i32) -> () = {
    v = v + 1;
}

fun test_pass_through_reference() -> i64 = {
    var x: i32 = 10;
    adder(refof x);
    return x;
}

