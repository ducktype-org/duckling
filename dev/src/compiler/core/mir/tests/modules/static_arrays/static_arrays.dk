class Point {
    x: i32;
}

fun static_array_test() -> i64 = {
    var arr: i32[5];
    arr[2] = 42i32;

    var pts: Point[2];
    pts[0].x = 100;

    return pts[0].x;
}

fun for_continue_test() -> i64 = {
    var arr: i64[2];
    for (x in arr) {
        if (x == 0) continue;
    }
    return 0;
}
