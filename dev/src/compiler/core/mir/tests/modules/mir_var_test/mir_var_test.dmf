var c: i64 = 20 + g;
var g: i64 = hoo();

fun foo() = {
	c = g;
	var a: i64 = 23;
	# @TODO: #1543 Change '9i64' to '9' once `NumericValue::createOfType()` gets implemented. 
	while (9i64) {
		var b: i64 = 7;
	}
	if (9i64) {
		var b: i64 = 7;
	}
	return 0;
}

fun goo() = { 
	var a: i32 = i32(23);
	a = i32(24);
	hoo() = 15;
}

fun hoo() -> i64 = {
	c = c + 1;
	g = c + hoo();
	return 33;
}
