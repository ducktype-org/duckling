# Destructor insertion: at the end of a scope, before an assignment that overwrites a live value,
# and for global variables (which get a ctor that must not destruct anything and a dtor that must).

class Res {
    id: i32 = 0;
    Res.destroy() = { var t: i32 = id; }
}

# A global of a non-trivially destructible class, so its ctor runs the class constructor.
var g_res: Res = Res(1);
# A global box, so its ctor allocates and its dtor frees.
var g_box: box i32 = new 7;
# A trivially destructible global, so its dtor stays empty.
var g_int: i32 = 3;

# The value living in `a` is destructed before the assignment overwrites it, and `a` is destructed
# again at the end of the scope.
fun assignOverExisting() = {
    var a: Res = Res(2);
    a = Res(3);
}

# `a` dies at the end of the inner scope, `b` at the end of the function. `t` is trivially
# destructible, so it is never destructed.
fun scopeEnd() = {
    {
        var a: Res = Res(4);
    };
    var t: i64 = 5;
    var b: Res = Res(6);
}

fun bump(r: ref Res) -> Res = { return Res(r.id + 1); }

# The new value is computed by a call that reads `a` through a reference, so the old value has to
# stay alive until the call returns: the result goes into a temporary, the destructor of the old
# value runs after the call, and only then is `a` overwritten.
fun assignFromCallTakingRef() = {
    var a: Res = Res(7);
    a = bump(&a);
}

# Self-assignment reads the very value it overwrites, so the copy has to be made before the
# destructor of the old value runs.
fun assignItself() = {
    var a: Res = Res(8);
    a = a;
}

fun main() -> i64 = {
    assignOverExisting();
    scopeEnd();
    assignFromCallTakingRef();
    assignItself();
    return 0;
}
