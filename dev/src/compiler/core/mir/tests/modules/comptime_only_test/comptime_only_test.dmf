fun patient_zero(x: i64) -> i64 = {
    let _ = box i64; 
    return x;
}

fun infection_chain_level_1(x: i64) -> i64 = {
    return patient_zero(x);
}

fun infection_chain_level_2(x: i64) -> i64 = {
    return infection_chain_level_1(x); 
}

fun regular_runtime_function(x: i64) -> i64 = {
    let a = x + 10;
    return a; 
}

fun main() -> i64 = {
    var a: i64 = 42;
    let result = infection_chain_level_2(a);
    let _ = regular_runtime_function(a);
    return result;
}