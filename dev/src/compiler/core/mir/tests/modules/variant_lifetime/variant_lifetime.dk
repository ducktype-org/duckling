# A payload with a destructor, so handing its ownership to and from a variant is observable in
# the lifetime flags.
class R {
	a: i32 = 0;
	R.destroy() = { var t: i32 = a; }
}

# The local is moved into the variant, so the variant is the only owner left.
fun moveIntoVariant() -> i32 = {
	var payload: R;
	var v: R | i32 = move payload;
	return 0i32;
}

# The variant is moved into the match, which moves the payload out into the case binding.
fun matchOutOfVariant() -> i32 = {
	var payload: R;
	var v: R | i32 = move payload;
	return match (move v) {
		case r : R = r.a;
		case n : i32 = n;
	};
}

# The constrained wildcard binds nothing, so the match owns the payload it covers and has to
# destroy it itself.
fun dropInMatch() -> i32 = {
	var payload: R;
	var v: R | i32 = move payload;
	return match (move v) {
		case _ : R = 1i32;
		case n : i32 = n;
	};
}
