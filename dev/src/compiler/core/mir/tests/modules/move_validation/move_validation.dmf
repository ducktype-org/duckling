fun good1(c: i64) = {
    var a: i64 = 10i64;
    var b: i64 = 15i64;
    a = b; # this is move (in test)
    a = 3i64;
}

fun good2(c: i64) = {
    var a: i64 = 10;
    var b: i64 = 15;
    if (b < 16i64){
        a = b; # this is move (in test)
    }
    a = 3i64;
}

fun good3(c: i64) = {
    var a: i64 = 10i64;
    while (a < 16i64){
        var b: i64 = 15i64;
        if (b < 16i64){
            b = 4i64;
            a = b; # this is move (in test)
        }
    }
    a = 3i64;
}

fun good4(c: i64) = {
    var a: i64 = 15i64;
    while (a < 16i64){
        var b: i64 = 10i64;
        a = b; # this is move (in test)
    }
    a = 3i64;
}

fun bad1(c: i64) = {
    var a: i64 = 10;
    var b: i64 = 15;
    a = b; # this is move (in test)
    b = a;
}


fun bad2(c: i64) = {
    var a: i64 = 10i64;
    var b: i64 = 15i64;
    while (b < 16i64){
        a = b; # this is move (in test)
    }
}


fun bad3(c: i64) = {
    var a: i64 = 10i64;
    var b: i64 = 15i64;
    if (b < 16i64){
        a = b; # this is move (in test)
    }
    b = 3i64;
}
