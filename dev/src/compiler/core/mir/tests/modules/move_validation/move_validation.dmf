fun good1(c: i64) = {
    var a: i64 = 10;
    var b: i64 = 15;
    a = b; # this is move (in test)
    a = 3;
}

fun good2(c: i64) = {
    var a: i64 = 10;
    var b: i64 = 15;
    if (13 < b < 16){
        a = b; # this is move (in test)
    }
    a = 3;
}

fun good3(c: i64) = {
    var a: i64 = 10;
    while (a < 16){
        var b: i64 = 15;
        if (b < 16){
            b = 4;
            a = b; # this is move (in test)
        }
    }
    a = 3;
}

fun good4(c: i64) = {
    var a: i64 = 15;
    while (a < 16){
        var b: i64 = 10;
        a = b; # this is move (in test)
    }
    a = 3;
}

fun bad1(c: i64) = {
    var a: i64 = 10;
    var b: i64 = 15;
    a = b; # this is move (in test)
    b = a;
}


fun bad2(c: i64) = {
    var a: i64 = 10;
    var b: i64 = 15;
    while (b < 16){
        a = b; # this is move (in test)
    }
}


fun bad3(c: i64) = {
    var a: i64 = 10;
    var b: i64 = 15;
    if (b < 16){
        a = b; # this is move (in test)
    }
    b = 3;
}
