fun createUnit() -> type = {
    var a: type = ();
    return a;
}
const A = createUnit();

fun createBox(t: type) -> type = box t;
const B = createBox(i32);

fun createRef(t: type) -> type = ref t;
const C = createRef(i32);

fun createVariant(a: type, b: type, c: type, d: type) -> type = a | b | c | d;
const D = createVariant(i16, i32, i64, i128);

fun createTuple(a: type, b: type, c: type, d: type) -> type = {
    var e: type = (a, b, c, d);
    return e;
}
const E = createTuple(i16, i32, i64, i128);

fun megaType(a: type) -> type = {
    var c: type = (createUnit(), createBox(a), i32, (i16, f16), i64 | (f64, f128));
    return c;
}
const megaGigaType = megaType(i128);

fun fib(n: i64) -> i64 = {
   if (n < 2i64) { return n; }
   return fib(n - 1i64) + fib(n - 2i64);
}

fun complexLogic(n: i64) -> type = {
    if (fib(n) < 15i64) {
        return createBox(i16);
    } else {
        return createRef(i64);
    }
}

const FIRST = complexLogic(5);
const SECOND = complexLogic(10);
