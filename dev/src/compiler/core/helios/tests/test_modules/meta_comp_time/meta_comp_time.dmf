fun createUnit(t: type) -> type = ();
# const A = createUnit(i32);

fun createBox(t: type) -> type = box t;
# const B = createBox(i32);

fun createRef(t: type) -> type = ref t;
# const C = createRef(i32);

fun createVariant(a: type, b: type, c: type, d: type) -> type = a | b | c | d;
const D = createVariant(i16, i32, i64, i128);

fun createTuple(a: type, b: type, c: type, d: type) -> type = {
    var e: type = (a, b, c, d);
    return e;
}
# const E = createTuple(i16, i32, i64, i128);

