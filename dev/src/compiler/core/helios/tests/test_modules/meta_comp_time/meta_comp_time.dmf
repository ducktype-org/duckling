fun fib(n: i64) -> i64 = {
   if (n < 2i64) { return n; }
   return fib(n - 1i64) + fib(n - 2i64);
}

fun complexLogic(n: i64) -> type = {
    if (fib(n) < 15i64) {
        return i32;
    } else {
        return i64;
    }
}

const FIRST = complexLogic(1);
const SECOND = complexLogic(3);
const THIRD = complexLogic(5);
const FOURTH = complexLogic(10);



