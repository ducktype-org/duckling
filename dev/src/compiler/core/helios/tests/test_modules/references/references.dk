class RefPoint {
	x: ref mut i32;
	y: ref mut i32;
}

fun test_simple_ref() -> i32 = {
	var x: i32 = 10;
	var r: ref mut i32 = &x;
	r = 42; # Deref of lhs.
	var y: i32 = r; # Deref of rhs.
	var r2: ref i32 = &y;
	r = r2; # Reference rebinding -> no derefs.
	r = r + 1; # Deref of both sides.
	dummy(r); # Deref in arguments.
	var z: i32 = -r; # Deref in unary.
	var p: i32 = r + r2; # Deref in binary.

	var point = RefPoint(&x, &y);
	var ref_point: ref mut RefPoint = &point;
	var val: i32 = ref_point.x; # Two derefs should appear. One for `ref_point`, one for `x`.

	return r; # Deref in return.
}

fun dummy(x: i32) -> i32 = x;

fun test_deduced_from_ref() -> i32 = {
	var x: i32 = 10;
	var r: ref mut i32 = &x;
	var copied = r; # A deduced declaration copies a `ref` initializer.
	let copied_let = r;
	var taken = &x; # An explicit `&` is copied too.
	copied = 5; # Writes to `copied` only, not to `x`.
	return copied + copied_let + taken;
}
