
class FirstClass {
    a: i64 = 0;
    b: f32 = 0.0;
}

class ClassWithMember {
    member: FirstClass = FirstClass(3, 4.0);
    
    fun getMemberA() -> i64 = {
        return member.getA();
    }
}

var c          = ClassWithMember(FirstClass(5, f32(6.0)));
var c_member   = c.member;

