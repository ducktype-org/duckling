class Point {
    x: i32;
    y: i32;
}

class InitializedPoint {
    x: i32 = 0;
    y: i32 = 1;
}

fun by_ref(p : ref Point) -> i32 = {
    return p.x;
}

fun by_val(p : Point) -> i32 = {
    return p.x;
}

fun double_coerce(x: ref i64) -> i64 = {
    return x;
}

fun by_box(p: box Point) -> i32 = {
    return p.x;
}

fun test_boxes() -> i32 = {
    var b_int: box i32 = 42; # Coercion from direct to `box i32`. `BoxOfExpr` should be inserted.

    double_coerce(refof b_int);
    
    var b_point: box Point = Point(10, 20);
    var b2_point: box InitializedPoint = InitializedPoint();

    var x: i32 = b_point.x;
    var y: i32 = b2_point.y;
    
    b_point.y = 99; # Deref on the lhs.

    by_val(b_point); # Box -> Direct coercion. Should copy
    by_ref(refof b_point); # Box -> Ref coercion.
    
    # TODOP: Verify that.
    by_box(b_point); # TODOP: Should crash.
    # by_box(copy b_point); # TODOP: Shouldn't crash

    return b_int; # Box i32 -> i32 coercion;
}
