class ExampleClass {
    exampleField: i64 = 0;

    fun getField() -> i64 = {
        return exampleField;
    }

    fun setField(field:i64 = 0) = {
        exampleField = field;
    }
}

fun main() -> i64 = {
    var obj1 = ExampleClass();
    var obj2 = ExampleClass(1);

    var v1 = obj1.exampleField;
    var v2 = obj2.getField();

    builtin_output_i64(v1);
    builtin_output_i64(v2);

    obj1.setField(2);
    obj2.setField(3);

    var v3 = obj1.getField();
    var v4 = obj2.exampleField;

    builtin_output_i64(v3);
    builtin_output_i64(v4);

    return 0;
}
