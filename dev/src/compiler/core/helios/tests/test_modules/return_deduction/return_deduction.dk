fun one_stmt(x: i64) = x + 1;

fun one_stmt_lit() = 0i64;

fun one_return(x: i64) = {
    return x + 1;
}

fun one_return_lit() = {
    return 0i64;
}

fun multiple_returns(x: i64) = {
    if (x > 0) {
        return x;
    }
    else {
        return -x;
    }
}

fun const_if_returns(x: i64) = {
    if const (1 == 1) {
        return x;
    }
    else {
        # Not compiled, so it takes no part in the deduction.
        return true;
    }
}
