const D: i64 = A + (B + C);

const C: i32 = X;

namespace N {
	alias X = A; # X = 1
}

alias H = NN.NNN.A;
const H2: i64 = H;

const A: i32 = 1;

const B: i32 = (X - 6) + (1 + A); # B = -3

const E: i32 = 2 + 2 * 2; # E = 6

const MOD: i32 = 69 % 42; # MOD = 27 27

using N.*;

namespace NN {
	namespace NNN {
		const A: i64 = D + 4;
	}
	alias A = NNN.A;
	# const Amb: i64 = A; # this is ambiguity error
}

const T0: i64 = 1;
const T1: i64 = T0 + 1;
const T2: i64 = T1 + 1;

const F1: f64 = 1.0;
const F2: f32 = 1.0;
const F3 = F1 + F2 + 2.0 + F2;




namespace Inner {
	const Inner_X: i64 = 123;
}
using Inner.*;

const F: i64 = ((A + 1) / 2 + (E + 2) / 2) * 2 * NN.A;

const M: i64 = (A + A * 2) * NN.NNN.A * Inner.Inner_X;

const BOOL_TRUE = true;
const BOOL_FALSE = not BOOL_TRUE;
const LOGIC_AND = BOOL_TRUE and not BOOL_FALSE;
const LOGIC_OR = not BOOL_TRUE and BOOL_FALSE;

#                             1 >= 1 == -3 + 4 < 6 != 9 > -3
const TRUE_COMPARISON: bool = A >= 1 ==  B + 4 < 6 != 9 >  B;
#                              1 < 4 <=  3
const FALSE_COMPARISON: bool = A < 4 <= -B;

fun fib(n: i64) -> i64 = {
   if (n < 2) { return n; }
   return fib(n - 1) + fib(n - 2);
}

fun fib_on_i32(n: i32) -> i32 = {
   if (n < 2) { return n; }
   return fib_on_i32(n - 1) + fib_on_i32(n - 2);
}
const FIB_ON_I32_10 = fib_on_i32(10); # 55

const FIB_10 = fib(10); # 55
const COMPLEX_VM_CALL: i64 = add(FIB_10, T2); # 55 + 3 = 58
const COMPLEX_VM_CALL_2: i64 = add(fib(9), T2); # 34 + 3 = 37
const VM_SIMPLE_CALL: i64 = add(20, 22);
const VM_SIMPLE_CALL_2: i64 = add(M, 22);

fun add(a: i64, b: i64) -> i64 = {
    return a + b;
}

fun sub(a: i64, b: i64) -> i64 = {
    return a - b;
}

fun mul(a: i64, b: i64) -> i64 = {
    return a * b;
}

fun div(a: i64, b: i64) -> i64 = {
    return a / b;
}

fun collatz_step(current_val: i64, steps_left: i64) -> i64 = {
	if (steps_left < 1) {
		return current_val;
	}
	
	if (current_val % 2 < 1) {
		return collatz_step(div(current_val, 2), sub(steps_left, 1));
	} else {
		return collatz_step(add(mul(3, current_val), 1), sub(steps_left, 1));
	}
}

fun intentionally_complex_collatz_nth(start: i64, n: i64) -> i64 = {
	return collatz_step(start, n);
}

const COLLATZ: i64 = intentionally_complex_collatz_nth(6, 8); # COLLATZ == 1

@builtin("size_of")
fundecl sizeOf(v: type) -> i64;

@builtin("alignment_of")
fundecl alignOf(v: type) -> i64;

fun sizeAndAlign(t: type) -> i64 = {
	return sizeOf(t) + alignOf(t);
}
# Exercises the meta builtins through a VM comp-time call: size_of(i64) + alignment_of(i64).
const SIZE_AND_ALIGN_I64: i64 = sizeAndAlign(i64); # 8 + 8 = 16
