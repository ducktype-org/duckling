class W {
    x: i32 = 0;

    W.copy(other: const ref W) = {
        return W(other.x);
    }
}

fun usesOps() -> i32 = {
    var a: W = W(1);
    var b: W = copy a;
    var c: W = move a;
    return c.x;
}

fun returnsLocal() -> W = {
    var w: W = W(2);
    return w; # Should implicitly move.
}
