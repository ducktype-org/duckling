class W {
    x: i32 = 0;

    W.copy(other: const ref W) = {
        return W(other.x);
    }
}

fun usesOps() -> i32 = {
    var a: W = W(1);
    var b: W = copy a;
    var c: W = move a;
    return c.x;
}

fun copiesThroughRef(r: ref W, bx: box W) -> i32 = {
    var b: W = copy r;
    var c: W = copy bx;
    return b.x;
}
