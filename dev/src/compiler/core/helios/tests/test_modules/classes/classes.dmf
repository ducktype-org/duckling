# Simple classes

class FirstClassEver {
    a: i64 = 0;
    b: f32 = 0;

    fun getA() -> i64 = {
        return a;
    }

    fun setA(new_a: i64) = {
        a = new_a;
    }

    private {
        FirstClassEver.copy(other: FirstClassEver) = {
            a = other.a;
            b = other.b;
        }
    }

    FirstClassEver.destroy() = {}
}

let a: FirstClassEver = FirstClassEver(1, f32(2.0));
let b = a;

fun main() -> i64 = {
    builtin_output_i64(a.a);
    a.a = 42;
    builtin_output_i64(a.a);
    return 0;
}

