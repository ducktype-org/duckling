# Simple classes

class FirstClassEver {
    a: i64 = 0;
    b: f32 = 0.0;

    fun getA() -> i64 = {
        return a;
    }

    fun setA(new_a: i64) = {
        a = new_a;
    }

    private {
        FirstClassEver.copy(other: const ref FirstClassEver) = {
            return FirstClassEver(other.a, other.b);
        }
    }

    FirstClassEver.destroy() = {}
}

class SecondClass extends FirstClassEver {}

let first_class_ever: FirstClassEver = FirstClassEver(1, f32(2.0));
let first_class_ever_copy = copy first_class_ever;

class ClassWithMember {
    member: FirstClassEver = FirstClassEver(3, 4.0);

    fun getMemberA() -> i64 = {
        return member.getA();
    }
}

