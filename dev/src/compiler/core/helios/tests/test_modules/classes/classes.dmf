# Simple classes

class FirstClassEver {
    a: i64 = 0;
    b: f32 = 0;

    fun getA() -> i64 = {
        return a;
    }

    fun setA(new_a: i64) = {
        a = new_a;
    }

    private {
        FirstClassEver.copy(other: FirstClassEver) = {
            a = other.a;
            b = other.b;
        }
    }

    FirstClassEver.destroy() = {}
}

class SecondClass extends FirstClassEver {}

let a: FirstClassEver = FirstClassEver(1, f32(2.0));
let b = a;

class ClassWithMember {
    member: FirstClassEver = FirstClassEver(3, 4.0);
    
    fun getMemberA() -> i64 = {
        return member.getA();
    }
}

let c: ClassWithMember = ClassWithMember(FirstClassEver(5, 6.0));
#let c_member: FirstClassEver = c.member;
#let c_member_a: i64 = c.getMemberA();

