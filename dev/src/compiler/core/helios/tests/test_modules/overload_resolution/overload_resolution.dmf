# Test overload resolution with different parameter types and scenarios


class MyClass {
    value: i32;
}

fun process(x: bool) -> i32 = {
    return 1;
}

fun process(x: f64) -> i32 = {
    return 2;
}

fun process(x: MyClass) -> i32 = {
    return 3;
}

var CALL_WITH_BOOL: i32 = process(true);
var CALL_WITH_FLOAT: i32 = process(get_f64());
var CALL_WITH_CLASS: i32 = process(MyClass(42));

fun foo(x: i64) -> i32 = {
    return 10;
}

fun foo(y: i64) -> i32 = {
    return 20;
}

# Named parameter disambiguates which function to call
var NAMED_CALL_X: i32 = foo(x = 30);
var NAMED_CALL_Y: i32 = foo(y = 40);


fun get_f64() -> f64 = {
    return 3;
}