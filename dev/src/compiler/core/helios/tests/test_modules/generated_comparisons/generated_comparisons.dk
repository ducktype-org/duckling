class Point {
    x: i64 = 0;
    y: i64 = 0;
}

fun tupleLess(a: (i32, i64), b: (i32, i64)) -> bool = {
    return a < b;
}

fun classEqual(a: Point, b: Point) -> bool = {
    return a == b;
}

fun classGreaterEqual(a: Point, b: Point) -> bool = {
    return a >= b;
}

fun typesEqual() -> bool = {
    return (i32, i64) == (i32, i64);
}
