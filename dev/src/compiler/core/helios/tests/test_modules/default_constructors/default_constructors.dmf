class Trivial {
    a: i32;
    b: f64;
}

class WithInit {
    x: i32 = 42;
}

class Nested {
    w: WithInit;
}

class ArrayHolder {
    arr: WithInit[5];
}

class TupleHolder {
    tup: (WithInit, WithInit);
}

class DeepStack {
    n: Nested;
}

class DeepStackTrivial {
    n: Trivial[2];
}

class TupleTrivial {
    tup: (Trivial, Trivial);
}
