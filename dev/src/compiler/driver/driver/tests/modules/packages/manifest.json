{
    "packages": [
        {
            "id": "lib_a",
            "name": "lib_a",
            "version": "0.1.0",
            "path": "modules/packages/lib_a",
            "features": [ "use_mathlib" ]
        },
        {
            "id": "lib_b",
            "name": "lib_b",
            "version": "0.1.0",
            "path": "modules/packages/lib_b",
            "features": [ "use_mathlib", "use_lib_a" ],
            "dependencies": [
                { "id": "lib_a", "alias": "lib_a" }
            ]
        },
        {
            "id": "app1",
            "name": "app1",
            "version": "0.1.0",
            "path": "modules/packages/app1",
            "features": [],
            "dependencies": [
                { "id": "lib_a", "alias": "lib_a" },
                { "id": "lib_b", "alias": "lib_b" }
            ]
        },
        {
            "id": "app2",
            "name": "app2",
            "version": "0.1.0",
            "path": "modules/packages/app2",
            "dependencies": [
                { "id": "lib_a", "alias": "lib_a" }
            ]
        }
    ],
    "tasks": [
        {
            "package": "lib_a",
            "strategy": "lib",
            "output_file": "lib_a.a"
        },
        {
            "package": "lib_b",
            "strategy": "lib",
            "output_file": "lib_b.a"
        },

        {
            "package": "lib_a",
            "strategy": "dvm_lib",
            "output_file": "lib_a_dvm.dbc"
        },
        {
            "package": "lib_b",
            "strategy": "dvm_lib",
            "output_file": "lib_b_dvm.dbc"
        },
        {
            "package": "app1",
            "strategy": "dvm_exe",
            "output_file": "app1_dvm.dbc"
        },
        {
            "package": "app2",
            "strategy": "dvm_exe",
            "output_file": "app2_dvm.dbc"
        },

        {
            "package": "app1",
            "strategy": "native",
            "output_file": "app1.exe",
            "linking_options": [
                "build/lib_a.a",
                "build/lib_b.a"
            ]
        },
        {
            "package": "app2",
            "strategy": "native",
            "output_file": "app2.exe",
            "linking_options": {
                "additional_link_options": ["build/lib_a.a"],
                "link_c_standard_library": true
            }
        }
    ]
}
