# Tests a function call with multiple parameters of different sizes.
# input = "a b c"
# output = a * c

function check { i64, i32, i64 } -> void {

	init_pany_type 		acc, i64;
	mov_p64_imm			acc, 1; 	# acc := 1
	mul_p64_p64			acc, arg0; 	# acc *= a
	mul_p64_p64			acc, arg2;  # acc *= c

	output_p64			acc;

	deinit; # acc
	deinit; # arg2
	deinit; # arg1
	deinit; # arg0
	ret;
}

function main { i64, ptr_argv } -> i64 {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type a, i64;
	init_pany_type b, i32;
	init_pany_type c, i64;

	input_p64	a;
	input_p32	b;
	input_p64	c;
	call_func          	check;

	deinit; # *argv
	deinit; # argc
	ret;
}
