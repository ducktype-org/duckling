# Tests returning other values than i64
# input = n
# output = n

function check {} -> i32 {
	input_p32       ret_val;
	ret;
}

function main { i64, ptr_argv } -> i64 {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type 			check_ret_val, i32;
	call_func          	check;
	output_p32 			check_ret_val;

	deinit;
	deinit; # *argv
	deinit; # argc
	ret;
}
