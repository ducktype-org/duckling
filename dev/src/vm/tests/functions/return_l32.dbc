# Tests returning other values than i64
# input = n
# output = n

function check {} -> { i32 } {
	input_l32       ret0;
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv

	init_lany_type 			check_ret_val, i32;
	call_func          	check;
	output_l32 			check_ret_val;

	deinit;
	deinit; # *argv
	deinit; # argc
	ret;
}
