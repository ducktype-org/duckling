# Tests a simple function call.
# input = n
# output = n

function check { i64 } -> void {
	output_p64          arg0;
	ret;
}

function main { i64, ptr_argv } -> i64 {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type 		check_arg0, i64;
	input_p64           check_arg0;
	call_func          	check;

	mov_p64_imm			ret_val, 42;
	deinit; # *argv
	deinit; # argc
	ret;
}
