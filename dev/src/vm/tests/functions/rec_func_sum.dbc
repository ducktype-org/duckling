# Tests for recurrence, but also for many function aspects
# (passing arguments, results, whether stacks are seperate).
# input = n
# output = n * (n + 1) / 2

function sum { i64 } -> { i64 } {
	cmpEq_p64_imm       arg0,  0;
	jmpIf_label      ret_label;
	# if arg != 0:
		init_pany_type           total, i64; # [16, 24) init a return value spot for sum()
		init_pany_type           a, i64; # [24, 32) init an arg0 spot for sum()
		mov_p64_p64         a,  arg0;
		sub_p64_imm         a,  1;

		call_func           sum;

		mov_p64_p64         ret0, total;
		add_p64_p64         ret0,  arg0;

		deinit; # sum() ret0. arg0 was deinitialized by the call.
	label ret_label;

	deinit; # arg0
	ret;    # The result already is on the 0 offset
}

function main { i64, ptr_argv } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type           sum_ret0, i64;
	init_pany_type           sum_arg0, i64;
	input_p64           sum_arg0;

	call_func          	sum;

	output_p64          sum_ret0;

	deinit; # sum ret0, sum arg0 is deinitialized by the call
	deinit; # *argv
	deinit; # argc
	ret;
}
