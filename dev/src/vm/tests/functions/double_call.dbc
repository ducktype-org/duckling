# Tests if call_func effectively deinit's it's parameters
# input = "a b c d"
# output = a + b + c + d

function foo { i64, i64 } -> { i64 } {
	mov_l64_l64     ret_val_0, arg0;
	add_l64_l64     ret_val_0, arg1;
	deinit; # arg1
	deinit; # arg0
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
	# ret_val_0 -> main ret_val_0
	# arg0 -> argc
	# arg1 -> *argv

	init_lany_type       acc, i64;
	init_lany_type       foo_ret_val, i64;
	init_lany_type       foo_arg0, i64;
	init_lany_type       foo_arg1, i64;

	input_l64       foo_arg0;
	input_l64       foo_arg1;
	call_func       foo;

	# Here foo_arg0 and foo_arg1 are deinitialized
	add_l64_l64     acc, foo_ret_val; # acc := a + b

	init_lany_type       foo2_arg0, i64;
	init_lany_type       foo2_arg1, i64;

	input_l64       foo2_arg0;
	input_l64       foo2_arg1;
	call_func       foo;
	# Here foo2_arg0 and foo2_arg1 are deinitialized

	add_l64_l64     acc, foo_ret_val; # acc += c + d

	output_l64      acc;

	deinit; # foo ret_val_0
	deinit; # accumulator
	deinit; # *argv
	deinit; # argc
	ret;
}
