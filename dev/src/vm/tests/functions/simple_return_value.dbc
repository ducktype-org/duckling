# Tests if values from functions are returned correctly.
# input = n
# output = n

function check {} -> i64 {
	input_p64       ret_val;
	ret;
}

function main { i64, ptr_argv } -> i64 {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv
	
	init_pany_type  check_ret_val, i64;
	call_func       check;
	output_p64      check_ret_val;

	deinit;
	deinit; # *argv
	deinit; # argc 
	ret;
}
