# Tests if values from functions are returned correctly.
# input = n
# output = n

function check {} -> { i64 } {
	input_l64       ret_val_0;
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
	# ret_val_0 -> main ret_val_0
	# arg0 -> argc
	# arg1 -> *argv
	
	init_lany_type  check_ret_val, i64;
	call_func       check;
	output_l64      check_ret_val;

	deinit;
	deinit; # *argv
	deinit; # argc 
	ret;
}
