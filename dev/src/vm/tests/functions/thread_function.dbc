global_data counter i64 {};

function func {} -> void {
    init_lany_type			 temp, i64;
	init_lany_type 			 i, i64;
	mov_l64_imm				 i, 100;
	# while(i > 0)
	label Loop1;
		# i--
		sub_l64_imm          i, 1;

		mov_l64_g64			 temp, counter;
		add_l64_imm			 temp, 1;
		mov_g64_l64			 counter, temp;

		# if i > 0 goto Loop1
		cmpG_l64_imm         i, 0;
		jmpIf_label      	 Loop1;

	deinit;
	deinit;
    ret;
}

function main { i64, ptr_argv } -> i64 {
	init_lany_type           thread_id, i64;
    call_builtinfunc 		 builtin_start_thread;

	call_func				 func;	

	init_lany_type 			 join_id, i64;
    mov_l64_l64 			 join_id, thread_id;
    call_builtinfunc 		 builtin_join_thread;	

    init_lany_type 			 returned_size, i64;
    init_lany_type			 output_var, i64;
    mov_l64_g64 			 output_var, counter;
    call_builtinfunc 		 builtin_output_i64;

	deinit;
	deinit;
	deinit;
	deinit;
    ret;
}
