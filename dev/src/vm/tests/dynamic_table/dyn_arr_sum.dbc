type dynamic_table: tablei64 i64
type pointer: ptr_tablei64 tablei64

function main { i64, ptr_argv } -> { i64 } {
    
    init_pany_type aggr, i64;
    init_pany_type iter, i64;
    init_pany_type val, i64;
    init_pany_type tbl_ptr, ptr_tablei64;
    mov_p64_imm val, 5;
    dynTableReAlloc_pptr_type_p64 tbl_ptr, tablei64, val;
    mov_p64_imm iter, 5;

    label Loop1;
        sub_p64_imm iter, 1;
        dynTableStore_pptr_pany_p64 tbl_ptr, val, iter;
        sub_p64_imm val, 1;
        cmpEq_p64_imm iter, 0;
        jmpIfNot_label Loop1;
    
    mov_p64_imm val, 10;
    dynTableReAlloc_pptr_type_p64 tbl_ptr, tablei64, val;

    mov_p64_imm iter, 10;
    label Loop2;
        sub_p64_imm iter, 1;
        dynTableStore_pptr_pany_p64 tbl_ptr, val, iter;
        sub_p64_imm val, 1;
        cmpEq_p64_imm iter, 5;
        jmpIfNot_label Loop2;
    
    mov_p64_imm aggr, 0;
    mov_p64_imm iter, 10;
    label Loop3;
        sub_p64_imm iter, 1;
        dynTableLoad_pany_pptr_p64 val, tbl_ptr, iter;
        add_p64_p64 aggr, val;
        cmpEq_p64_imm iter, 0;
        jmpIfNot_label Loop3;

    output_p64 aggr;
    free_pptr tbl_ptr;


    deinit; # *tbl_ptr
    deinit; # val
    deinit; # iter
    deinit; # aggr
    deinit; # *argv
    deinit; # argc
    ret;
}
