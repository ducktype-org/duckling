type dynamic_table: dtablei64 i32
type pointer: dptr_i64 dtablei64

function main { i64, ptr_argv } -> { i64 } {

    init_pany_type iter, i64;
    init_pany_type val, i64;
    init_pany_type table_ptr, dptr_i64;
    init_pany_type other_ptr, ptr_i64;
    mov_p64_imm val, 5;
    dynTableReAlloc_pptr_type_p64 table_ptr, dtablei64, val;
    mov_p64_imm iter, 5;
    

    label Loop1;
        sub_p64_imm iter, 1;
        dynTableStore_pptr_pany_p64 table_ptr, val, iter;
        cmpEq_p64_imm iter, 0;
        jmpIfNot_label Loop1;

    dynTableLea_pptr_pptr_p64 other_ptr, table_ptr, iter;
    mov_p64_imm val, 4;
    store_pptr_pany other_ptr, val;

    mov_p64_imm iter, 0;
    dynTableLoad_pany_pptr_p64 val, table_ptr, iter;

    output_p64 val;

    deinit; # other_ptr
    free_pptr table_ptr;
    deinit; # table_ptr
    deinit; # val
    deinit; # iter
    deinit; # *argv
    deinit; # argc
    ret;
}
