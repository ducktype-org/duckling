type dynamic_table: dtablei64 i64
type pointer: dptr_i64 dtablei64

function main { i64, ptr_argv } -> { i64 } {

    init_lany_type iter, i64;
    init_lany_type val, i64;
    init_lany_type table_ptr, dptr_i64;
    init_lany_type other_ptr, ptr_i64;
    mov_l64_imm val, 5;
    dynTableReAlloc_lptr_type_l64 table_ptr, dtablei64, val;
    mov_l64_imm iter, 5;
    

    label Loop1;
        sub_l64_imm iter, 1;
        dynTableStore_lptr_lany_l64 table_ptr, val, iter;
        cmpEq_l64_imm iter, 0;
        jmpIfNot_label Loop1;

    dynTableLea_lptr_lptr_l64 other_ptr, table_ptr, iter;
    mov_l64_imm val, 4;
    store_lptr_lany other_ptr, val;

    mov_l64_imm iter, 0;
    dynTableLoad_lany_lptr_l64 val, table_ptr, iter;

    output_l64 val;

    deinit; # other_ptr
    free_lptr table_ptr;
    deinit; # table_ptr
    deinit; # val
    deinit; # iter
    deinit; # *argv
    deinit; # argc
    ret;
}
