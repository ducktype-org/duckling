type dynamic_table: tablei64 i64
type pointer: ptr_tablei64 tablei64

function main { i64, ptr_argv } -> { i64 } {
    
    init_lany_type tbl_ptr, ptr_tablei64;
    init_lany_type iter, i64;
    mov_l64_imm iter, 5;
    
    # Allocate table with 5 elements
    dynTableReAlloc_lptr_type_l64 tbl_ptr, tablei64, iter;
    
    # Reallocate to 0 elements - this should free the data and set pointer to null
    mov_l64_imm iter, 0;
    dynTableReAlloc_lptr_type_l64 tbl_ptr, tablei64, iter;
    
    # Check that pointer is null after 0-element reallocation
    cmpNull_lptr tbl_ptr;
    jmpIf_label pointer_is_null_as_expected;
    
    # If we reach here, pointer is not null - this is an error
    mov_l64_imm iter, 1;  # Error code 1
    output_l64 iter;
    deinit; # iter
    deinit; # *tbl_ptr
    deinit; # *argv
    deinit; # argc
    ret;
    
label pointer_is_null_as_expected;
    
    # Try to allocate again with 3 elements after the zero reallocation
    mov_l64_imm iter, 3;
    dynTableReAlloc_lptr_type_l64 tbl_ptr, tablei64, iter;
    
    # If we get here without crashing, output 42 to indicate success
    mov_l64_imm iter, 42;
    output_l64 iter;
    
    free_lptr tbl_ptr;

    deinit; # iter
    deinit; # *tbl_ptr
    deinit; # *argv
    deinit; # argc
    ret;
}
