type fixed_size_table: fst1_i64 i64 1
type dynamic_table: dyn_i64 i64
type pointer: ptr_fst fst1_i64
type pointer: ptr_dyn dyn_i64

global_data g_arr fst1_i64 {
    initial_value: fixed_size_table [ 0x000000000000002A ]
}

function main { i64, ptr_argv } -> { i64 } {
    init_pany_type t_fst, ptr_fst;
    init_pany_type t_dyn, ptr_dyn;
    init_pany_type idx, i64;
    init_pany_type val, i64;

    ref_pptr_pany t_fst, g_arr;
    fstToDynTable_pptr_pptr t_dyn, t_fst;

    input_p64 idx;
    dynTableLoad_pany_pptr_p64 val, t_dyn, idx;
    output_p64 val;

    deinit; # val
    deinit; # idx
    deinit; # t_dyn
    deinit; # t_fst
    deinit; # *argv
    deinit; # argc
    ret;
}
