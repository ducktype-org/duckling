function fib { i64 } -> { i64 } {
	# arg0 -> n

	mov_p64_p64         ret0, arg0;

	# if !(n > 1): end
	cmpGt_p64_imm        arg0, 1;
	jmpIfNot_label      End;

	# fib(n - 1)
	init_pany_type      rec_result, i64;
	init_pany_type      n1, i64;
	mov_p64_p64         n1, arg0;
	sub_p64_imm         n1, 1;
	call_func           fib;

	mov_p64_p64         ret0, rec_result;

	# fib(n - 2)
	init_pany_type      n2, i64;
	mov_p64_imm         rec_result, 0;
	mov_p64_p64         n2, arg0;
	sub_p64_imm         n2, 2;
	call_func           fib;


	# (fib(n - 1) + fib(n - 2)) % mod
	add_p64_p64         ret0, rec_result;
	mod_p64_imm         ret0, 8388449;

	deinit;  # rec_result
	label               End;

	deinit;  # arg0
	ret;
}

function main { } -> { i64 } {
	init_pany_type  result, i64;
	init_pany_type  n, i64;
	input_p64       n;

	call_func       fib;

	output_p64      result;

	ret;
}
