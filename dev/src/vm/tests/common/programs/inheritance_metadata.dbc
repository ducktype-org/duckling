type fun: method_I1_int {ptr{I1}} { i64 }

type fun: method_parent_int {ptr{Parent}, i64} {}

type fun: method_child_int {ptr{Child}, i64} {}


function Child_cry_impl {ptr{Child}, i64} -> {} {
    ret;
}

function Parent_getAge_impl {ptr{Parent}, i64} -> {} {
    init_pany_type age, i64;
    mov_p64_imm age, 50;
    output_p64 age;
    deinit; # age
    deinit; # arg0
    ret;
}

function Child_getAge_impl {ptr{Child}, i64} -> {} {
    init_pany_type age, i64;
    mov_p64_imm age, 15;
    output_p64 age;
    deinit; # age
    deinit; # arg0
    ret;
}

function I1_foo_impl {ptr{I1}} -> { i64 } {
    init_pany_type x, i64;
    mov_p64_imm x, 0;
    output_p64 x;
    deinit;
    ret;
}

function Child_I1_impl {ptr{Child}} -> { i64 } {
    init_pany_type x, i64;
    mov_p64_imm x, 1;
    output_p64 x;
    deinit;
    ret;
}

type data: POD {
	abc: i64,
}

type interface: I1 {
    virtual_methods: {
        foo: method_I1_int,
        bar: method_I1_int,
    };
    implementations: {
        foo: I1_foo_impl,
    };
}

type interface: I2 {
}

type class: Parent {
    fields: {
        x: i64,
    };
    virtual_methods: {
        getAge: method_parent_int,
    };
    implementations: {
        getAge: Parent_getAge_impl, # Implementation of age for Parent.
    };
}

type class: Child {
    extends: Parent;
    abstract: false;  # This is the case by default.
    implements: {I1, I2};
    fields: {
        y: i64,
    };
    virtual_methods: {
        cry: method_child_int,
    };
    implementations: { # If Child is a concrete class, all methods have to be implemented.
        getAge: Child_getAge_impl, # Implementation of getAge for child.
        bar: Child_I1_impl,
        cry: Child_cry_impl,
    };
}

type class: PietMondrian {
	abstract: true;
}

function main { i64, ptr{argv} } -> { i64 } {
    ret;
}
