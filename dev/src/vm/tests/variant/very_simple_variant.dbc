type primitive: i8 1
type variant: simple_variant { i64, i8 }

function main { i64, ptr_argv } -> { i64 } {
    init_lany_type v1, simple_variant;  # var v1: variant<i64, i8>;

    variantSetInner_lvnt_type v1, i64;        # v1.setType<i64>();

    init_lany_type ptr, ptr_i64;        # var ptr: i64*;
    variantGetInner_lptr_lvnt_type ptr, v1, i64;        # ptr = v1.getData<i64>();

    init_lany_type int, i64;            # var int: i64;
    input_l64 int;                      # int = input();

    store_lptr_lany ptr, int;           # *ptr = int;

    init_lany_type read_ptr, i64;       # var read_ptr: i64;
    load_lany_lptr read_ptr, ptr;       # read_ptr = *ptr;

    output_l64 read_ptr;                # print(read_ptr);

    ret;
}
