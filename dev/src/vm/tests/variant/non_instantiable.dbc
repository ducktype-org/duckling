type class: A {
    abstract: true;
}

type variant: simple_variant { i64, A, i32 }

function main { i64, ptr_argv } -> { i64 } {
    # let v0: variant<i64, A, i32>;
    init_pany_type v0, simple_variant;

    # v0.setType<i64>();
    variantSetInner_pvnt_type v0, i64;

    # let ptr: ptr<i64>;
    init_pany_type ptr, ptr_i64;

    # ptr = v0.getData<i64>();
    variantGetInner_pptr_pvnt_type ptr, v0, i64;

    # let value: i64 = input();
    init_pany_type value, i64;
    input_p64 value;

    # *ptr = value;
    store_pptr_pany ptr, value;

    # let read_val: i64 = *ptr;
    init_pany_type read_val, i64;
    load_pany_pptr read_val, ptr;

    output_p64 read_val;

    ret;
}
