type fun: method_child_void {ptr{Child}} {}

type class: Child {
    virtual_methods: { 
        cry: method_child_void,
    };
    implementations: {
        cry: Child_cry_impl_type,
    };
}

function Child_cry_impl_type {ptr{Child}} -> {} {
    init_pany_type res, i64; mov_p64_imm res, 55; output_p64 res; deinit; deinit; ret;
}

function main { i64, ptr{argv} } -> { i64 } {
    init_pany_type fake_child, ptr{i64};
    init_pany_type actual_child, ptr{Child};
    alloc_pptr_type actual_child, Child;
    setVTable_pptr_type actual_child, Child;

    init_pany_type temp_child, ptr{Child};
    mov_pptr_pptr temp_child, actual_child;
    virtualCall_pptr_method fake_child, cry; # fake_child is fakeing to be a child.

    deinit;
    deinit;
    deinit;
    ret;
}