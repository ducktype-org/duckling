# All methods on the inheritance path are implemented. This should pass.
type pointer: pointer_A A
type pointer: pointer_B B
type pointer: pointer_C C

type fun: method_foo {pointer_A} {}
type fun: method_bar {pointer_A} {}

function method_foo_impl_A {pointer_A} -> {} {
    ret;
}

type fun: method_goo {pointer_B} {}

function method_foo_impl_B {pointer_B} -> {} {
    ret;
}

function method_bar_impl_B {pointer_B} -> {} {
    ret;
}

type fun: method_gaa {pointer_C} {}

function method_goo_impl_C {pointer_C} -> {} {
    ret;
}

function method_gaa_impl_C {pointer_C} -> {} {
    ret;
}

type class: A {
    abstract: true;
    virtual_methods: {
        foo: method_foo, 
        bar: method_bar,
    };
    implementations: {
        foo: method_foo_impl_A, 
    };
}

type class: B {
    extends: A;
    abstract: true;
    virtual_methods: {
        goo: method_goo,
    };
    implementations: {
        foo: method_foo_impl_B, 
        bar: method_bar_impl_B, 
    };
}

type class: C {
    extends: B;
    virtual_methods: {
        gaa: method_gaa,
    };
    implementations: {
        goo: method_goo_impl_C, 
        gaa: method_gaa_impl_C, 
    };
}
