type fun: method_foo {ptr{A}} {}
type fun: method_bar {ptr{A}} {}
function method_foo_impl {ptr{A}} -> {} {
    ret;
}

type class: A {
    virtual_methods: {
        foo: method_foo, 
        bar: method_bar,
    };
    implementations: {
        foo: method_foo_impl, 
        # bar() is unimplemented in an instantiable class.
    };
}
