type fun: method_foo {ptr{A}} {}
type fun: method_bar {ptr{A}} {}

function method_foo_impl {ptr{A}} -> {} {
    init_pany_type x, i64;
    mov_p64_imm x, 0;
    output_p64 x;
    deinit;
    ret;
}

type class: A {
    abstract: true;
    virtual_methods: {
        foo: method_foo, 
        bar: method_bar,
    };
    implementations: {
        foo: method_foo_impl, 
        # bar() is unimplemented in an abstract class. This should pass.
    };
}
