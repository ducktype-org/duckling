# Method bar() lacks implementation in an instantiable class C.

type fun: method_foo {ptr{A}} {}
type fun: method_bar {ptr{A}} {}
type fun: method_goo {ptr{B}} {}
type fun: method_gaa {ptr{C}} {}

function method_foo_impl_A {ptr{A}} -> {} {
    ret;
}

function method_foo_impl_B {ptr{B}} -> {} {
    ret;
}

type fun: method_bar_impl_B {ptr{B}} {}

function method_goo_impl_C {ptr{C}} -> {} {
    ret;
}

function method_gaa_impl_C {ptr{C}} -> {} {
    ret;
}

type class: A {
    abstract: true;
    virtual_methods: {
        foo: method_foo, 
        bar: method_bar,
    };
    implementations: {
        foo: method_foo_impl_A, 
    };
}

type class: B {
    abstract: true;
    extends: A;
    virtual_methods: {
        goo: method_goo,
    };
    implementations: {
        foo: method_foo_impl_B, 
    };
}

type class: C {
    extends: B;
    virtual_methods: {
        gaa: method_gaa,
    };
    implementations: {
        goo: method_goo_impl_C, 
        gaa: method_gaa_impl_C, 
    };
}
