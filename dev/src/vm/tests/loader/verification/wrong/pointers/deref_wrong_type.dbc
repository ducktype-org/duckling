type primitive: ui64 8

function main { i64, ptr_argv } -> { i64 } {
	# ret_val_0 -> main ret_val_0
	# arg0 -> argc
	# arg1 -> *argv

	init_lany_type 		x, ptr_i64;
	init_lany_type 		y, ui64;
	init_lany_type 		z, i64;

	mov_l64_imm         z, 1;
	ref_lptr_lany        x, z;  # x = &z
	load_lany_lptr       y, x;  # y = *x

	deinit; # z
	deinit; # y
	deinit; # x
	deinit; # *argv
	deinit; # argc
	ret;
}
