type primitive: ui64 8

function main { i64, ptr_argv } -> i64 {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type 		x, ptr_i64;
	init_pany_type 		y, ui64;
	init_pany_type 		z, i64;

	mov_p64_imm         z, 1;
	ref_pptr_pany        x, z;  # x = &z
	load_pany_pptr       y, x;  # y = *x

	deinit; # z
	deinit; # y
	deinit; # x
	deinit; # *argv
	deinit; # argc
	ret;
}
