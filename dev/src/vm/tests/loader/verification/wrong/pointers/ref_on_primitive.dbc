type primitive: int128 16

function main { i64, ptr_argv } -> { i64 } {
	# ret_val_0 -> main ret_val_0
	# arg0 -> argc
	# arg1 -> *argv

	init_lany_type 		x, int128;
	init_lany_type 		y, i64;
	init_lany_type 		z, i64;

	mov_l64_imm         z, 1;
	ref_lptr_lany        x, z;  # x = &z
	fixedSizeTableLoad_lany_lptr_l64       y, x, y;  # y = *x

	deinit; # z
	deinit; # y
	deinit; # x
	deinit; # *argv
	deinit; # argc
	ret;
}
