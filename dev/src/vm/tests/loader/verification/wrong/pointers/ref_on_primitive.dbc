type primitive: int128 16

function main { i64, ptr_argv } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type 		x, int128;
	init_pany_type 		y, i64;
	init_pany_type 		z, i64;

	mov_p64_imm         z, 1;
	ref_pptr_pany        x, z;  # x = &z
	fixedSizeTableLoad_pany_pptr_p64       y, x, y;  # y = *x

	deinit; # z
	deinit; # y
	deinit; # x
	deinit; # *argv
	deinit; # argc
	ret;
}
