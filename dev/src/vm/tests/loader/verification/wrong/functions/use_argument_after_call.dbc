function check { i64 } -> {} {
	output_l64          arg0;
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
	# ret_val_0 -> main ret_val_0
	# arg0 -> argc
	# arg1 -> *argv

	init_lany_type 		check_arg0, i64;
