type primitive: ui64 8

function main { i64, ptr_argv } -> i64 {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type       x, i64;
	init_pany_type       y, ui64;

	mov_p64_imm     x, 1;
	mov_p64_p64     x, y;

	deinit; # y
	deinit; # x
	deinit; # *argv
	deinit; # argc
	ret;
}
