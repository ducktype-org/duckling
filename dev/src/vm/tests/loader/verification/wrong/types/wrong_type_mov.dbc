type primitive: ui64 8

function main { i64, ptr_argv } -> { i64 } {
	# ret_val_0 -> main ret_val_0
	# arg0 -> argc
	# arg1 -> *argv

	init_lany_type       x, i64;
	init_lany_type       y, ui64;

	mov_l64_imm     x, 1;
	mov_l64_l64     x, y;

	deinit; # y
	deinit; # x
	deinit; # *argv
	deinit; # argc
	ret;
}
