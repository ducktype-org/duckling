type primitive: MyInt64 8

function main { i64, ptr_argv } -> i64 {
    init_pany_type a, MyInt64;

    init_pany_type i, i64;
    mov_p64_imm i, 5;  # i = 5;

label START;           # while (i > 0)
    cmpEq_p64_imm i, 0;
    jmpIf_label END;

    init_pany_type c, MyInt64;
    mov_p64_imm c, 1;

    # In second loop iteration types of those variables are not equal *
    add_p64_p64 a, c;

    init_pany_type b, i64;
    mov_p64_imm b, 1;

    # * because of this in-place cast.
    cast_p64_type a, i64;
    add_p64_p64 a, b;

    sub_p64_imm i, 1;  # i--;

    deinit;  # b
    deinit;  # c
    jmp_label START;
 label END;
    output_p64 a;

    ret;
}
