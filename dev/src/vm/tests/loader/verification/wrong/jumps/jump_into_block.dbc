function main { i64, ptr_argv } -> { i64 } {
	# ret_val_0 -> main ret_val_0
	# arg0 -> argc
	# arg1 -> *argv

	# conditional so that the code inbetween the target and jump does not get eliminated
	jmpIf_label           Inside;

	init_lany_type      x, i64;
	label               Inside;
	deinit; # x

	deinit; # *argv
	deinit; # argc
	ret;
}
