function main { i64, ptr_argv } -> i64 {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type     	x, i64;

	# conditional so that the code inbetween the target and jump does not get eliminated
	jmpIf_label 		Other;

	deinit; # x

	init_pany_type     	y, i64;
	label         		Other;
	deinit; # y

	deinit; # *argv
	deinit; # argc
	ret;
}
