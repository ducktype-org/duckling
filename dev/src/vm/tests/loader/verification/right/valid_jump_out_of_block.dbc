function main { i64, ptr_argv } -> i64 {
		# ret_val -> main ret_val
		# arg0 -> argc
		# arg1 -> *argv

		init_pany_type      x, i64;
		input_p64           x;

		# if x == 0
		cmpEq_p64_imm       x, 0;
		jmpIf_label         OUT;
		output_p64          x;
		deinit; # x
		jmp_label           EXIT;

		label               OUT;
		add_p64_imm         x, 10; # x += 10
		output_p64          x;
		deinit; # x

		label               EXIT;
		deinit; # *argv
		deinit; # argc
		ret;
}
