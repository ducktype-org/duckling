# Checks verifying the type of ret_val space initialized by the caller on call.

function check { i64 } -> i32 {
	mov_p32_imm     ret_val, 42;
	ret;
}

function main { i64, ptr_argv } -> i64 {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv
	
	init_pany_type      check_arg0, i64;
	mov_p64_imm         check_arg0, 30;
	call_func           check;

	mov_p64_imm         ret_val, 42;
	
	deinit;             # *argv
	deinit;             # argc
	ret;
}