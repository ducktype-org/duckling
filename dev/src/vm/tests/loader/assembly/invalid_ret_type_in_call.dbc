# Checks verifying the type of ret_val_0 space initialized by the caller on call.

function check { i64 } -> { i32 } {
	mov_l32_imm     ret_val_0, 42;
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
	# ret_val_0 -> main ret_val_0
	# arg0 -> argc
	# arg1 -> *argv
	
	init_lany_type      check_arg0, i64;
	mov_l64_imm         check_arg0, 30;
	call_func           check;

	mov_l64_imm         ret_val_0, 42;
	
	deinit;             # *argv
	deinit;             # argc
	ret;
}