# Main thread blocks on a bytecode condition variable. Its state stays `Running` - `builtinWaitCV`
# drops the GIL but never reports the thread as sleeping - which is why the test waits for
# `Running` and not for `Sleeping`. Since no status change marks the wait being entered, the
# fixture writes a marker on the last instruction before it and the test waits for that instead.

global_data sleep_mutex mutex {}
global_data cv_main     condition_variable {}

function main { } -> { i64 } {
	init_pany_type		ism, mutex;
	call_builtinfunc	builtin_create_mutex;
	mov_popq_popq		sleep_mutex, ism;

	init_pany_type		icvm, condition_variable;
	call_builtinfunc	builtin_create_cv;
	mov_popq_popq		cv_main, icvm;

	init_pany_type		sm, mutex;
	mov_popq_popq		sm, sleep_mutex;
	call_builtinfunc	builtin_lock_mutex;

	# The marker the test waits for: everything below is the condition-variable wait itself.
	init_pany_type		marker, i64;
	mov_p64_imm			marker, 1;
	output_p64			marker;
	deinit; # marker

	label SleepLoop;
		init_pany_type		scv, condition_variable;
		mov_popq_popq		scv, cv_main;
		init_pany_type		swm, mutex;
		mov_popq_popq		swm, sleep_mutex;
		call_builtinfunc	builtin_wait_cv;
		jmp_label			SleepLoop;

	ret;
}
