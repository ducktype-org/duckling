function addTen { i64 }-> { i64 } {
	init_pany_type          add_ret0, i64;
	init_pany_type          add_arg0, i64;
	init_pany_type          add_arg1, i64;
	mov_p64_p64             add_arg0, arg0;
	mov_p64_imm             add_arg1, 10;
	call_cfunc              add;

	mov_p64_p64             ret0, add_ret0;
	deinit; # add_ret0
	ret;
}

function main { i64, ptr_argv }-> { i64 } {
    # Read counter from STDIN
    init_pany_type counter, i64;
    input_p64 counter;

label loop_start;

    cmpEq_p64_imm counter, 0;
    jmpIf_label loop_end;

	init_pany_type          addTen_ret0, i64;
	init_pany_type          addTen_arg0, i64;
	mov_p64_p64             addTen_arg0, counter;
	call_func               addTen;

    output_p64              addTen_ret0;
    deinit; # addTen_ret0

    add_p64_imm counter, -1;
    jmp_label loop_start;

label loop_end;

    mov_p64_imm ret0, 0;

    deinit; # counter
    deinit; # *argv
    deinit; # argc
    ret;
}
