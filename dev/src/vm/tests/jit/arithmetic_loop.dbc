    init_pany_type cntr, i64;
    init_pany_type loop_limit, i64;

    mov_p64_imm loop_limit, 100;
    mov_p64_imm a, 0;
    mov_p64_imm cntr, 0;
    label loop_start;
    add_p64_imm a, 1;
    add_p64_imm a, 2;
    mul_p64_imm a, 1;
    sub_p64_imm a, 3;
