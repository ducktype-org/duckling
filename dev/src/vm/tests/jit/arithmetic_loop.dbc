    add_p64_imm a, 1;
    add_p64_imm a, 2;
    mul_p64_imm a, 1;
    sub_p64_imm a, 3;
    add_p64_imm a, 1;
    add_p64_imm a, 2;
    mul_p64_imm a, 1;
    sub_p64_imm a, 3;
    
    add_p64_imm cntr, 1;
    cmpEq_p64_p64 cntr, loop_limit;
    jmpIfNot_label loop_start;

    deinit;
    deinit;
    deinit;
    ret;

}

function main { i64, ptr_argv } -> { i64 } {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

    # Read counter limit from STDIN
    init_pany_type counter_limit, i64;
    input_p64 counter_limit;

    # Initialize loop counter
    init_pany_type counter, i64;
    mov_p64_imm counter, 0;

    # Loop until counter equals counter_limit
    label loop_start;
    
    # Check if counter == counter_limit
    cmpEq_p64_p64 counter, counter_limit;
    jmpIf_label loop_end;

    # Call function f
    call_func f;

    # Increment counter
    add_p64_imm counter, 1;

    # Jump back to loop start
    jmp_label loop_start;

    label loop_end;
    
    # Return 0
    mov_p64_imm ret0, 0;
    
    deinit; # counter
    deinit; # counter_limit
    deinit; # *argv
    deinit; # argc
    ret;
}
