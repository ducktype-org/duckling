# Benchmark: operations on fixed-size (static) array
# Function f performs ~40 array operations sequentially (no branches, no calls)
# Main reads n from STDIN and calls f n times

type fixed_size_table: table_i64 i64 20
type pointer: ptr_table_i64 table_i64

function f {} -> void {
    # Declare local variables
    init_lany_type arr, ptr_table_i64;
    init_lany_type idx, i64;
    init_lany_type val, i64;
    init_lany_type tmp, i64;
    
    # Allocate fixed-size array
    alloc_lptr_type arr, table_i64;
    
    # Initialize values
    mov_l64_imm val, 100;
    
    # Store sequence: arr[0] = 100, arr[1] = 101, ...
    mov_l64_imm idx, 0;
    fixedSizeTableStore_lptr_lany_l64 arr, val, idx;
    add_l64_imm val, 1;
    
    mov_l64_imm idx, 1;
    fixedSizeTableStore_lptr_lany_l64 arr, val, idx;
    add_l64_imm val, 1;
    
    mov_l64_imm idx, 2;
    fixedSizeTableStore_lptr_lany_l64 arr, val, idx;
    add_l64_imm val, 1;
    
    mov_l64_imm idx, 3;
    fixedSizeTableStore_lptr_lany_l64 arr, val, idx;
    add_l64_imm val, 1;
    
    mov_l64_imm idx, 4;
    fixedSizeTableStore_lptr_lany_l64 arr, val, idx;
    add_l64_imm val, 1;
    
    mov_l64_imm idx, 5;
    fixedSizeTableStore_lptr_lany_l64 arr, val, idx;
    add_l64_imm val, 1;
    
    mov_l64_imm idx, 6;
    fixedSizeTableStore_lptr_lany_l64 arr, val, idx;
    add_l64_imm val, 1;
    
    mov_l64_imm idx, 7;
    fixedSizeTableStore_lptr_lany_l64 arr, val, idx;
    add_l64_imm val, 1;
    
    mov_l64_imm idx, 8;
    fixedSizeTableStore_lptr_lany_l64 arr, val, idx;
    add_l64_imm val, 1;
    
    mov_l64_imm idx, 9;
    fixedSizeTableStore_lptr_lany_l64 arr, val, idx;
    add_l64_imm val, 1;
    
    # Load and modify sequence
    mov_l64_imm idx, 0;
    fixedSizeTableLoad_lany_lptr_l64 tmp, arr, idx;
    add_l64_imm tmp, 10;
    fixedSizeTableStore_lptr_lany_l64 arr, tmp, idx;
    
    mov_l64_imm idx, 1;
    fixedSizeTableLoad_lany_lptr_l64 tmp, arr, idx;
    add_l64_imm tmp, 20;
    fixedSizeTableStore_lptr_lany_l64 arr, tmp, idx;
    
    mov_l64_imm idx, 2;
    fixedSizeTableLoad_lany_lptr_l64 tmp, arr, idx;
    add_l64_imm tmp, 30;
    fixedSizeTableStore_lptr_lany_l64 arr, tmp, idx;
    
    mov_l64_imm idx, 3;
    fixedSizeTableLoad_lany_lptr_l64 tmp, arr, idx;
    add_l64_imm tmp, 40;
    fixedSizeTableStore_lptr_lany_l64 arr, tmp, idx;
    
    mov_l64_imm idx, 4;
    fixedSizeTableLoad_lany_lptr_l64 tmp, arr, idx;
    add_l64_imm tmp, 50;
    fixedSizeTableStore_lptr_lany_l64 arr, tmp, idx;
    
    # Free array
    free_lptr arr;
    
    # Cleanup
    deinit; # tmp
    deinit; # val
    deinit; # idx
    deinit; # arr
    
    ret;
}

function main { i64, ptr_argv } -> i64 {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

    # Read counter limit from STDIN
    init_lany_type counter_limit, i64;
    input_l64 counter_limit;

    # Initialize loop counter
    init_lany_type counter, i64;
    mov_l64_imm counter, 0;

    # Loop until counter equals counter_limit
    label loop_start;
    
    # Check if counter == counter_limit
    cmpEq_l64_l64 counter, counter_limit;
    jmpIf_label loop_end;

    # Call function f
    call_func f;

    # Increment counter
    add_l64_imm counter, 1;

    # Jump back to loop start
    jmp_label loop_start;

    label loop_end;
    
    # Return 0
    mov_l64_imm ret_val, 0;
    
    deinit; # counter
    deinit; # counter_limit
    deinit; # *argv
    deinit; # argc
    ret;
}
