type fun: method_I1_void {ptr{I1}} {}
type fun: method_parent_void {ptr{Parent}} {}
type fun: method_child_void {ptr{Child}} {}

type interface: I1 {
    virtual_methods: { 
        foo: method_I1_void, 
        bar: method_I1_void,
    };
    implementations: { 
        foo: I1_foo_default_impl_type,
    };
}

type class: Parent {
    virtual_methods: { 
        getAge: method_parent_void,
    };
    abstract: true;
    implements: {I1};
    implementations: {
        getAge: Parent_getAge_impl_type, 
    };
}

type class: Child {
    extends: Parent;
    abstract: false;
    implementations: {
        getAge: Child_getAge_impl_type,
        bar: Child_I1_bar_impl_type, 
    };
}

# ============ METHODS IMPLEMENTATION ============ 
function I1_foo_default_impl_type {ptr{I1}} -> { } {
    init_pany_type res, i64; mov_p64_imm res, 1; output_p64 res; deinit; deinit; ret;
}
function Child_I1_bar_impl_type {ptr{Child}} -> { } {
    init_pany_type res, i64; mov_p64_imm res, 2; output_p64 res; deinit; deinit; ret;
}
function Parent_getAge_impl_type {ptr{Parent}} -> { } {
    init_pany_type res, i64; mov_p64_imm res, 3; output_p64 res; deinit; ret;
}
function Child_getAge_impl_type {ptr{Child}} -> { } {
    init_pany_type res, i64; mov_p64_imm res, 4; output_p64 res; deinit; deinit; ret;
}

function to_jit { ptr{Parent} } -> { } {
    init_pany_type           sub_arg, ptr{I1};
    upcast_pptr_pptr         sub_arg, arg0;
    virtualCall_pptr_method sub_arg, foo;

    init_pany_type           sub_arg, ptr{I1};
    upcast_pptr_pptr         sub_arg, arg0;
    virtualCall_pptr_method sub_arg, bar;

    virtualCall_pptr_method arg0, getAge;
    ret;
}

function main { i64, ptr{argv} }-> { i64 } {
    # ret0 -> main ret0
    # arg0 -> argc
    # arg1 -> *argv

    init_pany_type ptr_child, ptr{Child};

    init_pany_type actual_child, ptr{Child};
    alloc_pptr_type actual_child, Child;
    setVTable_pptr_type actual_child, Child;

    # Read counter from STDIN
    init_pany_type counter, i64;
    input_p64 counter;

# Loop until counter equals 0
label loop_start;
    cmpEq_p64_imm counter, 0;
    jmpIf_label loop_end;

    init_pany_type      ptr_i1, ptr{Parent};
    upcast_pptr_pptr    ptr_i1, actual_child;
    call_func to_jit;

    add_p64_imm counter, -1;
    jmp_label loop_start;
label loop_end;
    
    free_pptr actual_child;
    deinit; # actual_child

    # Return 0
    mov_p64_imm ret0, 0;
    
    deinit; # counter
    deinit; # *argv
    deinit; # argc
    ret;
}