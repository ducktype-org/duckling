function add1000 { i64 } -> i64 {
	mov_l64_imm             ret_val, 1000;
	add_l64_l64             ret_val, arg0;
	ret;
}

function add1100 { i64 } -> i64 {
	mov_l64_imm    		    ret_val, 100;

	init_lany_type 			add1000_ret_val, i64; # [16, 24) add1000 ret_val
	init_lany_type 			add1000_arg0, i64; # [24, 32) add1000 arg0
	mov_l64_l64			    add1000_arg0, arg0;
	call_func               add1000;

	add_l64_l64             ret_val,   add1000_ret_val;
	ret;
}

function add1110 { i64 } -> i64 {
	mov_l64_imm    		    ret_val, 10;

	init_lany_type 			add1100_ret_val, i64;
	init_lany_type 			add1100_arg0, i64;
	mov_l64_l64			    add1100_arg0, arg0;

	call_func               add1100;

	add_l64_l64    		    ret_val, add1100_ret_val; # += add1100

	deinit; # add1100 ret_val
	deinit; # arg0
	ret;
}

function main { i64, ptr_argv } -> i64 {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

    # Read counter from STDIN
    init_lany_type counter, i64;
    input_l64 counter;

# Loop until counter equals 0
label loop_start;
    
    cmpEq_l64_imm counter, 0;
    jmpIf_label loop_end;

	init_lany_type 			add1110_ret_val, i64;
	init_lany_type 			add1110_arg0, i64;

	mov_l64_l64             add1110_arg0, counter;
	call_func          		add1100;

    output_l64              add1110_ret_val;
    deinit; # add1110_ret_val

    add_l64_imm counter, -1;
    jmp_label loop_start;

label loop_end;
    
    # Return 0
    mov_l64_imm ret_val, 0;
    
    deinit; # counter
    deinit; # *argv
    deinit; # argc
    ret;
}