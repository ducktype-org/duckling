# Finds the smallest value of form `3*2^n` larger than `arg0`
function pow { i64 }-> { i64 } {
    mov_p64_imm     ret0, 3;

    jmp_label loop_start;
    add_p64_p64     ret0, ret0;
label loop_start;
    add_p64_p64     ret0, ret0;

    ret;
}

function main { i64, ptr_argv }-> { i64 } {
    # ret0 -> main ret0
    # arg0 -> argc
    # arg1 -> *argv

    # Read counter limit from STDIN
    init_pany_type counter_limit, i64;
    input_p64 counter_limit;

    # Initialize loop counter
    init_pany_type counter, i64;
    mov_p64_imm counter, 0;

    # Loop until counter equals counter_limit
    label loop_start;
    
    # Check if counter == counter_limit
    cmpEq_p64_p64 counter, counter_limit;
    jmpIf_label loop_end;

    # Call function pow
	init_pany_type 	pow_ret, i64;
    init_pany_type  pow_arg, i64;
    mov_p64_p64     pow_arg, counter;
    call_func       pow;
    output_p64      pow_ret;
    deinit;       # pow_ret

    # Increment counter
    add_p64_imm counter, 1;

    # Jump back to loop start
    jmp_label loop_start;

    label loop_end;
    
    # Return 0
    mov_p64_imm ret0, 0;
    
    deinit; # counter
    deinit; # counter_limit
    deinit; # *argv
    deinit; # argc
    ret;
}
