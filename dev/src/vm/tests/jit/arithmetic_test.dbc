# Benchmark: arithmetic operations on local variables
# Function f performs ~40 arithmetic instructions sequentially (no branches, no calls)
# Main reads n from STDIN and calls f n times

function f {} -> { i64 } {
    add_p64_imm ret0, 21;
    ret;
}

function main { i64, ptr_argv }-> { i64 } {
    # ret0 -> main ret0
    # arg0 -> argc
    # arg1 -> *argv

    # Read counter limit from STDIN
    init_pany_type counter_limit, i64;
    input_p64 counter_limit;

    # Initialize loop counter
    init_pany_type counter, i64;
    mov_p64_imm counter, 0;

    # Loop until counter equals counter_limit
    label loop_start;
    
    # Check if counter == counter_limit
    cmpEq_p64_p64 counter, counter_limit;
    jmpIf_label loop_end;

    # Call function f
    init_pany_type  retval, i64;
    mov_p64_imm     retval, 0;
    call_func f;
    output_p64      retval;
    deinit;       # retval

    # Increment counter
    add_p64_imm counter, 1;

    # Jump back to loop start
    jmp_label loop_start;

    label loop_end;
    
    # Return 0
    mov_p64_imm ret0, 0;
    
    deinit; # counter
    deinit; # counter_limit
    deinit; # *argv
    deinit; # argc
    ret;
}
