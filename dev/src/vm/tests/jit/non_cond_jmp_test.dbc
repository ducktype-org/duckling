# Finds the smallest value of form `3*2^n` larger than `arg0`
function pow { i64 } -> i64 {
    mov_l64_imm     ret_val, 3;

    jmp_label loop_start;
label loop_start;
    add_l64_l64     ret_val, ret_val;

    ret;
}

function main { i64, ptr_argv } -> i64 {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

    # Read counter limit from STDIN
    init_lany_type counter_limit, i64;
    input_l64 counter_limit;

    # Initialize loop counter
    init_lany_type counter, i64;
    mov_l64_imm counter, 0;

    # Loop until counter equals counter_limit
    label loop_start;
    
    # Check if counter == counter_limit
    cmpEq_l64_l64 counter, counter_limit;
    jmpIf_label loop_end;

    # Call function pow
	init_lany_type 	pow_ret, i64;
    init_lany_type  pow_arg, i64;
    mov_l64_l64     pow_arg, counter;
    call_func       pow;
    output_l64      pow_ret;
    deinit;       # pow_ret

    # Increment counter
    add_l64_imm counter, 1;

    # Jump back to loop start
    jmp_label loop_start;

    label loop_end;
    
    # Return 0
    mov_l64_imm ret_val, 0;
    
    deinit; # counter
    deinit; # counter_limit
    deinit; # *argv
    deinit; # argc
    ret;
}
