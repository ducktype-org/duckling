# For a given x the program calculates a collatz sequence
# for each number from [1, x) and returns a maximum value
# reached in any of this sequences.
# For example, for x = 4:
# collatz(1) -> [1], max is 1
# collatz(2) -> [2, 1], max is 2.
# collatz(3) -> [3, 10, 5, 16, 8, 4, 2, 1], max is 16.
# Thus, the program should output 16.

function collatz { i64 } -> i64 {
	# arg0 -> n - value for which the collatz sequence is calculated
	# max - maximum value in the calculated collatz sequence

	init_lany_type		max, i64;
	init_lany_type		tmp, i64;

	mov_l64_l64		max, arg0; # max := n

	# if n == 1: end
	cmpEq_l64_imm         arg0, 1;
	jmpIf_label        End;

	# do-while (n != 1):
	label WhileNneq0;
		# if n % 2 == 0:

		# if condition:
			mov_l64_l64         tmp, arg0; # tmp := n
			mod_l64_imm         tmp, 2; # tmp %= 2
			cmpEq_l64_imm       tmp, 0;
			jmpIf_label      else;

		# if code:
			# n = 3n + 1;
			mul_l64_imm		    arg0, 3;
			add_l64_imm         arg0, 1;
			jmp_label        afterIf;

		# else
			label else;

			# else code:
				# n = n / 2
				div_l64_imm  arg0, 2;

		label afterIf;

		# if n > max:
		cmpGt_l64_l64     	arg0, max;
		cmov_l64_l64     	max, arg0; # max := n

		# if n == 1
		cmpEq_l64_imm       arg0, 1;
		jmpIfNot_label   WhileNneq0;

		# cmpGt_l64_imm       arg0, 1;
		# jmpIf_label   WhileNneq0;

	label End;

	# return max
	mov_l64_l64 	ret_val_0, max; # ret_val_0 := max

	deinit; # tmp
	deinit; # max
	deinit; # arg0
	ret;
}


function main { i64, ptr_argv } -> i64 {
	# ret_val_0 -> main ret_val_0
	# arg0 -> argc
	# arg1 -> *argv

	# x - 8
	# max - 16
	# i - 24
	# tmp - 32

	init_lany_type 		x, i64;
	init_lany_type 		max, i64;
	init_lany_type 		i, i64;
	init_lany_type 		tmp, i64;

	input_l64       x; 		# x := input
	mov_l64_imm     max, 0; 	# max := 0
	mov_l64_imm     i, 1; 	# i := 1

	# do-for (i < x; i++)
	label Loop;
		# tmp := collatz(i)
		init_lany_type 			col_ret_val, i64; 	# collatz(i) ret_val_0
		init_lany_type 			col_arg0, i64; 		# collatz(i) arg0

		mov_l64_l64 		col_arg0, i;		# arg0 := i
		call_func          	collatz;
		mov_l64_l64 		tmp, col_ret_val; 	# tmp := collatz(i)
		deinit; # col_ret_val

		# if tmp > max:
		cmpGt_l64_l64       	tmp, max;
		jmpIfNot_label  	EndIF;
			mov_l64_l64    	max, tmp; 	# max := tmp

		label EndIF;

		add_l64_imm      	i, 1; 		# i := i + 1

		# if x > i : end
		cmpGt_l64_l64     	x, i;
		jmpIf_label   	Loop;

	output_l64      max;

	deinit; # tmp
	deinit;	# i
	deinit;	# max
	deinit;	# x
	deinit; # *argv
	deinit; # argc
	ret;
}
