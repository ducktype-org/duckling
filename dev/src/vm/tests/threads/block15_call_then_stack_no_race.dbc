# The race-free twin of block15_call_then_stack_race.dbc: the child is joined before main calls
# the non-void function and writes the shared stack variable, so the write is ordered after the
# child's and Fast Track must not report a race. A shadow head that drifted after the call would
# show up here as a false positive.

type pointer: ptr_i64 i64

global_data g_stack_ptr ptr_i64 {}

function seven {} -> { i64 } {
    mov_p64_imm ret0, 7;
    ret;
}

function child_thread {} -> {} {
    init_pany_type val1, i64;
    mov_p64_imm val1, 42;

    init_pany_type local_stack_ptr, ptr_i64;
    mov_pptr_pptr local_stack_ptr, g_stack_ptr;
    store_pptr_pany local_stack_ptr, val1;

    deinit; # local_stack_ptr
    deinit; # val1
    ret;
}

function main { i64, ptr_argv } -> { i64 } {
    init_pany_type stack_var, i64;
    init_pany_type stack_ptr, ptr_i64;
    ref_pptr_pany stack_ptr, stack_var;
    mov_pptr_pptr g_stack_ptr, stack_ptr;

    init_pany_type thread_id, i64;
    set_threadctx child_thread;
    call_builtinfunc builtin_start_thread;

    init_pany_type join_ret, i64;
    init_pany_type join_id, i64;
    mov_p64_p64 join_id, thread_id;
    call_builtinfunc builtin_join_thread;

    # The non-void call, then the write: both after the join, so no race.
    init_pany_type seven_ret, i64;
    call_func seven;

    init_pany_type temp, i64;
    mov_p64_p64 temp, seven_ret;
    store_pptr_pany stack_ptr, temp;

    deinit; # temp
    deinit; # seven_ret
    deinit; # join_id
    deinit; # join_ret
    deinit; # thread_id
    deinit; # stack_ptr
    deinit; # stack_var
    ret;
}
