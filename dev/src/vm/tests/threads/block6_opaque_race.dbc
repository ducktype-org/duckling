type opaque: OpaqueType 16
type pointer: ptr_OpaqueType OpaqueType
type pointer: ptr_i64 i64

global_data g_opaque_ptr ptr_OpaqueType {};

function child_thread {} -> {} {
    init_pany_type local_opaque_ptr, ptr_OpaqueType;
    mov_pptr_pptr local_opaque_ptr, g_opaque_ptr;

    # Exposes store_pptr_bany tracking gap for opaque values
    init_pany_type temp, OpaqueType;
    store_pptr_pany local_opaque_ptr, temp;

    deinit;
    ret;
}

function main { i64, ptr_argv } -> { i64 } {
    init_pany_type local_opaque, OpaqueType;
    init_pany_type opaque_ptr, ptr_OpaqueType;
    ref_pptr_pany opaque_ptr, local_opaque;
    mov_pptr_pptr g_opaque_ptr, opaque_ptr;

    init_pany_type thread_id, i64;
    set_threadctx child_thread;
    call_builtinfunc builtin_start_thread;

    # Concurrently copy opaque value blocks (exposes mov_popq_popq gap)
    init_pany_type main_temp, OpaqueType;
    mov_popq_popq local_opaque, main_temp;
    ext_imm 16;

    init_pany_type join_ret, i64;
    init_pany_type join_id, i64;
    mov_p64_p64 join_id, thread_id;
    call_builtinfunc builtin_join_thread;

    cmpLt_p64_imm join_ret, 0;
    jmpIf_label PanicLabel;

    deinit; # join_id
    deinit; # join_ret
    deinit; # thread_id
    deinit; # local_opaque
    ret;

    label PanicLabel;
    init_pany_type zero, i64;
    mov_p64_imm zero, 0;
    div_p64_p64 thread_id, zero;
    deinit; # join_id
    deinit; # join_ret
    deinit; # thread_id
    deinit; # local_opaque
    ret;
}
