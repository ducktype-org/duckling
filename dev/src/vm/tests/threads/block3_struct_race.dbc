type data: SimpleStruct {
    f1: i64,
    f2: i64
}

type pointer: ptr_SimpleStruct SimpleStruct
type pointer: ptr_i64 i64

global_data g_struct_ptr ptr_SimpleStruct {};

function child_thread {} -> {} {
    init_pany_type local_struct_ptr, ptr_SimpleStruct;
    mov_pptr_pptr local_struct_ptr, g_struct_ptr;

    init_pany_type field_ptr, ptr_i64;
    structLea_pptr_pptr_field field_ptr, local_struct_ptr, SimpleStruct.f1;
    
    init_pany_type val, i64;
    mov_p64_imm val, 42;
    store_pptr_pany field_ptr, val;

    deinit;
    ret;
}

function main { i64, ptr_argv } -> { i64 } {
    init_pany_type local_struct, SimpleStruct;
    init_pany_type struct_ptr, ptr_SimpleStruct;
    ref_pptr_pany struct_ptr, local_struct;
    mov_pptr_pptr g_struct_ptr, struct_ptr;

    init_pany_type thread_id, i64;
    set_threadctx child_thread;
    call_builtinfunc builtin_start_thread;

    init_pany_type val2, i64;
    mov_p64_imm val2, 100;
    structStore_pste_pany_field local_struct, val2, SimpleStruct.f1;

    init_pany_type join_ret, i64;
    init_pany_type join_id, i64;
    mov_p64_p64 join_id, thread_id;
    call_builtinfunc builtin_join_thread;

    cmpLt_p64_imm join_ret, 0;
    jmpIf_label PanicLabel;

    deinit; # join_id
    deinit; # join_ret
    deinit; # thread_id
    deinit; # local_struct
    ret;

    label PanicLabel;
    init_pany_type zero, i64;
    mov_p64_imm zero, 0;
    div_p64_p64 thread_id, zero;
    deinit; # join_id
    deinit; # join_ret
    deinit; # thread_id
    deinit; # local_struct
    ret;
}
