global_data m1 mutex {};
global_data m2 mutex {};

function threadA {} -> void {
    # Lock m1
    init_lany_type      local_m1, mutex;
    mov_lopq_gopq       local_m1, m1;
    call_builtinfunc    builtin_lock_mutex;

    # Wait for thread B to lock m2
    init_lany_type      i, i64;
    mov_l64_imm         i, 10000000;
    label LoopA;
        sub_l64_imm     i, 1;
        cmpGt_l64_imm   i, 0;
        jmpIf_label     LoopA;

    # Try to lock m2 (Will block here)
    init_lany_type      local_m2, mutex;
    mov_lopq_gopq       local_m2, m2;
    call_builtinfunc    builtin_lock_mutex;

    # Unlock (Deadlock means we never get here)
    init_lany_type      unlock_m2, mutex;
    mov_lopq_gopq       unlock_m2, m2;
    call_builtinfunc    builtin_unlock_mutex;

    init_lany_type      unlock_m1, mutex;
    mov_lopq_gopq       unlock_m1, m1;
    call_builtinfunc    builtin_unlock_mutex;

    ret;
}

function threadB {} -> void {
    # Lock m2
    init_lany_type      local_m2, mutex;
    mov_lopq_gopq       local_m2, m2;
    call_builtinfunc    builtin_lock_mutex;

    # Wait for thread A to lock m1
    init_lany_type      j, i64;
    mov_l64_imm         j, 10000000;
    label LoopB;
        sub_l64_imm     j, 1;
        cmpGt_l64_imm   j, 0;
        jmpIf_label     LoopB;

    # Try to lock m1 (Will block here)
    init_lany_type      local_m1, mutex;
    mov_lopq_gopq       local_m1, m1;
    call_builtinfunc    builtin_lock_mutex;

    # Unlock
    init_lany_type      unlock_m1, mutex;
    mov_lopq_gopq       unlock_m1, m1;
    call_builtinfunc    builtin_unlock_mutex;

    init_lany_type      unlock_m2, mutex;
    mov_lopq_gopq       unlock_m2, m2;
    call_builtinfunc    builtin_unlock_mutex;

    ret;
}

function main { i64, ptr_argv } -> i64 {
    # Initialize global mutexes
    init_lany_type      init_m1, mutex;
    call_builtinfunc    builtin_create_mutex;
    mov_gopq_lopq       m1, init_m1;

    init_lany_type      init_m2, mutex;
    call_builtinfunc    builtin_create_mutex;
    mov_gopq_lopq       m2, init_m2;

    # Start Thread A
    init_lany_type      idA, i64;
    set_threadctx       threadA;
    call_builtinfunc    builtin_start_thread;

    # Start Thread B
    init_lany_type      idB, i64;
    set_threadctx       threadB;
    call_builtinfunc    builtin_start_thread;

    # Join threads
    init_lany_type      retA, i64;
    init_lany_type      joinA, i64;
    mov_l64_l64         joinA, idA;
    call_builtinfunc    builtin_join_thread;

    init_lany_type      retB, i64;
    init_lany_type      joinB, i64;
    mov_l64_l64         joinB, idB;
    call_builtinfunc    builtin_join_thread;

    ret;
}
