type variant: VarType { i64, i32 }
type pointer: ptr_VarType VarType
type pointer: ptr_i64 i64

global_data g_var_ptr ptr_VarType {};

function child_thread {} -> {} {
    init_pany_type local_var_ptr, ptr_VarType;
    mov_pptr_pptr local_var_ptr, g_var_ptr;

    init_pany_type val_ptr, ptr_i64;
    variantGetInner_pptr_pptr_type val_ptr, local_var_ptr, i64;

    init_pany_type val, i64;
    mov_p64_imm val, 42;
    store_pptr_pany val_ptr, val;

    deinit;
    ret;
}

function main { i64, ptr_argv } -> { i64 } {
    init_pany_type local_var, VarType;
    init_pany_type var_ptr, ptr_VarType;
    ref_pptr_pany var_ptr, local_var;
    mov_pptr_pptr g_var_ptr, var_ptr;

    variantSetInner_pvnt_type local_var, i64;

    init_pany_type thread_id, i64;
    set_threadctx child_thread;
    call_builtinfunc builtin_start_thread;

    variantSetInner_pvnt_type local_var, i64;

    init_pany_type join_ret, i64;
    init_pany_type join_id, i64;
    mov_p64_p64 join_id, thread_id;
    call_builtinfunc builtin_join_thread;

    cmpLt_p64_imm join_ret, 0;
    jmpIf_label PanicLabel;

    deinit; # join_id
    deinit; # join_ret
    deinit; # thread_id
    deinit; # local_var
    ret;

    label PanicLabel;
    init_pany_type zero, i64;
    mov_p64_imm zero, 0;
    div_p64_p64 thread_id, zero;
    deinit; # join_id
    deinit; # join_ret
    deinit; # thread_id
    deinit; # local_var
    ret;
}
