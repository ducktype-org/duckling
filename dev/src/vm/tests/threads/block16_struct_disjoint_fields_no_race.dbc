# Two threads write different fields of one heap struct through pointers. The field's byte
# offset has to reach the shadow check (`ft_structWrite` reads the same `ext_field` as the data
# op), or both writes land on the shadow entry of the first field and a race-free program is
# reported as racy.

type data: Pair {
    f1: i64,
    f2: i64
}

type pointer: ptr_Pair Pair

global_data g_pair_ptr ptr_Pair {}

function child_thread {} -> {} {
    init_pany_type local_ptr, ptr_Pair;
    mov_pptr_pptr local_ptr, g_pair_ptr;

    init_pany_type val, i64;
    mov_p64_imm val, 42;
    structStore_pptr_pany_field local_ptr, val, Pair.f2;

    deinit; # val
    deinit; # local_ptr
    ret;
}

function main { i64, ptr_argv } -> { i64 } {
    init_pany_type pair_ptr, ptr_Pair;
    alloc_pptr_type pair_ptr, Pair;
    mov_pptr_pptr g_pair_ptr, pair_ptr;

    init_pany_type thread_id, i64;
    set_threadctx child_thread;
    call_builtinfunc builtin_start_thread;

    # Concurrent with the child, but on the other field: no race.
    init_pany_type val, i64;
    mov_p64_imm val, 100;
    structStore_pptr_pany_field pair_ptr, val, Pair.f1;

    init_pany_type join_ret, i64;
    init_pany_type join_id, i64;
    mov_p64_p64 join_id, thread_id;
    call_builtinfunc builtin_join_thread;

    init_pany_type read_back, i64;
    structLoad_pany_pptr_field read_back, pair_ptr, Pair.f2;

    free_pptr pair_ptr;
    ret;
}
