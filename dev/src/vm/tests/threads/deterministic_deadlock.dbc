# Deterministic deadlock test.
#
# Scenario:
# - threadA locks m1, then waits on a barrier while still holding m1.
# - threadB locks m2, then waits on the same barrier while still holding m2.
# - main waits until both workers have reached the barrier, then releases them.
# - after release, threadA tries to lock m2 and threadB tries to lock m1.
#
# This should always produce a deadlock if deadlock detection does not abort first,
# because both threads are guaranteed to hold their first mutex before attempting the second.

global_data m1 mutex {};
global_data m2 mutex {};
global_data gate mutex {};
global_data cv condition_variable {};
global_data ready_count i64 {};
global_data phase i64 {};

function threadA {} -> void {
    init_lany_type      lock_m1, mutex;
    mov_lopq_gopq       lock_m1, m1;
    call_builtinfunc    builtin_lock_mutex;

    init_lany_type      gate_lock, mutex;
    mov_lopq_gopq       gate_lock, gate;
    call_builtinfunc    builtin_lock_mutex;

    init_lany_type      rc, i64;
    mov_l64_g64         rc, ready_count;
    add_l64_imm         rc, 1;
    mov_g64_l64         ready_count, rc;

    init_lany_type      cv_ready, condition_variable;
    mov_lopq_gopq       cv_ready, cv;
    call_builtinfunc    builtin_notify_all_cv;

    label WaitReleaseAInit;
        init_lany_type  p, i64;
        init_lany_type  wait_cv, condition_variable;
        init_lany_type  wait_gate, mutex;

    label WaitReleaseA;
        mov_l64_g64     p, phase;
        cmpEq_l64_imm   p, 1;
        jmpIf_label     ReleaseA;

        mov_lopq_gopq   wait_cv, cv;
        mov_lopq_gopq   wait_gate, gate;
        call_builtinfunc builtin_wait_cv;
        deinit;
        jmp_label       WaitReleaseAInit;

    label ReleaseA;
    deinit;
    deinit;
    deinit;

    init_lany_type      unlock_gate_a, mutex;
    mov_lopq_gopq       unlock_gate_a, gate;
    call_builtinfunc    builtin_unlock_mutex;

    init_lany_type      lock_m2, mutex;
    mov_lopq_gopq       lock_m2, m2;
    call_builtinfunc    builtin_lock_mutex;

    init_lany_type      unlock_m2, mutex;
    mov_lopq_gopq       unlock_m2, m2;
    call_builtinfunc    builtin_unlock_mutex;

    init_lany_type      unlock_m1, mutex;
    mov_lopq_gopq       unlock_m1, m1;
    call_builtinfunc    builtin_unlock_mutex;

    ret;
}

function threadB {} -> void {
    init_lany_type      lock_m2, mutex;
    mov_lopq_gopq       lock_m2, m2;
    call_builtinfunc    builtin_lock_mutex;

    init_lany_type      gate_lock, mutex;
    mov_lopq_gopq       gate_lock, gate;
    call_builtinfunc    builtin_lock_mutex;

    init_lany_type      rc, i64;
    mov_l64_g64         rc, ready_count;
    add_l64_imm         rc, 1;
    mov_g64_l64         ready_count, rc;

    init_lany_type      cv_ready, condition_variable;
    mov_lopq_gopq       cv_ready, cv;
    call_builtinfunc    builtin_notify_all_cv;

    label WaitReleaseBInit;
        init_lany_type  p, i64;
        init_lany_type  wait_cv, condition_variable;
        init_lany_type  wait_gate, mutex;

    label WaitReleaseB;
        mov_l64_g64     p, phase;
        cmpEq_l64_imm   p, 1;
        jmpIf_label     ReleaseB;

        mov_lopq_gopq   wait_cv, cv;
        mov_lopq_gopq   wait_gate, gate;
        call_builtinfunc builtin_wait_cv;
        deinit;
        jmp_label       WaitReleaseBInit;

    label ReleaseB;
    deinit;
    deinit;
    deinit;

    init_lany_type      unlock_gate_b, mutex;
    mov_lopq_gopq       unlock_gate_b, gate;
    call_builtinfunc    builtin_unlock_mutex;

    init_lany_type      lock_m1, mutex;
    mov_lopq_gopq       lock_m1, m1;
    call_builtinfunc    builtin_lock_mutex;

    init_lany_type      unlock_m1, mutex;
    mov_lopq_gopq       unlock_m1, m1;
    call_builtinfunc    builtin_unlock_mutex;

    init_lany_type      unlock_m2, mutex;
    mov_lopq_gopq       unlock_m2, m2;
    call_builtinfunc    builtin_unlock_mutex;

    ret;
}

function main { i64, ptr_argv } -> i64 {
    init_lany_type      init_m1, mutex;
    call_builtinfunc    builtin_create_mutex;
    mov_gopq_lopq       m1, init_m1;

    init_lany_type      init_m2, mutex;
    call_builtinfunc    builtin_create_mutex;
    mov_gopq_lopq       m2, init_m2;

    init_lany_type      init_gate, mutex;
    call_builtinfunc    builtin_create_mutex;
    mov_gopq_lopq       gate, init_gate;

    init_lany_type      init_cv, condition_variable;
    call_builtinfunc    builtin_create_cv;
    mov_gopq_lopq       cv, init_cv;

    mov_g64_imm         ready_count, 0;
    mov_g64_imm         phase, 0;

    init_lany_type      t1_id, i64;
    set_threadctx       threadA;
    call_builtinfunc    builtin_start_thread;

    init_lany_type      t2_id, i64;
    set_threadctx       threadB;
    call_builtinfunc    builtin_start_thread;

    init_lany_type      main_gate_lock, mutex;
    mov_lopq_gopq       main_gate_lock, gate;
    call_builtinfunc    builtin_lock_mutex;

    label WaitReadyInit;
        init_lany_type  r, i64;
        init_lany_type  wait_ready_cv, condition_variable;
        init_lany_type  wait_ready_gate, mutex;

    label WaitReady;
        mov_l64_g64     r, ready_count;
        cmpEq_l64_imm   r, 2;
        jmpIf_label     ReleaseWorkers;

        mov_lopq_gopq   wait_ready_cv, cv;
        mov_lopq_gopq   wait_ready_gate, gate;
        call_builtinfunc builtin_wait_cv;
        deinit;
        jmp_label       WaitReadyInit;

    label ReleaseWorkers;
    deinit;
    deinit;
    deinit;

    mov_g64_imm         phase, 1;

    init_lany_type      cv_release, condition_variable;
    mov_lopq_gopq       cv_release, cv;
    call_builtinfunc    builtin_notify_all_cv;

    init_lany_type      unlock_gate_main, mutex;
    mov_lopq_gopq       unlock_gate_main, gate;
    call_builtinfunc    builtin_unlock_mutex;

    # Keep main alive briefly so worker threads can reach the 2-thread deadlock,
    # but avoid an infinite loop that may block stop/kill.
    init_lany_type      spin, i64;
    mov_l64_imm         spin, 3000000;

    label KeepAliveWindow;
        sub_l64_imm     spin, 1;
        cmpGt_l64_imm   spin, 0;
        jmpIf_label     KeepAliveWindow;

    ret;
}
