# Dynamic table realloc no-race test.
#
# Pitfall being tested: after dynTableReAlloc, the existing shadow entries
# for old elements must be preserved — specifically the happens-before
# established by a join. A write after join+realloc must not produce a
# false positive.
#
# If ft_dynTableReAlloc incorrectly wipes shadow entries for existing
# elements, the post-join write below would appear to race with the
# child's earlier write (because the join's HB would be forgotten).
#
# Timeline:
#   main:  create table size 1
#   spawn child
#   child: write element 0        (shadow: last_write = child@1)
#   main:  join child             (main.vc[child] >= child's final clock)
#   main:  realloc to size 3      (shadow for element 0 must survive)
#   main:  write element 0        (last_write child@1 <= main.vc -> no race)

type dynamic_table: dtablei64 i64
type pointer: ptr_dtablei64 dtablei64

global_data g_tbl_ptr ptr_dtablei64 {}

function child_thread {} -> {} {
    init_pany_type local_ptr, ptr_dtablei64;
    mov_pptr_pptr local_ptr, g_tbl_ptr;

    init_pany_type idx, i64;
    mov_p64_imm idx, 0;
    init_pany_type val, i64;
    mov_p64_imm val, 55;
    dynTableStore_pptr_pany_p64 local_ptr, val, idx;

    deinit;
    ret;
}

function main { i64, ptr_argv } -> { i64 } {
    init_pany_type tbl_ptr, ptr_dtablei64;

    # Initial allocation: size 1
    init_pany_type size1, i64;
    mov_p64_imm size1, 1;
    dynTableReAlloc_pptr_type_p64 tbl_ptr, dtablei64, size1;

    mov_pptr_pptr g_tbl_ptr, tbl_ptr;

    init_pany_type thread_id, i64;
    set_threadctx child_thread;
    call_builtinfunc builtin_start_thread;

    # Join child before realloc — establishes happens-before
    init_pany_type join_ret, i64;
    init_pany_type join_id, i64;
    mov_p64_p64 join_id, thread_id;
    call_builtinfunc builtin_join_thread;

    # Grow the table — shadow for element 0 must be preserved
    init_pany_type size3, i64;
    mov_p64_imm size3, 3;
    dynTableReAlloc_pptr_type_p64 tbl_ptr, dtablei64, size3;

    # Write element 0 after join+realloc — no race expected
    init_pany_type idx, i64;
    mov_p64_imm idx, 0;
    init_pany_type val, i64;
    mov_p64_imm val, 99;
    dynTableStore_pptr_pany_p64 tbl_ptr, val, idx;

    deinit; # join_id
    deinit; # join_ret
    deinit; # thread_id
    free_pptr tbl_ptr;
    deinit; # tbl_ptr
    ret;
}
