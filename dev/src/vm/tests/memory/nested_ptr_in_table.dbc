# Allocate a heap i64, store a pointer to it inside a struct that is an element
# of a fixed-size table. When the table goes out of scope, the destructor must
# recurse into the struct to find and decrement the nested pointer's refcount.
# Before the fix for #3225, iterateOverDataAndExecute was one level deep and
# would skip the pointer nested inside the struct, leaking the refcount.

type pointer: ptr_i64 i64
type data: Holder {
    val: i64,
    ptr: ptr_i64
}
type fixed_size_table: Table Holder 1
type pointer: TablePtr Table
type pointer: HolderPtr Holder
type pointer: ptr_ptr_i64 ptr_i64

function main { i64, ptr_argv } -> { i64 } {
    # Allocate a heap i64.
    init_pany_type heap_val, i64;
    init_pany_type heap_ptr, ptr_i64;
    alloc_pptr_type heap_ptr, i64;
    mov_p64_imm heap_val, 42;
    store_pptr_pany heap_ptr, heap_val;

    # Create a fixed-size table (local -- auto-destroyed on return).
    init_pany_type table, Table;

    # Get pointer to table element 0.
    init_pany_type table_ptr, TablePtr;
    ref_pptr_pany table_ptr, table;
    init_pany_type holder_ptr, HolderPtr;
    fixedSizeTableLea_pptr_pptr_p64 holder_ptr, table_ptr, ret0;

    # Store the heap pointer into holder.ptr.
    init_pany_type ptr_field, ptr_ptr_i64;
    structLea_pptr_pptr_field ptr_field, holder_ptr, Holder.ptr;
    store_pptr_pany ptr_field, heap_ptr;

    # Clear the local reference -- the table element now owns the only reference
    # to the heap block.
    setNull_pptr heap_ptr;

    # Return. The table goes out of scope; its destructor must recurse into
    # Holder.ptr and decrement the heap block's refcount.
    ret;
}
