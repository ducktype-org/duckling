global_data a i64 {
    constructor: a_ctor,
    destructor: a_dtor
}

global_data b i64 {
    constructor: b_ctor,
    destructor: b_dtor
}

function a_ctor {} -> {} {
    mov_p64_imm a, 1;
    ret;
}

function b_ctor {} -> {} {
    mov_p64_imm b, 2;
    ret;
}

function b_dtor {} -> {} {
    output_p64 b;
    ret;
}

function a_dtor {} -> {} {
    call_builtinfunc abort;
    ret;
}

function main { i64, ptr_argv } -> { i64 } {
    mov_p64_imm ret0, 0;
    ret;
}
