global_data g i64 {
    constructor: g_ctor,
    destructor: g_dtor
}

function g_ctor {} -> {} {
    mov_p64_imm g, 5;
    ret;
}

# Decomposing a null pointer fails at runtime, so the destructor never reaches its `ret`. The run
# itself completed, so the deinit is legal, but it cannot finish.
function g_dtor {} -> {} {
    init_pany_type id, i64;
    init_pany_type off, i64;
    init_pany_type np, ptr_i64;
    setNull_pptr np;
    ptrParts_p64_p64_pptr id, off, np;

    deinit; # np
    deinit; # off
    deinit; # id
    ret;
}

function main { i64, ptr_argv } -> { i64 } {
    mov_p64_p64 ret0, g;
    ret;
}
