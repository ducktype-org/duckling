type pointer: pointer_I1 I1
type pointer: pointer_I2 I2
type pointer: pointer_parent Parent
type pointer: pointer_child Child

type fun: method_I1_int {pointer_I1} i64

type fun: method_parent_int {pointer_parent, i64} void

type fun: method_child_int {pointer_child, i64} void


function Child_cry_impl {pointer_child, i64} -> void {
    ret;
}

function Parent_getAge_impl {pointer_parent, i64} -> void {
    init_pany_type age, i64;
    mov_p64_imm age, 50;
    output_p64 age;
    deinit; # age
    deinit; # arg0
    ret;
}

function Child_getAge_impl {pointer_child, i64} -> void {
    init_pany_type age, i64;
    mov_p64_imm age, 15;
    output_p64 age;
    deinit; # age
    deinit; # arg0
    ret;
}

function I1_foo_impl {pointer_I1} -> i64  {
    init_pany_type x, i64;
    mov_p64_imm x, 0;
    output_p64 x;
    deinit;
    ret;
}

function Child_I1_impl {pointer_child} -> i64 {
    init_pany_type x, i64;
    mov_p64_imm x, 1;
    output_p64 x;
    deinit;
    ret;
}

type data: POD {
	abc: i64,
}

type interface: I1 {
    virtual_methods: {
        foo: method_I1_int,
        bar: method_I1_int,
    };
    implementations: {
        foo: I1_foo_impl,
    };
}

type interface: I2 {
}

type class: Parent {
    fields: {
        x: i64,
    };
    virtual_methods: {
        getAge: method_parent_int,
    };
    implementations: {
        getAge: Parent_getAge_impl, # Implementation of age for Parent.
    };
}

type class: Child {
    extends: Parent;
    abstract: false;  # This is the case by default.
    implements: {I1, I2};
    fields: {
        y: i64,
    };
    virtual_methods: {
        cry: method_child_int,
    };
    implementations: { # If Child is a concrete class, all methods have to be implemented.
        getAge: Child_getAge_impl, # Implementation of getAge for child.
        bar: Child_I1_impl,
        cry: Child_cry_impl,
    };
}

type class: PietMondrian {
	abstract: true;
}

function main { i64, ptr_argv } -> i64 {
    ret;
}
