type pointer: pointer_I1 I1
type pointer: pointer_Parent Parent
type pointer: pointer_Child Child

type fun: method_I1_void {pointer_I1} void
type fun: method_parent_void {pointer_Parent} void
type fun: method_child_void {pointer_Child} void

type interface: I1 {
    virtual_methods: { 
        foo: method_I1_void, 
        bar: method_I1_void,
    };
    implementations: { 
        foo: I1_foo_default_impl_type,
    };
}

type class: Parent {
    virtual_methods: { 
        getAge: method_parent_void,
    };
    implementations: {
        getAge: Parent_getAge_impl_type, 
    };
}

type class: Child {
    extends: Parent;
    abstract: false;
    implements: {I1};
    virtual_methods: { 
        cry: method_child_void,
    };
    implementations: {
        getAge: Child_getAge_impl_type,
        bar: Child_I1_bar_impl_type, 
        cry: Child_cry_impl_type,
    };
}

# ============ METHODS IMPLEMENTATION ============ 
function I1_foo_default_impl_type {pointer_I1} -> void {
    init_pany_type res, i64; mov_p64_imm res, 11; output_p64 res; deinit; deinit; ret;
}
function Child_I1_bar_impl_type {pointer_Child} -> void {
    init_pany_type res, i64; mov_p64_imm res, 22; output_p64 res; deinit; deinit; ret;
}
function Parent_getAge_impl_type {pointer_Parent} -> void {
    init_pany_type res, i64; mov_p64_imm res, 33; output_p64 res; deinit; ret;
}
function Child_getAge_impl_type {pointer_Child} -> void {
    init_pany_type res, i64; mov_p64_imm res, 44; output_p64 res; deinit; deinit; ret;
}
function Child_cry_impl_type {pointer_Child} -> void {
    init_pany_type res, i64; mov_p64_imm res, 55; output_p64 res; deinit; deinit; ret;
}

function main { i64, ptr_argv } -> i64 {
    init_pany_type ptr_i1, pointer_I1;
    init_pany_type ptr_parent, pointer_Parent;
    init_pany_type ptr_child, pointer_Child;

    init_pany_type actual_child, pointer_Child;

    # --- Object Child, pointer I1* ---
    alloc_pptr_type actual_child, Child;
    setVTable_pptr_type actual_child, Child;
    upcast_pptr_pptr ptr_i1, actual_child;

    init_pany_type temp_this_i1_foo, pointer_I1;
    mov_pptr_pptr temp_this_i1_foo, ptr_i1;
    virtual_call_pptr_method ptr_i1, foo; # Expected: 11

    init_pany_type temp_this_i1_bar, pointer_I1;
    mov_pptr_pptr temp_this_i1_bar, ptr_i1;
    virtual_call_pptr_method ptr_i1, bar; # Expected: 22

    # --- Same Child object, pointer Parent* ---
    upcast_pptr_pptr ptr_parent, actual_child;

    init_pany_type temp_ptr_parent, pointer_Parent;
    mov_pptr_pptr temp_ptr_parent, ptr_parent ;
    virtual_call_pptr_method ptr_parent, getAge; # Expected: 44

    # --- Same Child object, pointer Child* ---
    mov_pptr_pptr ptr_child, actual_child;
    init_pany_type temp_this_child_cry, pointer_Child;
    mov_pptr_pptr temp_this_child_cry, ptr_child;
    virtual_call_pptr_method ptr_child, cry; # Expected: 55

    free_pptr actual_child;

    deinit;
    deinit;
    deinit;
    deinit;
    ret;
}