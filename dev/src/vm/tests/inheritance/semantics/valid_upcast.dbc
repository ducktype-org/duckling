type class: Animal {
	abstract: true;
}
type class: Dog {
	extends: Animal;
}
type class: Cat {
	extends: Animal;
}

type pointer: AnimalPtr Animal
type pointer: DogPtr Dog

function main { i64, ptr_argv } -> i64 {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv
	init_pany_type dog, DogPtr;
	init_pany_type animal, AnimalPtr;
	alloc_pptr_type dog, Dog;
	setVTable_pptr_type dog, Dog;
	upcast_pptr_pptr animal, dog;  # animal := static_cast<AnimalPtr>(dog)

	free_pptr dog;
	
	ret;
}

