type class: Animal {
	abstract: true;
}
type class: Dog {
	extends: Animal;
}
type class: Cat {
	extends: Animal;
}

type pointer: AnimalPtr Animal
type pointer: DogPtr Dog

function main { i64, ptr_argv } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv
	init_lany_type dog, DogPtr;
	init_lany_type animal, AnimalPtr;
	alloc_lptr_type dog, Dog;
	setVTable_lptr_type dog, Dog;
	upcast_lptr_lptr animal, dog;  # animal := static_cast<AnimalPtr>(dog)

	free_lptr dog;
	
	ret;
}

