type pointer: pointer_Child Child
type fun: method_child_void {pointer_Child} void

type class: Child {
    virtual_methods: { 
        cry: method_child_void,
    };
    implementations: {
        cry: Child_cry_impl_type,
    };
}

function Child_cry_impl_type {pointer_Child} -> void {
    init_pany_type res, i64; mov_p64_imm res, 55; output_p64 res; deinit; deinit; ret;
}

function main { i64, ptr_argv } -> i64 {
    init_pany_type fake_child, ptr_i64;
    init_pany_type actual_child, pointer_Child;
    alloc_pptr_type actual_child, Child;
    setVTable_pptr_type actual_child, Child;

    init_pany_type temp_child, pointer_Child;
    mov_pptr_pptr temp_child, actual_child;
    virtual_call_pptr_method fake_child, cry; # fake_child is fakeing to be a child.

    deinit;
    deinit;
    deinit;
    ret;
}