type class: Animal {
	abstract: true;
}
type class: Dog {
	extends: Animal;
}
type class: Cat {
	extends: Animal;
}

type pointer: AnimalPtr Animal
type pointer: DogPtr Dog
type pointer: CatPtr Cat

function main { i64, ptr_argv } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv
	init_pany_type animal, AnimalPtr;
	init_pany_type cat, CatPtr;
	init_pany_type dog, DogPtr;
	init_pany_type x, i64;

	init_pany_type helper_dog, DogPtr;
	alloc_pptr_type helper_dog, Dog;
	setVTable_pptr_type helper_dog, Dog;
	upcast_pptr_pptr animal, helper_dog;

	downcast_pptr_pptr cat, animal;  # cat := static_cast<CatPtr>(animal)
	cmpNull_pptr cat;  # flag := cat != nullptr

	# Check if succeeded
	jmpIfNot_label notCat;
		add_p64_imm x, 10;
	label notCat;

	downcast_pptr_pptr dog, animal;  # dog := static_cast<DogPtr>(animal)
	cmpNull_pptr dog;  # flag := dog != nullptr

	# Check if succeeded
	jmpIfNot_label notDog;
		add_p64_imm x, 1;
	label notDog;

	output_p64 x;

	free_pptr helper_dog;

	ret;
}
