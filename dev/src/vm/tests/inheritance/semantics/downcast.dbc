type class: Animal {
	abstract: true;
}
type class: Dog {
	extends: Animal;
}
type class: Cat {
	extends: Animal;
}

type pointer: AnimalPtr Animal
type pointer: DogPtr Dog
type pointer: CatPtr Cat

function main { i64, ptr_argv } -> { i64 } {
	# ret_val_0 -> main ret_val_0
	# arg0 -> argc
	# arg1 -> *argv
	init_lany_type animal, AnimalPtr;
	init_lany_type cat, CatPtr;
	init_lany_type dog, DogPtr;
	init_lany_type x, i64;

	init_lany_type helper_dog, DogPtr;
	alloc_lptr_type helper_dog, Dog;
	setVTable_lptr_type helper_dog, Dog;
	upcast_lptr_lptr animal, helper_dog;

	downcast_lptr_lptr cat, animal;  # cat := static_cast<CatPtr>(animal)
	cmpNull_lptr cat;  # flag := cat != nullptr

	# Check if succeeded
	jmpIfNot_label notCat;
		add_l64_imm x, 10;
	label notCat;

	downcast_lptr_lptr dog, animal;  # dog := static_cast<DogPtr>(animal)
	cmpNull_lptr dog;  # flag := dog != nullptr

	# Check if succeeded
	jmpIfNot_label notDog;
		add_l64_imm x, 1;
	label notDog;

	output_l64 x;

	free_lptr helper_dog;

	ret;
}
