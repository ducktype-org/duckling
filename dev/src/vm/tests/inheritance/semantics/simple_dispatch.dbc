type pointer: pointer_A A
type fun: method_foo_void_A {pointer_A} void

function method_foo_void_impl_A {pointer_A} -> void {
    init_pany_type x, i64;
    mov_p64_imm x, 421;
    output_p64 x;
    deinit; # x
    deinit; # arg0
    ret;
}

type class: A {
    fields: {
        x: i64,
    };
    virtual_methods: {
        foo: method_foo_void_A,
    };
    implementations: {
        foo: method_foo_void_impl_A,
    };
}

function main { i64, ptr_argv } -> i64 {
    init_pany_type a_obj, pointer_A;
    alloc_pptr_type a_obj, A;
    setVTable_pptr_type a_obj, A;
    init_pany_type a_ptr, pointer_A;
    mov_pptr_pptr a_ptr, a_obj;
    virtual_call_pptr_method a_obj, foo;

    free_pptr a_obj;

    deinit; # a_obj
    ret;
}
