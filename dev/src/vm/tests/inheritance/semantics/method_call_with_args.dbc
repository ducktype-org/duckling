type pointer: pointer_A A
type fun: method_foo_int_int_A {pointer_A, i64, i64} i64

function method_foo_int_int_impl_A {pointer_A, i64, i64} -> i64 {
    mov_p64_p64 ret_val, arg1;
    add_p64_p64 ret_val, arg2;
    deinit; # arg2
    deinit; # arg1
    deinit; # arg0
    ret;
}

type class: A {
    fields: {
        x: i64,
    };
    virtual_methods: {
        foo: method_foo_int_int_A,
    };
    implementations: {
        foo: method_foo_int_int_impl_A,
    };
}

function main { i64, ptr_argv } -> i64 {
    init_pany_type a_obj, pointer_A;
    alloc_pptr_type a_obj, A;
    setVTable_pptr_type a_obj, A;
    
    init_pany_type ret, i64;

    init_pany_type a_ptr, pointer_A;
    mov_pptr_pptr a_ptr, a_obj;
    init_pany_type a0, i64;
    init_pany_type a1, i64;
    input_p64 a0;
    input_p64 a1;

    virtual_call_pptr_method a_obj, foo;

    output_p64 ret;

    free_pptr a_obj;

    deinit; # ret
    deinit; # a_obj
    ret;
}
