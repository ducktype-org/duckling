type pointer: pointer_Animal Animal
type pointer: pointer_Dog Dog

# ========== VIRTUAL METHOD DECLARATIONS ==============
type fun: method_toHumanYears {pointer_Animal} {}

# ============ CLASSES DEFINITIONS ============
type class: Animal {
    abstract: true;
    virtual_methods: {
        toHumanYears: method_toHumanYears,
    };
}

type class: Dog {
    abstract: false;
    extends: Animal;
    implementations: {
        toHumanYears: dog_year_to_human_years,
    };
}

type fixed_size_table: dog_table Dog 2
type pointer:          dog_table_ptr dog_table

# ============ METHODS IMPLEMENTATION ============

# Implementation for Dog.
function dog_year_to_human_years {pointer_Dog} -> {} {
    init_lany_type         call_res,      i64;
    init_lany_type         call_arg0,     i64;
    mov_l64_imm            call_arg0,       0;
    call_builtinfunc      builtin_output_i64;
    deinit;
    ret;
}

type variant: Dog_or_i64 {Dog, i64}

function main { i64, ptr_argv } -> { i64 } {
    init_lany_type              dog_or_i64, Dog_or_i64;
    variantSetInner_lvnt_type   dog_or_i64, Dog;

    init_lany_type              dog_ptr, pointer_Dog;
    variantGetInner_lptr_lvnt_type   dog_ptr, dog_or_i64, Dog;
    # unset vtable ptr: setVTable_lptr_type         dog_ptr, Dog;
    virtual_call_lptr_method    dog_ptr, toHumanYears;

    ret;
}
