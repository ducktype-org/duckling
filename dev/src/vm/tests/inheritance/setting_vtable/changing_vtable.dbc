type pointer: pointer_Animal Animal
type pointer: pointer_Dog Dog
type pointer: pointer_Chiuaua Chiuaua

# ========== VIRTUAL METHOD DECLARATIONS ==============
type fun: method_toHumanYears {pointer_Animal} void

# ============ CLASSES DEFINITIONS ============
type class: Animal {
    abstract: true;
    virtual_methods: {
        toHumanYears: method_toHumanYears,
    };
}

type class: Dog {
    abstract: false;
    extends: Animal;
    implementations: {
        toHumanYears: dog_year_to_human_years,
    };
}

type class: Chiuaua {
    abstract: false;
    extends: Dog;
    implementations: {
        toHumanYears: chiuaua_year_to_human_years,
    };
}


# ============ METHODS IMPLEMENTATION ============

# Implementation for Dog.
function dog_year_to_human_years {pointer_Dog} -> void {
    init_pany_type         call_res,      i64;
    init_pany_type         call_arg,      i64;
    mov_p64_imm            call_arg,        0;
    call_builtinfunc      builtin_output_i64;
    deinit;
    ret;
}

# Implementation for Chiuaua.
function chiuaua_year_to_human_years {pointer_Chiuaua} -> void {
    init_pany_type         call_res,      i64;
    init_pany_type         call_arg,      i64;
    mov_p64_imm            call_arg,        1;
    call_builtinfunc      builtin_output_i64;
    deinit;
    ret;
}

function main { i64, ptr_argv } -> i64 {
    init_pany_type  chiuaua_ptr, pointer_Chiuaua;
    alloc_pptr_type chiuaua_ptr, Chiuaua;
    setVTable_pptr_type  chiuaua_ptr, Chiuaua;

    init_pany_type temp1, pointer_Chiuaua;
    mov_pptr_pptr temp1, chiuaua_ptr;
    virtual_call_pptr_method  temp1, toHumanYears;

    init_pany_type  dog_ptr, pointer_Dog;
	upcast_pptr_pptr dog_ptr, chiuaua_ptr;

    setVTable_pptr_type  dog_ptr, Dog;
    virtual_call_pptr_method  dog_ptr, toHumanYears;

    free_pptr chiuaua_ptr;

    ret;
}
