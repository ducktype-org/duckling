type pointer: pointer_Animal Animal
type pointer: pointer_Dog Dog

# ========== VIRTUAL METHOD DECLARATIONS ==============
type fun: method_toHumanYears {pointer_Animal} {}

# ============ CLASSES DEFINITIONS ============
type class: Animal {
    abstract: true;
    virtual_methods: {
        toHumanYears: method_toHumanYears,
    };
}

type class: Dog {
    abstract: false;
    extends: Animal;
    implementations: {
        toHumanYears: dog_year_to_human_years,
    };
}

type fixed_size_table: dog_table Dog 2
type pointer:          dog_table_ptr dog_table

# ============ METHODS IMPLEMENTATION ============

# Implementation for Dog.
function dog_year_to_human_years {pointer_Dog} -> {} {
    init_pany_type         call_res,      i64;
    init_pany_type         call_arg0,     i64;
    mov_p64_imm            call_arg0,       0;
    call_builtinfunc      builtin_output_i64;
    deinit;
    ret;
}

function main { i64, ptr_argv } -> { i64 } {
    # Dog array[2];
    init_pany_type                  array, dog_table_ptr;
    alloc_pptr_type                 array, dog_table;

    # Dog* dog_ptr = &array[0]
    init_pany_type                  index, i64;
    mov_p64_imm                     index, 0;

    init_pany_type                  dog_ptr, pointer_Dog;
    fixedSizeTableLea_pptr_pptr_p64     dog_ptr, array, index;

    # dog_ptr->toHumanYears
    # unset vtable: setVTable_pptr_type dog_ptr, Dog;
    virtual_call_pptr_method dog_ptr, toHumanYears;

    ret;
}
