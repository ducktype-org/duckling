# Virtual method for bar() doesn't exist.
type pointer: pointer_A A
type fun: method_foo {pointer_A} void
function method_bar_impl {pointer_A} -> void {
    ret;
}

type class: A {
    virtual_methods: {
        foo: method_foo, 
    };
    implementations: {
        bar: method_bar_impl, 
    };
}
