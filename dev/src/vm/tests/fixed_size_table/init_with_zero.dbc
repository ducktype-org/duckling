type fixed_size_table: tablei64 i64 2
type pointer: ptr_tablei64 tablei64

function main { i64, ptr_argv } -> i64 {
	# ret_val_0 -> main ret_val_0
	# arg0 -> argc
	# arg1 -> *argv

	init_lany_type           x, i64;
	init_lany_type           i, i64;
	init_lany_type           y, i64;
	init_lany_type           t, ptr_tablei64;

	alloc_lptr_type     t, tablei64;

	# x := t[0]
	mov_l64_imm         		i, 0;
	fixedSizeTableLoad_lany_lptr_l64   x, t, i;

	mov_l64_l64         y, x;

	# x := t[1]
	mov_l64_imm         		i, 1;
	fixedSizeTableLoad_lany_lptr_l64   x, t, i;

	add_l64_l64         y, x;

	output_l64          y;

	free_lptr           t;

	deinit;
	deinit;
	deinit;
	deinit;
	deinit; # *argv
	deinit; # argc
	ret;
}
