type fixed_size_table: tablei64 i64 4
type pointer: ptr_tablei64 tablei64

function main { i64, ptr_argv } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv

	init_lany_type      x, i64;
	init_lany_type      i, i64;
	init_lany_type      arr_ptr, ptr_tablei64;

	alloc_lptr_type     arr_ptr, tablei64; # arr_ptr := alloc *int[]
	mov_l64_imm         i, 0;        # i := 0
	mov_l64_imm         x, 3;        # x := 3

	# t[i] := x (by i)
	fixedSizeTableStore_lptr_lany_l64  arr_ptr, x, i;       # t[i] := x

	mov_l64_imm         x, 5;        # x := 5

	fixedSizeTableLoad_lany_lptr_l64   ret0, arr_ptr, i;

	output_l64          i;

	free_lptr           arr_ptr;

	deinit;
	deinit;
	deinit;
	deinit; # *argv
	deinit; # argc
	ret;
}
