type fixed_size_table: tablei64 i64 4
type pointer: ptr_tablei64 tablei64

function main { i64, ptr_argv } -> i64 {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type      x, i64;
	init_pany_type      i, i64;
	init_pany_type      arr_ptr, ptr_tablei64;

	alloc_pptr_type     arr_ptr, tablei64; # arr_ptr := alloc *int[]
	mov_p64_imm         i, 0;        # i := 0
	mov_p64_imm         x, 3;        # x := 3

	# t[i] := x (by i)
	fixedSizeTableStore_pptr_pany_p64  arr_ptr, x, i;       # t[i] := x

	mov_p64_imm         x, 5;        # x := 5

	fixedSizeTableLoad_pany_pptr_p64   ret_val, arr_ptr, i;

	output_p64          i;

	free_pptr           arr_ptr;

	deinit;
	deinit;
	deinit;
	deinit; # *argv
	deinit; # argc
	ret;
}
