type pointer: LinkedList Node

type data: Node {
    head: i64,
    tail: LinkedList
}

function cons { i64, LinkedList } -> LinkedList {
    # ret_val_0: result
    # arg0: head
    # arg1: tail

    # using LinkedList = *Node

    # ret_val_0 = new Node()
    alloc_lptr_type ret_val_0, Node;

    structStore_lptr_lany_field ret_val_0, arg0, Node.head;

    structStore_lptr_lany_field ret_val_0, arg1, Node.tail;

    ret;
}

# OPTIMISED!!!
function tail {} -> LinkedList {
    structLoad_lany_lptr_field ret_val_0, ret_val_0, Node.tail;

    ret;
}

function print_list {LinkedList} -> void {
    # arg0: LinkedList

    cmpNull_lptr arg0;
    jmpIfNot_label non_empty;
    ret;
label non_empty;

    init_lany_type curr, i64;

    # curr = arg0->x
    structLoad_lany_lptr_field curr, arg0, Node.head;

    output_l64 curr;

    deinit;  # curr
    call_func tail;

    ret_tailcall_func print_list;
}

function free_list {LinkedList} -> void {
    # arg0: LinkedList

    cmpNull_lptr arg0;
    jmpIfNot_label non_empty;
    ret;
label non_empty;

    init_lany_type next, LinkedList;
    mov_lptr_lptr next, arg0;
    call_func tail;

    call_func free_list;
    free_lptr arg0;

    ret;
}

function main { i64, ptr_argv } -> i64 {
    # INPUT: n - list_length
    #        x1 x2 ... xn - list elements
    # OUTPUT: Inverted and concatenated elements

    init_lany_type length, i64;
    input_l64 length;

    # list = []  # aka NULL
    init_lany_type list, LinkedList;

label loop_begin;
    cmpEq_l64_imm length, 0;
    jmpIf_label loop_end;

    # curr = input()
    init_lany_type curr, i64;
    input_l64 curr;

    # list = cons(curr, list)
    init_lany_type tail, LinkedList;
    mov_lptr_lptr tail, list;
    call_func cons;

    sub_l64_imm length, 1;

    jmp_label loop_begin;
label loop_end;

    init_lany_type list2, LinkedList;
    mov_lptr_lptr list2, list;

    call_func print_list;
    call_func free_list;

    ret;
}
