type pointer: LinkedList Node
type pointer: LinkedListPtr LinkedList

type data: Node {
    head: i64,
    tail: LinkedList
}

function cons { i64, LinkedList } -> LinkedList {
    # ret_val: result
    # arg0: head
    # arg1: tail

    # using LinkedList = *Node

    # ret_val = new Node()
    alloc_pptr_type ret_val, Node;

    # head_ptr = &(ret_val->head)
    init_pany_type head_ptr, ptr_i64;
    structLea_pptr_pptr_field head_ptr, ret_val, Node.head;

    # *head_ptr = head
    store_pptr_pany head_ptr, arg0;
    deinit;  # head_ptr

    # ret_val->tail = arg1
    init_pany_type tail_ptr, LinkedListPtr;
    structLea_pptr_pptr_field tail_ptr, ret_val, Node.tail;

    store_pptr_pany tail_ptr, arg1;
    deinit;  # tail_ptr

    # return ret_val
    ret;
}

# OPTIMISED!!!
function tail {} -> LinkedList {
    init_pany_type ptr_ptr_node, LinkedListPtr;
    structLea_pptr_pptr_field ptr_ptr_node, ret_val, Node.tail;

    load_pany_pptr ret_val, ptr_ptr_node;

    ret;
}

function print_list { LinkedList } -> void {
    # arg0: LinkedList

    cmpNull_pptr arg0;
    jmpIfNot_label non_empty;
    ret;
label non_empty;

    init_pany_type curr, i64;
    init_pany_type x_ptr, ptr_i64;

    # curr = arg0->x
    structLea_pptr_pptr_field x_ptr, arg0, Node.head;
    load_pany_pptr curr, x_ptr;
    deinit;  # x_ptr

    output_p64 curr;

    deinit;  # curr
    call_func tail;

    ret_tailcall_func print_list;
}


function free_list {LinkedList} -> void {
    # arg0: LinkedList

    cmpNull_pptr arg0;
    jmpIfNot_label non_empty;
    ret;
label non_empty;

    init_pany_type next, LinkedList;
    mov_pptr_pptr next, arg0;
    call_func tail;

    call_func free_list;
    free_pptr arg0;

    ret;
}

function main { i64, ptr_argv } -> i64 {
    # INPUT: n - list_length
    #        x1 x2 ... xn - list elements
    # OUTPUT: Inverted and concatenated elements

    init_pany_type length, i64;
    input_p64 length;

    # list = []  # aka NULL
    init_pany_type list, LinkedList;

label loop_begin;
    cmpEq_p64_imm length, 0;
    jmpIf_label loop_end;

    # curr = input()
    init_pany_type curr, i64;
    input_p64 curr;

    # list = cons(curr, list)
    init_pany_type tail, LinkedList;
    mov_pptr_pptr tail, list;
    call_func cons;

    sub_p64_imm length, 1;

    jmp_label loop_begin;
label loop_end;

    init_pany_type list2, LinkedList;
    mov_pptr_pptr list2, list;
    call_func print_list;
    call_func free_list;

    ret;
}
