type pointer: LinkedList Node
type pointer: LinkedListPtr LinkedList

type data: Node {
    head: i64,
    tail: LinkedList
}

function cons { i64, LinkedList } -> { LinkedList } {
    # ret0: result
    # arg0: head
    # arg1: tail

    # using LinkedList = *Node

    # ret0 = new Node()
    alloc_lptr_type ret0, Node;

    # head_ptr = &(ret0->head)
    init_lany_type head_ptr, ptr_i64;
    structLea_lptr_lptr_field head_ptr, ret0, Node.head;

    # *head_ptr = head
    store_lptr_lany head_ptr, arg0;
    deinit;  # head_ptr

    # ret0->tail = arg1
    init_lany_type tail_ptr, LinkedListPtr;
    structLea_lptr_lptr_field tail_ptr, ret0, Node.tail;

    store_lptr_lany tail_ptr, arg1;
    deinit;  # tail_ptr

    # return ret0
    ret;
}

# OPTIMISED!!!
function tail {} -> { LinkedList } {
    init_lany_type ptr_ptr_node, LinkedListPtr;
    structLea_lptr_lptr_field ptr_ptr_node, ret0, Node.tail;

    load_lany_lptr ret0, ptr_ptr_node;

    ret;
}

function print_list { LinkedList } -> {} {
    # arg0: LinkedList

    cmpNull_lptr arg0;
    jmpIfNot_label non_empty;
    ret;
label non_empty;

    init_lany_type curr, i64;
    init_lany_type x_ptr, ptr_i64;

    # curr = arg0->x
    structLea_lptr_lptr_field x_ptr, arg0, Node.head;
    load_lany_lptr curr, x_ptr;
    deinit;  # x_ptr

    output_l64 curr;

    deinit;  # curr
    call_func tail;

    ret_tailcall_func print_list;
}


function free_list {LinkedList} -> {} {
    # arg0: LinkedList

    cmpNull_lptr arg0;
    jmpIfNot_label non_empty;
    ret;
label non_empty;

    init_lany_type next, LinkedList;
    mov_lptr_lptr next, arg0;
    call_func tail;

    call_func free_list;
    free_lptr arg0;

    ret;
}

function main { i64, ptr_argv } -> { i64 } {
    # INPUT: n - list_length
    #        x1 x2 ... xn - list elements
    # OUTPUT: Inverted and concatenated elements

    init_lany_type length, i64;
    input_l64 length;

    # list = []  # aka NULL
    init_lany_type list, LinkedList;

label loop_begin;
    cmpEq_l64_imm length, 0;
    jmpIf_label loop_end;

    # curr = input()
    init_lany_type curr, i64;
    input_l64 curr;

    # list = cons(curr, list)
    init_lany_type tail, LinkedList;
    mov_lptr_lptr tail, list;
    call_func cons;

    sub_l64_imm length, 1;

    jmp_label loop_begin;
label loop_end;

    init_lany_type list2, LinkedList;
    mov_lptr_lptr list2, list;
    call_func print_list;
    call_func free_list;

    ret;
}
