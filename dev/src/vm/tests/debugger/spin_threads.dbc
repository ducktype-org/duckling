# Keep in sync with tests/api/spin_threads.dbc - the two suites cannot share one
# fixture, because `path()` resolves per suite directory.
# Main plus three worker threads, all spinning forever. Nothing ever terminates on its own, so
# every thread is Running until the test pauses, stops or kills the process.

function spinner {} -> {} {
	init_pany_type			tmp, i64;

	mov_p64_imm				tmp, 0;
	label Loop;
		cmpEq_p64_imm		tmp, 0;
		jmpIf_label			Loop;

	deinit; # tmp
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
	init_pany_type			t1, i64;
	set_threadctx			spinner;
	call_builtinfunc		builtin_start_thread;

	init_pany_type			t2, i64;
	set_threadctx			spinner;
	call_builtinfunc		builtin_start_thread;

	init_pany_type			t3, i64;
	set_threadctx			spinner;
	call_builtinfunc		builtin_start_thread;

	init_pany_type			tmp, i64;
	mov_p64_imm				tmp, 0;
	label MainLoop;
		cmpEq_p64_imm		tmp, 0;
		jmpIf_label			MainLoop;

	ret;
}
