# Returns number that was inputed

function main { i64, ptr_argv } -> { i64 } {
	# [0, 8) main ret0
	# [8, 16) argc
	# [16, 32) *argv

	init_pany_type          x, i64; # [32, 40)
	call_builtinfunc  builtin_input_i64;
	mov_p64_p64 ret0, x;

	deinit; # [8, 16) ret0
	deinit; # *argv
	deinit; # argc
	ret;
}
