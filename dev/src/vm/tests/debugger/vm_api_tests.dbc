type fixed_size_table: tablei64 i64 42

function main { i64, ptr_argv } -> { i64 } {
		# ret0 -> main ret0
		# arg0 -> argc
		# arg1 -> *argv

	init_pany_type     x, i64;
	input_p64          x;
	mov_p64_imm        x, 1;
	deinit; # x
	
	init_pany_type     y, i64;
	output_p64         y;
	deinit; # y

	deinit; # *argv
	deinit; # argc

	ret;
}
