# Returns a pointer to a local that the expression deinitializes before it returns, so the
# pointer is dangling once the evaluation completes.
function ptr_to_local { } -> { ptr_i64 } {
	init_pany_type local, i64;
	mov_p64_imm local, 123;
	init_pany_type p, ptr_i64;
	ref_pptr_pany p, local;
	mov_pptr_pptr ret0, p;
	ret;
}
