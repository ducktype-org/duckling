# input = "a b c d"
# output = a + b + c + d

function foo { i64, i64 } -> { i64 } {
	mov_p64_p64     ret0, arg0;
	add_p64_p64     ret0, arg1;
	deinit; # arg1
	deinit; # arg0
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
	init_pany_type       unused_arg0, i64;
	init_pany_type       unused_arg1, i64;
	mov_p64_imm    unused_arg0, 67;
    mov_p64_imm    unused_arg1, 42;   

	init_pany_type       acc, i64;
	init_pany_type       foo_ret0, i64;
	init_pany_type       foo_arg0, i64;
	init_pany_type       foo_arg1, i64;

	mov_p64_imm    foo_arg0, 1;
    mov_p64_imm    foo_arg1, 2;   
	call_func       foo;

	add_p64_p64     acc, foo_ret0; # acc := a + b

	init_pany_type       foo2_arg0, i64;
	init_pany_type       foo2_arg1, i64;

	mov_p64_imm    foo2_arg0, 3;
    mov_p64_imm    foo2_arg1, 4;
 	call_func       foo;

	add_p64_p64     acc, foo_ret0; # acc += c + d

	output_p64      acc;

	ret;
}
