function level2 { } -> { i64 } {
	init_pany_type l2_local, i64;
	mov_p64_imm l2_local, 20;
	# The breakpoint set on `pause_here_too` instruction 0 lands here; while paused, `level3`
	# is evaluated and sees `l2_local` = 20.
	call_func pause_here_too;
	mov_p64_p64 ret0, frame 1 l1_local;
	add_p64_p64 ret0, l2_local;
	add_p64_p64 ret0, l2_local;
	ret_from_expr;
}
