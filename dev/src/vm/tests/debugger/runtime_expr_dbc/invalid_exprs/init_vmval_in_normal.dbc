# `init_pany_vmval` is only legal in runtime expressions and the synthetic start function; it
# must be rejected in a normal (program) function.
function offender { } -> { i64 } {
	init_pany_vmval value, $ 0;
	mov_p64_p64 ret0, value;
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
	mov_p64_imm ret0, 0;
	ret;
}
