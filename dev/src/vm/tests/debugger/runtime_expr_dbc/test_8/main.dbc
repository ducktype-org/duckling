
global_data counter i64 {}

function foo { i64 } -> { i64 } {
    add_p64_imm counter, 1;
    mov_p64_p64 ret0, arg0;
    add_p64_imm ret0, 10;
    ret;
}


function main { i64, ptr_argv } -> { i64 } {
	init_pany_type foo_ret0, i64;
	init_pany_type foo_arg0, i64;
	mov_p64_imm foo_arg0, 3;

	call_func foo;
	mov_p64_p64 ret0, counter;
	ret;
}
