function level3 { } -> { i64 } {
	# Frame stack at compile time: start(0), main(1), level1(2), pause_here(3), level2(4),
	# pause_here_too(5). `l2_local` lives in the paused `level2` expression frame (index 4),
	# `l1_local` in the paused `level1` expression frame (index 2) and `a`/`b` in `main` (index 1).
	mov_p64_imm frame 4 l2_local, 30;
	mov_p64_p64 ret0, frame 4 l2_local;
	add_p64_p64 ret0, frame 2 l1_local;
	add_p64_p64 ret0, frame 1 a;
	add_p64_p64 ret0, frame 1 b;
	ret_from_expr;
}
