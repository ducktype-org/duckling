function main { i64, ptr_argv } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type 		a, i64;
	init_pany_type 		b, i64;
	init_pany_type 		c, i64;
	mov_p64_imm  	a, 0;
	mov_p64_imm  	b, 0;
	breakpoint;
	mov_p64_imm  	a, 0;
	mov_p64_imm  	b, 0;
	mov_p64_imm 	c, 0;
	breakpoint;

	deinit; # c
	deinit; # b
	deinit; # a
	deinit; # *argv
	deinit; # argc
	ret;
}
