# The main thread starts a worker that keeps writing to the output, then blocks on input that never
# arrives and spins afterwards. Used to observe that a thread sleeping on IO does not hold the GIL,
# and that `pauseAll` waits for it.

function talker {} -> {} {
	init_pany_type			n, i64;
	init_pany_type			i, i64;

	mov_p64_imm				n, 0;
	label Loop;
		mov_p64_imm			i, 20000;
		label Spin;
			sub_p64_imm		i, 1;
			cmpGt_p64_imm	i, 0;
			jmpIf_label		Spin;

		add_p64_imm			n, 1;
		output_p64			n;
		jmp_label			Loop;

	deinit; # i
	deinit; # n
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
	init_pany_type			t1, i64;
	set_threadctx			talker;
	call_builtinfunc		builtin_start_thread;

	init_pany_type			x, i64;
	init_pany_type			tmp, i64;

	input_p64				x;

	mov_p64_imm				tmp, 0;
	label MainLoop;
		cmpEq_p64_imm		tmp, 0;
		jmpIf_label			MainLoop;

	ret;
}
