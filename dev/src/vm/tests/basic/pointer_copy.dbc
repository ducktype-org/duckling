function main { i64, ptr_argv } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv

	init_lany_type           x, i64;
	init_lany_type           y, i64;
	init_lany_type           p, ptr_i64;
	init_lany_type           q, ptr_i64;
	init_lany_type           r, ptr_i64;

	ref_lptr_lany        p, x;      # p := &x

	# from null to non-null
	mov_lptr_lptr       q, p;      # q = p

	mov_l64_imm         y, 42;     # y = 42
	store_lptr_lany  q, y;      # *q := y
	output_l64          x;         # print(x)

	# from non-null to null
	mov_lptr_lptr       p, r;      # p = r

	deinit; # r
	deinit; # q
	deinit; # p
	deinit; # y
	deinit; # x
	deinit; # *argv
	deinit; # argc
	ret;
}
