function integers {} -> { i64 } {
	init_lany_type	a, i64;
	init_lany_type	b, i64;
	init_lany_type	c, i64;

	# ======== Arithmetic =========
	mov_l64_imm 	b, 3;
	mov_l64_l64 	a, b;
	# a = 3, b = 3
	cmov_l64_l64 	a, a;
	add_l64_l64 	a, b;
	add_l64_imm 	b, 1;
	# a = 6, b = 4

	sub_l64_l64 	a, b;
	sub_l64_imm 	b, 1;
	# a = 2, b = 3

	mul_l64_l64 	a, b;
	mul_l64_imm 	b, 3;
	# a = 6, b = 9

	mod_l64_l64 	a, b;
	mod_l64_imm 	b, 7;
	# a = 6, b = 2;

	div_l64_l64 	a, b;
	div_l64_imm 	b, 2;
	# a = 3, b = 1

	cmpEq_l64_imm 	a, 3;
	jmpIfNot_label 	fail;

	cmpEq_l64_imm 	b, 1;
	jmpIfNot_label	fail;

	# ======== Signed Comparisons =========
	mov_l64_imm		a, 20; 		# a = 20
	mov_l64_imm		b, 10; 		# b = 10
	mov_l64_l64		c, a; 		# c = 20

	cmpEq_l64_l64 	a, b; 		# 20 == 10
	jmpIf_label 	fail;
	cmpEq_l64_imm 	b, 10;		# 10 == 10
	jmpIfNot_label 	fail;

	cmpNeq_l64_l64	a, b;		# 20 != 10
	jmpIfNot_label	fail;
	cmpNeq_l64_imm	a, 20;		# 20 != 20
	jmpIf_label		fail;

	cmpGt_l64_l64 	a, b;		# 20 > 10
	jmpIfNot_label 	fail;
	cmpGt_l64_imm 	b, 2;		# 10 > 2
	jmpIfNot_label 	fail;

	cmpGe_l64_l64	a, b;		# 20 >= 10
	jmpIfNot_label	fail;
	cmpGe_l64_l64	a, c;		# 20 >= 20
	jmpIfNot_label	fail;
	cmpGe_l64_imm	b, 20;		# 10 >= 20
	jmpIf_label		fail;

	cmpLt_l64_l64	b, a;		# 10 < 20
	jmpIfNot_label	fail;
	cmpLt_l64_imm	a, 10;		# 20 < 10
	jmpIf_label		fail;

	cmpLe_l64_l64	b, a;		# 10 <= 20
	jmpIfNot_label	fail;
	cmpLe_l64_l64	a, c;		# 20 <= 20
	jmpIfNot_label	fail;
	cmpLe_l64_imm	a, 10;		# 20 <= 10
	jmpIf_label		fail;

	# ======== Unsigned Comparisons =========
	mov_l64_imm		a, 10;		# a = 10
	mov_l64_imm		b, -1; 		# b = -1 (MAX_U64) 
	mov_l64_l64		c, a;

	ucmpGt_l64_l64	b, a;		# MAX_U64 > 10
	jmpIfNot_label	fail;
	ucmpGt_l64_imm	a, -1;		# 10 > MAX_U64
	jmpIf_label		fail;

	ucmpGe_l64_l64	b, a;		# MAX_U64 >= 10
	jmpIfNot_label	fail;
	ucmpGe_l64_l64	a, c;		# 10 >= 10
	jmpIfNot_label	fail;
	ucmpGe_l64_imm	a, -1;		# 10 >= MAX_U64
	jmpIf_label		fail;
	
	ucmpLt_l64_l64	a, b;		# 10 < MAX_U64
	jmpIfNot_label	fail;
	ucmpLt_l64_imm	b, 10;		# MAX_U64 < 10
	jmpIf_label		fail;

	ucmpLe_l64_l64	a, b;		# 10 <= MAX_U64
	jmpIfNot_label	fail;
	ucmpLe_l64_l64	a, c;		# 10 <= 10
	jmpIfNot_label	fail;
	ucmpLe_l64_imm	b, 10;		# MAX_U64 <= 10
	jmpIf_label		fail;

	mov_l64_imm 	ret_val_0, 1;
	ret;

	label fail;
	mov_l64_imm 	ret_val_0, 1234;
	ret;
}

function floats {} -> { i64 } {
	init_lany_type	a, i64;
	init_lany_type	b, i64;
	init_lany_type	c, i64;

	# ======== Arithmetic =========
	mov_l64_imm 	b, 0.5;
	mov_l64_l64 	a, b;

	fadd_l64_l64 	a, b;
	fadd_l64_imm	a, 1.0;

	fcmpEq_l64_imm 	a, 2.0;
	jmpIfNot_label 	fail;

	fsub_l64_l64 	a, b;		# a = 2.0 - 0.5 -> a = 1.5
	fsub_l64_imm 	a, 0.5;		# a = 1.5 - 0.5 -> a = 1.0

	fcmpEq_l64_imm 	a, 1.0;
	jmpIfNot_label 	fail;

	fmul_l64_l64 	a, b;		# a = 1.0 * 0.5 -> a = 0.5
	fmul_l64_imm 	a, 0.5;		# a = 0.5 * 0.5 -> a = 0.25

	fcmpEq_l64_imm 	a, 0.25;
	jmpIfNot_label 	fail;

	fdiv_l64_l64 	a, b;		# a = 0.25 / 0.5 -> a = 0.5
	fdiv_l64_imm 	a, 1.0;		# a = 0.5 / 1.0 -> a = 0.5

	fneg_l64 		a;			# a = -0.5
	mov_l64_imm 	b, 0.5;
	fneg_l64		b;			# b = -0.5

	fcmpEq_l64_l64 	a, b;   	# -0.5 == -0.5
	jmpIfNot_label 	fail;
	
	# ======== Comparisons =========
	mov_l64_imm		a, 20.0;
	mov_l64_imm		b, 10.0;
	mov_l64_l64		c, b;

	fcmpGt_l64_l64	a, b;			# 20.0 > 10.0
	jmpIfNot_label	fail;
	fcmpGt_l64_imm	b, 20.0;		# 10.0 > 20.0
	jmpIf_label		fail;

	fcmpLt_l64_l64	b, a;			# 10.0 < 20.0
	jmpIfNot_label	fail;
	fcmpLt_l64_imm	a, 10.0;		# 20.0 < 10.0
	jmpIf_label		fail;

	fcmpGe_l64_l64	a, b;			# 20.0 >= 10.0
	jmpIfNot_label	fail;
	fcmpGe_l64_l64	b, c;			# 10.0 >= 10.0
	jmpIfNot_label	fail;
	fcmpGe_l64_imm	b, 20.0;		# 10.0 >= 20.0
	jmpIf_label		fail;

	fcmpLe_l64_l64	b, a;			# 10.0 <= 20.0
	jmpIfNot_label	fail;
	fcmpLe_l64_l64	b, c;			# 10.0 <= 10.0
	jmpIfNot_label	fail;
	fcmpLe_l64_imm	a, 10.0;		# 20.0 <= 10.0
	jmpIf_label		fail;

	fcmpNeq_l64_l64	a, b;			# 20.0 != 10.0
	jmpIfNot_label	fail;
	fcmpNeq_l64_imm	b, 10.0;		# 10.0 != 10.0
	jmpIf_label		fail;

	fcmpEq_l64_l64	b, c;			# 10.0 == 10.0
	jmpIfNot_label	fail;
	fcmpEq_l64_imm	a, 10.0;		# 20.0 == 10.0
	jmpIf_label		fail;

	mov_l64_imm 	ret_val_0, 1; 	# ret_val_0 = 1
	ret;

	label fail;
	mov_l64_imm 	ret_val_0, 0;
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
    # ret_val_0 -> main ret_val_0
    # arg0 -> argc
    # arg1 -> *argv

	init_lany_type 	test_ret_val, i64;

	call_func 	integers;
	output_l64 	test_ret_val;
	
	call_func 	floats;
	output_l64 	test_ret_val;

	deinit;
    deinit; # *argv
    deinit; # argc
	ret;
}
