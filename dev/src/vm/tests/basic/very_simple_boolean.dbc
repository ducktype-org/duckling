function main {
    init_lany_type tmp, i64;
    init_lany_type tmp2, i64;
    init_lany_type tmp3, i32;
    init_lany_type tmp4, i32;

    # 1 is for true, 0 false
    # so 1 1 means the tests for both true values

    # 1 1
    mov_l64_imm tmp, 1;
    mov_l64_imm tmp2, 1;

    and_l64_l64 tmp, tmp2;
    cmpEq_l64_imm tmp, 1;
    jmpIfNot_label Finish;

    or_l64_l64 tmp, tmp2;
    cmpEq_l64_imm tmp, 1;
    jmpIfNot_label Finish;

    xor_l64_l64 tmp, tmp2;
    cmpEq_l64_imm tmp, 0;
    jmpIfNot_label Finish;

    # 0 1
    mov_l64_imm tmp, 0;
    mov_l64_imm tmp2, 1;

    and_l64_l64 tmp, tmp2;
    cmpEq_l64_imm tmp, 0;
    jmpIfNot_label Finish;

    or_l64_l64 tmp, tmp2;
    cmpEq_l64_imm tmp, 1;
    jmpIfNot_label Finish;

    mov_l64_imm tmp, 0;
    xor_l64_l64 tmp, tmp2;
    cmpEq_l64_imm tmp, 1;
    jmpIfNot_label Finish;


    # 0 0
    mov_l64_imm tmp, 0;
    mov_l64_imm tmp2, 0;

    and_l64_l64 tmp, tmp2;
    cmpEq_l64_imm tmp, 0;
    jmpIfNot_label Finish;
    
    xor_l64_l64 tmp, tmp2;
    cmpEq_l64_imm tmp, 0;
    jmpIfNot_label Finish;

    or_l64_l64 tmp, tmp2;
    cmpEq_l64_imm tmp, 0;
    jmpIfNot_label Finish;


    # i32
    # 1 1
    mov_l32_imm tmp3, 1;
    mov_l32_imm tmp4, 1;

    and_l32_l32 tmp3, tmp4;
    cmpEq_l32_imm tmp3, 1;
    jmpIfNot_label Finish;

    or_l32_l32 tmp3, tmp4;
    cmpEq_l32_imm tmp3, 1;
    jmpIfNot_label Finish;

    xor_l32_l32 tmp3, tmp4;
    cmpEq_l32_imm tmp3, 0;
    jmpIfNot_label Finish;

    # 0 1
    mov_l32_imm tmp3, 0;
    mov_l32_imm tmp4, 1;

    and_l32_l32 tmp3, tmp4;
    cmpEq_l32_imm tmp3, 0;
    jmpIfNot_label Finish;

    or_l32_l32 tmp3, tmp4;
    cmpEq_l32_imm tmp3, 1;
    jmpIfNot_label Finish;

    mov_l32_imm tmp3, 0;
    xor_l32_l32 tmp3, tmp4;
    cmpEq_l32_imm tmp3, 1;
    jmpIfNot_label Finish;

    # 0 0
    mov_l32_imm tmp3, 0;
    mov_l32_imm tmp4, 0;

    and_l32_l32 tmp3, tmp4;
    cmpEq_l32_imm tmp3, 0;
    jmpIfNot_label Finish;

    xor_l32_l32 tmp3, tmp4;
    cmpEq_l32_imm tmp3, 0;
    jmpIfNot_label Finish;

    or_l32_l32 tmp3, tmp4;
    cmpEq_l32_imm tmp3, 0;
    jmpIfNot_label Finish;

    # not
    not_l64 tmp;
    cmpEq_l64_imm tmp, 1;
    jmpIfNot_label Finish;

    not_l64 tmp;
    cmpEq_l64_imm tmp, 0;
    jmpIfNot_label Finish;

    not_l32 tmp3;
    cmpEq_l32_imm tmp3, 1;
    jmpIfNot_label Finish;

    not_l32 tmp3;
    cmpEq_l32_imm tmp3, 0;
    jmpIfNot_label Finish;

    # output
    init_lany_type out, i64;
    mov_l64_imm out, 1;
    output_l64 out;
    deinit; # out

    label Finish;

    deinit; # tmp4
    deinit; # tmp3
    deinit; # tmp2
    deinit; # tmp
    deinit; # *argv
    deinit; # argc
    ret;
}