function main { i64, ptr_argv } -> { i64 } {
    init_lany_type tmp, byte;
    init_lany_type tmp2, byte;

    # 1 is for true, 0 false
    # so 1 1 means the tests for both true values

    # 1 1
    mov_l8_imm tmp, 1;
    mov_l8_imm tmp2, 1;

    log_and_l8_l8 tmp, tmp2;
    cmpEq_l8_imm tmp, 1;
    jmpIfNot_label Finish;

    log_or_l8_l8 tmp, tmp2;
    cmpEq_l8_imm tmp, 1;
    jmpIfNot_label Finish;

    log_xor_l8_l8 tmp, tmp2;
    cmpEq_l8_imm tmp, 0;
    jmpIfNot_label Finish;

    # 0 1
    mov_l8_imm tmp, 0;
    mov_l8_imm tmp2, 1;

    log_and_l8_l8 tmp, tmp2;
    cmpEq_l8_imm tmp, 0;
    jmpIfNot_label Finish;

    log_or_l8_l8 tmp, tmp2;
    cmpEq_l8_imm tmp, 1;
    jmpIfNot_label Finish;

    mov_l8_imm tmp, 0;
    log_xor_l8_l8 tmp, tmp2;
    cmpEq_l8_imm tmp, 1;
    jmpIfNot_label Finish;


    # 0 0
    mov_l8_imm tmp, 0;
    mov_l8_imm tmp2, 0;

    log_and_l8_l8 tmp, tmp2;
    cmpEq_l8_imm tmp, 0;
    jmpIfNot_label Finish;
    
    log_xor_l8_l8 tmp, tmp2;
    cmpEq_l8_imm tmp, 0;
    jmpIfNot_label Finish;

    log_or_l8_l8 tmp, tmp2;
    cmpEq_l8_imm tmp, 0;
    jmpIfNot_label Finish;

    # not
    log_not_l8 tmp;
    cmpEq_l8_imm tmp, 1;
    jmpIfNot_label Finish;

    log_not_l8 tmp;
    cmpEq_l8_imm tmp, 0;
    jmpIfNot_label Finish;

    # output
    init_lany_type out, i64;
    mov_l64_imm out, 1;
    output_l64 out;
    deinit; # out

    label Finish;
    ret;
}