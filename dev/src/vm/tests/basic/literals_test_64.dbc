type fun: foo {} i64

function foo {
	init_lany_type		a, i64;

	mov_l64_imm 		a, +0.5;		# a = 0.5    
    cmpEq_l64_imm       a, 4602678819172646912u64;
	jmpIfNot_label 	fail;

    mov_l64_imm 		a, 0.5d;		# a = 0.5    
    cmpEq_l64_imm       a, 4602678819172646912u64;
	jmpIfNot_label 	fail;

	mov_l64_imm 		a, 1u64;
	cmpEq_l64_imm       a, 1;
	jmpIfNot_label 	fail;
		
	mov_l64_imm			a, 0xffffffffffffffff;
	cmpEq_l64_imm 		a, -1;
	jmpIfNot_label 	fail;

	mov_l64_imm			a, 0b11;
	cmpEq_l64_imm 		a, 3;
	jmpIfNot_label 	fail;


	mov_l64_l64 		ret_val, a;
	ret;

	label fail;
	init_lany_type		tmp, i64;
	mov_l64_imm 		tmp, 2137;
	output_l64  		tmp;
	mov_l64_l64 		ret_val, a;

	ret;
}

function main {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

	init_lany_type 	foo_ret_val, i64;

	call_func 	foo;
	output_l64 	foo_ret_val;

	deinit;
    deinit; # *argv
    deinit; # argc
	ret;
}
