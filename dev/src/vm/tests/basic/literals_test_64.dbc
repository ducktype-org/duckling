function foo {} -> i64 {
	init_pany_type		a, i64;

	mov_p64_imm 		a, 123i64;
	cmpEq_p64_imm 		a, 123;
	jmpIfNot_label 	fail;

	mov_p64_imm 		a, -123i64;
	cmpEq_p64_imm 		a, -123;
	jmpIfNot_label 	fail;

	mov_p64_imm			a, 0b11;
	cmpEq_p64_imm 		a, 3;
	jmpIfNot_label 	fail;

	mov_p64_imm			a, 0o071;
	cmpEq_p64_imm 		a, 57;
	jmpIfNot_label 	fail;

	mov_p64_imm			a, 0o71;
	cmpEq_p64_imm 		a, 57;
	jmpIfNot_label 	fail;

	mov_p64_imm			a, 0x00000001;
	cmpEq_p64_imm 		a, 1;
	jmpIfNot_label 	fail;

	mov_p64_imm 		a, 1u64;
	cmpEq_p64_imm 		a, 1;
	jmpIfNot_label 	fail;

	mov_p64_imm			a, 18446744073709551615u64;
	cmpEq_p64_imm 		a, -1;
	jmpIfNot_label 	fail;

	mov_p64_imm 		a, +0.5;		# a = 0.5    
    cmpEq_p64_imm       a, 4602678819172646912u64;
	jmpIfNot_label 	fail;

    mov_p64_imm 		a, 0.5f64;		# a = 0.5    
    cmpEq_p64_imm       a, 4602678819172646912u64;
	jmpIfNot_label 	fail;

	mov_p64_imm			a, 0xffffffffffffffff;
	cmpEq_p64_imm 		a, -1;
	jmpIfNot_label 	fail;

	mov_p64_imm 		ret_val, 1;
	ret;

	label fail;
	init_pany_type		tmp, i64;
	mov_p64_imm 		tmp, 1235;
	output_p64  		tmp;
	mov_p64_p64 		ret_val, a;

	ret;
}

function main { i64, ptr_argv } -> i64 {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

	init_pany_type 	foo_ret_val, i64;

	call_func 	foo;
	output_p64 	foo_ret_val;

	deinit;
    deinit; # *argv
    deinit; # argc
	ret;
}
