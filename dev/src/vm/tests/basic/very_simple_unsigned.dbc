function main {
    # testing on i64 because u64 variables are not supported yet
    init_lany_type tmp, i64;
    init_lany_type tmp2, i64;

    umov_l64_imm tmp2, 1;
    umov_l64_imm tmp, 2130;
    uadd_l64_imm tmp, 9;
    usub_l64_imm tmp, 2;
    umul_l64_imm tmp, 2;
    udiv_l64_imm tmp, 2;
    umov_l64_imm tmp, 2130;

    label Loop;
    uadd_l64_l64 tmp, tmp2;
    ucmpEq_l64_imm tmp, 2137;
    jmpIfNot_label Loop;

    output_l64 tmp;

    deinit; # tmp2
    deinit; # tmp
    deinit; # *argv
    deinit; # argc
    ret;
}