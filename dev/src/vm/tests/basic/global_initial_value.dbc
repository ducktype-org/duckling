type data: Point {
    x: i32,
    y: i32,
    is_ok: i8,
}

type fixed_size_table: point_arr Point 2

global_data answers point_arr {
    is_constant: true,
    initial_value: fixed_size_table [ class { x: 0x0000000A, y: 0xFFFFFFF6, is_ok: 0x2F }, class { x: 0x00000001, y: 0xFFFFFFFF, is_ok: 0x6F } ]
}

function main {} -> { i64 } {
    init_pany_type idx, i64;
    init_pany_type elem, Point;

    # Load first element
    mov_p64_imm idx, 0;
    fixedSizeTableLoad_pany_pfst_p64 elem, answers, idx;

    # Output Point[0].x = 0x12345678 = 10
    init_pany_type res_i64, i64;
    init_pany_type out_i32, i32;
    structLoad_pany_pste_field out_i32, elem, Point.x;
    call_builtinfunc builtin_output_i32;

    # Output Point[0].y = 0x87654321 = -10
    init_pany_type out_i32_2, i32;
    structLoad_pany_pste_field out_i32_2, elem, Point.y;
    call_builtinfunc builtin_output_i32;

    # Output Point[0].is_ok = 0xFF = -1
    init_pany_type out_i8, i8;
    structLoad_pany_pste_field out_i8, elem, Point.is_ok;
    call_builtinfunc builtin_output_char;

    # Load second element
    mov_p64_imm idx, 1;
    fixedSizeTableLoad_pany_pfst_p64 elem, answers, idx;

    # Output Point[1].x = 0x00000001 = 1
    init_pany_type out_i32_3, i32;
    structLoad_pany_pste_field out_i32_3, elem, Point.x;
    call_builtinfunc builtin_output_i32;

    # Output Point[1].y = 0xFFFFFFFF = -1
    init_pany_type out_i32_4, i32;
    structLoad_pany_pste_field out_i32_4, elem, Point.y;
    call_builtinfunc builtin_output_i32;

    # Output Point[1].is_ok = 0x0A = 10
    init_pany_type out_i8_2, i8;
    structLoad_pany_pste_field out_i8_2, elem, Point.is_ok;
    call_builtinfunc builtin_output_char;

    ret;
}
