function foo {} -> i32 {
	init_lany_type		a, i32;
	init_lany_type		b, i32;

	mov_l32_imm 		b, 3;
	mov_l32_l32 		a, b;
	# a = 3, b = 3

	cmov_l32_l32 		a, a;
	add_l32_l32 		a, b;
	add_l32_imm 		b, 1;
	# a = 6, b = 4

	sub_l32_l32 		a, b;
	sub_l32_imm 		b, 1;
	# a = 2, b = 3

	mul_l32_l32 		a, b;
	mul_l32_imm 		b, 3;
	# a = 6, b = 9

	mod_l32_l32 		a, b;
	mod_l32_imm 		b, 7;
	# a = 6, b = 2;

	div_l32_l32 		a, b;
	div_l32_imm 		b, 2;
	# a = 3, b = 1

	cmpEq_l32_l32 		a, b;
	jmpIf_label 		fail;

	cmpEq_l32_imm 		b, 1;
	jmpIfNot_label 	fail;

	cmpG_l32_l32 		a, b;
	jmpIfNot_label 	fail;

	cmpG_l32_imm 		b, 2;
	jmpIf_label 		fail;

	add_l32_l32 		b, a;
	# b = 4
	mov_l32_l32 		ret_val, b;
	ret;

	label fail;
	init_lany_type		tmp, i32;
	mov_l32_imm 		tmp, 2137;
	output_l32  		tmp;
	mov_l32_l32 		ret_val, a;

	ret;
}

function main { i64, ptr_argv } -> i64 {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

	init_lany_type 	foo_ret_val, i32;

	call_func 	foo;
	output_l32 	foo_ret_val;

	deinit;
    deinit; # *argv
    deinit; # argc
	ret;
}
