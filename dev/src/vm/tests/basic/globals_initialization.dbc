# var f: i64 = 7;
# var g: i64 = 5;

# fun main() = {
#     g = f;
#     return g;
# }

global_data f i64 {
    constructor: f_ctor
};

global_data g i64 {
    constructor: g_ctor
};

function f_ctor {} -> {} {
    mov_g64_imm f, 7;
    ret;
}

function g_ctor {} -> {} {
    mov_g64_imm g, 5;
    ret;
}

function main { i64, ptr_argv } -> { i64 } {
    mov_g64_g64 g, f;
    mov_l64_g64 ret0, g;
    ret;
}
