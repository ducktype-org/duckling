function foo {} -> i32 {
	init_lany_type		a, i32;

	mov_l32_imm 		a, 0.5f;		# b = 0.5    
    cmpEq_l32_imm       a, 1056964608i32; # 1056964608 as int has same bits as 0.5f 
	jmpIfNot_label 	fail;

	mov_l32_imm 		a, 1u32;
	cmpEq_l32_imm 		a, 1;
	jmpIfNot_label 	fail;

	mov_l32_imm			a, 0x00000001;
	cmpEq_l32_imm 		a, 1;
	jmpIfNot_label 	fail;

	mov_l32_imm			a, 0b11;
	cmpEq_l32_imm 		a, 3;
	jmpIfNot_label 	fail;

	mov_l32_l32 		ret_val, a;
	ret;

	label fail;
	init_lany_type		tmp, i32;
	mov_l32_imm 		tmp, 2137;
	output_l32  		tmp;
	mov_l32_l32 		ret_val, a;

	ret;
}

function main { i64, ptr_argv } -> i64 {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

	init_lany_type 	foo_ret_val, i32;

	call_func 	foo;
	output_l32 	foo_ret_val;

	deinit;
    deinit; # *argv
    deinit; # argc
	ret;
}
