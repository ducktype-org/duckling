function main { i64, ptr_argv } -> i64 {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type 		a, i64;
	init_pany_type 		b, i64;
	init_pany_type 		c, i64;

	mov_p64_imm   a, 10;
	mov_p64_imm   b, 0;
	mov_p64_imm   c, 1;

	label Loop;

	output_p64       b;
	add_p64_p64      b, c;

	cmpEq_p64_p64    b, a;
	jmpIfNot_label Loop;

	deinit; # c
	deinit; # b
	deinit; # a
	deinit; # *argv
	deinit; # argc
	ret;
}
