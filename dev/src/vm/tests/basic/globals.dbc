global_data counter i64 {};

global_data global_ptr ptr_i64 {};

function for_coverage {} -> {} {
	init_lany_type ptr, ptr_i64;
	alloc_lptr_type ptr, i64;
	mov_gptr_lptr global_ptr, ptr;

	init_lany_type ptr2, ptr_i64;
	mov_lptr_lptr ptr, ptr2;  # clear
	deinit;

	mov_lptr_gptr ptr, global_ptr;
	init_lany_type int, i64;
	mov_l64_imm int, 5;
	store_lptr_lany ptr, int;

	deinit;
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
	mov_g64_imm counter, 5;
	mov_l64_g64 ret0, counter;
	output_l64 ret0;

	call_func for_coverage;
	init_lany_type ptr, ptr_i64;
	mov_lptr_gptr ptr, global_ptr;
	load_lany_lptr ret0, ptr;
	free_lptr ptr;


	deinit; # ptr
	deinit; # *argv
	deinit; # argc
	ret;
}
