# ===== Nested Struct Array =====
type fixed_size_table: InnerArray i64 10
type data: Level2 { pad: i64, arr: InnerArray }
type data: Level1 { pad: i64, l2: Level2 }
type data: Root   { pad: i64, l1: Level1 }

type pointer: ptr_InnerArray InnerArray
type pointer: ptr_Level1 Level1
type pointer: ptr_Level2 Level2

function test_nested_struct_array {} -> {} {
    init_pany_type root, Root;
    init_pany_type ptr_to_arr, ptr_InnerArray;
    init_pany_type ptr_to_l1, ptr_Level1;
    init_pany_type ptr_to_l2, ptr_Level2;
    init_pany_type ptr_to_element, ptr_i64;
    init_pany_type idx, i64;

    structLea_pptr_pste_field ptr_to_l1, root, Root.l1;
    structLea_pptr_pptr_field ptr_to_l2, ptr_to_l1, Level1.l2;
    structLea_pptr_pptr_field ptr_to_arr, ptr_to_l2, Level2.arr;

    mov_p64_imm idx, 9; # Accessing the last element so the offset gets as big as it can and potentially cause an out of bounds read.
    # TODOP: This is weird, shouldn't work but it does
    # mov_p64_imm idx, 200; # Accessing the last element so the offset gets as big as it can and potentially cause an out of bounds read.
    fixedSizeTableLea_pptr_pptr_p64 ptr_to_element, ptr_to_arr, idx;
    
    
    init_pany_type asd, InnerArray;
    fixedSizeTableStore_pfst_pany_p64 asd, idx, idx;

    ret;
}

# ===== Array of Structs=====
type fixed_size_table: Table Element 5
type pointer: ptr_Element Element
type pointer: ptr_Table Table
type data: Element { x: i64, y: i64, z: i64 }

function test_array_of_structs {} -> {} {
    init_pany_type tbl, Table;
    init_pany_type ptr_el, ptr_Element;
    init_pany_type ptr_tbl, ptr_Table;
    init_pany_type idx, i64;
    
    mov_p64_imm idx, 4;
    # mov_p64_imm idx, 5; # TODOP: Fishy, this works but shouldn't
    fixedSizeTableLea_pptr_pfst_p64 ptr_el, tbl, idx;

    ret;
}

# ===== Array of Arrays =====
type fixed_size_table: Row i64 4
type fixed_size_table: Matrix Row 4
type pointer: ptr_Row Row 
type pointer: ptr_Matrix Matrix

function test_matrix {} -> {} {
    init_pany_type m, Matrix;
    init_pany_type row_ptr, ptr_Row;
    init_pany_type val_ptr, ptr_i64;
    init_pany_type idx, i64;

    mov_p64_imm idx, 2;
    fixedSizeTableLea_pptr_pfst_p64 row_ptr, m, idx;
    fixedSizeTableLea_pptr_pptr_p64 val_ptr, row_ptr, idx;
    ret;
}

# ===== Array of Pointers =====
type fixed_size_table: PtrArray ptr_i64 5
type pointer: ptr_ptr_i64 ptr_i64


function test_ptr_array {} -> {} {
    init_pany_type tbl, PtrArray;
    init_pany_type p_ptr, ptr_ptr_i64;
    init_pany_type idx, i64;

    mov_p64_imm idx, 1;
    fixedSizeTableLea_pptr_pfst_p64 p_ptr, tbl, idx;

    ret;
}

# ===== Mattest =====
type fixed_size_table: T i64 5
type pointer: ptr_T T
type data: F {
    a: T
}

function test_mattest {} -> {} {
    init_pany_type foo, F;
    init_pany_type ptr, ptr_T;
    structLea_pptr_pste_field ptr, foo, F.a;

    init_pany_type value_ptr, ptr_i64;
    init_pany_type idx, i64;
    mov_p64_imm idx, 1;
    fixedSizeTableLea_pptr_pptr_p64 value_ptr, ptr, idx;
    ret;
}



function main {} -> { i64 } {
    call_func test_nested_struct_array;
    call_func test_array_of_structs;    
    call_func test_matrix;    
    call_func test_ptr_array;    
    call_func test_mattest;    

    ret;
}
