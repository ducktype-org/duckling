type fun: foo {} i64

function foo {
	init_lany_type		a, i64;
	init_lany_type		b, i64;

	mov_l64_imm 		b, 1056964608;		# b = 0.5
	mov_l64_l64 		a, b;				# a = 0.5

	fadd_l64_l64 		a, b;				# a = 1.0
	fadd_l64_imm		a, 1065353216;		# a = 2.0

	cmpEq_l64_imm 		a, 1073741824;		# a == 2.0
	jmpIfNot_label 	fail;

	fsub_l64_l64 		a, b;				# a = 1.5
	fsub_l64_imm 		a, 1056964608;		# a = 1.0

	cmpEq_l64_imm 		a, 1065353216;		# a == 1.0
	jmpIfNot_label 	fail;

	fmul_l64_l64 		a, b;				# a = 0.5
	fmul_l64_imm 		a, 1056964608;		# a = 0.25

	cmpEq_l64_imm 		a, 1048576000;		# a == 0.25
	jmpIfNot_label 	fail;

	fdiv_l64_l64 		a, b;				# a = 0.5
	fdiv_l64_imm 		a, 1065353216;		# a = 0.5

	cmpEq_l64_l64 		a, b;
	jmpIfNot_label 		fail;

	mov_l64_l64 		ret_val, a;
	ret;

	label fail;
	init_lany_type		tmp, i64;
	mov_l64_imm 		tmp, 2137;
	output_l64  		tmp;
	mov_l64_l64 		ret_val, a;

	ret;
}

function main {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

	init_lany_type 	foo_ret_val, i64;

	call_func 	foo;
	output_l64 	foo_ret_val;

	deinit;
    deinit; # *argv
    deinit; # argc
	ret;
}
