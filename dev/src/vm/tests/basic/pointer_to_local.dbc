type pointer: ptr_ptri64 ptr_i64

function main { i64, ptr_argv } -> i64 {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type x, i64;
	init_pany_type y, i64;
	init_pany_type p, ptr_i64;

	# First let's check if it works for ints.
	ref_pptr_pany p, x;         # p := &x
	mov_p64_imm y, 42;          # y := 42
	store_pptr_pany p, y;   	# *p := y
	output_p64 x;               # print(x)

	init_pany_type q, ptr_ptri64;
	ref_pptr_pany q, p;        # q := &p
	# There are no instructions to check if that worked,
	# so let's for now just check if it doesn't panic.
	deinit;                     # q
	deinit;                     # p
	deinit;                     # y
	deinit;                     # x
	deinit; # *argv
	deinit; # argc
	ret;
}
