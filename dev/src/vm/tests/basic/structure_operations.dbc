type data: Foo {
    a: i64,
    b: i64
}

function main { i64, ptr_argv } -> i64 {
    init_lany_type s1, Foo;
    init_lany_type a_ptr, ptr_i64;
    init_lany_type val, i64;
    mov_l64_imm val, 5;
    structStore_lste_lany_field s1, val, Foo.a;
    init_lany_type s2, Foo;
    mov_lste_lste s2, s1;
    init_lany_type val2, i64;
    structLoad_lany_lste_field val2, s2, Foo.a;
    output_l64 val2;
    structLoad_lany_lste_field val2, s2, Foo.b;
    output_l64 val2;

    init_lany_type foo_b_ptr, ptr_i64;
    structLea_lptr_lste_field foo_b_ptr, s2, Foo.b;
    mov_l64_imm val, 6;
    store_lptr_lany foo_b_ptr, val;
    structLoad_lany_lste_field val2, s2, Foo.b;
    output_l64 val2;


    ret;
}
