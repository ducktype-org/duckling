function sitofp_rounding_test {} -> { i32 } {
	init_lany_type i32_val, i32;
	init_lany_type f32_val, f32;

	mov_l32_imm i32_val, 123456789;
	sitofp_l32_l32 f32_val, i32_val;
	fcmpEq_l32_imm f32_val, 123456790.0f32;
	jmpIfNot_label fail;

