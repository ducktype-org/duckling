function fptosi_test {} -> { i32 } {
	init_lany_type f32_val, f32;
	init_lany_type f64_val, f64;
	init_lany_type i32_val, i32;
	init_lany_type i64_val, i64;
	
	mov_l32_imm f32_val, -10.5f32;
	fptosi_l32_l32 i32_val, f32_val;
	cmpEq_l32_imm i32_val, -10;
	jmpIfNot_label fail;

	mov_l64_imm f64_val, -20.9;
	fptosi_l32_l64 i32_val, f64_val;
	cmpEq_l32_imm i32_val, -20;
	jmpIfNot_label fail;

	mov_l32_imm ret0, 1;
	ret;
	
	label fail;
	mov_l32_imm ret0, 0;
	ret;
}

