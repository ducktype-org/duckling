function sitofp_rounding_test {} -> { i32 } {
	init_pany_type i32_val, i32;
	init_pany_type f32_val, f32;

	mov_p32_imm i32_val, 123456789;
	sitofp_p32_p32 f32_val, i32_val;
	fcmpEq_p32_imm f32_val, 123456790.0f32;
	jmpIfNot_label fail;

	mov_p32_imm ret0, 1;
