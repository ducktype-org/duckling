	mov_p64_imm f64_val, 20.9;
	fptoui_p32_p64 u32_val, f64_val;
	cmpEq_p32_imm u32_val, 20;
	jmpIfNot_label fail;

	mov_p32_imm ret0, 1;
	ret;
	
