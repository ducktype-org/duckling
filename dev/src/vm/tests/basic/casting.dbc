function fptosi_saturation_test {} -> { i32 } {
	init_lany_type f64_val, f64;
	init_lany_type i32_val, i32;
	init_lany_type f32_val, f32;
	init_lany_type i8_val, i8;
	init_lany_type i16_val, i16;
	init_lany_type i64_val, i64;
	init_lany_type u8_val, u8;

	# > MAX_INT (2147483647)
	mov_l64_imm f64_val, 3000000000.0;
	fptosi_l32_l64 i32_val, f64_val;
	cmpEq_l32_imm i32_val, 2147483647;
	jmpIfNot_label fail;

	# < MIN_INT (-2147483648)
	mov_l64_imm f64_val, -3000000000.0;
	fptosi_l32_l64 i32_val, f64_val;
	cmpEq_l32_imm i32_val, -2147483648;
	jmpIfNot_label fail;

	# NaN -> 0
	mov_l32_imm f32_val, 0b01111111110000000000000000000000;
	fptosi_l32_l32 i32_val, f32_val;
	cmpEq_l32_imm i32_val, 0;
	jmpIfNot_label fail;

	# Inf -> MAX_INT
	mov_l32_imm f32_val, 0b01111111100000000000000000000000;
	fptosi_l32_l32 i32_val, f32_val;
	cmpEq_l32_imm i32_val, 2147483647;
	jmpIfNot_label fail;

	# -Inf -> MIN_INT
	mov_l32_imm f32_val, 0b11111111100000000000000000000000;
	fptosi_l32_l32 i32_val, f32_val;
	cmpEq_l32_imm i32_val, -2147483648;
	jmpIfNot_label fail;

	# f32 -> i8 saturation
	# > MAX_I8 (127)
	mov_l32_imm f32_val, 200.0f32;
	fptosi_l8_l32 i8_val, f32_val;
	cmpEq_l8_imm i8_val, 127;
	jmpIfNot_label fail;

	# < 0
	mov_l32_imm f32_val, -10.0f32;
	fptoui_l8_l32 u8_val, f32_val;
	cmpEq_l8_imm u8_val, 0;
	jmpIfNot_label fail;

	# < MIN_I8 (-128)
	mov_l32_imm f32_val, -200.0f32;
	fptosi_l8_l32 i8_val, f32_val;
	cmpEq_l8_imm i8_val, -128;
	jmpIfNot_label fail;

	# f32 -> i16 saturation
	# > MAX_I16 (32767)
	mov_l32_imm f32_val, 40000.0f32;
	fptosi_l16_l32 i16_val, f32_val;
	cmpEq_l16_imm i16_val, 32767;
	jmpIfNot_label fail;

	# < MIN_I16 (-32768)
	mov_l32_imm f32_val, -40000.0f32;
	fptosi_l16_l32 i16_val, f32_val;
	cmpEq_l16_imm i16_val, -32768;
	jmpIfNot_label fail;

	# f32 -> i32 saturation
	# > MAX_I32 (2147483647)
	mov_l32_imm f32_val, 3000000000.0f32;
	fptosi_l32_l32 i32_val, f32_val;
	cmpEq_l32_imm i32_val, 2147483647;
	jmpIfNot_label fail;

	# < MIN_I32 (-2147483648)
	mov_l32_imm f32_val, -3000000000.0f32;
	fptosi_l32_l32 i32_val, f32_val;
	cmpEq_l32_imm i32_val, -2147483648;
	jmpIfNot_label fail;

	# f32 -> i64 saturation
	# > MAX_I64
	mov_l32_imm f32_val, 10000000000000000000.0f32;
	fptosi_l64_l32 i64_val, f32_val;
	cmpEq_l64_imm i64_val, 0x7FFFFFFFFFFFFFFF;
	jmpIfNot_label fail;

	# < MIN_I64
	mov_l32_imm f32_val, -10000000000000000000.0f32;
	fptosi_l64_l32 i64_val, f32_val;
	cmpEq_l64_imm i64_val, 0x8000000000000000;
	jmpIfNot_label fail;

	# f32 -> u8 saturation
	# > MAX_U8 (255)
	mov_l32_imm f32_val, 300.0f32;
	fptoui_l8_l32 u8_val, f32_val;
	cmpEq_l8_imm u8_val, 255;
	jmpIfNot_label fail;

	mov_l32_imm ret0, 1;
	ret;
	
	label fail;
	mov_l32_imm ret0, 0;
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
	init_lany_type test_ret, i32;
	
	call_func sext_test;
	output_l32 test_ret;
	
	call_func zext_test;
	output_l32 test_ret;

	call_func trunc_test;
	output_l32 test_ret;

	call_func sitofp_test;
	output_l32 test_ret;

	call_func uitofp_test;
	output_l32 test_ret;

	call_func fptosi_test;
	output_l32 test_ret;

	call_func fptoui_test;
	output_l32 test_ret;

	call_func fptrunc_test;
	output_l32 test_ret;

	call_func fpext_test;
	output_l32 test_ret;

	call_func sitofp_rounding_test;
	output_l32 test_ret;

	call_func fptosi_saturation_test;
	output_l32 test_ret;

	deinit;
	deinit;
	deinit;
	ret;
}
