type primitive: f64 8
type primitive: f32 4
type primitive: u64 8
type primitive: u32 4
type primitive: u16 2
type primitive: u8 1

function sext_test {} -> { i32 } {
	init_lany_type i8_val, i8;
	init_lany_type i16_val, i16;
	init_lany_type i32_val, i32;
	init_lany_type i64_val, i64;

	mov_l8_imm i8_val, -1; # 0xFF
	
	# i8 -> i16
	sext_l16_l8 i16_val, i8_val;
	cmpEq_l16_imm i16_val, -1;
	jmpIfNot_label fail;

	# i8 -> i32
	sext_l32_l8 i32_val, i8_val;
	cmpEq_l32_imm i32_val, -1;
	jmpIfNot_label fail;
	
	# i8 -> i64
	sext_l64_l8 i64_val, i8_val;
	cmpEq_l64_imm i64_val, -1;
	jmpIfNot_label fail;

	mov_l16_imm i16_val, -1; # 0xFFFF
	
	# i16 -> i32
	sext_l32_l16 i32_val, i16_val;
	cmpEq_l32_imm i32_val, -1;
	jmpIfNot_label fail;

	# i16 -> i64
	sext_l64_l16 i64_val, i16_val;
	cmpEq_l64_imm i64_val, -1;
	jmpIfNot_label fail;

	mov_l32_imm i32_val, -1; # 0xFFFFFFFF
	
	# i32 -> i64
	sext_l64_l32 i64_val, i32_val;
	cmpEq_l64_imm i64_val, -1;
	jmpIfNot_label fail;

	mov_l32_imm ret0, 1;
	ret;

	label fail;
	mov_l32_imm ret0, 0;
	ret;
}

function zext_test {} -> { i32 } {
	init_lany_type u8_val, u8;
	init_lany_type u16_val, u16;
	init_lany_type u32_val, u32;
	init_lany_type u64_val, u64;

	mov_l8_imm u8_val, 0xFF; 
	
	# u8 -> u16
	zext_l16_l8 u16_val, u8_val;
	cmpEq_l16_imm u16_val, 255;
	jmpIfNot_label fail;

	# u8 -> u32
	zext_l32_l8 u32_val, u8_val;
	cmpEq_l32_imm u32_val, 255;
	jmpIfNot_label fail;
	
	# u8 -> u64
	zext_l64_l8 u64_val, u8_val;
	cmpEq_l64_imm u64_val, 255;
	jmpIfNot_label fail;

	mov_l16_imm u16_val, 0xFFFF;
	
	# u16 -> u32
	zext_l32_l16 u32_val, u16_val;
	cmpEq_l32_imm u32_val, 65535;
	jmpIfNot_label fail;
	
	# u16 -> u64
	zext_l64_l16 u64_val, u16_val;
	cmpEq_l64_imm u64_val, 65535;
	jmpIfNot_label fail;
	
	# u32 -> u64
	mov_l32_imm u32_val, -1; # Max u32
	zext_l64_l32 u64_val, u32_val;
	cmpEq_l64_imm u64_val, 4294967295;
	jmpIfNot_label fail;

	mov_l32_imm ret0, 1;
	ret;

	label fail;
	mov_l32_imm ret0, 0;
	ret;
}

function trunc_test {} -> { i32 } {
	init_lany_type u8_val, u8;
	init_lany_type u16_val, u16;
	init_lany_type u32_val, u32;
	init_lany_type u64_val, u64;

	# u16 -> u8
	mov_l16_imm u16_val, 0x1234;
	trunc_l8_l16 u8_val, u16_val;
	cmpEq_l8_imm u8_val, 0x34;
	jmpIfNot_label fail;

	# u32 -> u8
	mov_l32_imm u32_val, 0x12345678;
	trunc_l8_l32 u8_val, u32_val;
	cmpEq_l8_imm u8_val, 0x78;
	jmpIfNot_label fail;

	# u64 -> u8
	mov_l64_imm u64_val, 0x123456789ABCDEF0;
	trunc_l8_l64 u8_val, u64_val;
	cmpEq_l8_imm u8_val, 0xF0;
	jmpIfNot_label fail;

	# u32 -> u16
	mov_l32_imm u32_val, 0x12345678;
	trunc_l16_l32 u16_val, u32_val;
	cmpEq_l16_imm u16_val, 0x5678;
	jmpIfNot_label fail;

	# u64 -> u16
	mov_l64_imm u64_val, 0x123456789ABCDEF0;
	trunc_l16_l64 u16_val, u64_val;
	cmpEq_l16_imm u16_val, 0xDEF0;
	jmpIfNot_label fail;

	# u64 -> u32
	mov_l64_imm u64_val, 0x123456789ABCDEF0;
	trunc_l32_l64 u32_val, u64_val;
	cmpEq_l32_imm u32_val, 0x9ABCDEF0;
	jmpIfNot_label fail;

	mov_l32_imm ret0, 1;
	ret;

	label fail;
	mov_l32_imm ret0, 0; 
	ret;
}

function sitofp_test {} -> { i32 } {
	init_lany_type i32_val, i32;
	init_lany_type f32_val, f32;
	init_lany_type f64_val, f64;

	mov_l32_imm i32_val, -10;
	sitofp_l32_l32 f32_val, i32_val;
	fcmpEq_l32_imm f32_val, -10.0f32;
	jmpIfNot_label fail;

	sitofp_l64_l32 f64_val, i32_val;
	fcmpEq_l64_imm f64_val, -10.0;
	jmpIfNot_label fail;

	mov_l32_imm ret0, 1;
	ret;

	label fail;
	mov_l32_imm ret0, 0;
	ret;
}

