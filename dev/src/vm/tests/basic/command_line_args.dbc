# Should output a sum of numerical arguments passed to a program.

function main {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv

	init_lany_type sum, i64;
	init_lany_type temp, i64;

	label Loop;
		cmpEq_l64_l64       ret_val, arg0;  # i == argc
		jmpIf_label         End;
		# temp := argv[i]
		fixedSizeTableLoad_lany_lptr   temp, arg1;
		ext_l64             ret_val;

		add_l64_l64         sum, temp;      # sum += temp
		add_l64_imm         ret_val, 1;     # i++
		jmp_label           Loop;
	label End;

	output_l64 sum;
	mov_l64_imm ret_val, 0;

	deinit; # temp
	deinit; # sum
	deinit; # *argv
	deinit; # argc
	ret;
}
