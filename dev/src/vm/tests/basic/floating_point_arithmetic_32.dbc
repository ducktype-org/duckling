function foo {} -> i32 {
	init_lany_type		a, i32;
	init_lany_type		b, i32;
	init_lany_type	c, i32;

	# ======== Arithmetic =========
	mov_l32_imm 		b, 1056964608i32;	# b = 0.5
	mov_l32_l32 		a, b;				# a = 0.5

	fadd_l32_l32 		a, b;				# a = 1.0
	fadd_l32_imm		a, 1065353216;		# a = 2.0

	fcmpEq_l32_imm 		a, 1073741824;		# a == 2.0
	jmpIfNot_label 	fail;

	fsub_l32_l32 		a, b;				# a = 1.5
	fsub_l32_imm 		a, 1056964608;		# a = 1.0

	fcmpEq_l32_imm 		a, 1065353216;		# a == 1.0
	jmpIfNot_label 	fail;

	fmul_l32_l32 		a, b;				# a = 0.5
	fmul_l32_imm 		a, 1056964608;		# a = 0.25

	fcmpEq_l32_imm 		a, 1048576000;		# a == 0.25
	jmpIfNot_label 	fail;

	fdiv_l32_l32 		a, b;				# a = 0.5
	fdiv_l32_imm 		a, 1065353216;		# a = 0.5

	fneg_l32 			a;					# a = -0.5
	fneg_l32			b;					# b = -0.5

	fcmpEq_l32_l32 		a, b;
	jmpIfNot_label 		fail;

	
	# ======== Comparison tests =========
	mov_l32_imm		a, 1101004800;			# a = 20.0
	mov_l32_imm		b, 1092616192;			# b = 10.0
	mov_l32_l32		c, b;					# c = 10.0

	fcmpG_l32_l32		a, b;				# 20.0 > 10.0
	jmpIfNot_label	fail;
	fcmpG_l32_imm		b, 1101004800;		# 10.0 > 20.0
	jmpIf_label		fail;

	fcmpL_l32_l32		b, a;				# 10.0 < 20.0
	jmpIfNot_label	fail;
	fcmpL_l32_imm		a, 1092616192;		# 20.0 < 10.0
	jmpIf_label		fail;

	fcmpGe_l32_l32		a, b;				# 20.0 >= 10.0
	jmpIfNot_label	fail;
	fcmpGe_l32_l32		b, c;				# 10.0 >= 10.0
	jmpIfNot_label	fail;
	fcmpGe_l32_imm		b, 1101004800;		# 10.0 >= 20.0
	jmpIf_label		fail;

	fcmpLe_l32_l32		b, a;				# 10.0 <= 20.0
	jmpIfNot_label	fail;
	fcmpLe_l32_l32		b, c;				# 10.0 <= 10.0
	jmpIfNot_label	fail;
	fcmpLe_l32_imm		a, 1092616192;		# 20.0 <= 10.0
	jmpIf_label		fail;

	fcmpNeq_l32_l32		a, b;				# 20.0 != 10.0
	jmpIfNot_label	fail;
	fcmpNeq_l32_imm		b, 1092616192;		# 10.0 != 10.0
	jmpIf_label		fail;

	fcmpEq_l32_l32		b, c;				# 10.0 == 10.0
	jmpIfNot_label	fail;
	fcmpEq_l32_imm		a, 1092616192;		# 20.0 == 10.0
	jmpIf_label		fail;

	mov_l32_imm 		ret_val, 1056964608; # ret_val = 1.0
	ret;

	label fail;
	init_lany_type		tmp, i32;
	mov_l32_imm 		tmp, 1235;
	output_l32  		tmp;
	mov_l32_imm 		ret_val, 0;
	ret;
}

function main { i64, ptr_argv } -> i64 {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

	init_lany_type 	foo_ret_val, i32;

	call_func 	foo;
	output_l32 	foo_ret_val;

	deinit;
    deinit; # *argv
    deinit; # argc
	ret;
}
