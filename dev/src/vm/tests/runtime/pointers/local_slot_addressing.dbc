# A local whose block is created on demand sits above variables of mixed sizes, so the offset
# the lowering emits and the address its slot records have to agree.

function main { i64, ptr_argv } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type		a, i8;
	init_pany_type		b, i64;
	init_pany_type		c, i8;
	init_pany_type		d, i32;
	init_pany_type		target, i64;
	init_pany_type		source, i64;
	init_pany_type		ptr, ptr_i64;

	mov_p8_imm			a, 1;
	mov_p64_imm			b, 2;
	mov_p8_imm			c, 3;
	mov_p32_imm			d, 4;
	mov_p64_imm			target, 5;
	mov_p64_imm			source, 77;

	# `target` gets its block here, and writing through the pointer has to land on `target`
	# itself rather than on any of its differently sized neighbours.
	ref_pptr_pany		ptr, target;
	store_pptr_pany		ptr, source;

	output_p64			target;
	output_p64			b;
	output_p32			d;

	deinit; # ptr
	deinit; # source
	deinit; # target
	deinit; # d
	deinit; # c
	deinit; # b
	deinit; # a
	deinit; # *argv
	deinit; # argc
	ret;
}
