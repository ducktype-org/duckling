global_data counter i64 {}
global_data lock mutex {}

function inc {} -> {} {
    init_pany_type			temp, i64;
	init_pany_type			i, i64;
	mov_p64_imm				i, 10000;
	# while(i > 0)
	label Loop1;
		# i--
		sub_p64_imm			i, 1;

		init_pany_type		lock1, mutex;
		mov_popq_popq		lock1, lock;
		call_builtinfunc	builtin_lock_mutex;

		mov_p64_p64			temp, counter;
		add_p64_imm			temp, 1;
		mov_p64_p64			counter, temp;

		init_pany_type		lock2, mutex;
		mov_popq_popq		lock2, lock;
		call_builtinfunc	builtin_unlock_mutex;

		# if i > 0 goto Loop1
		cmpGt_p64_imm		i, 0;
		jmpIf_label			Loop1;

    ret;
}

function main { i64, ptr_argv } -> { i64 } {
    init_pany_type			lock1, mutex;
	call_builtinfunc		builtin_create_mutex;
	mov_popq_popq			lock, lock1;

	init_pany_type			thread_inc1_id, i64;
	setThreadCtx_func			inc;
    call_builtinfunc		builtin_start_thread;

	init_pany_type			thread_inc2_id, i64;
	setThreadCtx_func			inc;
    call_builtinfunc		builtin_start_thread;

	init_pany_type			join_inc1_ret, i64;
	init_pany_type			join_inc1_id, i64;
    mov_p64_p64				join_inc1_id, thread_inc1_id;
    call_builtinfunc		builtin_join_thread;	

	init_pany_type			join_inc2_ret, i64;
	init_pany_type			join_inc2_id, i64;
    mov_p64_p64				join_inc2_id, thread_inc2_id;
    call_builtinfunc		builtin_join_thread;

    init_pany_type			output_var, i64;
    mov_p64_p64				output_var, counter;
    output_p64				output_var;
	
	init_pany_type			lock2, mutex;
	mov_popq_popq			lock2, lock;
	call_builtinfunc		builtin_destroy_mutex;

    ret;
}
