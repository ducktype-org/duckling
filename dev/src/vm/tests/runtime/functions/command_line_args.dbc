# Should output a sum of numerical arguments passed to a program.

type dynamic_table: dtablei64 i64
type pointer: ptr_dtablei64 dtablei64

function main { i64, ptr_argv } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type sum, i64;
	init_pany_type temp, i64;
	init_pany_type res_arr_ptr, ptr_dtablei64;
	dynTableReAlloc_pptr_type_p64 res_arr_ptr, dtablei64, arg0;
	init_pany_type stoi_ret0, i64;
	mov_p64_imm ret0, 0;
	#output_p64 ret0;

	label ConvLoop;
		cmpEq_p64_p64 ret0, arg0;
		jmpIf_label EndConvLoop;
		init_pany_type stoi_arg, ptr_string;
		dynTableLoad_pany_pptr_p64 stoi_arg, arg1, ret0;
		call_builtinfunc builtin_stoi_pptr;
		dynTableStore_pptr_pany_p64 res_arr_ptr, stoi_ret0, ret0;
		add_p64_imm ret0, 1;
		jmp_label ConvLoop;


	label EndConvLoop;
		mov_p64_imm ret0, 0;

	label Loop;
		cmpEq_p64_p64       ret0, arg0;  # i == argc
		jmpIf_label         End;
		# temp := argv[i]
		dynTableLoad_pany_pptr_p64   temp, res_arr_ptr, ret0;

		add_p64_p64         sum, temp;      # sum += temp
		add_p64_imm         ret0, 1;     # i++
		jmp_label           Loop;
	label End;

	output_p64 sum;
	mov_p64_imm ret0, 0;

	free_pptr res_arr_ptr;
	deinit; # stoi_ret0
	deinit; # res_arr_ptr
	deinit; # temp
	deinit; # sum
	deinit; # *argv
	deinit; # argc
	ret;
}
