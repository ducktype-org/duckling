# Test's whether on function call the flag (result of the compare opcodes)
# is preserved after the call to another function.
# output == 1 <- test passed
# output == 0 <- test failed

function check {} -> {} {
	init_pany_type 		x, i64;
	mov_p64_imm         x,   15;
	cmpEq_p64_imm       x,   14;
	deinit;
	ret;
}

function main { i64, ptr_argv } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type           a, i64;
	init_pany_type           b, i64;

	mov_p64_imm         a,  1;
	cmpEq_p64_imm       a,  1;

	call_func          	check;

	mov_p64_imm         a,  1;
	mov_p64_imm         b,  0;

	# flag from cmpEq should be on
	jmpIf_label      ok_label;

	# print "0" (failed)
	output_p64          b;
	ret;

	label ok_label;
	# print "1" (passed)
	output_p64          a;

	deinit; # local_2
	deinit; # local_1
	deinit; # *argv
	deinit; # argc
	ret;
}
