# Tests whether variant data (here a pointer) is properly destructed.
# This means it is destructed exactly once.

type variant: IntOrPtr { i64, ptr{i64} }

function main {} -> { i64 } {
    init_pany_type v, IntOrPtr;
    variantSetInner_pvnt_type v, ptr{i64};
    init_pany_type p, ptr{ptr{i64}};
    variantGetInner_pptr_pvnt_type p, v, ptr{i64};

    init_pany_type ret_ptr, ptr{i64};
    ref_pptr_pany ret_ptr, ret0;

    store_pptr_pany p, ret_ptr;

    ret;
}
