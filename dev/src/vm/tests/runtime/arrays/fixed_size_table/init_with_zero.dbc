type fixed_size_table: tablei64 i64 2
type pointer: ptr_tablei64 tablei64

function main { i64, ptr_argv } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv

	init_pany_type           x, i64;
	init_pany_type           i, i64;
	init_pany_type           y, i64;
	init_pany_type           t, ptr_tablei64;

	alloc_pptr_type     t, tablei64;

	# x := t[0]
	mov_p64_imm         		i, 0;
	fixedSizeTableLoad_pany_pptr_p64   x, t, i;

	mov_p64_p64         y, x;

	# x := t[1]
	mov_p64_imm         		i, 1;
	fixedSizeTableLoad_pany_pptr_p64   x, t, i;

	add_p64_p64         y, x;

	output_p64          y;

	free_pptr           t;

	deinit;
	deinit;
	deinit;
	deinit;
	deinit; # *argv
	deinit; # argc
	ret;
}
