# ========== VIRTUAL METHOD DECLARATIONS ==============
type fun: method_toHumanYears {ptr{Animal}} {}

# ============ CLASSES DEFINITIONS ============
type class: Animal {
    abstract: true;
    virtual_methods: {
        toHumanYears: method_toHumanYears,
    };
}

type class: Dog {
    abstract: false;
    extends: Animal;
    implementations: {
        toHumanYears: dog_year_to_human_years,
    };
}

# ============ METHODS IMPLEMENTATION ============

# Implementation for Dog.
function dog_year_to_human_years {ptr{Dog}} -> {} {
    init_pany_type         call_res,      i64;
    init_pany_type         call_arg0,     i64;
    mov_p64_imm            call_arg0,       0;
    call_builtinfunc      builtin_output_i64;
    deinit;
    ret;
}

function main { i64, ptr{argv} } -> { i64 } {
    init_pany_type  dog_ptr, ptr{Dog};
    alloc_pptr_type dog_ptr, Dog;

    # vtable unset: setVTable_pptr_type  dog_ptr, Dog;
    virtualCall_pptr_method  dog_ptr, toHumanYears;

    ret;
}
