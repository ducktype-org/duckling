function main { i64, ptr{argv} } -> { i64 } {
    init_pany_type p, ptr{i64};
    init_pany_type value, i64;
    alloc_pptr_type p, i64;
    mov_p64_imm value, 5;
    store_pptr_pany p, value;

    free_pptr p;
    # Freeing the same block again has to be refused by the VM, not by the allocator.
    free_pptr p;

    ret;
}
