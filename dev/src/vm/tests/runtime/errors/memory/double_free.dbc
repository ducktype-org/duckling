function main { i64, ptr_argv } -> { i64 } {
    init_pany_type ptr, ptr_i64;
    init_pany_type value, i64;
    alloc_pptr_type ptr, i64;
    mov_p64_imm value, 5;
    store_pptr_pany ptr, value;

    free_pptr ptr;
    # Freeing the same block again has to be refused by the VM, not by the allocator.
    free_pptr ptr;

    ret;
}
