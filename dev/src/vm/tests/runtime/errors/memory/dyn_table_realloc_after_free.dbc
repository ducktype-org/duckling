function main { i64, ptr{argv} } -> { i64 } {
    init_pany_type count, i64;
    init_pany_type table_ptr, ptr{dyntable{i64}};
    mov_p64_imm count, 5;
    dynTableReAlloc_pptr_type_p64 table_ptr, dyntable{i64}, count;

    free_pptr table_ptr;
    # Reallocating freed data has to be refused by the VM, not by the allocator.
    mov_p64_imm count, 3;
    dynTableReAlloc_pptr_type_p64 table_ptr, dyntable{i64}, count;

    ret;
}
