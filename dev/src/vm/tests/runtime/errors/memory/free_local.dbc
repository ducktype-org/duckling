type primitive: i8 1
type variant: simple_variant { i64, i8 }
type pointer: ptr_simple_variant simple_variant

function main { i64, ptr_argv } -> { i64 } {
    init_pany_type v1, simple_variant;
    # Gives the variant a nested child block.
    variantSetInner_pvnt_type v1, i64;

    init_pany_type ptr, ptr_simple_variant;
    ref_pptr_pany ptr, v1;

    # Locals are not heap-allocated.
    free_pptr ptr;

    ret;
}
