type dynamic_table: dtablei64 i64

function main { i64, ptr{argv} } -> { i64 } {
    init_pany_type count, i64;
    init_pany_type table_ptr, ptr{dtablei64};
    mov_p64_imm count, 5;
    dynTableReAlloc_pptr_type_p64 table_ptr, dtablei64, count;

    free_pptr table_ptr;
    # A zero-element realloc frees the data, so it has to be refused as well.
    mov_p64_imm count, 0;
    dynTableReAlloc_pptr_type_p64 table_ptr, dtablei64, count;

    ret;
}
