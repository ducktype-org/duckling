type primitive: i8 1

function main { i64, ptr{argv} } -> { i64 } {
    init_pany_type p, ptr{variant{i64, i8}};
    alloc_pptr_type p, variant{i64, i8};
    variantSetInner_pptr_type p, i64;

    init_pany_type inner, ptr{i64};
    variantGetInner_pptr_pptr_type inner, p, i64;

    # The payload is a view into the variant, not an allocation of its own.
    free_pptr inner;

    ret;
}
