global_data g_arr fixtable{i64, 1} {
    initial_value: fixtable [ 0x000000000000002A ]
}

function main { i64, ptr{argv} } -> { i64 } {
    init_pany_type t_fst, ptr{fixtable{i64, 1}};
    init_pany_type t_dyn, ptr{dyntable{i64}};
    init_pany_type count, i64;

    ref_pptr_pany t_fst, g_arr;
    fstToDynTable_pptr_pptr t_dyn, t_fst;

    mov_p64_imm count, 5;
    dynTableReAlloc_pptr_type_p64 t_dyn, dyntable{i64}, count;

    deinit; # count
    deinit; # *t_dyn
    deinit; # *t_fst
    deinit; # *argv
    deinit; # argc
    ret;
}
