type primitive: byte 1
type dynamic_table: byte_array byte

function main { i64, ptr{argv} } -> { i64 } {
    init_pany_type size, i64;
    mov_p64_imm size, 9223372036854775808u64;  # 2^63
    output_p64 size;

    init_pany_type p, ptr{byte_array};
    dynTableReAlloc_pptr_type_p64 p, byte_array, size;  # alloc 2^63 bytes

    ret;
}
