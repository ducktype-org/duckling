type primitive: i8 1
type variant: i64_i8 { i64, i8}
type variant: big_variant {i64_i8, i64}
type variant: big_big_variant {big_variant, i64}

type pointer: big_big_variant_ptr big_big_variant
type pointer: big_variant_ptr big_variant
type pointer: i64_i8_ptr i64_i8
type pointer: i64_ptr i64

function main { i64, ptr_argv} -> { i64 } {
	# Create big_big_variant, set its value to big_variant->i64_i8->i64.
	init_pany_type v0, big_big_variant;
	variantSetInner_pvnt_type v0, big_variant;
	init_pany_type my_ptr, big_variant_ptr;

	variantGetInner_pptr_pvnt_type my_ptr, v0, big_variant;

	variantSetInner_pptr_type my_ptr, i64_i8;

	init_pany_type my_ptr2, i64_i8_ptr;
	variantGetInner_pptr_pptr_type my_ptr2, my_ptr, i64_i8;

	variantSetInner_pptr_type my_ptr2, i64;

	init_pany_type my_ptr3, i64_ptr;
	variantGetInner_pptr_pptr_type my_ptr3, my_ptr2, i64;

	# Read i64 value, and save it in big_big_variant v0.
	init_pany_type value, i64;
	input_p64 value;

	store_pptr_pany my_ptr3, value;


	init_pany_type read_val, i64;
	load_pany_pptr read_val, my_ptr3;

	# Create another big_big_variant v1 and copy v0 there
	init_pany_type v1, big_big_variant;
	init_pany_type ptr_to_first, big_big_variant_ptr;
	ref_pptr_pany ptr_to_first, v0;

	load_pany_pptr v1, ptr_to_first;

	# Change v0 by adding 10 to it.
	add_p64_imm read_val, 10;
	store_pptr_pany my_ptr3, read_val;
	
	# Print value of v1, it should be what we read firstly.
	variantGetInner_pptr_pvnt_type my_ptr, v1, big_variant;

	variantGetInner_pptr_pptr_type my_ptr2, my_ptr, i64_i8;

	variantGetInner_pptr_pptr_type my_ptr3, my_ptr2, i64;

	load_pany_pptr read_val, my_ptr3;
	output_p64 read_val;	

	ret;
}
