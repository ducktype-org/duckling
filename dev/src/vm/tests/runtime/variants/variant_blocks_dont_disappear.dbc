type primitive: i8 1
type variant: simple_variant { i64, i8 }

function main { i64, ptr_argv } -> { i64 } {
    init_pany_type v1, simple_variant;
    variantSetInner_pvnt_type v1, i64;

    init_pany_type value, i64;
    input_p64 value;

    init_pany_type ptr, ptr_i64;
    variantGetInner_pptr_pvnt_type ptr, v1, i64;

    store_pptr_pany ptr, value;

    deinit; # ptr

    init_pany_type new_ptr, ptr_i64;
    variantGetInner_pptr_pvnt_type new_ptr, v1, i64;

    mov_p64_imm value, 0;
    load_pany_pptr value, new_ptr;

    output_p64 value;

    ret;
}
