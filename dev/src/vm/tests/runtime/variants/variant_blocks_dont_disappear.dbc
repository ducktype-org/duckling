type primitive: i8 1

function main { i64, ptr{argv} } -> { i64 } {
    init_pany_type v1, variant{i64, i8};
    variantSetInner_pvnt_type v1, i64;

    init_pany_type value, i64;
    input_p64 value;

    init_pany_type p, ptr{i64};
    variantGetInner_pptr_pvnt_type p, v1, i64;

    store_pptr_pany p, value;

    deinit; # ptr

    init_pany_type new_ptr, ptr{i64};
    variantGetInner_pptr_pvnt_type new_ptr, v1, i64;

    mov_p64_imm value, 0;
    load_pany_pptr value, new_ptr;

    output_p64 value;

    ret;
}
