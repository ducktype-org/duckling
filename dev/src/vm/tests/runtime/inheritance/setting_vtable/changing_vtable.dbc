# ========== VIRTUAL METHOD DECLARATIONS ==============
type fun: method_toHumanYears {ptr{Animal}} {}

# ============ CLASSES DEFINITIONS ============
type class: Animal {
    abstract: true;
    virtual_methods: {
        toHumanYears: method_toHumanYears,
    };
}

type class: Dog {
    abstract: false;
    extends: Animal;
    implementations: {
        toHumanYears: dog_year_to_human_years,
    };
}

type class: Chiuaua {
    abstract: false;
    extends: Dog;
    implementations: {
        toHumanYears: chiuaua_year_to_human_years,
    };
}


# ============ METHODS IMPLEMENTATION ============

# Implementation for Dog.
function dog_year_to_human_years {ptr{Dog}} -> {} {
    init_pany_type         call_res,      i64;
    init_pany_type         call_arg,      i64;
    mov_p64_imm            call_arg,        0;
    call_builtinfunc      builtin_output_i64;
    deinit;
    ret;
}

# Implementation for Chiuaua.
function chiuaua_year_to_human_years {ptr{Chiuaua}} -> {} {
    init_pany_type         call_res,      i64;
    init_pany_type         call_arg,      i64;
    mov_p64_imm            call_arg,        1;
    call_builtinfunc      builtin_output_i64;
    deinit;
    ret;
}

function main { i64, ptr{argv} } -> { i64 } {
    init_pany_type  chiuaua_ptr, ptr{Chiuaua};
    alloc_pptr_type chiuaua_ptr, Chiuaua;
    setVTable_pptr_type  chiuaua_ptr, Chiuaua;

    init_pany_type temp1, ptr{Chiuaua};
    mov_pptr_pptr temp1, chiuaua_ptr;
    virtualCall_pptr_method  temp1, toHumanYears;

    init_pany_type  dog_ptr, ptr{Dog};
	upcast_pptr_pptr dog_ptr, chiuaua_ptr;

    setVTable_pptr_type  dog_ptr, Dog;
    virtualCall_pptr_method  dog_ptr, toHumanYears;

    free_pptr chiuaua_ptr;

    ret;
}
