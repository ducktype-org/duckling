type class: Animal {
	abstract: true;
}
type class: Dog {
	extends: Animal;
}
type class: Cat {
	extends: Animal;
}


function main { i64, ptr{argv} } -> { i64 } {
	# ret0 -> main ret0
	# arg0 -> argc
	# arg1 -> *argv
	init_pany_type dog, ptr{Dog};
	init_pany_type animal, ptr{Animal};
	alloc_pptr_type dog, Dog;
	setVTable_pptr_type dog, Dog;
	upcast_pptr_pptr animal, dog;  # animal := static_cast<AnimalPtr>(dog)

	free_pptr dog;
	
	ret;
}

