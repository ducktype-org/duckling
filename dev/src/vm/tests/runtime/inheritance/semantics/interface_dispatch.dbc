type fun: method_I1_void {ptr{I1}} {}
type fun: method_parent_void {ptr{Parent}} {}
type fun: method_child_void {ptr{Child}} {}

type interface: I1 {
    virtual_methods: { 
        foo: method_I1_void, 
        bar: method_I1_void,
    };
    implementations: { 
        foo: I1_foo_default_impl_type,
    };
}

type class: Parent {
    virtual_methods: { 
        getAge: method_parent_void,
    };
    implementations: {
        getAge: Parent_getAge_impl_type, 
    };
}

type class: Child {
    extends: Parent;
    abstract: false;
    implements: {I1};
    virtual_methods: { 
        cry: method_child_void,
    };
    implementations: {
        getAge: Child_getAge_impl_type,
        bar: Child_I1_bar_impl_type, 
        cry: Child_cry_impl_type,
    };
}

# ============ METHODS IMPLEMENTATION ============ 
function I1_foo_default_impl_type {ptr{I1}} -> {} {
    init_pany_type res, i64; mov_p64_imm res, 11; output_p64 res; deinit; deinit; ret;
}
function Child_I1_bar_impl_type {ptr{Child}} -> {} {
    init_pany_type res, i64; mov_p64_imm res, 22; output_p64 res; deinit; deinit; ret;
}
function Parent_getAge_impl_type {ptr{Parent}} -> {} {
    init_pany_type res, i64; mov_p64_imm res, 33; output_p64 res; deinit; ret;
}
function Child_getAge_impl_type {ptr{Child}} -> {} {
    init_pany_type res, i64; mov_p64_imm res, 44; output_p64 res; deinit; deinit; ret;
}
function Child_cry_impl_type {ptr{Child}} -> {} {
    init_pany_type res, i64; mov_p64_imm res, 55; output_p64 res; deinit; deinit; ret;
}

function main { i64, ptr{argv} } -> { i64 } {
    init_pany_type ptr_i1, ptr{I1};
    init_pany_type ptr_parent, ptr{Parent};
    init_pany_type ptr_child, ptr{Child};

    init_pany_type actual_child, ptr{Child};

    # --- Object Child, pointer I1* ---
    alloc_pptr_type actual_child, Child;
    setVTable_pptr_type actual_child, Child;
    upcast_pptr_pptr ptr_i1, actual_child;

    init_pany_type temp_this_i1_foo, ptr{I1};
    mov_pptr_pptr temp_this_i1_foo, ptr_i1;
    virtualCall_pptr_method ptr_i1, foo; # Expected: 11

    init_pany_type temp_this_i1_bar, ptr{I1};
    mov_pptr_pptr temp_this_i1_bar, ptr_i1;
    virtualCall_pptr_method ptr_i1, bar; # Expected: 22

    # --- Same Child object, pointer Parent* ---
    upcast_pptr_pptr ptr_parent, actual_child;

    init_pany_type temp_ptr_parent, ptr{Parent};
    mov_pptr_pptr temp_ptr_parent, ptr_parent ;
    virtualCall_pptr_method ptr_parent, getAge; # Expected: 44

    # --- Same Child object, pointer Child* ---
    mov_pptr_pptr ptr_child, actual_child;
    init_pany_type temp_this_child_cry, ptr{Child};
    mov_pptr_pptr temp_this_child_cry, ptr_child;
    virtualCall_pptr_method ptr_child, cry; # Expected: 55

    free_pptr actual_child;

    deinit;
    deinit;
    deinit;
    deinit;
    ret;
}