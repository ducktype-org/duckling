function main {
    arg_size: 0;
	next_arg_size: 0;
    ret_size: 8;
    
    # n - 0
    # m - 8
    # a - 16
    # b - 24
    # c - 32
    
    local_size: 40;
    
    code: {
        # n := argument
        input_l64           0;
        input_l64           8;
        
        # a = 0
        mov_l64_imm         16, 0;
        # b = 1
        mov_l64_imm         24, 1;

        # while(x > 0)
        label Loop;
            # c = (a + b) % m
            mov_l64_l64     32, 16;
            add_l64_l64     32, 24;
            mod_l64_l64     32, 8;
            # a = b
            mov_l64_l64     16, 24;
            # b = c
            mov_l64_l64     24, 32;

            # x--;
            sub_l64_imm     0, 1;
            
            # if x > 0 : end
            cmpGt_l64_imm    0, 0;
            jmpRelIf_label  Loop;

        output_l64      16;
        ret_l64         16;       
    }
}
