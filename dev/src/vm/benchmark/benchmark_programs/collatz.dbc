# For a given x the program calculates a collatz sequence
# for each number from [1, x) and returns a maximum value
# reached in any of this sequences.
# For example, for x = 4:
# collatz(1) -> [1], max is 1
# collatz(2) -> [2, 1], max is 2.
# collatz(3) -> [3, 10, 5, 16, 8, 4, 2, 1], max is 16.
# Thus, the program should output 16.

type fun: collatz { i64 } i64

function collatz {
	# ret_val - 0
	# n - 8 (value for which the collatz sequence is calculated)
	# max - 16 (maximum value in the calculated collatz sequence)
	# tmp - 24

	# [0, 8) ret_val
	# [8, 16) arg0 -> n

	init_type		i64; # [16, 24) max
	init_type		i64; # [24, 32) tmp

	mov_p64_p64		16, 8; # max := n

	# if n == 1: end
	cmpEq_p64_imm         8, 1;
	jmpIf_label        End;

	# do-while (n != 1):
	label WhileNneq0;
		# if n % 2 == 0:

		# if condition:
			mov_p64_p64         24, 8; # tmp := n
			mod_p64_imm         24, 2; # tmp %= 2
			cmpEq_p64_imm       24, 0;
			jmpIf_label      else;

		# if code:
			# n = 3n + 1;
			mul_p64_imm		    8, 3;
			add_p64_imm         8, 1;
			jmp_label        afterIf;

		# else
			label else;

			# else code:
				# n = n / 2
				div_p64_imm  8, 2;

		label afterIf;

		# if n > max:
		cmpGt_p64_p64     	8, 16;
		cmov_p64_p64     	16, 8; # max := n

		# if n == 1
		cmpEq_p64_imm       8, 1;
		jmpIfNot_label   WhileNneq0;

		# cmpGt_p64_imm       8, 1;
		# jmpIf_label   WhileNneq0;

	label End;

	# return max
	mov_p64_p64 	0, 16; # ret_val := max

	deinit; # tmp
	deinit; # max
	deinit; # arg0
	ret;
}


function main { i64, ptr_argv } -> i64 {
	# [0, 8) -> main ret_val
    # [8, 16) -> argc
    # [16, 32) -> *argv

	# x - 8
	# max - 16
	# i - 24
	# tmp - 32

	init_type 		i64; 	# [8, 16) x
	init_type 		i64; 	# [16, 24) max
	init_type 		i64; 	# [24, 32) i
	init_type 		i64; 	# [32, 40) tmp

	input_p64       32; 		# x := input
	mov_p64_imm     40, 0; 	# max := 0
	mov_p64_imm     48, 1; 	# i := 1

	# do-for (i < x; i++)
	label Loop;
		# tmp := collatz(i)
		init_type 			i64; 		# [40, 48) collatz(i) ret_val
		init_type 			i64; 		# [48, 56) collatz(i) arg0

		mov_p64_p64 		72, 48;		# arg0 := i
		call_func          	collatz;
		mov_p64_p64 		56, 64; 	# tmp := collatz(i)
		deinit; 						# deinit collatz(i) ret_val

		# if tmp > max:
		cmpGt_p64_p64       	56, 40;
		jmpIfNot_label  	EndIF;
			mov_p64_p64    	40, 56; 	# max := tmp

		label EndIF;

		add_p64_imm      	48, 1; 		# i := i + 1

		# if x > i : end
		cmpGt_p64_p64     	32, 48;
		jmpIf_label   	Loop;

	output_p64      40;

	deinit; # tmp
	deinit;	# i
	deinit;	# max
	deinit;	# x
    deinit; # *argv
    deinit; # argc
	ret;
}
