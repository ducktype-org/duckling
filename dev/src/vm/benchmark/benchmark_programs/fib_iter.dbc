function main { i64, ptr_argv } -> { i64 } {
    # [0, 8) main ret_val_0
    # [8, 16) -> argc
    # [16, 32) -> *argv

    # n - 32
    # m - 40
    # a - 48
    # b - 56
    # c - 64

    init_type       i64; # [32, 40)
    init_type       i64; # [40, 48)

    input_l64       32; # n := argument
    input_l64       40; # m (modulo)

    init_type       i64; # [48, 56) a
    init_type       i64; # [56, 64) b

    mov_l64_imm     48, 0; # a = 0
    mov_l64_imm     56, 1; # b = 1

    # while(x > 0)
    label Loop;
        # c = (a + b) % m
        init_type       i64; # [64, 72) c

        mov_l64_l64     64, 48;
        add_l64_l64     64, 56;
        mod_l64_l64     64, 40;
        # a = b
        mov_l64_l64     48, 56;
        # b = c
        mov_l64_l64     56, 64;

        # n--;
        sub_l64_imm    32, 1;

        deinit; # c

        # if n > 0 : end
        cmpGt_l64_imm    32, 0;
        jmpIf_label  Loop;

    output_l64      48;

    deinit; # b
    deinit; # a
    deinit; # m
    deinit; # n
    deinit;       # *argv
    deinit;       # argc
    ret;
}
