type fun: run_every_opcode {} {}

function run_every_opcode {
    init_type i64; # [0, 8) tmp1
    init_type i64; # [8, 16) tmp2
    init_type i64; # [16, 24) tmp3

    mov_l64_imm            0, 0;
    mov_l64_l64            8, 0;
    cmov_l64_l64           8, 0;
    mov_l64_r0               0;
    mov_r0_l64               0;
    add_l64_l64  0, 8;
    add_l64_imm  8, 10;
    sub_l64_l64  0, 8;
    sub_l64_imm  0, 0;
    mul_l64_imm  0, 0;
    mod_l64_imm  0, 1;
    mod_l64_l64  0, 8;
    div_l64_imm  0, 1;
    cmpEq_l64_l64 0, 8;
    cmpEq_l64_imm 0, 0;
    cmpGt_l64_l64  0, 8;
    cmpGt_l64_imm  0, 0;
    jmp_label Here;
    label Here;
    jmpIf_label Here2;
    label Here2;
    jmpIfNot_label Here3;
    label Here3;

    deinit; # tmp3
    deinit; # tmp2
    deinit; # tmp1

    ret;
}


function main { i64, ptr_argv } -> { i64 } {
    # [0, 8) main ret0
    # [8, 16) argc
    # [16, 32) *argv
    init_type       i64; # [32, 40) x

    input_l64       32;
    label Loop;
        call_func           run_every_opcode;
        call_func           run_every_opcode;
        call_func           run_every_opcode;
        call_func           run_every_opcode;
        call_func           run_every_opcode;

        sub_l64_imm         32, 1;
        cmpEq_l64_imm       32, 0;
        jmpIfNot_label   Loop;

    deinit; # x
    deinit; # *argv
    deinit; # argc
    ret;
}
