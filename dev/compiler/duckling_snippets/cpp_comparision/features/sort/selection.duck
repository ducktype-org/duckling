import std.io;

template {T}
fun sort(data: ref List:{T}) = {
    for (i in data) {
        var min = i;
        for (j in data[i:]) { # czy mamy slice?
            if (j < min) min = j;
        }
        swap(i, min);
    }
}

fun main() = {
    var n: i32;
    var data: List:{i32};

    io.scan(n);
    for (i in 1..n) {
        var tmp: int;
        io.scan(tmp);
        data.append(tmp);
    }

    sort(data);

    for (i in 1..n) {
        io.print(data[i], " ");
    }
    io.print("\n");
}
