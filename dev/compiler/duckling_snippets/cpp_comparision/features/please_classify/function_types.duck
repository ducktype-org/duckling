import std.io as io;

template{T, U}
fun map(list: List:{T}, modifier: const ref T -> U) -> List:{U} = {
	var result: List:{U};
	for(el in list) {
		result.append(modifier(el));
	}
	return result;
}

template{T}
fun filter(list: List:{T}, condition: const ref T -> Bool) -> List:{T} = {
	var result: List:{T};
	for(el in list) {
		if (condition(el)) {
			result.append(modifier(el));
		}
	}
	return result;
}

