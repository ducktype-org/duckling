import std.{set, min, abs};

fun main() = {
    var n: i32;
    scan(n);
    
    let s1: set:{(i64,i64,i32)};
    let s2: set:{(i64,i64,i32)};

    var x: i64, y: i64;
    var ODW: i64[n+7];
    var Neigh: (i32,i64)[n+7];
    for (i in 0..n) {
        scan(x,y);
        s1.insert((x,y,i));
        s2.insert((x,y,i));
    }
    ODW[0]=0;
    for (i in 1..n+5)
        ODW[i]=-1;
    var wyspa1 = *(s1.begin()); # todo ???
    s1.pop();
    while (not s1.empty()) {
        let wyspa2 = *(s1.begin()); # todo ???
        s1.pop();
        let dist : i64 = min(abs(wyspa1[0] - wyspa2[0]), abs(wyspa1[1] - wyspa2[1]));
        Neigh[wyspa1[2]].push_back((wyspa2[2], dist));
        Neigh[wyspa2[2]].push_back((wyspa1[2], dist));
        wyspa1 = wyspa2;
    }
    wyspa1 = *(s2.begin());
    s2.pop();
    while (not s2.empty()) {
        let wyspa2 = *(s2.begin());
        s2.pop();
        let dist : i64 = min(abs(wyspa1[0] - wyspa2[0]), abs(wyspa1[1] - wyspa2[1]));
        Neigh[wyspa1[2]].push_back((wyspa2[2], dist));
        Neigh[wyspa2[2]].push_back((wyspa1[2], dist));
        wyspa1 = wyspa2;
    }
    let q = set((i54,i32))();
    for (i in 0..Neigh[0].size()) {
        let wyspa = Neigh[0][i][0];
        ODW[wyspa] = Neigh[0][i][1];
        q.insert((-ODW[wyspa], wyspa));
    }
    while (not q.empty()) {
        let wyspa = *(q.begin())[1];
        q.pop();
        for (i in 0..Neigh[wyspa].size()) {
            let (cel, sciezka) = Neigh[wyspa][i];
            if (ODW[cel] > sciezka + ODW[wyspa] or ODW[cel] == -1) {
                ODW[cel] = ODW[wyspa] + sciezka;
                q.insert((-ODW[cel],cel));
                if (cel == n-1 and ODW[cel] == 0) {
                    printLn(0);
                    return;
                }
            }
        }
    }
    printLn(ODW[n-1]);
}
