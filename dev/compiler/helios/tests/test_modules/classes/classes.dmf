class FirstClassEver {
    a: i32 = 0;
    b: f32 = 0;

    fun getA() -> i32 = {
        return a;
    }
    fun setA(new_a: i32) = {
        a = new_a;
    }

    private {
        FirstClassEver.copy(FirstClassEver other) = {
            a = other.a;
            b = other.b;
        }
    }

    FirstClassEver.destroy() = {}
}

class SecondClass extends FirstClassEver {}
