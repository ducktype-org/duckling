+/*
+ * Checks whether TaskFunction<R> can wrap F bound to Args.
+ *
+ * Self is TaskFunction<R> itself. The check for it has to short circuit through if constexpr
+ * instead of a && chain in the requires clause: asking whether TaskFunction is nothrow move
+ * constructible performs overload resolution over its constructors, which evaluates this very
+ * constraint again. A conjunction of atomic constraints does not stop that recursion because
+ * every atom is still substituted into, so clang rejects it outright while gcc accepts it.
+ */
+template<typename Self, typename R, typename F, typename... Args>
+constexpr bool isTaskCallable()
+{
+	if constexpr(std::same_as<std::decay_t<F>, Self>)
+		return false;
+	else
+		return std::is_invocable_r_v<R, std::decay_t<F>, std::decay_t<Args>...> &&
+		       std::is_nothrow_move_constructible_v<std::decay_t<F>> &&
+		       (std::is_nothrow_move_constructible_v<std::decay_t<Args>> && ...) &&
+		       (std::constructible_from<std::decay_t<Args>, Args&&> && ...);
+}
+
+} // namespace detail
+
