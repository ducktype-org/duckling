{
    "name": "rift-support",
    "displayName": "Rift Language Support",
    "description": "Extension for RIFT language with Language Server",
    "version": "0.0.1",
    "author": "zpp-2.1",
    "categories": [
        "Programming Languages"
    ],
    "engines": {
        "vscode": "^1.84.0"
    },
    "main": "./client/out/extension",
    "activationEvents": [
        "onLanguage:rift"
    ],
    "contributes": {
        "languages": [
            {
                "id": "rift",
                "aliases": [
                    "Rift",
                    "rift"
                ],
                "extensions": [
                    ".rift"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "rift",
                "scopeName": "source.rift",
                "path": "./syntaxes/rift.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Rift Language Configuration",
            "properties": {
                "RiftLanguageServer.maxNumberOfProblems": {
                    "scope": "resource",
                    "type": "number",
                    "default": 100,
                    "description": "Controls the maximum number of problems produced by the server."
                },
                "RiftLanguageServer.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the Rift language server."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -b",
        "watch": "tsc -b -w",
        "lint": "eslint ./client/src ./server/src --ext .ts,.tsx",
        "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
        "test": "sh ./scripts/e2e.sh"
    },
    "devDependencies": {
        "@types/mocha": "^9.1.0",
        "@types/node": "^16.18.34",
        "@types/webpack-env": "^1.18.4",
        "@typescript-eslint/eslint-plugin": "^6.7.0",
        "@typescript-eslint/parser": "^6.7.0",
        "eslint": "^8.35.0",
        "mocha": "^9.2.1",
        "typescript": "^5.2.2"
    },
    "license": "MIT",
    "keywords": [
        "Rift",
        "language server",
        "programming language",
        "lsp",
        "syntax highlighting"
    ]
}
