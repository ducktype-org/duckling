PROJECT_NAME = "Duckling Code Docs"
SOURCE_BROWSER = YES

# General options
INPUT = "@DOXYGEN_INPUT_DIR@"
OUTPUT_DIRECTORY = "@DOXYGEN_OUTPUT_DIR@"
GENERATE_XML = YES
RECURSIVE = YES
FILE_PATTERNS = *.hpp *.cpp *.md
EXCLUDE_PATTERNS = "@PROJECT_SOURCE_DIR@/*build*/*" \
                   "@PROJECT_SOURCE_DIR@/docs/*" \
                   */toolbox.py \
                   "@PROJECT_SOURCE_DIR@/*/examples/*" \
                   "@PROJECT_SOURCE_DIR@/*/tests/*"
# Examples should be excluded not to generate docs for classes and functions in examples.

# Code snippets and code examples options
EXAMPLE_PATH = "@DOXYGEN_INPUT_DIR@"
EXAMPLE_RECURSIVE = YES

# Images
IMAGE_PATH = "@PROJECT_SOURCE_DIR@"
# Path to images should be relative to dev directory.

# Graph look options
HAVE_DOT = YES
DOT_IMAGE_FORMAT = svg
INTERACTIVE_SVG = YES # To handle large graphs (they were cut off before)
INCLUDED_BY_GRAPH = NO
UML_LOOK = YES
DOT_UML_DETAILS = NONE

# Macro preprocessing options
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
EXPAND_ONLY_PREDEF = YES
ALIASES += "query=\xrefitem query \"Query\" \"Queries\"" \
            "TODO=\todo" \
            "tip=\remark" \
            "hint=\remark" \
            "important=\attention" \
            "NOTE=\note"
PREDEFINED = "DECLARE_QUERY(name, key, value)=auto name(key) -> value;/**< \query \ref ImplementationOf_##name \"Implementation\" */" \
            "STRONG_TYPEDEF_ID(name)=using name = u64;" \
            "IMPLEMENT_QUERY(name, PResult)=ImplementationOf_##name final: public query::QueryImplementation<name, PResult>" \
            "QUERY_IMPLEMENTATION_BOILERPLATE(name)=" \
            "COMMA=," \
            "MAKE_STRINGIFYABLE_ENUM(namespace_name, base_type, name, ...)=namespace namespace_name { enum class name : base_type { __VA_ARGS__, COUNT }; }"

# Currently unused left for potential future 
# FILTER_PATTERNS = "*.hpp=python @CMAKE_CURRENT_SOURCE_DIR@/doxygen-ext/format_fixer.py"

EXTRACT_ALL = YES
ALLOW_UNICODE_NAMES    = NO

# If you use STL classes (i.e. std::string, std::vector, etc.) but do not want
# to include (a tag file for) the STL sources as input, then you should set this
# tag to YES in order to let doxygen match functions declarations and
# definitions whose arguments contain STL classes (e.g. func(std::string);
# versus func(std::string) {}). This also make the inheritance and collaboration
# diagrams that involve STL classes more complete and accurate.
# The default value is: NO.

BUILTIN_STL_SUPPORT    = YES

# The size of the symbol lookup cache can be set using LOOKUP_CACHE_SIZE. This
# cache is used to resolve symbols given their name and scope. Since this can be
# an expensive process and often the same symbol appears multiple times in the
# code, doxygen keeps a cache of pre-resolved symbols. If the cache is too small
# doxygen will become slower. If the cache is too large, memory is wasted. The
# cache size is given by this formula: 2^(16+LOOKUP_CACHE_SIZE). The valid range
# is 0..9, the default is 0, corresponding to a cache size of 2^16=65536
# symbols. At the end of a run doxygen will report the cache usage and suggest
# the optimal cache size from a speed point of view.
# Minimum value: 0, maximum value: 9, default value: 0.

LOOKUP_CACHE_SIZE      = 4


# If the EXTRACT_PRIVATE tag is set to YES all private members of a class will
# be included in the documentation.
# The default value is: NO.

EXTRACT_PRIVATE        = YES

# If the EXTRACT_STATIC tag is set to YES all static members of a file will be
# included in the documentation.
# The default value is: NO.

EXTRACT_STATIC         = YES


# For doxygen-awesome:

GENERATE_TREEVIEW = YES # optional. Also works without treeview
DISABLE_INDEX     = NO
FULL_SIDEBAR      = NO
HTML_EXTRA_STYLESHEET  = "@CMAKE_CURRENT_SOURCE_DIR@/doxygen-awesome-css/doxygen-awesome.css" "@CMAKE_CURRENT_SOURCE_DIR@/doxygen-ext/doxygen_custom.css"
HTML_COLORSTYLE        = LIGHT

# To customize layout
# Currently the only change is to make "Detailed Description" appear at the top of documentation website of every "file"
LAYOUT_FILE = "@CMAKE_CURRENT_SOURCE_DIR@/doxygen-ext/DoxygenLayout.xml"