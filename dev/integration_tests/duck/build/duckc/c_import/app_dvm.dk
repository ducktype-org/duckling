# Same checks as app_native.dk minus the constants: the DVM backend does not link package
# dependencies, so any symbol from another package is unresolved at load (#3645). That is
# unrelated to the generated bindings, whose `extern("C")` declarations are resolved by dlopen.
import core.builtins.*;
import mylib.mylib.*;

fun main() -> i64 = {
    if (mylib_add(2i32, 3i32) != 5i32) { return 1i64; }
    if (mylib_point_sum(struct_mylib_point(3i32, 4i32)) != 7i32) { return 2i64; }

    let p = mylib_point_make(5i32, 6i32);
    if (p.x != 5i32 or p.y != 6i32) { return 3i64; }

    if (mylib_neg_char(3i8) != -3i8) { return 4i64; }

    return 0i64;
}
