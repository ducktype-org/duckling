# With --split each header becomes its own module, so the header name is part of the import path.
import core.builtins.*;
import shapes.mylib.*;
import shapes.mylib_extra.*;

fun main() -> i64 = {
    if (mylib_add(2i32, 3i32) != 5i32) { return 1i64; }
    if (mylib_extra_scaled_sum(struct_mylib_point(3i32, 4i32), 2i32) != 14i32) { return 2i64; }
    return 0i64;
}
