import core.builtins.*;

# A top-level `var` initializer must run in source order, interleaved with the
# surrounding top-level statements, not eagerly before them.

fun first() -> String = {
	builtin_output_i64(1);
	return "3\n".toString();
}

fun second() = {
	builtin_output_i64(2);
}

second();
var b = first();
print(&b);
