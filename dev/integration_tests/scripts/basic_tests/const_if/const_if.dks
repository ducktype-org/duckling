template(T: type)
fun pick() -> i64 = {
	if const (T == char) {
		return 1;
	} else if const (T == str) {
		return 2;
	} else {
		# Never compiled for the instantiations below.
		return this_function_does_not_exist();
	}
}

# The condition is false, so the body is never compiled.
if const (1 == 2) {
	builtin_output_i64(this_function_does_not_exist());
}

builtin_output_i64(pick[char]());
builtin_output_i64(pick[str]());
