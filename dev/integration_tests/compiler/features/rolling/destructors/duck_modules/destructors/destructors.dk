import core.builtins.*;

# A class with a user-defined destructor, printing its id when it dies.
class Res {
    id: i64 = 0;

    Res.destroy() = {
        builtin_output_i64(id);
    }
}

class Holder {
    boxed: box i64;
    res: Res;
}

var g_holder: Holder = Holder(new 100i64, Res(101));
var g_res: Res = Res(102);

fun scoped() = {
    var a: Res = Res(1);
    {
        var b: Res = Res(2);    # 2
    };
    builtin_output_i64(3);      # 3
}                               # 1

fun assigned() = {
    var a: Res = Res(4);
    a = Res(5);                 # 4
    builtin_output_i64(6);      # 6
}                               # 5

fun nested() = {
    var h: Holder = Holder(new 7i64, Res(8));
    var boxed_value: i64 = h.boxed;
    builtin_output_i64(boxed_value);    # 7
}                                       # 8

# Returning a `Holder` by value hands it over to the caller, so it is not destroyed here.
fun makeHolder(boxed: i64, res_id: i64) -> Holder = {
    return Holder(new boxed, Res(res_id));
}

# A by-value parameter is owned by the callee, so it is destroyed when the callee returns.
fun consumeHolder(h: Holder) -> i64 = {
    var boxed_value: i64 = h.boxed;
    return boxed_value;
}                                       # 10

fun returnedAndPassed() = {
    # The returned value lives on in the caller.
    var h: Holder = makeHolder(9i64, 10i64);
    builtin_output_i64(11);             # 11

    # Handing it to the callee makes the callee destroy it, so nothing is left to destroy here.
    var boxed_value: i64 = consumeHolder(move h);
    builtin_output_i64(boxed_value);    # 9

    # A returned value nobody hands over is destroyed at the end of the scope.
    var kept: Holder = makeHolder(12i64, 13i64);
    builtin_output_i64(14);             # 14
}                                       # 13

# ===== Temporaries of conditionally evaluated parts of an expression =====
# Such a temporary belongs to the scope of the whole expression, not of the branch that built it,
# so it is destroyed where that expression ends and only on the paths that actually built it.

fun make(id: i64) -> Res = Res(id);

# The right-hand side runs only when the left-hand side does not already decide the result.
fun lazyOr(c: bool) -> bool = { return c or make(20i64).id == 0i64; }
fun lazyAnd(c: bool) -> bool = { return c and make(21i64).id == 0i64; }

# Each branch of the ternary builds its own temporary, only the taken one is destroyed.
fun ternary(c: bool) -> i64 = { return if c then make(22i64).id else make(23i64).id; }

# The same holds for the cases of a match, which share the scope of the match itself.
fun matchExpr(v: i32 | f32) -> i64 = {
    return match (v) {
        case x : i32 = make(24i64).id;
        case _ = make(25i64).id;
    };
}

# `Borrowed.destroy` clobbers the field the reference points at, so the value printed by `borrow`
# tells whether the temporary was still alive while the call ran.
class Borrowed {
    x: i64 = 0;

    Borrowed.destroy() = {
        builtin_output_i64(40);
        x = -1i64;
    }

    fun getX() -> ref i64 = &x;
}

fun makeBorrowed(x: i64) -> Borrowed = Borrowed(x);
fun borrow(x: ref i64) = { builtin_output_i64(x); }

fun conditionalTemporaries() = {
    lazyOr(true);               # short-circuited, nothing is built
    lazyOr(false);              # 20
    builtin_output_i64(30);     # 30

    lazyAnd(false);             # short-circuited, nothing is built
    lazyAnd(true);              # 21
    builtin_output_i64(31);     # 31

    ternary(true);              # 22
    ternary(false);             # 23
    builtin_output_i64(32);     # 32

    var i: i32 | f32 = 7i32;
    matchExpr(i);               # 24
    var f: i32 | f32 = (3.5 as f32);
    matchExpr(f);               # 25
    builtin_output_i64(33);     # 33

    # The call reads through a reference into the temporary, so the temporary has to outlive it:
    # its destructor runs at the end of the whole expression, after the call has returned.
    var fallback: i64 = 41i64;
    borrow(if true then makeBorrowed(42i64).getX() else &fallback);    # 42, then 40
    borrow(if false then makeBorrowed(42i64).getX() else &fallback);   # 41
    builtin_output_i64(34);     # 34
}

fun main() -> i64 = {
    scoped();
    assigned();
    nested();
    returnedAndPassed();
    conditionalTemporaries();

    # Reading a global class member through its box and its non-trivial member.
    var global_boxed: i64 = g_holder.boxed;
    builtin_output_i64(global_boxed);        # 100
    builtin_output_i64(g_holder.res.id);     # 101

    # Assigning to a global destroys the old value first.
    g_res = Res(103);                        # 102

    builtin_output_i64(999);                 # 999
    return 0;
}                                            # 103, then 101 with g_holder
