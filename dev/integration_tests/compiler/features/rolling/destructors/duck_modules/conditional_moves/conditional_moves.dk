import core.builtins.*;

class Res {
    id: i32 = 0;
    Res.destroy() = {
        builtin_output_i64(id);
    }
}

fun eat(r: Res) -> () = {}
fun eatBoxed(r: box Res) -> () = {}
fun maybeEat(r: Res, take_it: bool) -> () = {
    if (take_it) {
        eat(move r);
    }
}

fun takenPath() = {
    var a: Res = Res(1);
    if (a.id == 1) {
        eat(move a);            # 1
    }
    builtin_output_i64(2);      # 2
}

fun untakenPath() = {
    var a: Res = Res(3);
    if (a.id == 999) {
        eat(move a);
    }
    builtin_output_i64(4);      # 4
}                               # 3

fun bothPaths() = {
    var a: Res = Res(5);
    if (a.id == 5) {
        eat(move a);            # 5
    } else {
        eat(move a);
    }
    builtin_output_i64(6);      # 6
}

fun boxed() = {
    var a: box Res = new Res(7);
    if (a.id == 7) {
        eatBoxed(move a);       # 7
    }

    var b: box Res = new Res(8);
    if (b.id == 999) {
        eatBoxed(move b);
    }
    builtin_output_i64(9);      # 9
}                               # 8

fun params() = {
    maybeEat(Res(10), true);    # 10
    maybeEat(Res(11), false);   # 11
    builtin_output_i64(12);     # 12
}

fun reassigned() = {
    # Overwriting a maybe-moved value destroys the old one only if it is still there.
    var a: Res = Res(13);
    if (a.id == 13) {
        eat(move a);            # 13
    }
    a = Res(14);
    builtin_output_i64(15);     # 15
}                               # 14

fun condReinit(c: bool, d: bool) = {
    var a: Res = Res(16);
    if (c) {
        eat(move a);
    }
    if (d) {
        a = Res(17);
    }
    builtin_output_i64(18);
}

fun loops() = {
    var i = 0;
    while (i < 3) {
        # Constructed on every iteration and moved out of on one of them.
        var r: Res = Res(20 + i);
        if (i == 1) {
            eat(move r);        # 21
        }
        i = i + 1;
    }                           # 20 and 22, at the end of the iterations that don't move it out. 
    builtin_output_i64(23);     # 23
}

fun main() -> i64 = {
    takenPath();
    untakenPath();
    bothPaths();
    boxed();
    params();
    reassigned();
    condReinit(true, true);
    condReinit(false, true);
    condReinit(true, false);
    condReinit(false, false);
    loops();
    return 0;
}
