# `void` is uninhabited, so an expression of that type never produces a value: control never
# reaches the point where one would exist. Such an expression therefore stands in wherever a
# value of any type is expected, with no cast written by hand, and the coercion lowers to
# nothing at all.

import core.panicking;

fun getI32(v: i32|f64) -> i32 = match(v) {
    case i: i32 = i;
    # This case diverges instead of yielding an `i32`, so it needs no `as i32` to agree with
    # the case above.
    case f: f64 = panicking.panic();
}

fun main() -> i64 = {
    var v1: i32|f64 = -4;
    var v2: i32|f64 = 3.14;

    print(getI32(v1));  # -4
    print(getI32(v2));  # panics, so nothing past this point runs
    return 0i64;
}
