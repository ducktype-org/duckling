fun testBigRealloc() -> () = {
    var l: List[i64];
    var i = 0;
    while (i < 100) {
        l.push(i);
        i = i + 1;
    }

    builtin_output_i64(l.length()); # 100

    builtin_output_i64(l.at(0));   # 0
    builtin_output_i64(l.at(49));  # 49
    builtin_output_i64(l.at(99));  # 99
}

fun testPushPopPushPopPushPop() -> () = {
    var l: List[i64];

    var i = 0;
    while (i < 10) { l.push(i); i = i + 1; }

    i = 0;
    while (i < 5) { l.pop(); i = i + 1; }
    builtin_output_i64(l.length()); # 5

    i = 0;
    while (i < 20) { l.push(i + 100); i = i + 1; }

    builtin_output_i64(l.length()); # 25
    builtin_output_i64(l.at(0));       # 0
    builtin_output_i64(l.at(4));       # 4
    builtin_output_i64(l.at(5));       # 100
    builtin_output_i64(l.at(24));      # 119
}

fun testPopUntilEmpty() -> () = {
    var l: List[i64];
    l.push(1); l.push(2);

    while (l.length() > 0i64) { l.pop(); }
    builtin_output_i64(l.length()); # 0

    l.push(555);
    builtin_output_i64(l.at(0)); # 555
}

fun main() -> i64 = {
    testBigRealloc();
    testPushPopPushPopPushPop();
    testPopUntilEmpty();

    return 0;
}
