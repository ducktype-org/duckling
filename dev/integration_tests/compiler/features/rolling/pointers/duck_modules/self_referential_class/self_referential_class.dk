import core.builtins.*;

# A class holding a pointer to its own type: its layout must not need its own layout.
class Node {
    next: ptr Node;
    v: i64;
}

fun main() -> i64 = {
    var a: Node;
    var b: Node;
    a.v = 5;
    b.v = 7;
    a.next = &b as ptr Node;
    b.next = &a as ptr Node;
    builtin_output_i64((*a.next).v);
    builtin_output_i64((*(*a.next).next).v);
    return 0;
}
