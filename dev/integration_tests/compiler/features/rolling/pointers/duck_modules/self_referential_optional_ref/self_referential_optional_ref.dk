import core.builtins.*;

# A class holding an optional reference to its own type, i.e. a linked list.
class Link {
    v: i64;
    next: ref Link | ();
}

fun sum(l: ref Link) -> i64 = {
    return l.v + match (l.next) {
        case n : ref Link = sum(n);
        case _ = 0i64;
    };
}

fun main() -> i64 = {
    var a = Link(1, ());
    var b = Link(20, &a);
    var c = Link(300, &b);
    builtin_output_i64(sum(&c));
    return 0;
}
