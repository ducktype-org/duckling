fun +*(a: i64, b: i64) -> i64 = {
    return a * b + a;
}

fun prefix -*(a: i64) -> i64 = {
    return a * 6;
}

fun suffix -*(a: i64) -> i64 = {
    return a * 7;
}

fun suffix -(a: i64) -> i64 = {
    return a * 8;
}

class Foo {
    x: i64 = 0;

    fun +(a: i64) -> i64 = {
        return x * a + x;
    }

    fun prefix -() -> i64 = {
        return x * 6;
    }

    fun suffix -() -> i64 = {
        return x * 7;
    }
}

fun main() -> i64 = {
    let prefix = 1;
    let suffix = prefix;
    let x = 7 +* 5;
    builtin_output_i64(x);
    let y = -* 7;
    builtin_output_i64(y);
    let z = 7 -*;
    builtin_output_i64(z);
    let numeric_suffix = (6 + suffix) -;
    builtin_output_i64(numeric_suffix);

    var fu = Foo(7);
    let u = fu + 5;
    builtin_output_i64(u);
    var fv = Foo(7);
    let v = -fv;
    builtin_output_i64(v);
    var fw = Foo(7);
    let w = fw-;
    builtin_output_i64(w);
    return 0;
}
