import core.builtins.*;

class Point {
    x: i64 = 1;
    y: i64 = 2;
}

# `move` dereferences like `copy`: moving a `ref i64` gives an `i64` that does not alias the element.
fun moveFromList() -> () = {
    var li: List[i64];
    li.push(42);
    var y = move li.at(0);
    li.at(0) = 7;
    builtin_output_i64(y);                      # 42
    builtin_output_i64(li.at(0));               # 7
}

# The same for a variant of plain classes: the copy survives the list being replaced.
fun moveVariantFromList() -> () = {
    var events: List[Point | i64];
    events.push(Point(3, 4));
    var oldest = move events.at(0);
    var rest: List[Point | i64];
    rest.push(5i64);
    events = moveof rest;
    builtin_output_i64(match (oldest) {
        case p: Point = p.x;
        case n: i64 = -1i64;
    });                                         # 3
}

# `moveof` keeps the reference kind: the moved box is the same allocation, nothing is copied.
fun moveofBox() -> () = {
    var a: box Point = new Point(8, 9);
    var b: box Point = moveof a;
    builtin_output_i64(b.y);                    # 9
}

# `move` keeps a box: it moves the box itself, so `c` is the same box that `b` wrote to.
fun moveBox() -> () = {
    var a: box Point = new Point(5, 6);
    var b: box Point = move a;
    b.x = 11;
    var c: box Point = move b;
    builtin_output_i64(c.x);                    # 11
}

fun main() -> i64 = {
    moveFromList();
    moveVariantFromList();
    moveofBox();
    moveBox();
    return 0;
}
