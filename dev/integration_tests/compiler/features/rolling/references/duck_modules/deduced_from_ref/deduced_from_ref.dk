# A `var`/`let` without a type copies a `ref` initializer.
fun copy_of_list_element() -> () = {
	var values: List[i64];
	values.push(1);
	values.push(5);

	var best = values.at(0i64);
	best = 7;
	builtin_output_i64(best); # 7
	builtin_output_i64(values.at(0i64)); # 1
}

# A running maximum must not overwrite the first element.
fun running_maximum() -> () = {
	var values: List[i64];
	values.push(3);
	values.push(9);
	values.push(4);

	var best = values.at(0i64);
	var i = 1i64;
	while (i < values.length()) {
		if (values.at(i) > best) best = values.at(i);
		i = i + 1;
	}
	builtin_output_i64(best); # 9
	builtin_output_i64(values.at(0i64)); # 3
}

# An explicit `&` or an explicit `ref` type still declares a reference.
fun explicit_references() -> () = {
	var values: List[i64];
	values.push(1);

	var x = 10i64;
	var taken = &x;
	taken = 20;
	builtin_output_i64(x); # 20

	var element: ref mut i64 = values.at(0i64);
	element = 30;
	builtin_output_i64(values.at(0i64)); # 30
}

fun main() -> i64 = {
	copy_of_list_element();
	running_maximum();
	explicit_references();
	return 0;
}
