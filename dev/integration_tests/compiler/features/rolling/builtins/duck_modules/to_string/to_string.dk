class Person {
	name: str;
	age: i32;
	height: f64
}

class Holder {
	t: type;
	x: i64;

	fun toString() -> String = { return f"holder"; }
}

namespace Types {
	class Inner {}

	template(T: type)
	class Boxed {
		value: T
	}
}

template(T: type)
class Boxed {
	value: T
}

fun selectType(select_first: bool) -> type = {
	if (select_first) return i64;
	return bool;
}

fun singleTupleType() -> type = (i64,);

fun main() -> i64 = {
	print((1).toString());
	var a = 2;
	print(a.toString());

	print(3.14.toString());

	print('d'.toString());

	print(true.toString());
	print(i64.toString());
	print(selectType(false).toString());
	print(f"{i32}");
	print(Person.toString());
	print(f"{Person}");
	print(str.toString());
	print((i64 | bool).toString());
	print((ptr Types.Inner).toString());
	print(((ptr i64)[3]).toString());
	print((ptr (i64 | bool)).toString());
	print((ptr (i64[3])).toString());
	print((slice const char).toString());
	print(Boxed[i64].toString());
	print(Types.Boxed[Person].toString());
	print((i64[3][2]).toString());
	print(singleTupleType().toString());

	print(().toString());

	var t = ("John Smith", 42, 1.69);
	print(t.toString());

	var p = Person("John Smith", 42, 1.69);
	print(p.toString());
	var h = Holder(i64, 3);
	print((h, 1).toString());

	# Print only the "ptr()" part, without the insides, as the inside is different on DVM and LLVM.
	var pointer_text = (&p as ptr Person).toString();
	print(pointer_text.at(0i64).toString());
	print(pointer_text.at(1i64).toString());
	print(pointer_text.at(2i64).toString());
	print(pointer_text.at(3i64).toString());
	print(pointer_text.at(pointer_text.length() - 1).toString());

	return 0;
}
