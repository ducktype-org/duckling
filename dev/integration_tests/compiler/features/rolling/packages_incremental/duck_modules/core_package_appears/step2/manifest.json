{
    "packages": [
        {
            "id": "core",
            "name": "core",
            "version": "0.1.0",
            "path": "src/core"
        },
        {
            "id": "app",
            "name": "app",
            "version": "0.1.0",
            "path": "src/app"
        }
    ],
    "tasks": [
        {
            "package": "core",
            "strategy": "dvm_lib",
            "output_file": "core.dbc"
        },
        {
            "package": "app",
            "strategy": "dvm_exe",
            "output_file": "app_exe.dbc",
            "dvm_linking_options": {
                "link_libraries": []
            }
        }
    ]
}
