import core.builtins.*;

fun check(actual: i64, expected: i64, msg: str) -> () = {
	if (actual != expected) print(msg);
}
fun check(actual: bool, expected: bool, msg:  str) -> () = {
	if (actual != expected) print(msg);
}

class Cls {
	x: i64;
}

class NonTrivialCls {
	x: String
}

fun checkType(v: str) = ();

fun intro() -> () = {
	var c: ?Cls = Cls(1);
	check(c.full(), true, "intro 1");
	check(c.empty(), false, "intro 2");
	check(c.value().x, 1, "intro 3");

	c = none;
	check(c.valueOr(Cls(2)).x, 2, "intro 4");

	var c_ref : ref ?Cls = &c;
	check(c_ref.valueOr(Cls(2)).x, 2, "intro 5");
	c = Cls(1);

	check(c.full(), true, "intro 6");
	check(c.empty(), false, "intro 7");
	check(c.value().x, 1, "intro 8");


	var c_value = Cls(1);
	var c_opt_ref : ? ref Cls = &c_value;
	check(c.value().x, 1, "intro 9");

	var ntc: ?NonTrivialCls = NonTrivialCls("a".toString());
	check(c.full(), true, "intro 10");
	check(c.empty(), false, "intro 11");

	ntc = none;
	check(ntc.full(), false, "intro 12");
	check(ntc.empty(), true, "intro 13");

	var ntc_ref : ref ? NonTrivialCls = &ntc;
	{
		var tmp = NonTrivialCls("aa".toString());
		check(ntc_ref.valueOr(&tmp).x.length(), 2, "intro 14");
	};

	ntc = NonTrivialCls("a".toString());
	check(c.full(), true, "intro 15");
	{
		var should_be_ref : ref NonTrivialCls = ntc.value();
	};

	var should_be_value : NonTrivialCls = (move ntc).value();
	check(should_be_value.x.length(), 1, "intro 16");
}

# ===== `?` is a compile-time type operator =====

fun Opt(t: type) -> type = ?t;

fun compTime() -> () = {
	var t: Opt(i32) = 3i32;
	check(t.value() as i64, 3i64, "comp time 1");
	# ? binds tighter than |
	var u: ?i64 | f32 = 1.5 as f32;
	var w: ?(i64 | f32) = none;
	const same_type: bool = (?i32) == (i32 | optional_primitives.None);
	check(same_type as bool, false, "comp time 2"); 
	check(w.full(), false, "precedence 1");
	check(w.empty(), true, "precedence 2");
}

fun main() -> i64 = {
	intro();
	compTime();

	return 0i64;
}
