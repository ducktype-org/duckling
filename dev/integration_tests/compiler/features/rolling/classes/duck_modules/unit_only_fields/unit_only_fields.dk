# Classes whose fields all carry no information (units, empty classes, unit tuples) have no size.
# They must work like `()` itself in every position a value can be in, the same as unit tuples.

class Empty {}

class Units {
    first: ();
    second: ();
}

class Nested {
    units: Units;
    empty: Empty;
    pair: ((), ());
}

class Holder {
    units: Units;
    value: i64;
}

fun takeUnits(u: Units) -> i64 = {
    let first: () = u.first;
    return 1;
}

fun makeUnits() -> Units = {
    return Units((), ());
}

fun main() -> i64 = {
    var a: Units;
    var b = Units((), ());
    var nested: Nested;
    var array: Units[3];
    var tuple: (Units, Empty);

    let unit: () = a.second;
    let inner: Units = nested.units;
    a = b;
    array[1] = makeUnits();
    tuple._1 = a;

    builtin_output_i64(takeUnits(a));           # 1
    builtin_output_i64(takeUnits(makeUnits())); # 1
    builtin_output_i64(takeUnits(array[2]));    # 1

    var holder = Holder(Units((), ()), 7);
    builtin_output_i64(holder.value);           # 7
    return 0;
}
