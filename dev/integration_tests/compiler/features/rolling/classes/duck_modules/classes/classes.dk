# General class test: record types, methods, static fields and static methods.

# ============================ Records ============================
# Construction, copy, field access and field assignment.

class RecordClass {
    a: i64 = 0;
    b: f32 = 0.0 as f32;
    c: i16 = 0 as i16;
}

class BiggerRecordClass {
    x: i8 = 0 as i8;
    y: RecordClass = RecordClass(1, 2.0 as f32, 3 as i16);
    z: f64 = 0.0;
}

fun printRecordClass(r: RecordClass) = {
    builtin_output_i64(r.a);
    builtin_output_i64(r.c);
}

let record: RecordClass = RecordClass(1, 2.0 as f32, 3 as i16);

let big = BiggerRecordClass(1 as i8, RecordClass(2, 3.0 as f32, 4 as i16), 5 as f64);

# ======================= Getters and setters =======================

class Simple {
    exampleField: i64 = 7;

    fun getField() = {
        return exampleField;
    }

    fun setField(x: i64) = {
        exampleField = x;
    }
}

class Wrapper {
    inner: Simple = Simple(0);

    fun getInner() = {
        return inner;
    }

    fun setInner(x: Simple) = {
        inner = x;
    }

    fun getFromInner() = {
        return self.inner.getField()
    }

    fun setInInner(x: i64) = {
        return self.inner.setField(x);
    }
}

# ========================== Static members ==========================
# A static field is stored once for the whole program instead of once per instance.

class Counter {
    public global count: i64 = 1;
    public value: i64 = 0;

    public fun bump() -> i64 = {
        Counter.count = Counter.count + 1;
        return Counter.count;
    }
}

class OtherCounter {
    public global count: i64 = 100;
    public value: i64 = 0;
}

class Maker {
    public global made: i64 = 0;
    public value: i64 = 0;

    public global fun make(v: i64) -> i64 = {
        made = made + 1;
        return v * 2;
    }

    public global fun madeSoFar() -> i64 = {
        return made;
    }

    public fun scaled() -> i64 = {
        return value * 10;
    }
}

# A global variable named like a static field of a class, which it never collides with.
let count: i64 = 1000;

fun main() -> i64 = {
    # -------- records --------
    var record_copy = record;
    printRecordClass(record);           # 1, 3
    record.a = 42;
    record.c = (6 * 9) as i16;
    printRecordClass(record);           # 42, 54
    printRecordClass(record_copy);      # 1, 3
    record_copy = record;
    printRecordClass(record_copy);      # 42, 54

    builtin_output_i64(big.y.c);        # 4

    # -------- getters and setters --------
    var obj1 = Simple();
    builtin_output_i64(obj1.exampleField);          # 7

    obj1.exampleField = 6;
    builtin_output_i64(obj1.getField());            # 6

    obj1.setField(5);
    builtin_output_i64(obj1.getField());            # 5

    var obj2 = Wrapper();
    builtin_output_i64(obj2.getFromInner());        # 0

    obj2.setInInner(4);
    builtin_output_i64(obj2.inner.exampleField);    # 4

    obj2.setInner(obj1);
    builtin_output_i64(obj2.getInner().getField()); # 5

    # -------- static fields --------
    builtin_output_i64(Counter.count);      # 1
    builtin_output_i64(OtherCounter.count); # 100
    builtin_output_i64(count);              # 1000

    Counter.count = 7;
    builtin_output_i64(Counter.count);      # 7
    builtin_output_i64(OtherCounter.count); # 100
    builtin_output_i64(count);              # 1000

    var c: Counter = Counter(0);
    builtin_output_i64(c.bump());           # 8
    builtin_output_i64(Counter.count);      # 8

    # A static field is reachable through a value of its class as well.
    builtin_output_i64(c.count);            # 8

    var other: Counter = Counter(0);
    builtin_output_i64(other.bump());       # 9

    # -------- static methods --------
    builtin_output_i64(Maker.make(21));     # 42
    builtin_output_i64(Maker.madeSoFar());  # 1

    var m: Maker = Maker(3);
    builtin_output_i64(m.scaled());         # 30

    # A static method is callable through a value of its class as well.
    builtin_output_i64(m.make(5));          # 10
    builtin_output_i64(Maker.madeSoFar());  # 2

    return 0i64;
}
