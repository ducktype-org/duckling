# Lists compare their elements, also when they are fields of tuples and classes.

class Team {
    members: List[String];
    rank: i64 = 0;
}

fun show(value: bool) = {
    if (value) builtin_output_i64(1);
    else builtin_output_i64(0);
}

fun main() -> i64 = {
    var a: List[i64];
    var b: List[i64];
    a.push(1i64);
    b.push(1i64);
    # Equal elements in different buffers.
    show(a == b);   # 1
    show(a != b);   # 0
    show(a <= b);   # 1
    show(a < b);    # 0

    # A proper prefix comes before the longer list.
    b.push(2i64);
    show(a < b);    # 1
    show(a >= b);   # 0

    # The first differing element decides, not the length.
    a.push(3i64);
    a.push(0i64);
    show(a > b);    # 1
    show(a <= b);   # 0

    # Elements are compared with their own operators.
    var s: List[String];
    var t: List[String];
    s.push("ab".toString());
    t.push("ab".toString());
    show(s == t);   # 1
    t.push("".toString());
    show(s < t);    # 1

    # Lists as fields.
    show((copy s, 1) == (copy s, 1));  # 1
    show(Team(copy s, 1) < Team(copy t, 0));  # 1
    return 0;
}
