# Tuples get lexicographic comparison operators generated by the compiler.

fun show(value: bool) = {
    if (value) builtin_output_i64(1);
    else builtin_output_i64(0);
}

fun main() -> i64 = {
    var a = (1, 2);
    var b = (1, 3);
    show(a == b);  # 0
    show(a != b);  # 1
    show(a < b);   # 1
    show(a <= b);  # 1
    show(a > b);   # 0
    show(a >= b);  # 0

    # Temporaries and the first element deciding the order.
    show(a == (1, 2));        # 1
    show((1, 2) < (1, 2));    # 0
    show((1, 2) <= (1, 2));   # 1
    show((2, 0) > (1, 9));    # 1

    # Mixed element types: integers, floats, chars and booleans.
    var c = (1i64, 2.5f64, 'x', true);
    show(c == (1i64, 2.5f64, 'x', true));  # 1
    show(c != (1i64, 2.5f64, 'x', false)); # 1
    show((1i64, 2.5f64, 'a') < (1i64, 2.5f64, 'b'));  # 1

    # Nested tuples compare element by element too.
    var n = ((1, 2), 3);
    show(n < ((1, 3), 0));   # 1
    show(n == ((1, 2), 3));  # 1
    show(n >= ((1, 2), 4));  # 0
    return 0;
}
