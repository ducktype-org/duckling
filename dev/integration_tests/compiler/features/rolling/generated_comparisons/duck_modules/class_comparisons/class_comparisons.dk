# Classes get lexicographic comparison operators generated by the compiler. Fields are compared
# in declaration order.

class Point {
    x: i64 = 0;
    y: f64 = 0.0;
}

class Labeled {
    point: Point;
    label: char = 'a';
    visible: bool = false;
}

fun show(value: bool) = {
    if (value) builtin_output_i64(1);
    else builtin_output_i64(0);
}

fun main() -> i64 = {
    var p = Point(1, 2.0);
    var q = Point(1, 3.0);
    show(p < q);             # 1
    show(p == q);            # 0
    show(p == Point(1, 2.0)); # 1
    show(q >= p);            # 1
    show(q <= p);            # 0
    show(Point(2, 0.0) > q); # 1

    # A class field is compared with its own generated operator.
    var x = Labeled(Point(1, 1.0), 'b', true);
    var y = Labeled(Point(1, 1.0), 'b', true);
    show(x == y);  # 1
    show(x != y);  # 0
    y.visible = false;
    show(x == y);  # 0

    # Classes inside tuples work as well.
    show((p, 1) < (p, 2));  # 1
    show((q, 1) < (p, 2));  # 0
    return 0;
}
