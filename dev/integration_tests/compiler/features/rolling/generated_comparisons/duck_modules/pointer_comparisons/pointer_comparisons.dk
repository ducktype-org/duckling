# Pointer fields of tuples and classes are compared by address: two pointers are equal when they
# point to the same place.

class Slot {
    target: ptr i32;
    tag: i64 = 0;
}

fun show(value: bool) = {
    if (value) builtin_output_i64(1);
    else builtin_output_i64(0);
}

fun main() -> i64 = {
    var x = 1i32;
    var y = 1i32;
    let px = &x as ptr i32;
    let py = &y as ptr i32;
    show((px, 0) == (px, 0));  # 1
    show((px, 0) == (py, 0));  # 0, same value but another place
    show((px, 0) != (py, 0));  # 1
    show(Slot(px, 1) == Slot(px, 1));  # 1
    show(Slot(px, 1) != Slot(py, 1));  # 1
    return 0;
}
