# Strings compare their characters, also when they are fields of tuples and classes.

class Person {
	name: String;
	age: i64 = 0;
}

fun show(value: bool) = {
	if (value) builtin_output_i64(1);
	else builtin_output_i64(0);
}

fun main() -> i64 = {
	var a = "abc".toString();
	var b = "abd".toString();
	show(a == "abc".toString()); # 1
	show(a != b); # 1
	show(a < b); # 1
	show(b <= a); # 0
	show("ab".toString() < a); # 1
	show(a > "".toString()); # 1

	# Equal strings in different buffers.
	var c = "abc".toString();
	show(a != c); # 0
	show(a >= c); # 1
	show(a <= c); # 1

	var alice = Person("Alice".toString(), 30);
	show(alice == Person("Alice".toString(), 30)); # 1
	show(alice < Person("Bob".toString(), 20)); # 1
	show((copy alice, 1) >= (Person("Alice".toString(), 30), 2)); # 0
	return 0;
}
