fun main() -> i64 = {
    let magic_square = [
        [2, 7, 6],
        [9, 5, 1],
        [4, 3, 8],
    ];
    
    let sum = 15;

    var row = 0;
    while (row < 3) {
        if (magic_square[row][0] + magic_square[row][1] + magic_square[row][2] != sum) {
            return 1;
        }
        row += 1;
    }

    var col = 0;
    while (col < 3) {
        if (magic_square[0][col] + magic_square[1][col] + magic_square[2][col] != sum) {
            return 1;
        }
        col += 1;
    }

    return 0;
}
