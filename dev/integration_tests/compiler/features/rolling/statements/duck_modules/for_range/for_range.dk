fun printSeparator() -> () = {
    builtin_output_i64(888);
}

fun sumUpTo(n: i64) -> i64 = {
    var total = 0i64;
    for (i in 0..n) total = total + i;
    return total;
}

fun main() -> i64 = {
    printSeparator();
    for (i in 0..3) {
        builtin_output_i64(i);      # 0, 1, 2
    }

    printSeparator();
    let n: i32 = 2;
    for (i in -1..n) {              # The `i32` bound is widened to `i64`.
        builtin_output_i64(i);      # -1, 0, 1
    }

    printSeparator();
    var range = 5..7;
    for (i in range) {
        i = i * 10;                 # The iterator is a copy, changing it doesn't skip values.
        builtin_output_i64(i);      # 50, 60
    }
    builtin_output_i64(range.start); # 5
    builtin_output_i64(range.end);   # 7

    printSeparator();
    for (i in 3..3) {               # Empty range.
        builtin_output_i64(999);
    }
    for (i in 4..2) {               # Start after end, also empty.
        builtin_output_i64(999);
    }

    printSeparator();
    for (i in 0..2) {
        for (j in i..2) {
            builtin_output_i64(i * 10 + j); # 0, 1, 11
        }
    }

    printSeparator();
    for (i in 0..10) {
        if (i == 2) continue;
        if (i == 4) break;
        builtin_output_i64(i);      # 0, 1, 3
    }

    printSeparator();
    builtin_output_i64(sumUpTo(5)); # 10
    return 0;
}
