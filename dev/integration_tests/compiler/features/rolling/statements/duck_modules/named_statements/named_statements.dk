

fun main() -> i64 = {
    var marker: i64 = 0;
    if NamedIf (true) {
        marker = 1;
        break if;
        marker = 99;
    }
    if (marker != 1) return 1;

    var iterations: i64 = 0;
    var completed: i64 = 0;
    while NamedWhile (iterations < 4) {
        iterations = iterations + 1;
        if (iterations == 1) continue;
        completed = completed + 1;
        if (iterations == 3) break NamedWhile;
    }
    if (iterations != 3) return 2;
    if (completed != 2) return 3;

    var arr: i64[3];
    arr[0] = 1;
    arr[1] = 2;
    arr[2] = 3;
    var sum: i64 = 0;
    for NamedFor (x in arr) {
        if (x == 2) continue for;
        sum = sum + x;
    }
    if (sum != 4) return 4;

    var if_retries: i64 = 0;
    if NamedRetryIf (if_retries < 2) {
        if_retries = if_retries + 1;
        if (if_retries == 1) continue NamedRetryIf;
    }
    if (if_retries != 2) return 5;

    var block_retries: i64 = 0;
    block NamedRetryBlock {
        block_retries = block_retries + 1;
        if (block_retries == 1) continue NamedRetryBlock;
    }
    if (block_retries != 2) return 6;

    var block_marker: i64 = 0;
    block NamedBreakBlock {
        block_marker = 1;
        if (block_marker == 1) break NamedBreakBlock;
        block_marker = 99;
    }
    if (block_marker != 1) return 7;

    return 0;
}
