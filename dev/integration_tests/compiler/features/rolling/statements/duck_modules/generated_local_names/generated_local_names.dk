fun main() -> i64 = {
    var coll: i64[3];

    # A user variable spelled like the generated loop locals must resolve to itself.
    var sum: i64 = 0;
    for (x in coll) {
        let __index: i64 = 20;
        sum = sum + __index;
    }
    builtin_output_i64(sum);

    # The mirror direction: the generated local shadows a user variable of the enclosing scope.
    var shadowed: i64 = 0;
    for (y in coll) {
        var __index: i64 = 1;
        shadowed = shadowed + __index;
    }
    builtin_output_i64(shadowed);

    # Every loop shares that name, so nested loops exercise the collision too.
    var repeated: i64 = 0;
    for (z in coll) {
        for (w in coll) {
            repeated = repeated + 1;
        }
    }
    builtin_output_i64(repeated);

    return 0;
}
