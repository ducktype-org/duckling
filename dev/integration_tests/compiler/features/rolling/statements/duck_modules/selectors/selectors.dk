# `using` selects names from a path; `using a.b as c;` gives a symbol a new name.
# `export` is a specifier, so it works on a single statement and on a block.

namespace N {
    namespace M {
        var v: i64 = 7;
        const C: i64 = 3;
    }
}

using N.M.v as w;
using N.M as nm;
export using N.M.C;

export fun twice(x: i64) -> i64 = x * 2;

export {
    fun thrice(x: i64) -> i64 = x * 3;
}

fun main() -> i64 = {
    builtin_output_i64(w);         # 7, `w` is `N.M.v`
    builtin_output_i64(nm.v);      # 7, `nm` is `N.M`
    builtin_output_i64(C);         # 3
    builtin_output_i64(twice(4));  # 8
    builtin_output_i64(thrice(4)); # 12
    return 0;
}
