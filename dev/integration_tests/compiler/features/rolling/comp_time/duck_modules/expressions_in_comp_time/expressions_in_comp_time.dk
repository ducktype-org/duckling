import core.builtins.*;

# A class with a user-defined destructor. Its temporaries in the constant initializers below are
# destroyed by the compile-time DVM, which prints to the compiler's stderr.
class Res {
    id: i64 = 0;

    Res.destroy() = {
        print("dtor ");
        builtin_output_i64(id);
    }
}

class Point {
    x: i64 = 0;
    y: i64 = 0;
}

fun mkPoint(x: i64, y: i64) -> Point = Point(x = x, y = y);
fun mkRes(id: i64) -> Res = Res(id);
fun idOf(r: Res) -> i64 = r.id;

fun makeArray() -> i64[3] = {
    var arr: i64[3];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    return arr;
}

fun two() -> i64 = 2;
fun code(c: char) -> i64 = c as i64;
fun sumPair(p: (i64, i64)) -> i64 = p._1 + p._2;
fun pickBigger(v: i64 | bool) -> i64 = match (v) {
    case x : i64 = x;
    case _ = -1i64;
};
fun pair(t: type) -> (type, type) = (t, t);

# Class, array and tuple results read at compile time.
const POINT_X: i64 = mkPoint(3, 4).x;
const ARRAY_ELEM: i64 = makeArray()[2];
const TUPLE_ELEM: i64 = (1, 5)._2;
const ARRAY_PLUS_TUPLE: i64 = makeArray()[2] + (1, 5)._2;
const PAIR_SUM: i64 = sumPair((7, 8));

# Match on a variant built at compile time.
fun mkVariant() -> i64 | bool = 42i64;
const MATCHED: i64 = match (mkVariant()) {
    case x : i64 = x;
    case _ = 0i64;
};
const MATCHED_CALL: i64 = pickBigger(mkVariant());

# Chars, ternaries and chain comparisons around a function call.
const CHAR_CODE: i64 = code('a');
const TERNARY: i64 = if two() > 1 then 100 else 200;
const TERNARY_OF_CLASSES: i64 = (if two() < 1 then mkPoint(1, 1) else mkPoint(9, 9)).y;
const CHAIN: bool = 1 < two() < 3;
const CHAIN_FALSE: bool = 1 < two() < 2;

# Temporaries with a destructor, each destroyed exactly once at compile time.
const RES_FIELD: i64 = mkRes(7).id;
const RES_IN_TUPLE: i64 = (Res(8), 3)._2;
const RES_ARG: i64 = idOf(Res(9));
const RES_TERNARY: i64 = (if two() > 1 then Res(11) else Res(12)).id;

# A type tuple returned from and passed to a function.
var PAIR_VAR: pair(i32) = (123, 456);
const PAIR_SIZE: i64 = size_of(pair(i64));

fun main() -> i64 = {
    builtin_output_i64(POINT_X);
    builtin_output_i64(ARRAY_ELEM);
    builtin_output_i64(TUPLE_ELEM);
    builtin_output_i64(ARRAY_PLUS_TUPLE);
    builtin_output_i64(PAIR_SUM);
    builtin_output_i64(MATCHED);
    builtin_output_i64(MATCHED_CALL);
    builtin_output_i64(CHAR_CODE);
    builtin_output_i64(TERNARY);
    builtin_output_i64(TERNARY_OF_CLASSES);
    builtin_output_i64(if CHAIN then 1 else 0);
    builtin_output_i64(if CHAIN_FALSE then 1 else 0);
    builtin_output_i64(RES_FIELD);
    builtin_output_i64(RES_IN_TUPLE);
    builtin_output_i64(RES_ARG);
    builtin_output_i64(RES_TERNARY);
    builtin_output_i64((PAIR_VAR._1 + PAIR_VAR._2) as i64);
    builtin_output_i64(PAIR_SIZE);
    return 0;
}
