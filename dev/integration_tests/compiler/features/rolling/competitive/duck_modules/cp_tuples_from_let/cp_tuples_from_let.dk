import exp.containers.*;

# A tuple built out of `let` values is a `(imm i64, ...)`. It is used everywhere a `(i64, ...)`
# is expected: passed, stored, returned and copied.

class Edge {
	ends: (i64, i64);
	weight: i64;
}

fun sum(t: (i64, i64)) -> i64 = t._1 + t._2;

fun divMod(n: i64) -> (i64, i64) = {
	let q = n / 2;
	return (q, n % 2);
}

fun nested(a: i64) -> ((i64, i64), i64) = {
	let b = a + 1;
	return ((a, b), b);
}

fun narrow() -> (i8, i8) = {
	let x: i8 = 5i8;
	return (1i8, x);
}

fun main() -> i64 = {
	let a = 1i64;
	let b = 2i64;
	print(sum((a, b))); # 3

	let pair = (a, b);
	print(sum(pair)); # 3

	var pairs: List[(i64, i64)];
	pairs.push((a, b));
	print(pairs.at(0)._2); # 2

	var queue: PriorityQueue[(i64, i64)];
	for (i in 0 .. 3) {
		let d = 10 - i;
		queue.push((d, i));
	}
	print(queue.pop()._2); # 2

	var map: Map[(i64, i64), (i64, i64)];
	map.insert(pair, (b, a));
	print(map.at(pair)._1); # 2

	print(divMod(7)._1); # 3
	print(nested(4)._1._2); # 5
	print(narrow()._2); # 5

	let edge = Edge((a, b), a);
	print(edge.ends._2); # 2

	let f: f32 = 1.5f32;
	var mixed: (f32, i64) = (f, a);
	print(mixed._2); # 1
	return 0;
}
