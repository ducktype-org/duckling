import lib_a;
import lib_b;
import lib_c;

fun check(val: i64 | ()) -> bool = {
    return match(val) {
        case i: i64 = true;
        case _: () = false;
    }
}

fun get(val: i64 | ()) -> i64 = {
    return match(val) {
        case i: i64 = i;
        case _: ()  = 1000i64;
    }
}

fun main() -> i64 = {
    const empty: () = ();
    let check_empty = check(empty);

    let a = lib_a.foo();
    let na = lib_a.Name.foo();
    let b = lib_b.foo();
    let nb = lib_b.Name.foo();
    let c = lib_c.foo();
    let nc = lib_c.Name.foo();

    let is_ok = not check_empty and
                not check(a) and not check(na) and
                check(b) and check(nb) and
                check(c) and check(nc);

    if (is_ok) {
        builtin_output_i64(1);
    } else {
        builtin_output_i64(0);
    }

    let final_val = get(a) + get(na) + get(b) + get(nb) + get(c) + get(nc);
    builtin_output_i64(final_val);

    return 0;
}
