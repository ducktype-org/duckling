# Test `using ... as` - creates an alternative name for a symbol
# It can be used on any symbol including functions, variables, class members

namespace outer {
    namespace inner {
        namespace core {
            var counter: i64 = 0;

            fun veryLongFunctionName() -> bool = {
                counter = counter + 1;
                builtin_output_i64(counter);  # Output counter value
                return true;
            }

            fun addNumbers(a: i64, b: i64) -> i64 = a + b;
        }
    }
}

class Example {
    var class_member_a: i64 = 67;
    fun class_member_b() = { builtin_output_i64(9); }
}

class Example_wrapper {
    var wrapped_example: Example;
    using wrapped_example.class_member_b as class_print;
}

# Alias to a function in nested namespace
using outer.inner.core.veryLongFunctionName as f;
using outer.inner.core.addNumbers as add;
using outer.inner.core.counter as cnt;

var e = Example();
using e.class_member_a as mema;

fun main() -> i64 = {
    # Call function via alias
    if (f()) {
        builtin_output_i64(10);   # 10
    }

    # Call again to verify counter increments
    f();  # outputs 2

    # Use alias to function with parameters
    let result = add(15, 25);
    builtin_output_i64(result);  # 40

    # Access variable through alias (read)
    builtin_output_i64(cnt);     # 2 (counter was incremented twice)

    builtin_output_i64(mema);    # 67 (default value taken from empty constructor)
    mema = mema + 10;
    builtin_output_i64(mema);    # 77 (should be mutable so should be 67 + 10)

    let wrap: Example_wrapper = Example_wrapper();
    wrap.class_print();          # 9

    return 0;
}
