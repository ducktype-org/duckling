fun main() -> i64 = {
    var a: i64;
    var b = 0;
    var c: i64 = 0;
    var d = 0i64;
    var e = -5 + 5i128;
    if (a != b)
        return 1;
    if (a != c)
        return 2;
    if (c != b)
        return 3;
    if (a != d)
        return 4;
    if (d != c)
        return 5;
    if (d != b)
        return 6;
    if (a != e)
        return 7;
    if (e != c)
