fun printList(list: ref List[i64]) -> () = {
    print("8888888888888888888\n");
    var i = 0;
    while (i < len list) {
        builtin_output_i64(list[i]);
        i = i + 1;
    }
    print("8888888888888888888\n");
}

fun listByRef(list: ref List[i64]) -> () = {
    printList(list);

    var i = 0;
    while (i < len list) {
        list[i] = list[i] + 1; 
        i = i + 1;
    }
}

fun elementByRef(element: ref i64) -> () = {
    element = element + 1;
}


fun main() -> i32 = {
    # Simple usage.
    var arr: List[i64];
    arr += 111; 
    arr += 222; 
    arr += 333; 
    arr += 444; 
    arr += 555; 
    
    builtin_output_u64(len arr);

    printList(&arr);
    
    arr -= 3;
    builtin_output_u64(len arr);
    printList(&arr);

    arr += 999;
    printList(&arr);

    arr[1] = 1;
    printList(&arr);

    listByRef(&arr);
    printList(&arr);

    elementByRef(&arr[1]);
    printList(&arr);


    return 0;
}
