fun printList(list: ref List:{i64}) -> () = {
    print("8888888888888888888\n");
    var i = 0;
    while (i < list.length() as i64) {
        builtin_output_i64(list.at(i));
        i = i + 1;
    }
    print("8888888888888888888\n");
}

fun listByRef(list: ref List:{i64}) -> () = {
    printList(list);

    var i = 0;
    while (i < list.length() as i64) {
        list.at(i) = list.at(i) + 1;
        i = i + 1;
    }
}

fun elementByRef(element: ref i64) -> () = {
    element = element + 1;
}


fun main() -> i32 = {
    # Simple usage.
    var arr: List:{i64};
    arr.push(111);
    arr.push(222);
    arr.push(333);
    arr.push(444);
    arr.push(555);

    builtin_output_u64(arr.length());

    printList(&arr);

    arr.pop(); arr.pop(); arr.pop();
    builtin_output_u64(arr.length());
    printList(&arr);

    arr.push(999);
    printList(&arr);

    arr.at(1) = 1;
    printList(&arr);

    listByRef(&arr);
    printList(&arr);

    elementByRef(arr.at(1));
    printList(&arr);


    return 0;
}
