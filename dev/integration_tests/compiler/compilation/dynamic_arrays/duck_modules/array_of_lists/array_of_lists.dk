import core.containers;
import helper;

class Point {
    x: i64 = 1;
    y: i64 = 2;
}

fun printPointList(l: ref List:{Point}) -> () = {
    var i = 0;
    while (i < l.length()) {
        builtin_output_i64(l.at(i).x);
        builtin_output_i64(l.at(i).y);
        i = i + 1;
    }
}

fun arrayOfListsTest() -> () = {
    var arrayOfLists: List:{Point}[2];

    arrayOfLists[0].push(Point(1, 2));
    arrayOfLists[0].push(Point(3, 4));
    arrayOfLists[1].push(Point(5, 6));
    arrayOfLists[1].push(Point(7, 8));
    arrayOfLists[1].push(Point(9, 10));

    builtin_output_i64(arrayOfLists[0].length()); # 2
    builtin_output_i64(arrayOfLists[1].length()); # 3

    var p1 = arrayOfLists[0].at(1);
    builtin_output_i64(p1.x); # 3
    builtin_output_i64(p1.y); # 4

    var p2 = arrayOfLists[1].at(2);
    builtin_output_i64(p2.x); # 9
    builtin_output_i64(p2.y); # 10

    arrayOfLists[0].at(0).x = 100;
    builtin_output_i64(arrayOfLists[0].at(0).x); # 100

    var i = 0;
    while (i < 2) {
        builtin_output_i64(i as i64);
        printPointList(&arrayOfLists[i]);
        i = i + 1;
    }

    var nsArray: containers.List:{Point}[2];
    nsArray[0].push(Point(11, 12));
    builtin_output_i64(nsArray[0].at(0).x); # 11

    var nsArgArray: List:{helper.P}[2];
    nsArgArray[0].push(helper.P(5));
    builtin_output_i64(nsArgArray[0].at(0).x); # 5

    var nestedLists: List:{List:{i64}}[2];
    var inner: List:{i64};
    inner.push(1);
    inner.push(2);
    nestedLists[0].push(copy inner);
    builtin_output_i64(nestedLists[0].at(0).length()); # 2

    # The workaround spellings must keep working too.
    const PointList = List:{Point};
    var aliasArray: PointList[2];
    var parenArray: (List:{Point})[2];
    aliasArray[0].push(Point(21, 22));
    parenArray[0].push(Point(31, 32));
    builtin_output_i64(aliasArray[0].at(0).x); # 21
    builtin_output_i64(parenArray[0].at(0).x); # 31
}

fun main() -> i64 = {
    arrayOfListsTest();

    return 0;
}

