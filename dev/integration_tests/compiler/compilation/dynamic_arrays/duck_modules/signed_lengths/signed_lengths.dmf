# Container sizes are signed: `length()` returns `i64` on slices, static arrays and the std
# containers, so a length mixes with an index without a single `as i64` in sight.

fun sumBackwards(list: ref List:{i64}) -> i64 = {
    # `length() - 1` is plain i64 arithmetic, and the loop variable never needs a cast.
    var i          = list.length() - 1;
    var total: i64 = 0;
    while (i >= 0) {
        total = total + list.at(i);
        i     = i - 1;
    }
    return total;
}

fun main() -> i64 = {
    var list: List:{i64};
    list.push(10);
    list.push(20);
    list.push(30);

    builtin_output_i64(list.length());        # 3
    builtin_output_i64(sumBackwards(&list));  # 60

    # A `str` slice: its `len` field, and so `length()`, is signed too.
    let text = "duckling";
    builtin_output_i64(text.length());        # 8
    builtin_output_i64(text.length() - 8);    # 0

    # A `String` reports a signed length as well.
    var owned = text.toString();
    owned.append('!');
    builtin_output_i64(owned.length());       # 9

    # Static arrays: the `length()` of a static array and the `for` desugaring's index are both
    # signed, so the accumulator needs no cast either.
    var numbers: i64[4];
    numbers[0] = 1; numbers[1] = 2; numbers[2] = 3; numbers[3] = 4;
    var sum = numbers.length();
    for (n in numbers) sum = sum + n;
    builtin_output_i64(sum);                  # 14

    return 0;
}
