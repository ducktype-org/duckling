class Point {
    x: i64 = 1;
    y: i64 = 2;
}

fun printSeparator() -> () = {
    builtin_output_i64(888888888888888);
}

fun printMatrix(list: ref List[i32[3]]) -> () = {
    var i = 0;
    while(i < builtin_list_len(list)) {
        var j = 0;
        while (j < 3) {
            builtin_output_i64(list[i][j]);
            j = j + 1; 
        }
        i = i + 1; 
    }
}


