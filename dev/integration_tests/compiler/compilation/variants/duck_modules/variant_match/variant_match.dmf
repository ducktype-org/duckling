import core.builtins.*;
import core.containers.*;

# Every check is silent while it holds, so a passing run prints nothing at all and a failing one
# prints only the ids of the checks that broke.
fun check(actual: i64, expected: i64, id: i64) -> () = {
	if (actual != expected) builtin_output_i64(id);
}

fun store(out: ref i64, value: i64) -> i64 = {
	out = value;
	return 0i64;
}

fun identity(x: i64) -> i64 = x;

# ===== Match in every position an expression can appear in =====

# A constrained wildcard binds nothing, and together with the binding case it covers the variant
# without a bare `case _`.
fun classify(v: i32 | f32) -> i64 = {
	return match (v) {
		case x : i32 = x as i64;
		case _ : f32 = -1i64;
	};
}

# Initializer, both sides of a binary operator, call argument and a match as a case result of
# another match - all in one function.
fun positions(v: i32 | f32) -> i64 = {
	var acc: i64 = match (v) {
		case x : i32 = 1i64;
		case _ = 2i64;
	};

	# The case block is not the end of the statement here, the `* 2` still belongs to it.
	acc = acc + match (v) {
		case x : i32 = 10i64;
		case _ = 20i64;
	} * 2i64;

	return identity(match (v) {
		case x : i32 = match (v) {
			case y : i32 = acc;
			case _ = 0i64;
		};
		case _ = acc;
	});
}

# Nothing follows the match, so its continuation is the end of the function.
fun statementPosition(v: i32 | f32, out: ref i64) -> () = {
	match (v) {
		case x : i32 = store(out, x as i64);
		case _ = store(out, -1i64);
	};
}

# ===== A `ref` binding on a direct alternative aliases the payload =====

fun addOne(out: ref i32) -> i64 = {
	out = out + 1i32;
	return out as i64;
}

fun bumpInPlace(v: ref (i32 | f32)) -> i64 = {
	return match (v) {
		case x : ref i32 = addOne(x);
		case _ = -1i64;
	};
}

# ===== A `ref` alternative: the variant stores the reference itself =====
#
# Only the underlying type picks the alternative, so both a `ref i32` and an `i32` constraint
# select the `ref i32` alternative - the first binds the stored reference, the second reads the
# referenced value out of it.

fun refAltByRef(v: ref (ref i32 | f32)) -> i64 = {
	return match (v) {
		case x : ref i32 = x as i64;
		case _ = -1i64;
	};
}

fun refAltDirect(v: ref (ref i32 | f32)) -> i64 = {
	return match (v) {
		case x : i32 = x as i64;
		case _ = -1i64;
	};
}

fun refAltWrite(v: ref (ref i32 | f32), value: i32) -> i64 = {
	return match (v) {
		case x : ref i32 = assignI32(x, value);
		case _ = -1i64;
	};
}

fun assignI32(out: ref i32, value: i32) -> i64 = {
	out = value;
	return 0i64;
}

# ===== A `box` alternative: the variant owns the box and destroys it =====

fun boxAltRead(v: ref (box i32 | f32)) -> i64 = {
	return match (v) {
		case x : ref i32 = x as i64;
		case _ = -1i64;
	};
}

fun boxAltWrite(v: ref (box i32 | f32), value: i32) -> i64 = {
	return match (v) {
		case x : ref i32 = assignI32(x, value);
		case _ = -1i64;
	};
}

# ===== A `String` alternative: a non-trivially-copyable, non-trivially-destructible payload =====
#
# It can only be bound by reference, and the binding is the payload itself, so appending through
# it grows the string the variant holds.

fun stringAltLength(v: ref (String | i32)) -> i64 = {
	return match (v) {
		case s : ref String = s.length();
		case n : i32 = n as i64;
	};
}

fun stringAltAppend(v: ref (String | i32), c: char) -> i64 = {
	return match (v) {
		case s : ref String = appendChar(s, c);
		case n : i32 = -1i64;
	};
}

fun appendChar(s: ref String, c: char) -> i64 = {
	s.append(c);
	return s.length();
}

# ===== Checks =====

fun matchPositions() -> () = {
	var v: i32 | f32 = 41i32;
	check(classify(v), 41i64, 1i64);
	check(positions(v), 21i64, 2i64);

	# Reassignment with the other alternative.
	v = (3.5 as f32);
	check(classify(v), -1i64, 3i64);
	check(positions(v), 42i64, 4i64);

	var out: i64 = 0i64;
	statementPosition(v, &out);
	check(out, -1i64, 5i64);

	# Variant-to-variant assignment, no coercion involved.
	var w: i32 | f32 = v;
	w = 9i32;
	statementPosition(w, &out);
	check(out, 9i64, 6i64);

	# The `ref` binding aliases the payload, so the write lands in the variant.
	check(bumpInPlace(&w), 10i64, 7i64);
	check(classify(w), 10i64, 8i64);
	check(bumpInPlace(&v), -1i64, 9i64);

	# Every alternative here is trivially copyable, so the variant is too and an explicit `copy`
	# is a byte copy of the tag and the payload. The two are independent afterwards.
	var c: i32 | f32 = copy w;
	check(classify(c), 10i64, 10i64);
	check(bumpInPlace(&c), 11i64, 11i64);
	check(classify(w), 10i64, 12i64);
}

fun refAlternative() -> () = {
	var a: i32 = 7i32;
	var v: ref i32 | f32 = &a;

	check(refAltByRef(&v), 7i64, 20i64);
	check(refAltDirect(&v), 7i64, 21i64);

	# The variant holds a reference, so a later write to `a` is visible through it, and a write
	# through the binding lands back in `a`.
	a = 9i32;
	check(refAltByRef(&v), 9i64, 22i64);
	check(refAltWrite(&v, 11i32), 0i64, 23i64);
	check(a as i64, 11i64, 24i64);

	# The other alternative is a plain value and is unaffected by all of the above.
	v = (2.5 as f32);
	check(refAltByRef(&v), -1i64, 25i64);

	# Rebinding the reference alternative points the variant at another variable.
	var b: i32 = 21i32;
	v = &b;
	check(refAltByRef(&v), 21i64, 26i64);
	check(a as i64, 11i64, 27i64);
}

fun boxAlternative() -> () = {
	var v: box i32 | f32 = new 5i32;

	check(boxAltRead(&v), 5i64, 40i64);
	check(boxAltWrite(&v, 8i32), 0i64, 41i64);
	check(boxAltRead(&v), 8i64, 42i64);

	# Switching to the other alternative destroys the box.
	v = (2.5 as f32);
	check(boxAltRead(&v), -1i64, 43i64);
}

fun stringAlternative() -> () = {
	var v: String | i32 = "hello".toString();

	check(stringAltLength(&v), 5i64, 60i64);
	check(stringAltAppend(&v, '!'), 6i64, 61i64);
	check(stringAltLength(&v), 6i64, 62i64);

	# Replacing the string alternative destroys the string.
	v = 7i32;
	check(stringAltLength(&v), 7i64, 63i64);
	check(stringAltAppend(&v, '!'), -1i64, 64i64);
}

fun main() -> i64 = {
	matchPositions();
	refAlternative();
	boxAlternative();
	stringAlternative();

	return 0i64;
}
