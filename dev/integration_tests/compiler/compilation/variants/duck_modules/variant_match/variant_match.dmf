import core.builtins.*;

fun describe(v: i32 | f32) -> i64 = {
	var r: i64 = i64(0);
	r = match (v) {
		case x : i32 = i64(x);
		case _ = i64(-1);
	};
	return r;
}

fun pickExhaustive(v: i32 | f32) -> i64 = {
	var r: i64 = i64(0);
	r = match (v) {
		case x : i32 = i64(x) + i64(1);
		case y : f32 = i64(2);
	};
	return r;
}

fun main() -> i64 = {
	var a: i32 | f32 = i32(41);
	builtin_output_i64(describe(a));

	a = f32(3.5);
	builtin_output_i64(describe(a));

	a = i32(9);
	builtin_output_i64(pickExhaustive(a));
	a = f32(0.5);
	builtin_output_i64(pickExhaustive(a));

	return i64(0);
}
