import core.builtins.*;

# ===== Construction =====

fun construction() -> () = {
	# Construction via implicit coercion.
	var a: i32 = (7 as i32);
	var v: i32 | f32 = a;
	builtin_output_i64((1 as i64));

	# Reassignment with a different alternative.
	v = (2.5 as f32);
	builtin_output_i64((2 as i64));

	# Reassignment back to the first alternative.
	v = (42 as i32);
	builtin_output_i64((3 as i64));

	# Variant-to-variant assignment (same type, no coercion).
	var w: i32 | f32 = v;
	w = v;
	builtin_output_i64((4 as i64));
}

# ===== Match in each statement position =====

fun describe(v: i32 | f32) -> i64 = {
	var r: i64 = (0 as i64);
	r = match (v) {
		case x : i32 = (x as i64);
		case _ = (-1 as i64);
	};
	return r;
}

fun pickExhaustive(v: i32 | f32) -> i64 = {
	var r: i64 = match (v) {
		case x : i32 = (x as i64) + (1 as i64);
		case y : f32 = (2 as i64);
	};
	return r;
}

fun viaReturn(v: i32 | f32) -> i64 = {
	return match (v) {
		case x : i32 = (x as i64) * (2 as i64);
		case _ = (-5 as i64);
	};
}

# ===== Edge cases =====

# A single wildcard case: no alternative is ever tested.
fun onlyWildcard(v: i32 | f32) -> i64 = {
	return match (v) {
		case _ = (99 as i64);
	};
}

# A constrained wildcard binds nothing, so no payload is projected for it.
fun constrainedWildcard(v: i32 | f32) -> i64 = {
	return match (v) {
		case _ : i32 = (11 as i64);
		case _ : f32 = (22 as i64);
	};
}

# A `ref` binding aliases the payload in place instead of copying it out.
fun viaRefBinding(v: i32 | f32) -> i64 = {
	return match (v) {
		case x : ref i32 = (x as i64);
		case _ = (-2 as i64);
	};
}

# Nothing follows the match, so its continuation is the end of the function.
fun nothingAfter(v: i32 | f32) -> () = {
	match (v) {
		case x : i32 = builtin_output_i64(x as i64);
		case _ = builtin_output_i64(-3 as i64);
	};
}

fun main() -> i64 = {
	construction();

	var a: i32 | f32 = (41 as i32);
	builtin_output_i64(describe(a));

	a = (3.5 as f32);
	builtin_output_i64(describe(a));

	a = (9 as i32);
	builtin_output_i64(pickExhaustive(a));
	a = (0.5 as f32);
	builtin_output_i64(pickExhaustive(a));

	a = (21 as i32);
	builtin_output_i64(viaReturn(a));
	a = (1.5 as f32);
	builtin_output_i64(viaReturn(a));

	a = (5 as i32);
	builtin_output_i64(onlyWildcard(a));
	builtin_output_i64(constrainedWildcard(a));
	builtin_output_i64(viaRefBinding(a));
	nothingAfter(a);

	a = (2.5 as f32);
	builtin_output_i64(constrainedWildcard(a));
	builtin_output_i64(viaRefBinding(a));
	nothingAfter(a);

	return (0 as i64);
}
