import core.builtins.*;

fun foo(a: ref i64) = { a = a+1; }
fun bar(a: ref i64) = foo(&a);

fun main() -> i64 = {
    var a: i32 = 1;
    builtin_output_i64(a);

    var ref_a: ref i32 = &a;
    builtin_output_i64(ref_a);

    var box_a: box i32 = new a;
    builtin_output_i64(box_a);

    var ref_ref_a = &ref_a;
    builtin_output_i64(ref_ref_a);

    var ref_ref_a_2: ref ref i32 = ref_a;
    builtin_output_i64(ref_ref_a_2);
    
    var box_box_a: box box i32 = new a;
    builtin_output_i64(box_box_a);

    var box_ref_from_box: box ref i32 = new box_a;
    builtin_output_i64(box_ref_from_box);

    var box_ref_from_ref: box ref i32 = new ref_a;
    builtin_output_i64(box_ref_from_ref);

    var box_ref_from_direct: box ref i32 = new a;
    builtin_output_i64(box_ref_from_direct);

    var ref_box_from_ref: ref box i32 = &box_a;
    builtin_output_i64(ref_box_from_ref);

    var x: i64 = 2;
    bar(&x);
    builtin_output_i64(x);

    return 0;
}


