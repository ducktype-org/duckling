fun main() -> i32 = {
    var a: i32 = 1;
    builtin_output_i64(a);

    var ref_a: ref i32 = &a;
    builtin_output_i64(ref_a);

    var box_a: box i32 = a;
    builtin_output_i64(box_a);

    var ref_ref_a = &ref_a;
    builtin_output_i64(ref_ref_a);

    var ref_ref_a_2: ref ref i32 = ref_a;
    builtin_output_i64(ref_ref_a_2);

    var ref_ref_ref_a: ref ref ref i32 = &(&(&ref_a));
    builtin_output_i64(ref_ref_ref_a);
    
    var box_box_a: box box i32 = a;
    builtin_output_i64(box_box_a);

    var box_ref_a: box ref i32 = ref_a;
    builtin_output_i64(box_ref_a);

    var ref_box_a: ref box i32 = &box_a;
    builtin_output_i64(ref_box_a);


    return 0;
}