var glob_a: i64 = 100;
var glob_b: i64 = 200;

fun update_by_ref(r: ref i64, val: i64) -> () = {
    r = val;
}

fun test_globals_and_boxes() -> i32 = {
    update_by_ref(refof glob_a, 123);
    builtin_output_i64(glob_a);         # 123

    var b_from_glob: box i64 = glob_b;
    builtin_output_i64(b_from_glob);    # 200

    b_from_glob = 555;
    builtin_output_i64(b_from_glob);    # 555
    builtin_output_i64(glob_b);         # 200

    glob_a = b_from_glob;
    builtin_output_i64(glob_a);         # 555

    var local_box: box i64 = 10;
    var r_box = refof local_box;
    var r_glob = refof glob_b;

    r_box = 777;
    r_glob = 888;

    builtin_output_i64(local_box);      # 777
    builtin_output_i64(glob_b);         # 888

    return 0;
}

fun main() -> i32 = {
    test_globals_and_boxes();
    return 0;
}
