class Point {
    x: i32; 
    y: i32;
}

fun consumes_box(p: box Point) {
    builtin_output_i64(p.x);
}

fun produces_box() -> box i32 = {
    var b: box i32 = 1000;
    return move b;
}

fun point_by_box(p: box Point) -> () = {
    p.x = 777;
    p.y = 888;
    builtin_output_i64(p.x); # 777
}

fun boxes3() -> () = {
    var my_point: box Point = Point(10, 20);
    builtin_output_i64(my_point.x); # 10
    builtin_output_i64(my_point.y); # 20

    point_by_box(move my_point);

    builtin_output_i64(my_point.x); # This should be an error.

    var sanity_check: box Point = Point(0, 0);
    builtin_output_i64(sanity_check.x); # 0
}

fun main() -> i32 = {
    
    var b1: box i32 = 1;
    var b2 = move b1;

    builtin_output_i64(b2);
    builtin_output_i64(b1); # This should crash. Use after move.

    var b_point: box Point = Point(10, 20);
    consumes_box(move b_point);
    builtin_output_i64(b_point.x); # This should crash. Use after move.

    var b_from_func = produces_box();
    builtin_output_i64(b_from_func); # 1000

    var b_reassign: box Point = Point(1, 1);
    builtin_output_i64(b_reassign.x); # 1

    # Old box should be deallocated.
    b_reassign = Point(2, 2); 

    builtin_output_i64(b_reassign.x); # 2

    return 0;
}