import core.builtins.*;

class Point {
    x: i32;
    y: i32;
}

fun main() -> i64 = {
    var b_int: box i32 = 42;
    
    builtin_output_i64(b_int);
    b_int = 123;
    builtin_output_i64(b_int);
    
    var b_point: box Point = Point(1, 2);

    builtin_output_i64(b_point.x);
    builtin_output_i64(b_point.y);

    b_point.x = 99;
    b_point.y = 100;

    builtin_output_i64(b_point.x);
    builtin_output_i64(b_point.y);

    return 0;
}
