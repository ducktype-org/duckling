class Point { x: i64; y: i64; }
class Wrapper { p: Point; }

fun boxes1() -> () = {
    var w: box Wrapper = Wrapper(Point(1, 2));
    builtin_output_i64(w.p.x); # 1

    w.p.y = 42;
    builtin_output_i64(w.p.y); # 42
} 

class BoxPoint { x: box i64; y: box i64; }
class BoxWrapper { p: box BoxPoint; }

fun boxes2() -> () = {
    # Three allocations should appear:
    # - One for BoxPoint
    # - One for x
    # - One for y
    var b_wrapper: box BoxWrapper = BoxWrapper(BoxPoint(123, 456));

    builtin_output_i64(b_wrapper.p.x); # 123
    builtin_output_i64(b_wrapper.p.y); # 456

    b_wrapper.p.x = 999;
    builtin_output_i64(b_wrapper.p.x); # 999
} 

fun main() -> i64 = {
    # boxes1();
    boxes2();

    return 0;
}
