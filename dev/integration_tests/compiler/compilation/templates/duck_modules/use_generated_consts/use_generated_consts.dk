import core.builtins.*;

template(a: i64)
namespace M {
    var b = a;

    template(c: i64)
    fun foo() = a + c + 1;
}

template(a: i64)
fun get() = a;

template(a: i64)
const X = a;

fun main() -> i64 = {
    builtin_output_i64(M:{1}.b);
    builtin_output_i64(M:{2}.b);
    builtin_output_i64(M:{1}.b);

    builtin_output_i64(get:{1}());
    builtin_output_i64(get:{2}());
    builtin_output_i64(get:{1}());

    builtin_output_i64(M:{3}.foo:{1}());
    builtin_output_i64(M:{2}.foo:{1}());
    builtin_output_i64(M:{3}.foo:{2}());
    builtin_output_i64(M:{2}.foo:{2}());
    builtin_output_i64(M:{3}.foo:{1}());
    builtin_output_i64(M:{2}.foo:{1}());

    builtin_output_i64(X:{1});
    builtin_output_i64(X:{2});
    builtin_output_i64(X:{1});

    return 0;
}
