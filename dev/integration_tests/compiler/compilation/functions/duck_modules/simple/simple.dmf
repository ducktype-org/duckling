import core.builtins.*;

fun add(a: i64, b: i64) -> i64 = {
    return a + b;
}

fun addAndPrint(a: i64, b: i64) -> i64 = {
    let out = a + b;
    builtin_output_i64(out);
    return out;
}

fun noArgs() -> i64 = {
    return 1;
}

fun main() -> i64 = {
    let sum = noArgs() + addAndPrint(2, 3) + add(1, 0);
    builtin_output_i64(sum);
    return 0;
}
