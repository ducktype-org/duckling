import core.builtins.*;

fun print_no_default(a: i64, b: i64) -> i64 = {
    builtin_output_i64(a);
    builtin_output_i64(b);

    return 0;
}

fun print_default_b(a: i64, b: i64 = 2) -> i64 = {
    builtin_output_i64(a);
    builtin_output_i64(b);

    return 0;
}

fun print_default_both(a: i64 = 1, b: i64 = 2) -> i64 = {
    builtin_output_i64(a);
    builtin_output_i64(b);

    return 0;
}

fun main() -> i64 = {

    print_no_default(1, 2);            # 1, 2

    print_default_b(1);                # 1, 2,
    print_default_b(a = 3);            # 3, 2,
    print_default_b(4, 5);             # 4, 5,
    print_default_b(b = 3, a = 1);     # 1, 3,

    print_default_both();              # 1, 2,
    print_default_both(2, 3);          # 2, 3,
    print_default_both(b = 5, a = 4);  # 4, 5,
    print_default_both(b = 5);         # 1, 5,
    print_default_both(a = 4);         # 4, 2,

    return 0;
}
