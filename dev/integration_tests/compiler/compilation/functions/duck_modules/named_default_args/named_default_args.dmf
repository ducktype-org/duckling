fun print_no_default(a: i64, b: i64) -> i64 = {
    builtin_output_i64(a);
    builtin_output_i64(b);

    return 0i64;
}

fun print_default_b(a: i64, b: i64 = 2i64) -> i64 = {
    builtin_output_i64(a);
    builtin_output_i64(b);

    return 0i64;
}

fun print_default_both(a: i64 = 1i64, b: i64 = 2i64) -> i64 = {
    builtin_output_i64(a);
    builtin_output_i64(b);

    return 0i64;
}




fun main() -> i64 = {

    print_no_default(1i64, 2i64);            # 1, 2

    print_default_b(1i64);                # 1, 2,
    print_default_b(a = 3i64);            # 3, 2,
    print_default_b(4i64, 5i64);             # 4, 5,
    print_default_b(b = 3i64, a = 1i64);     # 1, 3,

    print_default_both();              # 1, 2,
    print_default_both(2i64, 3i64);          # 2, 3,
    print_default_both(b = 5i64, a = 4i64);  # 4, 5,
    print_default_both(b = 5i64);         # 1, 5,
    print_default_both(a = 4i64);         # 4, 2,

    return 0i64;
}