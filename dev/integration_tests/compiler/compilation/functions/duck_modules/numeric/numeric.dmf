import core.builtins.*;

fun add_i16(a: i16, b: i16) -> i16 = {
    return a + b;
}

fun multiply_u32(x: u32, y: u32) -> u32 = {
    return x * y;
}

fun average_f32(a: f32, b: f32) -> f32 = {
    return (a + b) / 2.0f32;
}

fun negate_f64(val: f64) -> f64 = {
    return -val;
}

fun identity_u64(n: u64) -> u64 = n;

fun main() -> i64 = {
    if (add_i16(200i16, 300i16) != 500i16) {
        builtin_output_i64(1);
    }
    if (add_i16(32767i16, 2i16) != -32767i16) {
        builtin_output_i64(2);
    }

    if (multiply_u32(1000u32, 2500u32) != 2500000u32) {
        builtin_output_i64(3);
    }

    let avg_res: f32 = average_f32(5.0f32, 10.0f32);
    if (avg_res != 7.5f32) {
        builtin_output_i64(4);
    }

    if (negate_f64(-123.456) != 123.456) {
        builtin_output_i64(5);
    }

    let u64_large: u64 = 18000000000000000000u64;
    if (identity_u64(u64_large) != u64_large) {
        builtin_output_i64(6);
    }

    return 0i64;
}
