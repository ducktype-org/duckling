import core.builtins.*;

import sub as s;

fun foo(a: i64) -> i64 = {
    return 42;
}

fun foo(b: i64) -> i64 = {
    return 7;
}

namespace N {
    fun foo(d: i64) -> i64 = {
        return d * 2;
    }
}

fun goo(a: i64 = 1, b: i64 = 2) -> i64 = {
    return a + b;
}

fun goo(a: i64) -> i64 = {
    return a * 2;
}

fun goo(a: i64 = 1, b: i64 = 2, c: i64) -> i64 = {
    return a + b + c;
}

fun test_calls() = {
    using N.*;
    builtin_output_i64(N.foo(d = 3));       # 6

    builtin_output_i64(goo());              # 3
    builtin_output_i64(goo(1, 4));          # 5
    builtin_output_i64(goo(a = 5, b = 6));  # 11
    builtin_output_i64(goo(b = 6));         # 7
    builtin_output_i64(goo(c = 10));        # 13
}

fun main() -> i64 = {

    let a = foo(a = 1);         # 42
    builtin_output_i64(a);
    let b = foo(b = a);         # 7
    builtin_output_i64(b);
    
    let c = s.foo(a = a);       # 43
    builtin_output_i64(c);
    let d = s.foo(c = c);       # 54
    builtin_output_i64(d);
    let e = N.foo(d = d);       # 108
    builtin_output_i64(e);

    test_calls();

    return a + b + c + d + e - 200;   # 54
}
