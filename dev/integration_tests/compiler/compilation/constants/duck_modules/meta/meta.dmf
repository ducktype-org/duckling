# This test tests the compile time evaluation of meta types. 
# Note that for more complex types we create bool constants 
# to assert their correctness, since some of them are not implemented.
fun createUnit() -> type = ();
fun createBox(t: type) -> type = box t;
fun createRef(t: type) -> type = ref t;
fun createVariant(a: type, b: type, c: type, d: type) -> type = a | b | c | d;
fun createTuple(a: type, b: type, c: type, d: type) -> type = (a, b, c, d);
fun createShortTuple(a: type, b: type) -> type = (a, b);
fun createMegaType(a: type) -> type = (createUnit(), createBox(a), i32, (i16, f16), i64 | (f64, f128));

fun typesEqual(a: type, b: type) -> bool = {
    return a == b;
}

const I32_TYPE = i32;
const I64_TYPE = i64;
const BOX_I32 = createBox(i32);
const REF_I32 = createRef(i32);

const MEGA_TYPE_I128 = createMegaType(i128);
const MEGA_TYPE_MANUAL: type = ((), box i128, i32, (i16, f16), i64 | (f64, f128));
const MEGA_TYPE_DIFFERENT = createMegaType(i64);

const TUPLE_A = createShortTuple(i32, f32);
const TUPLE_B: type = (i32, f32);


fun createInt() -> type = i32;
fun createBigInt() -> type = i64;
const A = createInt();
const B: A = 123;

const CMP1_IDENTICAL = I32_TYPE == i32;
const CMP2_DIFFERENT_PRIMITIVE = I32_TYPE == I64_TYPE;
const CMP3_DIFFERENT_CONSTRUCTION_SAME_TYPE = MEGA_TYPE_I128 == MEGA_TYPE_MANUAL;
const CMP4_DIFFERENT_MEGA_TYPE = MEGA_TYPE_I128 == MEGA_TYPE_DIFFERENT;
const CMP5_BOX_VS_REF = BOX_I32 == REF_I32;
const CMP6_TUPLES_EQUAL = TUPLE_A == TUPLE_B;
const CMP7_NOT_EQUAL = I32_TYPE != I64_TYPE;
const CMP8_NOT_EQUAL_FALSE = BOX_I32 != createBox(i32);
const CMP9_VIA_FUNCTION_TRUE = typesEqual(TUPLE_A, TUPLE_B);
const CMP10_VIA_FUNCTION_TRUE = typesEqual(MEGA_TYPE_I128, MEGA_TYPE_MANUAL);
const CMP11_VIA_FUNCTION_FALSE = typesEqual(MEGA_TYPE_I128, MEGA_TYPE_DIFFERENT);

class T {}
class U {}

fun getT() -> type = T;
fun getU() -> type = U;

const T_TYPE = T;
const U_TYPE = U;
const T2_TYPE = getT();

const CMP12 = T == T;
const CMP13 = T_TYPE == T2_TYPE;
const CMP14 = T != U;
const CMP15 = T != i32;

const T_ARRAY = getT()[5];      # T[5]
const T_LIST = List[getT()];    # List[T]
const CMP16 = T_ARRAY == T[5];
const CMP17 = T_LIST == List[T];

fun getTuple(order: i32, a: type, b: type) -> type = {
    if (order == 1) {
        return (a, b, createRef(a));
    } else {
        return (a, b, createRef(b));
    }
}

fun getVariant(order: i32, a: type, b: type) -> type = {
    if (order == 1) {
        return a | b | createRef(a);
    } else {
        return a | b | createRef(b);
    }
}

const T_IN_TUPLE = (i32, T, T, U);
const T_IN_TUPLE_MANUAL: type = (i32, getT(), getT(), getU());
const CMP18 = T_IN_TUPLE == T_IN_TUPLE_MANUAL;
const CMP19 = T_IN_TUPLE == createTuple(i32, T, T, U);
const CMP20 = (T, U, ref T) == getTuple(1, T, U);
const CMP21 = (T, U, ref U) == getTuple(0, T, U);
const CMP21 = (T, U, ref U) == getTuple(0, T, U);
const CMP22 = T | U | ref T == getVariant(0, T, U);
const CMP23 = T | U | ref U == getVariant(1, T, U);

fun main() -> i64 = {
    if (CMP1_IDENTICAL) {
        builtin_output_i64(1);
    }

    if (not CMP2_DIFFERENT_PRIMITIVE) {
        builtin_output_i64(2);
    }

    if (CMP3_DIFFERENT_CONSTRUCTION_SAME_TYPE) {
        builtin_output_i64(3);
    }

    if (not CMP4_DIFFERENT_MEGA_TYPE) {
        builtin_output_i64(4);
    }

    if (not CMP5_BOX_VS_REF) {
        builtin_output_i64(5);
    }

    if (CMP6_TUPLES_EQUAL) {
        builtin_output_i64(6);
    }

    if (CMP7_NOT_EQUAL) {
        builtin_output_i64(7);
    }

    if (not CMP8_NOT_EQUAL_FALSE) {
        builtin_output_i64(8);
    }
    
    if (CMP9_VIA_FUNCTION_TRUE) {
        builtin_output_i64(9);
    }

    if (CMP10_VIA_FUNCTION_TRUE) {
        builtin_output_i64(10);
    }

    if (not CMP11_VIA_FUNCTION_FALSE) {
        builtin_output_i64(11);
    }

    if(CMP12) {
        builtin_output_i64(12);
    }

    if(CMP13) {
        builtin_output_i64(13);
    }
    
    if(CMP14) {
        builtin_output_i64(14);
    }

    if(CMP15) {
        builtin_output_i64(15);
    }
    
    if(CMP16) {
        builtin_output_i64(16);
    }

    if(CMP17) {
        builtin_output_i64(17);
    }

    if(CMP18) {
        builtin_output_i64(18);
    }

    if(CMP19) {
        builtin_output_i64(19);
    }

    if(CMP20) {
        builtin_output_i64(20);
    }

    if(CMP21) {
        builtin_output_i64(21);
    }

    if(CMP22) {
        builtin_output_i64(22);
    }

    if(CMP23) {
        builtin_output_i64(23);
    }

    let sum: createInt() = 2147483647;
    let sum2: A = 2147483647;

    # If a correct type was evaluated this should be an overflow. So the result should be < 0.
    if (sum + 1 < 0)  {
        builtin_output_i64(12);
    } 

    if (sum2 + 1 < 0)  {
        builtin_output_i64(13);
    } 

    return 0i64;
}

