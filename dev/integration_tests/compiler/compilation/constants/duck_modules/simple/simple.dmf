import core.builtins.*;

fun operations(a: i64, b: i64) -> i64 = a + b*2i64;

fun fib(n: i64) -> i64 = {
   if (n < 2i64) { return n; }
   return fib(n - 1i64) + fib(n - 2i64);
}

fun fib_on_i32(n: i32) -> i32 = {
   if (n < 2) { return n; }
   return fib_on_i32(n - 1) + fib_on_i32(n - 2);
}
fun takeUnit(u: ()) -> i64 = 42i64;

fun unitIdentity(u: ()) -> () = u;

const one = 1;
const two = one + one;

const five_1 = operations(one, two);
const five_2 = operations(1, 2);
const five_3 = operations(1, one+one);

const FIB_10 = fib(10); # 55
const FIB_ON_I32_10 = fib_on_i32(10); # 55

const boolean = true and false; # false

const unit: () = ();

const PI_F32 = 3.14f32;
const RAD_F32 = 10.0f32;
const AREA_F32 = PI_F32 * RAD_F32 * RAD_F32;

const U16_MAX = 65535u16;
const U16_OVERFLOW = U16_MAX + 1u16;
const U8_MAX = 255u8;
const U8_OVERFLOW = U8_MAX + 1u8;
const I16_SOME_VALUE = -1000i16;
const I16_CALC = I16_SOME_VALUE / 10i16;

fun main() -> i64 = {
    builtin_output_i64(five_1);
    builtin_output_i64(five_2);
    builtin_output_i64(five_3);
    builtin_output_i64(FIB_10);
    builtin_output_i64(i64(FIB_ON_I32_10));

    if (not boolean) { builtin_output_i64(123123); }

    builtin_output_i64(takeUnit(unit));
    builtin_output_i64(takeUnit(unitIdentity(unit)));

    builtin_output_i64(i64(AREA_F32)); # 314
    builtin_output_i64(i64(U16_OVERFLOW)); # 0
    builtin_output_i64(i64(U8_OVERFLOW)); # 0
    builtin_output_i64(i64(I16_CALC)); # -100

    return 0i64;
}


