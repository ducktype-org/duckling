import core.builtins.*;

# This test checks record default values during construction and named arguments to constructors.
#
# This includes calling a function every time the constructor
# is called, if the function call is used as a default value.
#
# This also includes nested records and providing named arguments not fully and out of order.

class RecordClass {
    a: i64 = 1;
    b: i64 = 2;
}

var countdown: i64 = 0;

fun getRecordClass() -> RecordClass = {
    builtin_output_i64(countdown);
    countdown = countdown - i64(1);
    return RecordClass();
}

class BiggerRecordClass {
    x: i64 = 11;
    y: RecordClass = getRecordClass();
    z: i64 = 13;
}

let big1 = BiggerRecordClass();

fun main() -> i64 = {
    builtin_output_i64(big1.x); # 11
    builtin_output_i64(big1.y.a); # 1
    builtin_output_i64(big1.y.b); # 2
    builtin_output_i64(big1.z); # 13

    var big2 = BiggerRecordClass(z = 23, x = i32(21));
    builtin_output_i64(big2.x); # 21
    builtin_output_i64(big2.y.a); # 1
    builtin_output_i64(big2.y.b); # 2
    builtin_output_i64(big2.z); # 23

    var big3 = BiggerRecordClass(y = RecordClass(b = i16(32)));
    builtin_output_i64(big3.x); # 11
    builtin_output_i64(big3.y.a); # 1
    builtin_output_i64(big3.y.b); # 32
    builtin_output_i64(big3.z); # 13

    return 0i64;
}
