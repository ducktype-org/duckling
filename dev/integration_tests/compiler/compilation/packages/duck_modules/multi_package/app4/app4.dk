import lib_a;
import lib_b;
import lib_c;

fun check(val: i64 | ()) -> bool = {
    return match(val) {
        case i: i64 = true;
        case _: () = false;
    }
}

fun main() -> i64 = {
    const empty: () = ();
    let check_empty = check(empty);

    let a = lib_a.foo();
    let na = lib_a.Name.foo();
    let b = lib_b.foo();
    let nb = lib_b.Name.foo();
    let c = lib_c.foo();
    let nc = lib_c.Name.foo();

    let is_ok = not check_empty or
                not check(a) or not check(na) or
                check(b) or check(nb) or
                check(c) or check(nc);

    if (is_ok) {
        builtin_output_i64(1);
    } else {
        builtin_output_i64(0);
    }

    return 0;
}