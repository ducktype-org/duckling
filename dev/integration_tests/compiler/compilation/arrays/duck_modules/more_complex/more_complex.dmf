fun print_separator() -> () = {
    builtin_output_i64(88888888888);
}

fun test_1d_indexing() -> () = {
    var arr: i32[3];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    
    builtin_output_i64(arr[0]); # 10
    builtin_output_i64(arr[1]); # 20
    builtin_output_i64(arr[2]); # 30
}

fun sum_elements(a: i32[3]) -> i32 = {
    return a[0] + a[1] + a[2];
}

fun fill_ref(a: ref i32[3]) -> () = {
    a[0] = 100;
    a[1] = 200;
    a[2] = 300;
}

fun test_references() -> () = {
    var my_arr: i32[3];
    fill_ref(refof my_arr);
    
    builtin_output_i64(my_arr[0]); # 100
    builtin_output_i64(my_arr[1]); # 200
    builtin_output_i64(my_arr[2]); # 300
    
    let s = sum_elements(my_arr);
    builtin_output_i64(s); # 600
}

fun test_multi_dimensional() -> () = {
    var matrix: i32[2][2];
    matrix[0][0] = 1;
    matrix[0][1] = 2;
    matrix[1][0] = 3;
    matrix[1][1] = 4;
    
    builtin_output_i64(matrix[0][0]); # 1
    builtin_output_i64(matrix[0][1]); # 2
    builtin_output_i64(matrix[1][0]); # 3
    builtin_output_i64(matrix[1][1]); # 4
    
    var i = 1;
    builtin_output_i64(matrix[i][i - 1]); # matrix[1][0] -> 3
}

fun get_array_by_val() -> i32[3] = {
    var tmp: i32[3];
    tmp[0] = 7;
    tmp[1] = 8;
    tmp[2] = 9;
    return tmp;
}

fun test_array_return() -> () = {
    let val = get_array_by_val()[1];
    builtin_output_i64(val); # 8
}

fun main() -> i32 = {
    print_separator();

    test_1d_indexing();
    print_separator();
    
    test_references();
    print_separator();
    
    test_multi_dimensional();
    print_separator();
    
    test_array_return();
    print_separator();
    
    return 0;
}