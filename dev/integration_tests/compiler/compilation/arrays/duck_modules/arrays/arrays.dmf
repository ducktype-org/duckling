fun main() -> i32 = {
    var arr: i32[2];
    
    builtin_output_i64(arr[0]);
    builtin_output_i64(arr[1]);
    
    arr[0] = 123;
    arr[1] = 345;

    builtin_output_i64(arr[0]);
    builtin_output_i64(arr[1]);
    
    var arr2d: i32[2][2];
    builtin_output_i64(arr2d[0][0]);
    builtin_output_i64(arr2d[0][1]);
    builtin_output_i64(arr2d[1][0]);
    builtin_output_i64(arr2d[1][1]);
    
    var i = 0;
    var val = 123;
    while (i < 2) {
        var j = 0;
        while (j < 2) {
            arr2d[i][j] = val;
            val = val + 1;
            j = j + 1;
        }
        i = i + 1;
    }

    builtin_output_i64(arr2d[0][0]);
    builtin_output_i64(arr2d[0][1]);
    builtin_output_i64(arr2d[1][0]);
    builtin_output_i64(arr2d[1][1]);
    


    return 0;
}
