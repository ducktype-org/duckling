# TODOP: Future continue issue jumping over the index incrementation.

fun printSeparator() -> () = {
    builtin_output_i64(888);
}

fun look(list: ref List[i32], target: i64) -> bool = {
    for (x in list) {
        if (x == target) {
            return true;
        }
    }
    return false;
}

