fun main() -> i64 = {
    var dyn_arr: List[i32];
    dyn_arr += 1; dyn_arr += 2;
    
    var a = 1;
    var dyn_ref_arr: List[ref i32];
    dyn_ref_arr += &a; dyn_ref_arr += &a;

    # ===== Dynamic Arrays =====
    printSeparator(); 
    for (x in dyn_arr) {        # Type inferred to `i32`
        builtin_output_i64(x);  # 1, 2
    }

    printSeparator(); 
    for (x in dyn_ref_arr) {    # Type inferred to `ref i32`
        builtin_output_i64(x);  # 1, 11
        x = x + 10;             # Should mutate the next array elements.
    }

    printSeparator(); 
    for (x in dyn_ref_arr) {
        builtin_output_i64(x);  # 21, 21
        dyn_ref_arr += &a;      # This won't cause an infinite loop since we calculate len once.
    }

    printSeparator(); 
    for (x in dyn_ref_arr) {
        builtin_output_i64(x);  # 21, 21, 21, 21
        dyn_ref_arr -= 3;       # This works by accident, since our lists don't shrink.
    }

    printSeparator(); 
    builtin_output_i64(i64(len dyn_ref_arr)); # 0

    printSeparator(); 
    builtin_output_i64(look(&dyn_arr, 1)); # 1
    builtin_output_i64(look(&dyn_arr, 0)); # 0
    
    # ===== Nested fors =====
    
    # @TODO: #2000 This should work but we don't have copies. Enable once implemented.
    # var dyn_matrix: List[List[i64]];
    # var dyn_a: List[i64]; var dyn_b: List[i64];
    # dyn_a += 1; dyn_b += 1;
    # dyn_matrix += dyn_a; dyn_matrix += dyn_b;
    # for (row in dyn_matrix) {
    #     for (col in row) {
    #         builtin_output_i64(col);
    #     }
    # }

    return 0;
}
