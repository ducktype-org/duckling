}

fun D() -> i64 = {
    var x: i64 = 1;
    if (x == 0) {
        var y: i64 = 1;
        x = x + y;
    } else {
        {
            var z: i64 = 2;
            {
                var w: i64 = 3;
                x = x + z + w;
            };
        };
    }
    return x;
}

fun E() -> i64 = {
    {
        var x: i64 = 0;
        var y: i64 = 1;
        while(x < y) {
            x = x + 1;
        }
    };
    return 0;
}

fun F() -> i64 = {
    var ret: i64 = 0;
    {
        var x: i64 = 0;
        {
            var y: i64 = 1;
            {
                while(x < y) {
                    {
                        var z: i64 = 2;
