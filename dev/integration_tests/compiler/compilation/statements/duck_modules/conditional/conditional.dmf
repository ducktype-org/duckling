import core.builtins.*;

fun main() -> i64 = {
    # Testing using if with a literal value
    if (true) {}
    else {
        return 2i64;
    }

    if (false) {
        return 3i64;
    }

    # Testing using if with a local variable
    var a: bool = true;
    if (a) {
    } else {
        return 4i64;
    }

    a = false;
    if (a) {
        return 5i64;
    } else {}

    # Testing nested if expressions
    if (true) {
        if (false) {
            return 6i64;
        } else {
            if (false) {
                return 7i64;
            } else {}
        }
    }

    var output: i64 = 0i64;
    # Non empty both cases
    if (true) {
        output = 9i64;            # output = 9
    } else {
        output = 1i64;
    }

    if (a) {                   # a = false
        output = output + 10i64;
    } else {
        output = output + 90i64;  # output = 99
    }

    return output;
}
