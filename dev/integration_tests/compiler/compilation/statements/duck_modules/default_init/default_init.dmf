class Simple {
    x: i64 = 123;
    y: i32;         # Should be 0
}

class Nested {
    s: Simple;
    active: bool = true;
}

class ArrayContainer {
    points: Simple[3];
}

fun printSeparator() -> () = {
    builtin_output_string("=================\n");
}

fun testPrimitives() = {
    var a: i32;
    var b: f64;
    var c: bool;
    # TODOP: More cases
    builtin_output_i64(a);                  # 0
    builtin_output_f64(b);                  # 0.0
    builtin_output_i64(if c then 1 else 0); # 0
}

fun testClassInit() = {
    var s: Simple;
    builtin_output_i64(s.x);                        # 123
    builtin_output_i64(s.y);                        # 0

    var n: Nested;
    builtin_output_i64(n.s.x);                      # 123
    builtin_output_i64(if n.active then 1 else 0);  # 1
}

fun testArrayOfPrimitives() = {
    var arr: i64[5];
    var i = 0;
    var sum = 0i64;
    while (i < 5) {
        sum = sum + arr[i];
        i = i + 1;
    }
    builtin_output_i64(sum);        # 0
}

fun testArrayOfClasses() = {
    var arr: Simple[2];
    builtin_output_i64(arr[0].x); # 123
    builtin_output_i64(arr[1].x); # 123

    var container: ArrayContainer;
    builtin_output_i64(container.points[2].x);  # 123
}

class Deep {
    val: i64 = 999;
}
class Middle {
    d: Deep[2];
}
class Outer {
    m: Middle[2];
}

fun testDeepNesting() = {
    var o: Outer;
    builtin_output_i64(o.m[1].d[1].val);    # 999
}

fun main() -> i32 = {
    printSeparator();
    testPrimitives();

    printSeparator();
    testClassInit();

    printSeparator();
    testArrayOfPrimitives();

    printSeparator();
    testArrayOfClasses();

    printSeparator();
    testDeepNesting();

    return 0;
}