fun main() -> i64 = {
    while (false) {
        builtin_output_i64(1);
    }

    let a: i64 = 10;
    let b: i64 = 15;
    let c: i64 = 10;

    while (a < b) {
        a = a + c;
        builtin_output_i64(a);
    }
    # a = 20

    b = 100000000;
    c = 3;

    while (a < b) {
        a = a + c;
    }
    builtin_output_i64(a); # a = 1000001
    return 0;
}
