# for [loop-name]([var|let] <iter name>[: <iter type>] in <collection>) <statement>;

fun get_arr() -> i32[2] = {
    var l: i32[2]; 
    l[0] = 100;
    l[1] = 200;
    return l;
}

fun look(arr: i64[3], target: i64) -> bool = {
    for (x in arr) {
        if (x == target) {
            return true;
        }
    }
    return false;
}



fun main() -> i64 = {
    var static_arr: i64[3];
    static_arr[0] = 1;
    static_arr[1] = 2;
    static_arr[2] = 3;
    
    
    for (x: i64 in static_arr) {
        builtin_output_i64(x);
    }
    builtin_output_i64(8888888888);

    for (x in static_arr) {
        x = 123;
        builtin_output_i64(x);
    }

    for (x in static_arr) {
        builtin_output_i64(x);
    }

    builtin_output_i64(8888888888);

    # for (x: f32 in static_arr) {
    #     builtin_output_f64(x);
    # }
    
    var dyn_arr: List[i32];
    dyn_arr += 1;
    dyn_arr += 2;
    dyn_arr += 3;

    # TODOP: This doesn't work and there is no way to make it work currently.
    # builtin_output_i64(888888888812398123);
    # for (x: ref i32 in dyn_arr) {
    #     builtin_output_i64(x);
    # }
    # dyn_arr -= 1;

    for (x in dyn_arr) {
        builtin_output_i64(x);
    }

    builtin_output_i64(8888888888);

    var a = 1;
    var dyn_ref_arr: List[ref i32];
    dyn_ref_arr += &a;
    dyn_ref_arr += &a;
    dyn_ref_arr += &a;
    
    for (x in dyn_ref_arr) {
        builtin_output_i64(x);
        x = x + 10;
    }

    builtin_output_i64(8888888888);
    for (x in dyn_ref_arr) {
        builtin_output_i64(x);
        x = x + 10;
        dyn_ref_arr += &a; # This won't cause an infite loop since we calculate len once.
    }

    builtin_output_i64(8888888888);
    for (x in dyn_ref_arr) {
        builtin_output_i64(x);
        dyn_ref_arr -= 3; # This works by accident, since our lists don't shrink.
    }

    builtin_output_i64(i64(len dyn_ref_arr));

    builtin_output_i64(8888888888);
    for (x: i32 in dyn_ref_arr) {
        builtin_output_i64(x);
    }

    builtin_output_i64(8888888888);
    
    # TODOP: R-Value collections
    for (x in get_arr()) { # This works by accident. We should probably move the value into a temporary if it's r-value?
        builtin_output_i64(x);
    }

    # TODOP: Future continue issue.
    
    builtin_output_i64(99999998888888888);
    # TODOP: Nested loops
    for (x in static_arr) {
        builtin_output_i64(x);
        for (y in static_arr) {
            builtin_output_i64(y);
        }
    }
    builtin_output_i64(99999998888888888);


    var lister: List[i32];
    for (x in lister) {
        builtin_output_i64(9999);
    }

    builtin_output_i64(8888888888);

    var matrix: i64[2][2];
    matrix[0][0] = 1; matrix[0][1] = 2;
    matrix[1][0] = 3; matrix[1][1] = 4;
    for (row in matrix) {
        for (col in row) {
            builtin_output_i64(col);
        }
    }
    
    # TODOP: This should work but we don't have copies.
    # var dyn_matrix: List[List[i64]];
    # var dyn_a: List[i64];
    # var dyn_b: List[i64];
    # dyn_a += 1;
    # dyn_b += 1;
    # dyn_matrix += dyn_a;
    # dyn_matrix += dyn_b;
    # for (row in dyn_matrix) {
    #     for (col in row) {
    #         builtin_output_i64(col);
    #     }
    # }


    # var dyn_const_arr: List[const i32];
    # dyn_const_arr += 1;
    # dyn_const_arr += 1;
    # dyn_const_arr += 1;
    # for (x in dyn_const_arr) {
    #     builtin_output_i64(x);
    #     x = 2; # This will cause appropriate error when mutating the immutable.
    # }
    
    # for (x: const i32 in dyn_arr) {
    #     builtin_output_i64(x);
    #     x = 2; # This will cause appropriate error when mutating the immutable.
    # }

    builtin_output_i64(look(&static_arr, 1));
    builtin_output_i64(look(&static_arr, 0));

    var ref_sarr = &static_arr;
    for (x in ref_sarr) { # Works beautifully because of reference collapsing.
        builtin_output_i64(x);
    }
    
    # for (let x in static_arr) {
    #     builtin_output_i64(x);
    #     x = 123; # Causes error as it should
    # }

    for (let x: i64 in static_arr) {
        builtin_output_i64(x);
    }
    
    # Works
    for (var x in static_arr) {
        builtin_output_i64(x);
        x = 123;
    }

    for (var x: i64 in static_arr) {
        builtin_output_i64(x);
    }
    
    for (x in 5) {}

    return 0;
}
