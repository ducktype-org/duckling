import core.builtins.*;

class T {
    a: i64;
    b: bool;
}

fun main() -> i64 = {
    var i: i64;
    builtin_output_i64(i); # 0
    var b: i32;
    builtin_output_i64(b); # 0
    var f: f64;
    
    var klazz: T;
    builtin_output_i64(klazz.a); # 0
    builtin_output_i64(if klazz.b then 1 else 0); # 0

    var arr: i64[3];
    builtin_output_i64(arr[0] + arr[1] + arr[2]); # 0
    
    var arr2: T[2];
    builtin_output_i64(arr2[0].a + arr2[1].a); # 0
    builtin_output_i64(if arr2[0].b then 1 else 0); # 0

    var tup: (i64, bool);
    builtin_output_i64(tup._1); # 0
    builtin_output_i64(if tup._2 then 1 else 0); # 0

    # @TODO: #2448 Investigate why deterministic compilation check fails for this test
    var tup2: (T, T);
    builtin_output_i64(tup2._1.a + tup2._2.a); # 0
    builtin_output_i64(if tup2._1.b or tup2._2.b then 1 else 0); # 0


    # @TODO: #2483 When strings are handled in DVM, remove this test and enable `statements/default_initialization` for DVM.

    return 0;
}
