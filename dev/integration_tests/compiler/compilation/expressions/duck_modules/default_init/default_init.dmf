class Point {
    x: i64 = 777;
    y: i64 = 888;
}

fun main() -> i32 = {
    var i: i64;
    builtin_output_i64(i); # 0

    var f: f64;
    builtin_output_f64(f); # 0.0

    var arr: i32[1];
    builtin_output_i64(arr[0]); # 0
    builtin_output_i64(arr[1]); # 0

    # @TODO: #1941 This should call a default constructor of Point in the near future. 
    # The output should then be 777, 888.
    var p: Point;
    builtin_output_i64(p.x); # 0
    builtin_output_i64(p.y); # 0

    return 0;
}