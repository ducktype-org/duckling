import core.builtins.*;

fun main() -> i64 = {
    # NOTE: Language currently only has i64 literals; no direct float literals.
    # We restrict tests to casts derivable from i64 sources.

    # 1) i32 -> i64 (widening)
    var a32: i32 = (-1) as i32;  # explicit narrow from i64 literal
    var a64: i64 = a32 as i64;   # explicit widen
    builtin_output_i64(a64);     # -1

    # 2) i32 -> i64 (positive)
    var b32: i32 = 255 as i32;
    var b64: i64 = b32 as i64;
    builtin_output_i64(b64);     # 255

    # 3) i64 -> i32 -> i64 (narrow then extend; wrap)
    var big: i64 = 4294967295;   # 0x00000000_FFFFFFFF -> -1 when truncated to i32
    var c32: i32 = big as i32;
    var c64: i64 = c32 as i64;
    builtin_output_i64(c64);     # -1

    # 4) i32 -> f64 -> i32 (round trip, value in range, no saturation)
    var d32: i32 = (-42) as i32;
    var dflt: f64 = d32 as f64;       # int -> float
    var d32b: i32 = dflt as i32;      # float -> int
    var d64: i64 = d32b as i64;
    builtin_output_i64(d64);     # -42

    # 5) large positive -> f64 -> i32 (saturate to INT32_MAX)
    var bigpos: i64 = 3000000000;    # > INT32_MAX
    var bigposf: f64 = bigpos as f64;
    var satpos32: i32 = bigposf as i32;     # saturating
    var satpos64: i64 = satpos32 as i64;
    builtin_output_i64(satpos64);    # 2147483647

    # 6) large negative -> f64 -> i32 (saturate to INT32_MIN)
    var bigneg: i64 = -3000000000i64;   # < INT32_MIN
    var bignegf: f64 = bigneg as f64;
    var satneg32: i32 = bignegf as i32;     # saturating
    var satneg64: i64 = satneg32 as i64;
    builtin_output_i64(satneg64);    # -2147483648

    # 7) Implicit widening casts should still work (i16 -> i64 and i32 -> i64)
    var w16: i16 = 7 as i16;
    var w64a: i64 = w16;             # implicit widen
    builtin_output_i64(w64a);        # 7

    var w32: i32 = 9 as i32;
    var w64b: i64 = w32;             # implicit widen
    builtin_output_i64(w64b);        # 9

    var bool_i64: i64 = 64;
    var bool_val: bool = bool_i64;
    var bool_i64b: i64 = bool_val;
    builtin_output_i64(bool_i64b);   # 1

    # 8) int -> bool is a "is it non-zero" test, not a truncation. 64 has no bits in common
    #    with a 1-bit bool, so truncating would wrongly give `false`.
    var to_bool: bool = 64 as bool;
    builtin_output_i64(to_bool as i64);          # 1
    var zero_to_bool: bool = 0 as bool;
    builtin_output_i64(zero_to_bool as i64);     # 0
    var narrow: i32 = (-3) as i32;
    builtin_output_i64((narrow as bool) as i64); # 1

    # 9) float -> bool, also a non-zero test (a saturating fptoui would give 0 for 0.5).
    var half: f64 = 0.5;
    builtin_output_i64((half as bool) as i64);   # 1
    var fzero: f64 = 0.0;
    builtin_output_i64((fzero as bool) as i64);  # 0
    var fneg: f64 = -1.5;
    builtin_output_i64((fneg as bool) as i64);   # 1

    # 10) bool -> numeric, in both directions of the numeric hierarchy.
    var yes: bool = true;
    builtin_output_i64(yes as i64);              # 1
    var no: bool = false;
    builtin_output_i64(no as i64);               # 0
    var as_float: f64 = yes as f64;
    builtin_output_i64(as_float as i64);         # 1

    return 0i64;
}
