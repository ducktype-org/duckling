import core.builtins.*;

fun helloWorld() = {
    let myString = builtin_input_string();
    print(myString);
    print("\nHello, world!\n");
}

fun prependAppend() = {
    let b = "b";
    print('a' +: b);
    print("\n");
    print(b :+ 'c' :+ 'd');
    print("\n");
}

fun concat() = {
    let hello = "Hello, ";
    let world = "world!\n";
    print(hello ++ world);
}

fun main() -> i64 = {
    helloWorld();
    prependAppend();
    concat();
    return 0;
}
