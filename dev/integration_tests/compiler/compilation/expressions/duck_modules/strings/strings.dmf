import core.builtins.*;
import core.containers.*;

fun helloWorld() = {
    let myString = builtin_input_string();
    print(&myString);
    print("\nHello, world!\n");
}

fun prependAppend() = {
    let b = "b".toString();
    print('a' +: copy b);
    print("\n");
    print(copy b :+ 'c' :+ 'd');
    print("\n");
}

fun concat() = {
    let hello = "Hello, ".toString();
    let world = "world!\n".toString();
    print(&hello ++ (&world));
}

fun main() -> i64 = {
    helloWorld();
    prependAppend();
    concat();
    return 0;
}
