fun main() -> i64 = {
    let a_16: i16 = -32000i16;
    let b_16: i16 = 10i16;

    if (a_16 > b_16) {
        builtin_output_i64(1);
    }

    if (a_16 + b_16 != -31990i16) {
        builtin_output_i64(2);
    }

    let a_32: i32 = -2000000000i32;
    let b_32: i32 = 2000000000i32;

    if (a_32 >= b_32) {
        builtin_output_i64(3);
    }

    if (a_32 == b_32) {
        builtin_output_i64(4);
    }
    
    if (a_32 + b_32 != 0i32) {
        builtin_output_i64(5);
    }

    if (1000i32 * (-1000i32) != -1000000i32) {
        builtin_output_i64(6);
    }

    return 0i64;
}