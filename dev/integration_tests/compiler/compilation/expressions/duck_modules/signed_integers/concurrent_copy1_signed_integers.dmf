fun main_copy1() -> i64 = {
    ### I8 ###
    let a_8: i8 = -100i8;
    let b_8: i8 = 10i8;
    
    if (a_8 > b_8) {
        builtin_output_i64(1);
    }

    if (a_8 + b_8 != -90i8) {
        builtin_output_i64(2);
    }

    let i8_max: i8 = 127i8;
    let i8_min: i8 = i8_max + 1i8;

    # @TODO: #1732 This and INT_MIN of all the other sizes don't work...
    # let i8_min: i8 = -128u8;

    if (i8_min - 1i8 != 127i8) {
        builtin_output_i64(4);
    }

    ### I16 ###
    let a_16: i16 = -32000i16;
    let b_16: i16 = 10i16;
    
    if (a_16 > b_16) {
        builtin_output_i64(5);
    }

    if (a_16 + b_16 != -31990i16) {
        builtin_output_i64(6);
    }

    let i16_max: i16 = 32767i16;
    let i16_min: i16 = i16_max + 1i16;

    if (i16_min - 1i16 != 32767i16) {
        builtin_output_i64(7);
    }
    
    ### I32 ###
    let a_32: i32 = -2000000000i32;
    let b_32: i32 = 2000000000i32;

    if (a_32 >= b_32) {
        builtin_output_i64(8);
    }

    if (a_32 == b_32) {
        builtin_output_i64(9);
    }
    
    if (a_32 + b_32 != 0i32) {
        builtin_output_i64(10);
    }

    if (1000i32 * (-1000i32) != -1000000i32) {
        builtin_output_i64(11);
    }

    let i32_max: i32 = 2147483647i32;
    let i32_min: i32 = i32_max + 1i32;

    if (i32_min - 1i32 != 2147483647i32) {
        builtin_output_i64(12);
    }
    
    ### NUMERIC LITERALS ###
    let bin = 0b010010101;
    if (bin != 149) {
        builtin_output_i64(13);
    }
    
    let oct = 0o0234753;
    if (oct != 80363) {
        builtin_output_i64(14);
    }
    
    let hex = 0xefabc1239;
    if (hex != 64336171577) {
        builtin_output_i64(15);
    }
    
    let hex2 = 0xEFABC1239;
    if (hex != hex2) {
        builtin_output_i64(16);
    }
    
    return 0i64;
}
