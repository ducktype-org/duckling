import core.builtins.*;

# The DVM backend lowers binary/unary operations to destructive two-operand
# opcodes. When the destination aliases an argument (x = a - x), the operation
# used to be performed directly on the lhs local, clobbering `a` for the rest
# of the function.

fun main() -> i64 = {
    var a = 10i64;
    var x = 3i64;
    x = a - x;
    builtin_output_i64(a);
    builtin_output_i64(x);

    var y = 4i64;
    y = a - y;
    builtin_output_i64(a);
    builtin_output_i64(y);

    return 0;
}
