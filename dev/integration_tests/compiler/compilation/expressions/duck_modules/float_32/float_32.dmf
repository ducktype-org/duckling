import core.builtins.*;

fun main() -> i64 = {
    let a: f32 = 1.5f32;
    let b: f32 = 2.5f32;

    if (a + b != 4.0f32) {
        builtin_output_i64(1);
    }

    if (b / a != 1.6666666f32) {
        builtin_output_i64(2);
    }

    if (a > b) {
        builtin_output_i64(3);
    }

    let neg: f32 = -10.0f32;
    if (neg > 0.0f32) {
        builtin_output_i64(4);
    }

    let c: f32 = 0.1f32 + 0.2f32;
    if (c < 0.29f32 and c > 0.31f32) {
        builtin_output_i64(5);
    }

    return 0i64;
}
