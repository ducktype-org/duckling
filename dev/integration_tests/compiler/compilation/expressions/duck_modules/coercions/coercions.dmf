# Checks whether numerics in if statements coerce to bool expressions correctly.
fun main() -> i64 = {
    if (0) {
        builtin_output_i64(1);
    }

    if (5) {
    } else {
        builtin_output_i64(2);
    }

    if (0i16) {
        builtin_output_i64(3);
    }

    if (0u16) {
        builtin_output_i64(4);
    } 

    if (1u16) {
    } else {
        builtin_output_i64(4);
    }


    if (0i64) {
        builtin_output_i64(5);
    }

    # f32 coerce to bool.
    if (0.0) {
        builtin_output_i64(6);
    } 

    # f64 coerce to bool.
    if (3.14) {
    } else {
        builtin_output_i64(7);
    }

    return 0i64;
}
