import core.builtins.*;
import core.containers.*;

fun main() -> i64 = {
    # A `manyptr T` addresses a contiguous run of `T`s, so casting it to a `ptr T` yields a
    # pointer to the first element of that run.
    var many: manyptr i64 = allocation:{i64}.alloc(3u64);
    many[0] = 11i64;
    many[1] = 22i64;
    many[2] = 33i64;

    var first: ptr i64 = many as ptr i64;
    builtin_output_i64(*first);      # 11

    # Writing through the narrowed pointer is visible through the many-pointer.
    *first = 44i64;
    builtin_output_i64(many[0]);     # 44

    # The other elements are untouched.
    builtin_output_i64(many[1]);     # 22

    allocation:{i64}.free(many);
    return 0i64;
}
