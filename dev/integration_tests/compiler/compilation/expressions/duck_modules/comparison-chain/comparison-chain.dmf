fun numeric() -> () = {
    let c = 3;

    #    (           true           )
    #   3 >= 3 < 4 >= 3 == 3 <= 3 >= 3
    if (3 >= c < 4 >= c == c <= c >= c) {}
    else {
        builtin_output_string("bad 1");
    }

    #   (false) true  true
    #   -2 <= -3 == -3 != 3
    if (-2 <= -c == -c != c) { # first comparison is important
        builtin_output_string("bad 2");

        #       true  (false) true
        #      -4 <= -3 != -3 != 3
    } else if (-4 <= -c != -c != c) { # middle comparison is important
        builtin_output_string("bad 3");

        #       true  true (false)
        #      -4 <= -3 == -3 != 3
    } else if (-4 <= -c == -c == c) { # last comparison is important
        builtin_output_string("bad 4");
    }

    #           (false) true true
    #             5 < 3 <= 4 > 9
    let d: bool = 5 < c <= 4 > 9; # first
    if (d) {
        builtin_output_string("bad 5");
    }

    #               (      true      )                   true true true true
    #                3 == 3 != 3 == 3                    2 < 3 <= 3 <= 3 < 7
    let e: bool = if c == c != c == c  then false   else 2 < c <= 3 <= c < 7;
    if (e) {
    } else {
        builtin_output_string("bad 6");
    }
}

var counter = 0;

fun inc(x: i64) -> i64 = {
    counter = counter + 1;
    return x;
}

fun single_evaluation() -> () = {
    #        false    false
    if (inc(1) > inc(2) > inc(3)) {
        builtin_output_string("bad inc");
    }

    if (counter != 3) {
        builtin_output_string("bad counter : ");
        builtin_output_i64(counter);
    }
}

fun main() -> i64 = {
    numeric();
    single_evaluation();

    return 0;
}
