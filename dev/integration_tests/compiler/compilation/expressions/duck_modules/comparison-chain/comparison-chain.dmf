fun main() -> i64 = {
    let c = 3i64;

    #    (           true           )
    #   3 >= 3 < 4 >= 3 == 3 <= 3 >= 3
    if (3i64 >= c < 4i64 >= c == c <= c >= c) {}
    else {
        return 1i64;
    }

    #   (false) true  true
    #   -2 <= -3 == -3 != 3
    if (-2i64 <= -c == -c != c) { # first comparison is important
        return 2i64;

        #       true  (false) true
        #      -4 <= -3 != -3 != 3
    } else if (-4i64 <= -c != -c != c) { # middle comparison is important
        return 3i64;

        #       true  true (false)
        #      -4 <= -3 == -3 != 3
    } else if (-4i64 <= -c == -c == c) { # last comparison is important
        return 4i64;
    }

    #           (false) true true
    #             5 < 3 <= 4 > 9
    let d: bool = 5i64 < c <= 4i64 > 9i64; # first
    if (d) {
        return 5i64;
    }

    #               (      true      )                   true true true true
    #                3 == 3 != 3 == 3                    2 < 3 <= 3 <= 3 < 7
    let e: bool = if c == c != c == c  then false   else 2i64 < c <= 3i64 <= c < 7i64;
    if (e) {
    } else {
        return 6i64;
    }

    return 0i64;
}
