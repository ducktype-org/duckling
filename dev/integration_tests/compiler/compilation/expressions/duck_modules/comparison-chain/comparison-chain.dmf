fun main() -> i64 = {
    let c = 3;

    #   3 >= 3 < 4 >= 3 == 3 <= 3 >= 3
    if (3 >= c < 4 >= c == c <= c >= c) {}
    else {
        return 1;
    }

    #   -2 <= -3 == -3 != 3
    if (-2 <= -c == -c != c) { # first comparison is important
        return 2;
        #      -4 <= -3 != -3 != 3
    } else if (-4 <= -c != -c != c) { # middle comparison is important
        return 3;
        #      -4 <= -3 == -3 != 3
    } else if (-4 <= -c == -c == c) { # last comparison is important
        return 4;
    }

    #             5 < 3 <= 4 > 9
    let d: bool = 5 < c <= 4 > 9; # first
    if (d) {
        return 5;
    }
    
    #                 (    true    )                     2 < 3 <= 3 <= 3 < 7
    let e: bool = if c == c != c == c  then false   else 2 < c <= 3 <= c < 7;
    if (e) {
        let f = 5;
        let g: bool = (f == f);
    }
    else {
        let f = 3;
        let g: bool = (f != f);
        return 6;
    }
    return 0;
}