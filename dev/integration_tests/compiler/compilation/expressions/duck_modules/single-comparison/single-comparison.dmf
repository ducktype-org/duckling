fun main() -> i64 = {
    # @TODO: #1571 Remove literal specifiers from all integration tests, one casts are implemented.
    # ( false )
    if (4i64 < 4i64) {
        builtin_output_i64(1);
    }

    #   true 
    if (3i64 < 4i64) {
    } else {
        builtin_output_i64(2);
    }

    # ( false )
    if (0i64 > 0i64) {
        builtin_output_i64(3);
    }

    #   true
    if (2i64 > 1i64) {
    } else {
        builtin_output_i64(4);
    } 

    # ( false )
    if (5i64 <= 4i64) {
        builtin_output_i64(5);
    }

    #    true
    if (3i64 <= 4i64) {
    } else {
        builtin_output_i64(6);
    }

    #  ( false )
    if (-3i64 >= -2i64) {
        builtin_output_i64(7);
    }

    #    true
    if (2i64 >= -1i64) {
    } else {
        builtin_output_i64(8);
    }

    #  ( false )
    if (-1i64 == 1i64) {
        builtin_output_i64(9);
    }

    #    true
    if (1i64 == 1i64) {
    } else {
        builtin_output_i64(10);
    }

    #  ( false )
    if (4i64 != 4i64) {
        builtin_output_i64(11);
    }

    #    true
    if (-1i64 != 1i64) {
    } else {
        builtin_output_i64(12);
    }

    let a: i64 = 5i64;
    let b: i64 = 6i64;

    #           ( false )
    #             6 < 5
    let c: bool = b < a;
    if (c) {
        builtin_output_i64(13);
    }

    return 0i64;
}
