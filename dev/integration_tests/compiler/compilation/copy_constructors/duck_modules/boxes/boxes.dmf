var copies: i64 = 0;

class Counter {
    id: i32 = 0;
    Counter.copy(other: const ref Counter) = {
        copies = copies + 1;
        return Counter(other.id);
    }
}

fun main() -> i64 = {
    var bc: box Counter = Counter(1);
    var bc2: box Counter = copy bc;     # +1
    builtin_output_i64(copies);         # 1

    var bc3: box Counter = move bc;     # +1
    builtin_output_i64(copies);         # 1

    var a = 123;
    var b = copy a;

    return 0;
    # If we don't crash with double free it means the heap data was actually copied. 
}
