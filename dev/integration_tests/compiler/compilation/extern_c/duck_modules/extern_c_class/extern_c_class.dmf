import core.builtins.*;

extern("C") {
    class A {
        x: i8 = 0 as i8;
        y: i64 = 0i64;
    }

    class B {
        first: i32 = 0i32;
        second: i32 = 0i32;
    }
}

extern("C") class Flags {
    a: bool = false;
    b: char = 'A';
    c: i32 = 0i32;
    d: bool = false;
    e: i32 = 0i32;
}

extern("C") class Mixed {
    a: i32 = 0i32;
    b: f64 = 0.0f64;
    c: i32 = 0i32;
    d: f32 = 0.0f32;
    e: i32 = 0i32;
}

extern("C") class Nested {
    a: A;
    b: B;
    f: Flags;
    m: Mixed;
}

extern("C") class DoubleNested {
    n: Nested;
}

fun main() -> i64 = {
    var a = A(3 as i8, 17i64);
    var b = B(11 as i32, 22 as i32);

    var f = Flags(true, 'Z', 42 as i32, false, 7 as i32);

    var m = Mixed(7 as i32, 1.5f64, 9 as i32, 2.5f32, 11 as i32);

    var nest = Nested(a, b, f, m);
    var double_nest = DoubleNested(nest);

    builtin_output_i64(double_nest.n.a.x as i64);
    builtin_output_i64(double_nest.n.a.y);
    builtin_output_i64(double_nest.n.b.first as i64);
    builtin_output_i64(double_nest.n.b.second as i64);

    builtin_output_i64(double_nest.n.f.c as i64);
    builtin_output_i64(double_nest.n.f.e as i64);

    builtin_output_i64(double_nest.n.m.a as i64);
    builtin_output_i64(double_nest.n.m.c as i64);
    builtin_output_i64(double_nest.n.m.e as i64);

    return 0i64;
}
