import core.builtins.*;

extern("C") {
    class A {
        x: i8 = i8(0);
        y: i64 = 0i64;
    }

    class B {
        first: i32 = 0i32;
        second: i32 = 0i32;
    }
}

extern("C") class Flags {
    a: bool = false;
    b: char = 'A';
    c: i32 = 0i32;
    d: bool = false;
    e: i32 = 0i32;
}

extern("C") class Mixed {
    a: i32 = 0i32;
    b: f64 = 0.0f64;
    c: i32 = 0i32;
    d: f32 = 0.0f32;
    e: i32 = 0i32;
}

extern("C") class Nested {
    a: A;
    b: B;
    f: Flags;
    m: Mixed;
}

extern("C") class DoubleNested {
    n: Nested;
}

fun main() -> i64 = {
    var a = A(i8(3), 17i64);
    var b = B(i32(11), i32(22));

    var f = Flags(true, 'Z', i32(42), false, i32(7));

    var m = Mixed(i32(7), 1.5f64, i32(9), 2.5f32, i32(11));

    var nest = Nested(a, b, f, m);
    var double_nest = DoubleNested(nest);

    builtin_output_i64(i64(double_nest.n.a.x));
    builtin_output_i64(double_nest.n.a.y);
    builtin_output_i64(i64(double_nest.n.b.first));
    builtin_output_i64(i64(double_nest.n.b.second));

    builtin_output_i64(i64(double_nest.n.f.c));
    builtin_output_i64(i64(double_nest.n.f.e));

    builtin_output_i64(i64(double_nest.n.m.a));
    builtin_output_i64(i64(double_nest.n.m.c));
    builtin_output_i64(i64(double_nest.n.m.e));

    return 0i64;
}
