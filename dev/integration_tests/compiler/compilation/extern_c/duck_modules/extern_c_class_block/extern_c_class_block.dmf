# Verifies that classes declared inside an `extern("C") { ... }` block
# compile and behave like classes declared with the prefix form.

extern("C") {
    class A {
        x: i8 = i8(0);
        y: i64 = 0i64;
    }

    class B {
        first: i32 = 0i32;
        second: i32 = 0i32;
    }
}

fun main() -> i64 = {
    var a = A(i8(3), 17i64);
    var b = B(i32(11), i32(22));
    builtin_output_i64(i64(a.x));
    builtin_output_i64(a.y);
    builtin_output_i64(i64(b.first));
    builtin_output_i64(i64(b.second));
    return 0i64;
}
