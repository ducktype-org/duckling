import core.builtins.*;

const INT = i32;
const ARR = INT[2];
const ARR2 = ARR[2];

const WORKS_1 = ARR2 == i32[2][2];
const WORKS_2 = ARR2 == i32[2][3];
const WORKS_3 = ARR2 == i64[2][2];

fun fib(n: i64) -> i64 = {
   if (n < 2) { return n; }
   return fib(n - 1) + fib(n - 2);
}

const FIB_ARRAY = (if fib(4) == 3 then i64 else i32)[fib(5)]; # i64[5]
const SOME_CONSTANT = 1;

fun main() -> i64 = {
    builtin_output_i64(WORKS_1);
    builtin_output_i64(WORKS_2);
    builtin_output_i64(WORKS_3);
    
    var arr: FIB_ARRAY;
    var i = 0;
    while(i < 5) {      # If wrong size was picked this should cause a segmentation fault
        arr[i] = 1i64;  # If wrong type was picked, then this should crash in type check.
        i = i + 1;
    }
    
    arr[SOME_CONSTANT] = 123;
    builtin_output_i64(arr[SOME_CONSTANT]);

    return 0;
}
