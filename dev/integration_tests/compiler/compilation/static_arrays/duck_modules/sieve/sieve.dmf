fun init_array(arr: ref i64[100]) -> () = {
    var i = 0;
    while (i < arr.length()) {
        arr[i] = 1;
        i = i + 1;
    }
    if (arr.length() > 0) { arr[0] = 0; }
    if (arr.length() > 1) { arr[1] = 0; }
}

fun sieve(n: i64, is_prime: ref i64[100]) -> () = {
    var p = 2;
    while (p * p <= n) {
        if (is_prime[p] == 1) {
            var i = p * p;
            while (i <= n) {
                is_prime[i] = 0;
                i = i + p;
            }
        }
        p = p + 1;
    }
}

fun main() -> i64 = {
    let n = builtin_input_i64();
    
    var limit = n;
    if (n >= 100) {
        limit = 99;
    }

    var is_prime: i64[100];
    
    init_array(&is_prime);

    sieve(limit, &is_prime);

    builtin_output_i64(88888888);
    var k = 0;
    while (k <= limit) {
        if (is_prime[k] == 1) {
            builtin_output_i64(k);
        }
        k = k + 1;
    }

    return 0;
}
