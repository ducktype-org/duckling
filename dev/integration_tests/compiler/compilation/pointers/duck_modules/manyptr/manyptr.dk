import core.containers.*;

class SomeClass {
    x: i8[8];
    y: i64;

    fun print() = {
        builtin_output_i64(x[0]);
        builtin_output_i64(y);
    }
}

fun testInts() = {
    var a = allocation:{i32}.alloc(3);
    a[0] = 1;
    a[1] = 2 + a[0];
    a[2] = 3 + a[1] + a[0];

    builtin_output_i64(a[0]);
    builtin_output_i64(a[1]);
    builtin_output_i64(a[2]);
    allocation:{i32}.free(a);
}

fun testClasses() = {
    var a = allocation:{SomeClass}.alloc(3);
    a[0].x[0] = 42i8;
    a[0].y = 43;
    a[0].print();
    allocation:{SomeClass}.free(a);
}

fun testArrays() = {
    var ar = allocation:{(manyptr i32)[2]}.alloc(3);
    ar[0][0] = allocation:{i32}.alloc(2);
    ar[0][0][0] = 30;
    builtin_output_i64(ar[0][0][0]);
    allocation:{i32}.free(ar[0][0]);
    allocation:{(manyptr i32)[2]}.free(ar);
}


fun main() -> i64 = {
    testInts();
    testClasses();
    testArrays();

    return 0;
}
