import core.builtins.*;

var global_val = 10;

fun pointer_to_pointer() = {
    var value: i32 = 100;
    
    var p1: ptr i32 = &value as ptr i32;
    var p2: ptr ptr i32 = &p1 as ptr ptr i32;
    var p3: ptr ptr ptr i32 = &p2 as ptr ptr ptr i32;

    var read_val: i32 = *(*p2);
    builtin_output_i64(read_val as i64);

    *(*(*p3)) = 999;
    
    builtin_output_i64(value as i64);
}
namespace inner {
    fun print_ref_ptr(arg : ref ptr i32 ) = {
        builtin_output_i64(*(*arg));
    }
}

fun ref_to_pointer() = {
    var value = 10;
    var p1 = &value as ptr i32;
    inner.print_ref_ptr(&p1);
}

fun arr_of_pointers() = {
    var x : (ptr i32)[2];
    x[0] = &global_val as ptr i32;
    global_val = 3;
    builtin_output_i64(*x[0]);
}

fun main() -> i64 = {
    pointer_to_pointer();
    ref_to_pointer();
    arr_of_pointers();
    return 0;
}
