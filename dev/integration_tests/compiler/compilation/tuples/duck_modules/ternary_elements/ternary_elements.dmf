import core.builtins.*;

# Tuple elements that allocate their own basic blocks (ternaries) used to be
# lowered without chaining their blocks into the CFG, leaving them unreachable
# and the tuple constructed from uninitialized temporaries.

fun main() -> i64 = {
    var c = true;
    let t = (if c then 1i64 else 2i64, if c then 3i64 else 4i64);
    builtin_output_i64(t._1);
    builtin_output_i64(t._2);

    c = false;
    let u = (if c then 5i64 else 6i64, 7i64, if c then 8i64 else 9i64);
    builtin_output_i64(u._1);
    builtin_output_i64(u._2);
    builtin_output_i64(u._3);

    return 0;
}
