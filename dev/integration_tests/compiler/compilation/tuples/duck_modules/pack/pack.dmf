# Packing literals
var a = ();
var b = (1, -2, 3, 4);
var c = (false, 1, 2., "3");
var d = ((1, 0.), (3.5, 4));
var e = (0, 0);
var f = ("Hello");

# Assignement
var aa: () = a;
var bb: (i64, i32, i64, i32) = b;
var cc: (bool, i32, f32, str) = c;
var dd: ((i64, f32), (f64, i32)) = d;
var ee: (i32, i32) = e;
var ff: (str) = f;

var aaa = a;
var bbb = b;
var ccc = c;
var ddd = d;
var eee = e;
var fff = f;

# Packing expressions
var x = (1+2, 3-4, 1+2-3*4, 2.5/5.*100-1.333);
