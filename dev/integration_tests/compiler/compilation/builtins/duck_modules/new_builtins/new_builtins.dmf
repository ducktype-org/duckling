import core.builtins.*;

fun main() -> i64 = {
    var p = dvm_alloc:{char}(8u64);
    p[0] = 'H';
    p[1] = 'E';
    p[2] = 'L';
    p[3] = 'L';
    p[4] = 'O';
    let a = p[0];

    dvm_realloc:{char}(p, 16u64);
    p[5] = '\n';

    let s = slice_from_ptr_len:{char}(p, 6 as u64);
    builtin_output_str(s);

    dvm_free:{char}(p);
    return 0i64;
}
