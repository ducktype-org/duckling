import core.builtins.*;

class Person {
	name: String;
	age: i32;
	height: f64
}

fun main() -> i32 = {
	print((1).toString());
	var a = 2;
	print(a.toString());

	print(3.14.toString());

	print('d'.toString());

	print(true.toString());

	print(().toString());

	var t = ("John Smith", 42, 1.69);
	print(t.toString());

	var p = Person("John Smith", 42, 1.69);
	print(p.toString());

	return 0;
}
