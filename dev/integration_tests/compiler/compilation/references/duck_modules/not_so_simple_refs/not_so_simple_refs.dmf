fun assign_to_ref() -> () = {
    var a: i64 = 123;
    var b: i64 = 345;
    
    var ref_a = refof a;
    var ref_b = refof b;
    
    # This auto derefs `ref_b` and assign 345 to `a`.
    # It doesn't rebind the references.
    ref_a = ref_b;
    builtin_output_i64(a);
    
    ref_b = 999; # This should not affect a
    builtin_output_i64(ref_a);
}


fun main() -> i64 = {
    simple_auto_deref();
    assign_to_ref();

    var a: i64 = 123; 
    var b: i64 = 456; 
    # Swap just the values. References stay intact.
    value_swap(refof a, refof b);
    builtin_output_i64(a); # 456
    builtin_output_i64(b); # 123
    

    return 0;
}
