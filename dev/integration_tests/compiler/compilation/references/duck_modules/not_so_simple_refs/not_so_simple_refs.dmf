import core.builtins.*;

fun simple_auto_deref() -> () = {
    var x = 10i64;
    let r = &x;
    builtin_output_i64(x); # 10

    # Auto deref should get inserted.
    x = 20;
    var y: i64 = r;
    
    builtin_output_i64(x); # 20
    builtin_output_i64(y); # 20
    # Auto deref should get inserted.
    builtin_output_i64(r); # 20
}

fun value_swap(a: ref i64, b: ref i64) -> () = {
    let tmp: i64 = a;
    a = b;
    b = tmp;
}

fun assign_to_ref() -> () = {
    var a: i64 = 123;
    var b: i64 = 345;
    
    var ref_a = &a;
    var ref_b = &b;
    
    # This auto derefs `ref_b` and assigns 345 to `a`.
    # It doesn't rebind the references.
    ref_a = ref_b;
    builtin_output_i64(a); # 345
    
    ref_b = 999; # This should not affect a
    builtin_output_i64(ref_a); # 345
}


fun main() -> i64 = {
    simple_auto_deref();
    assign_to_ref();

    var a: i64 = 123; 
    var b: i64 = 456; 
    # Swap just the values. References stay intact.
    value_swap(&a, &b);
    builtin_output_i64(a); # 456
    builtin_output_i64(b); # 123
    

    return 0;
}
