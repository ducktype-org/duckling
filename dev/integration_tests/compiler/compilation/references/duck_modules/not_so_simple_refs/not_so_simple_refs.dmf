fun simple_auto_deref() -> () = {
    var x = 10i64;
    let r = refof x;
    builtin_output_i64(x); # 10

    # Auto deref should get inserted.
    x = 20;
    var y: i64 = r;
    
    builtin_output_i64(x); # 20
    builtin_output_i64(y); # 20
    # Auto deref should get inserted.
    builtin_output_i64(r); # 20
}

fun value_swap(a: ref i64, b: ref i64) -> () = {
    let tmp: i64 = a;
    let tmp2: i64 = b;
    a = tmp2;
    b = tmp;
}

