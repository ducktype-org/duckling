fun assign_to_ref() -> () = {
    var a: i64 = 123;
    var b: i64 = 345;
    
    var ref_a = refof a;
    var ref_b = refof b;
    
    # This auto derefs `ref_b` and assign 345 to `a`.
    # It doesn't rebind the references.
    ref_a = ref_b;
    builtin_output_i64(a);
    builtin_output_i64(ref_a);

    ref_b = 999; # This should not affect a
    builtin_output_i64(ref_a);
}

# TODOP: Figure this out.
fun dangling_ref() -> ref i64 = {
    var a: i64 = 123;
    return refof a;
}



fun main() -> i64 = {
    simple_auto_deref();
    not_so_simple_auto_deref();

    var a: i64 = 123; 
    var b: i64 = 456; 

    # TODOP: Figure this out
    # swap(refof a, refof b);
    easy_swap(refof a, refof b);
    
    builtin_output_i64(a);
    builtin_output_i64(b);
    
    assign_to_ref();
    
    let x = dangling_ref();
    builtin_output_i64(x); # TODOP: Actually happens to work.

    return 0;
}
