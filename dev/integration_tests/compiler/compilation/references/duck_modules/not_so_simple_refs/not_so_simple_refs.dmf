class Point { x: i64; y: i64; }
class Wrapper { p: Point; }

fun simple_auto_deref() -> () = {
    var x = 10i64;
    let r = refof x;

    builtin_output_i64(x);

    x = 20;
    # Auto deref should get inserted.
    var y: i64 = r;
    
    builtin_output_i64(x);
    builtin_output_i64(y);
    
    # Auto deref should get inserted.
    builtin_output_i64(r);

}

fun not_so_simple_auto_deref() -> () = {
    var w = Wrapper(Point(1, 2));
    let ref_w = refof w;

    # Auto deref should get inserted.
    builtin_output_i64(ref_w.p.x); # 1

    ref_w.p.y = 42;
    builtin_output_i64(w.p.y); # 42
}

fun swap(a: ref i64, b: ref i64) -> () = {
    let tmp = a;
    a = b;
    b = tmp;
}

fun easy_swap(a: ref i64, b: ref i64) -> () = {
    # TODOP: It won't work without the explicit type.
    let tmp: i64 = a;
    let tmp2: i64 = b;
    a = tmp2;
    b = tmp;
}

