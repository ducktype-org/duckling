fun test_simple_ref() -> i64 = {
    var x: i32 = 10;
    var r: ref i32 = refof x;
    r = 42;
    return x;
}

fun adder(v: ref i32) -> () = {
    v = v + 1;
}

fun test_pass_through_reference() -> i64 = {
    var x: i32 = 10;
    adder(refof x);
    builtin_output_i64(x); # 11
    var y: i32 = 12;
    adder(refof y); # ref i32 should coerce to ref i64
    builtin_output_i64(y); # 13
    return x;
}

fun whatWillHappen() -> () = {
    var x: i32 = 123;
    var y: i32 = 234;

    var ref_x: i32 = refof x;
    var ref_y: i32 = refof y;
    
    ref_x = ref_x + ref_y;

    builtin_output_i64(ref_x);
    builtin_output_i64(ref_y);
}

fun main() -> i64 = {
    builtin_output_i64(test_simple_ref());              # 42
    builtin_output_i64(test_pass_through_reference());  # 11
    whatWillHappen();
    return 0;
}
