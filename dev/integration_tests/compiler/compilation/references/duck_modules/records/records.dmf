class Point { x: i64; y: i64; }
class Wrapper { p: Point; }

fun records1() -> () = {
    var w = Wrapper(Point(1, 2));
    let ref_w = refof w;

    # Auto deref should get inserted.
    builtin_output_i64(ref_w.p.x); # 1

    ref_w.p.y = 42;
    builtin_output_i64(w.p.y); # 42
}

class RefPoint { x: ref i64; y: ref i64; }
class RefWrapper { p: ref RefPoint; }

fun records2() -> () = {
    var x: i64 = 123;
    var y: i64 = 456;

    var point = RefPoint(refof x, refof y);
    var ref_point = refof point;
    
    builtin_output_i64(ref_point.x);
    builtin_output_i64(ref_point.y);
    
    var wrapper = RefWrapper(refof point);
    var ref_wrapper = refof wrapper;
    
    ref_wrapper.p.x = 0;
    ref_wrapper.p.y = 1;
    builtin_output_i64(ref_wrapper.p.x);
    builtin_output_i64(ref_wrapper.p.y);
}


fun main() -> i64 = {
    records1();
    records2();

    return 0;
}
