simple.dbc
# ^^^^^^^^ - one file to debug this time

# Let's wait until the Debugger starts
> "Debugger has started"
> "+\n"
> "+\n"

# Now the debugger is running, so let's run our main function
timeout 0.005  # we expect status to be reported fast...
< "run\n"
> "Running"
timeout 0.5  # ..and wanna give the program some time to finish
> "ExecutionCompleted (return value = 0)"

# That's it!
