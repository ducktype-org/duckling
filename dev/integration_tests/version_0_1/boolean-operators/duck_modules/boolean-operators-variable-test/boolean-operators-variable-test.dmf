fun print_error(arg: bool) -> bool = {
    builtin_output_i64(99);
    return arg;
}

fun main() -> i64 = {

    var v: bool = true;
    if (v) {
        builtin_output_i64(1); # Should execute
    }
    v = not v;
    if (v) {
        builtin_output_i64(0); # Should not execute
    }

    # Testing AND operator with variables
    v = true;
    if (v and v) {
        builtin_output_i64(2); # Should execute
    }
    if (v and true) {
        builtin_output_i64(3); # Should execute
    }
    if (true and v) {
        builtin_output_i64(4); # Should execute
    }
    if (v and false) {
        builtin_output_i64(0); # Should not execute
    }
    if (false and v) {
        builtin_output_i64(0); # Should not execute
    }

    v = not v;
    if (v and v) {
        builtin_output_i64(0); # Should not execute
    }
    if (v and true) {
        builtin_output_i64(0); # Should not execute
    }
    if (true and v) {
        builtin_output_i64(0); # Should not execute
    }
    if (v and false) {
        builtin_output_i64(0); # Should not execute
    }
    if (false and v) {
        builtin_output_i64(0); # Should not execute
    }

    # Testing OR operator with variables
    v = true;
    if (v or v) {
        builtin_output_i64(5); # Should execute
    }
    if (v or true) {
        builtin_output_i64(6); # Should execute
    }
    if (true or v) {
        builtin_output_i64(7); # Should execute
    }
    if (v or false) {
        builtin_output_i64(8); # Should execute
    }
    if (false or v) {
        builtin_output_i64(9); # Should execute
    }

    v = not v;
    if (v or v) {
        builtin_output_i64(0); # Should not execute
    }
    if (v or true) {
        builtin_output_i64(10); # Should execute
    }
    if (true or v) {
        builtin_output_i64(11); # Should execute
    }
    if (v or false) {
        builtin_output_i64(0); # Should not execute
    }
    if (false or v) {
        builtin_output_i64(0); # Should not execute
    }

    # Testing OR for laziness
    v = true;
    if (v or print_error(true)) {
        builtin_output_i64(12); # Should execute
    }
    if (v or print_error(false)) {
        builtin_output_i64(13); # Should execute
    }


    # Testing NOT operator with variables
    v = false;
    if (not v) {
        builtin_output_i64(14); # Should execute
    }
    v = true;
    if (not v) {
        builtin_output_i64(0); # Should not execute
    }
    if (not (not v)) {
        builtin_output_i64(15); # Should execute
    }


    # Testing XOR operator with variables
    v = true;
    if (v xor false) {
        builtin_output_i64(16); # Should execute
    }
    v = false;
    if (v xor false) {
        builtin_output_i64(0); # Should not execute
    }

    return 0;
}
