import core.builtins.*;

# Test advanced f-string formatting
# Focus: complex format string interpolation per docs

fun main() -> i64 = {
    # Test f-string with arithmetic expressions
    print(f"calc: {3 * 4 + 5}\n");         # calc: 17

    # Test f-string with comparison results
    let x = 10;
    let y = 20;
    print(f"sum={x + y}, diff={y - x}\n"); # sum=30, diff=10

    # Test f-string with multiple variable types
    let name = "test";
    let count = 5;
    let rate = 3;
    print(f"{name}: {count * rate} items\n"); # test: 15 items

    # Test nested arithmetic in f-string
    print(f"nested: {(2 + 3) * (4 + 1)}\n"); # nested: 25

    # Test f-string with division
    let total = 100;
    let parts = 4;
    print(f"each: {total / parts}\n");      # each: 25

    # Test f-string with modulo
    let num = 17;
    let div = 5;
    print(f"{num} mod {div} = {num % div}\n"); # 17 mod 5 = 2

    # Test chained f-strings
    let a = 1;
    let b = 2;
    let c = 3;
    print(f"a={a}\n");                      # a=1
    print(f"b={b}\n");                      # b=2
    print(f"c={c}\n");                      # c=3
    print(f"total={a + b + c}\n");          # total=6

    # Test f-string with string variable
    let prefix = "Result";
    let value = 42;
    print(f"{prefix}: {value}\n");          # Result: 42

    return 0;
}
