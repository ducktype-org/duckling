import core.builtins.*;

# Operator overloading test (primitive types)
# This test checks if operator overloads work for primitive types

fun *(c: char, n: i64) -> String = {
	var result: String = "";
	while (n > 0) {
		result = result :+ c;
		n -= 1;
	}
	return result;
}

fun main() -> i64 = {
    builtin_output_string('a' * 5);
    return 0;
}
