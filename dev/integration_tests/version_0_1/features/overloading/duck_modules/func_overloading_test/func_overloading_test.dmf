import core.builtins.*;


# Function overloading test
# This test checks if function overloading works as expected for i64, f64, bool, and string

fun foo(a: i64) -> i64 = {
    return a * 10;
}

fun foo(b: i64) -> i64 = {
    return b * 100;
}

fun foo(x: i64) -> i64 = {
    return x + 1;
}

fun foo(x: f64) -> i64 = {
    return 100 + i64(x);
}

fun foo(x: bool) -> i64 = {
    if (x) return 42;
    else return 0;
}

fun foo(x: String) -> i64 = {
    if (x == "duckling") return 999;
    return 0;
}

# Multi-argument overloads
fun foo(x: i64, y: i64) -> i64 = {
    return x * y + 20000;
}

fun foo(x: String, y: i64) -> i64 = {
    if (x == "duckling" and y == 42) return 4242;
    return -1;
}

# Default arguments
fun foo(x: i64, y: i64 = 2, z: i64 = 3) -> i64 = {
    return x + y + z + 10000;
}

fun main() -> i64 = {
    # Overloading by type (explicit types)
    if (foo(5i64) == 6) builtin_output_i64(1);
    if (foo(3.5f64) == 103) builtin_output_i64(2);
    if (foo(true) == 42) builtin_output_i64(3);
    if (foo(false) == 0) builtin_output_i64(4);
    if (foo("duckling") == 999) builtin_output_i64(5);
    if (foo("other") == 0) builtin_output_i64(6);

    # Multi-argument overloads
    if (foo(2i64, 3i64) == 20006) builtin_output_i64(7);
    if (foo("duckling", 42i64) == 4242) builtin_output_i64(8);
    if (foo("other", 1i64) == -1) builtin_output_i64(9);

    # Default arguments
    if (foo(1i64, 2i64, 3i64) == 10006) builtin_output_i64(10);
    if (foo(1i64) == 10006) builtin_output_i64(11);
    if (foo(1i64, 2i64) == 10006) builtin_output_i64(12);

    # Overload by parameter name
    if (foo(a = 2i64) == 20) builtin_output_i64(13);
    if (foo(b = 3i64) == 300) builtin_output_i64(14);

    # # Error cases: ambiguous or no match
    # var err_count: i64 = 0;
    # # 1. Ambiguous: literal 5 (could be i64 or f64)
    # catch {
    #     foo(5);
    # } err {
    #     err_count += 1;
    # }
    # # 2. No match: passing an array
    # catch {
    #     foo([1,2,3]);
    # } err {
    #     err_count += 1;
    # }
    # # 3. No match: passing a bool to string overload
    # catch {
    #     foo("");
    #     foo(true, "extra");
    # } err {
    #     err_count += 1;
    # }
    # if (err_count == 3) builtin_output_i64(100); # Should execute if all errors caught

    return 0;
}
