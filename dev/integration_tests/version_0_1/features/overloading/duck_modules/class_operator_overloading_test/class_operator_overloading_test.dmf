import core.builtins.*;

# Class-based operator overloading test for Point comparison
# Point a < Point b is true when a is closer to (0, 0) than b.

class Point {
    x: i64 = 0;
    y: i64 = 0;
}

fun distance_sq(p: Point) -> i64 = {
    return p.x * p.x + p.y * p.y;
}

fun <(a: Point, b: Point) -> bool = {
    return distance_sq(a) < distance_sq(b);
}

fun main() -> i64 = {
    var a = Point(1, 1);
    var b = Point(3, 4);
    if (a < b) builtin_output_i64(1);
    if (not (b < a)) builtin_output_i64(2);

    var c = Point(2, 0);
    var d = Point(0, 3);
    if (c < d) builtin_output_i64(3);

    var e = Point(2, 2);
    var f = Point(-2, -2);
    if (not (e < f) and not (f < e)) builtin_output_i64(4);

    return 0;
}
