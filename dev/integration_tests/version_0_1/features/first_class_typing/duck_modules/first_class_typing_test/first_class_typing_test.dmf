# Test first-class typing basics
# Focus: type aliases and typed function signatures

# Note: Per docs, type aliases use const (types are values)
# However, alias can be used for symbol aliasing

class Vector2 {
    x: i64 = 0;
    y: i64 = 0;
}

# Function signatures with explicit types
fun addVectors(a: Vector2, b: Vector2) -> Vector2 = Vector2(a.x + b.x, a.y + b.y);

fun scaleVector(v: Vector2, s: i64) -> Vector2 = Vector2(v.x * s, v.y * s);

fun vectorLength(v: Vector2) -> i64 = v.x * v.x + v.y * v.y;

fun main() -> i64 = {
    # Test typed class construction
    var v1: Vector2 = Vector2(3, 4);
    var v2: Vector2 = Vector2(1, 2);

    # Test typed function calls
    var v3 = addVectors(v1, v2);
    builtin_output_i64(v3.x);           # 4
    builtin_output_i64(v3.y);           # 6

    # Test function returning typed class
    var v4 = scaleVector(v1, 2);
    builtin_output_i64(v4.x);           # 6
    builtin_output_i64(v4.y);           # 8

    # Test function with typed parameter and return
    builtin_output_i64(vectorLength(v1)); # 25

    # Test type declarations for primitives
    var a: i64 = 100;
    var b: i32 = i32(50);
    var c: u64 = 200u64;
    builtin_output_i64(a);              # 100
    builtin_output_i64(i64(b));         # 50
    builtin_output_i64(i64(c));         # 200

    return 0;
}