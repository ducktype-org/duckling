# Test types as values - conversions and casts
# Focus: explicit type conversions and type coercion

class Point {
    x: i64 = 0;
    y: i64 = 0;
}

fun makePoint(x: i64, y: i64) -> Point = Point(x, y);

fun main() -> i64 = {
    # Test type deduction from literals
    var a = 100;                # deduced as i64
    var b = 100i32;             # explicit i32
    var c = 100u64;             # explicit u64

    builtin_output_i64(a);              # 100
    builtin_output_i64(i64(b));         # 100
    builtin_output_i64(i64(c));         # 100

    # Test type deduction from class
    let p = makePoint(5, 10);   # deduced as Point
    builtin_output_i64(p.x);            # 5
    builtin_output_i64(p.y);            # 10

    # Test explicit type conversions (narrowing)
    var wide: i64 = 1000;
    var narrow: i32 = i32(wide);
    builtin_output_i64(i64(narrow));    # 1000

    # Test explicit type conversions (widening)
    var small: i8 = i8(50);
    var big: i64 = i64(small);
    builtin_output_i64(big);            # 50

    # Test float to int conversion (truncation)
    var f: f64 = 3.9;
    var truncated: i64 = i64(f);
    builtin_output_i64(truncated);      # 3

    # Test signed to unsigned conversion
    var signed: i32 = i32(42);
    var unsigned: u32 = u32(signed);
    builtin_output_i64(i64(unsigned));  # 42

    # Test chained conversions
    var chain: i64 = i64(i32(i16(i8(25))));
    builtin_output_i64(chain);          # 25

    return 0;
}