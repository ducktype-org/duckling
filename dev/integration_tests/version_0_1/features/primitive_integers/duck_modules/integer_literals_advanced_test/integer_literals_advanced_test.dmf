import core.builtins.*;

# Test advanced integer literals
# Focus: hex/octal/binary bases, floating point, byte type

fun main() -> i64 = {
    # Test hex literals (per docs: 0xABC3)
    var hex1 = 0xA;      # 10
    var hex2 = 0xFF;     # 255
    var hex3 = 0x1A3;    # 419
    builtin_output_i64(hex1);  # 10
    builtin_output_i64(hex2);  # 255
    builtin_output_i64(hex3);  # 419

    # Test octal literals (per docs: 0o prefix)
    var oct1 = 0o12;     # 10
    var oct2 = 0o77;     # 63
    var oct3 = 0o100;    # 64
    builtin_output_i64(oct1);  # 10
    builtin_output_i64(oct2);  # 63
    builtin_output_i64(oct3);  # 64

    # Test binary literals (per docs: 0b1010001)
    var bin1 = 0b1010;   # 10
    var bin2 = 0b11111111; # 255
    var bin3 = 0b100000; # 32
    builtin_output_i64(bin1);  # 10
    builtin_output_i64(bin2);  # 255
    builtin_output_i64(bin3);  # 32

    # Test floating point types (per docs: f16, f32, f64, f80, f128)
    var f32_val: f32 = 3.14f32;
    var f64_val: f64 = 2.718;
    var f64_neg: f64 = -9.5;
    builtin_output_i64(i64(f32_val));  # 3 (truncated)
    builtin_output_i64(i64(f64_val));  # 2 (truncated)
    builtin_output_i64(i64(f64_neg));  # -9 (truncated)

    # Test byte type (same storage as i8/u8 but different semantics)
    var byte1: byte = byte(65);  # 'A'
    var byte2: byte = byte(0);
    var byte3: byte = byte(255);
    builtin_output_i64(i64(byte1)); # 65
    builtin_output_i64(i64(byte2)); # 0
    builtin_output_i64(i64(byte3)); # 255

    # Test literal suffixes with different bases
    var hex_u64 = 0xFFu64;
    var hex_i32 = 0xAi32;
    builtin_output_i64(i64(hex_u64)); # 255
    builtin_output_i64(i64(hex_i32)); # 10

    return 0;
}
