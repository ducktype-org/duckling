# Test constant declarations at module level
const CONST_I64: i64 = 100;
const CONST_I32: i32 = 50i32;
const CONST_BOOL: bool = true;
const CONST_NO_TYPE = 42;
const CONST_COMPUTED = CONST_I64 + 10;

# Test const with expressions
const CONST_EXPR = 5 * 10 + 7;

fun main() -> i64 = {
    # Output constant values
    builtin_output_i64(CONST_I64);           # 100
    builtin_output_i64(i64(CONST_I32));      # 50
    builtin_output_i64(CONST_NO_TYPE);       # 42
    builtin_output_i64(CONST_COMPUTED);      # 110
    builtin_output_i64(CONST_EXPR);          # 57

    # Test using const in expressions
    var x: i64 = CONST_I64 * 2;
    builtin_output_i64(x);                   # 200

    # Test const bool
    if (CONST_BOOL) {
        builtin_output_i64(1);               # 1
    }

    return 0;
}
