fun main() -> i64 = {
    var a: i128;
    if (a != 0i128)
        return 1;
    var b: i64;
    if (b != 0i64)
        return 2;
    var c: i32;
    if (c != 0i32)
        return 3;
    var d: i16;
    if (d != 0i16)
        return 4;
    var e: i8;
    if (e != 0i8)
        return 5;
    return 0;
}
