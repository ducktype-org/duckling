fun main() -> u64 = {
    var a: i64;
    var b = 0;
    a = 70;
    if (a != 70)
        return 1;
    a = 2*a;
    if (a != 140)
        return 2;
    a = 0xFFFF;
    if (a != 65535)
        return 3;

    b = b+1;
    if (b != 1)
        return 4;
    b = u16(30);
    if (b != 30)
        return 5;

    var c: f64;
    c = 3.14;
    if (c != 3.14)
        return 6;

    var d: u64;
    d = -100;
    if (d + 100 != 0)
        return 7;
    d = 2 * d;
    if (d + 200 != 0)
        return 8;

    return 0;
}
