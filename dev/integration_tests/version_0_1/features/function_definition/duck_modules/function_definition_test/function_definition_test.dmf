import core.builtins.*;

# Test function with no arguments
fun noArgs() -> i64 = {
    return 42;
}

# Test function with single argument
fun identity(x: i64) -> i64 = {
    return x;
}

# Test function with multiple arguments
fun add(a: i64, b: i64) -> i64 = {
    return a + b;
}

# Test function with expression body (no braces)
fun multiply(a: i64, b: i64) -> i64 = a * b;

# Test function with different return type
fun isPositive(x: i64) -> bool = x > 0;

# Test function returning void (unit type)
fun printValue(x: i64) = {
    builtin_output_i64(x);
}

# Test recursive function
fun factorial(n: i64) -> i64 = {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fun main() -> i64 = {
    builtin_output_i64(noArgs());           # 42
    builtin_output_i64(identity(7));        # 7
    builtin_output_i64(add(3, 5));          # 8
    builtin_output_i64(multiply(4, 6));     # 24
    
    if (isPositive(10)) {
        builtin_output_i64(1);              # 1
    }
    if (not isPositive(-5)) {
        builtin_output_i64(2);              # 2
    }

    printValue(99);                         # 99

    builtin_output_i64(factorial(5));       # 120

    return 0;
}
