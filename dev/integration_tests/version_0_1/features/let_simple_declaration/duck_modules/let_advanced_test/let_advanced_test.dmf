import core.builtins.*;

# Test advanced let features
# Focus: global let, block scopes, and let with function returns

# Global let declarations (module-level immutable values)
let GLOBAL_A: i64 = 1000;
let GLOBAL_B = 2000;
let GLOBAL_SUM = GLOBAL_A + GLOBAL_B;

fun getValue() -> i64 = 42;
fun computeValue(x: i64) -> i64 = x * 5;

fun main() -> i64 = {
    # Test global let access
    builtin_output_i64(GLOBAL_A);       # 1000
    builtin_output_i64(GLOBAL_B);       # 2000
    builtin_output_i64(GLOBAL_SUM);     # 3000

    # Test let with function call result
    let fromFunc = getValue();
    builtin_output_i64(fromFunc);       # 42

    let computed = computeValue(5);
    builtin_output_i64(computed);       # 25

    # Test nested let in block scopes
    if (true) {
        let inner = 99;
        builtin_output_i64(inner);      # 99
    }

    # Test shadowing in nested scopes
    let x = 10;
    builtin_output_i64(x);              # 10
    if (true) {
        builtin_output_i64(x);          # 10
        builtin_output_i64(x+1);        # 11
        let x = 20;   # shadows outer x
        builtin_output_i64(x);          # 20
    }
    builtin_output_i64(x);              # 10 (outer still intact)

    # Test let in while condition scope
    var counter = 0;
    while (counter < 3) {
        let iteration = counter + 1;
        builtin_output_i64(iteration);  # 1, 2, 3
        counter = counter + 1;
    }

    # Test chained assignments with let
    let a = 5;
    let b = a + 5;
    let c = b + 5;
    builtin_output_i64(c);              # 15

    return 0;
}
