# Test advanced const features\n# Focus: namespace constants, const expressions, hex/binary literals\n\n# Const with different numeric bases\nconst HEX_CONST = 0xFF;          # 255\nconst BIN_CONST = 0b11110000;    # 240\nconst OCT_CONST = 0o77;          # 63\n\n# Const computed from other constants\nconst BASE = 100;\nconst DOUBLED = BASE * 2;\nconst TRIPLED = BASE * 3;\nconst SUM_ALL = BASE + DOUBLED + TRIPLED;\n\n# Const in namespace\nnamespace Config {\n    const MAX_SIZE: i64 = 1024;\n    const MIN_SIZE: i64 = 64;\n    const DEFAULT_SIZE = MAX_SIZE / 2;\n}\n\nnamespace Math {\n    const PI_APPROX: i64 = 3;\n    const E_APPROX: i64 = 2;\n}\n\nfun main() -> i64 = {\n    # Test hex/binary/octal constants\n    builtin_output_i64(HEX_CONST);           # 255\n    builtin_output_i64(BIN_CONST);           # 240\n    builtin_output_i64(OCT_CONST);           # 63\n\n    # Test computed constants\n    builtin_output_i64(BASE);                # 100\n    builtin_output_i64(DOUBLED);             # 200\n    builtin_output_i64(TRIPLED);             # 300\n    builtin_output_i64(SUM_ALL);             # 600\n\n    # Test namespace constants\n    builtin_output_i64(Config.MAX_SIZE);     # 1024\n    builtin_output_i64(Config.MIN_SIZE);     # 64\n    builtin_output_i64(Config.DEFAULT_SIZE); # 512\n\n    # Test multiple namespace constants\n    builtin_output_i64(Math.PI_APPROX);      # 3\n    builtin_output_i64(Math.E_APPROX);       # 2\n\n    # Test const in expressions with namespace\n    let result = Config.MAX_SIZE - Config.MIN_SIZE;\n    builtin_output_i64(result);              # 960\n\n    return 0;\n}