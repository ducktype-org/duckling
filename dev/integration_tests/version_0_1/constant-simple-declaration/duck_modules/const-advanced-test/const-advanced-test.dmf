# Test advanced const features
# Focus: namespace constants, const expressions, hex/binary literals

# Const with different numeric bases
const HEX_CONST = 0xFF;          # 255
const BIN_CONST = 0b11110000;    # 240
const OCT_CONST = 0o77;          # 63

# Const computed from other constants
const BASE = 100;
const DOUBLED = BASE * 2;
const TRIPLED = BASE * 3;
const SUM_ALL = BASE + DOUBLED + TRIPLED;

# Const in namespace
namespace Config {
    const MAX_SIZE: i64 = 1024;
    const MIN_SIZE: i64 = 64;
    const DEFAULT_SIZE = MAX_SIZE / 2;
}

namespace Math {
    const PI_APPROX: i64 = 3;
    const E_APPROX: i64 = 2;
}

fun main() -> i64 = {
    # Test hex/binary/octal constants
    builtin_output_i64(HEX_CONST);           # 255
    builtin_output_i64(BIN_CONST);           # 240
    builtin_output_i64(OCT_CONST);           # 63

    # Test computed constants
    builtin_output_i64(BASE);                # 100
    builtin_output_i64(DOUBLED);             # 200
    builtin_output_i64(TRIPLED);             # 300
    builtin_output_i64(SUM_ALL);             # 600

    # Test namespace constants
    builtin_output_i64(Config.MAX_SIZE);     # 1024
    builtin_output_i64(Config.MIN_SIZE);     # 64
    builtin_output_i64(Config.DEFAULT_SIZE); # 512

    # Test multiple namespace constants
    builtin_output_i64(Math.PI_APPROX);      # 3
    builtin_output_i64(Math.E_APPROX);       # 2

    # Test const in expressions with namespace
    let result = Config.MAX_SIZE - Config.MIN_SIZE;
    builtin_output_i64(result);              # 960

    return 0;
}
