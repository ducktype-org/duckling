# Test simple C FFI declaration
extern("C") fundecl abs(x: i32) -> i32;

fun main() -> i64 = {
    # Test calling C function abs (from libc)
    var a: i32 = i32(-10);
    var b: i32 = abs(a);
    builtin_output_i64(i64(b));        # 10

    var c: i32 = abs(i32(-25));
    builtin_output_i64(i64(c));        # 25

    var d: i32 = abs(i32(15));
    builtin_output_i64(i64(d));        # 15

    return 0;
}
