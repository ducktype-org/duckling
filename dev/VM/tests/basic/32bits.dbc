function foo {
    arg_size: 0;
	next_arg_size: 0;
	local_size: 24;
	ret_size: 4;

	# 0 -> a
	# 4 -> b
    code: {
        mov_l32_imm 4, 3;
		mov_l32_l32 0, 4;
		# a = 3, b = 3

		cmov_l32_l32 0, 0;
		add_l32_l32 0, 4;
		add_l32_imm 4, 1;
		# a = 6, b = 4

		sub_l32_l32 0, 4;
		sub_l32_imm 4, 1;
		# a = 2, b = 3

		mul_l32_l32 0, 4;
		mul_l32_imm 4, 3;
		# a = 6, b = 9

		mod_l32_l32 0, 4;
		mod_l32_imm 4, 7;
		# a = 6, b = 2;

		div_l32_l32 0, 4;
		div_l32_imm 4, 2;
		# a = 3, b = 1 

		cmpEq_l32_l32 0, 4;
		jmpRelIf_label fail;
		
		cmpEq_l32_imm 4, 1;
		jmpRelNotIf_label fail;

		cmpG_l32_l32 0, 4;
		jmpRelNotIf_label fail;

		cmpG_l32_imm 4, 2;
		jmpRelIf_label fail;

		add_l32_l32 4, 0;
		# b = 4
        ret_l32 4;
		
		label fail;
		mov_l64_imm 8, 2137;
		output_l64  8;
		ret_l32 0;
    }
}

function main {
	arg_size: 0;
	next_arg_size: 0;
	local_size: 24;
	ret_size: 0;

	code: {
        call_func foo;
        mov_l64_r0 0;
        output_l64 0;

		ret_l64 0;
	}
}
