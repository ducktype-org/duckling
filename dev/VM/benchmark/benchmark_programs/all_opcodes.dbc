function run_every_opcode {
	arg_size: 0;
	ret_size: 0;

    // 0: int64_t tmp1;
    // 8: int64_t tmp2;
    // 16: Pointer tmp3;
	local_size: 32;

	code: {
		mov_l64_imm            0, 0;
        mov_l64_l64            8, 0;
        cmov_l64_l64           8, 0;
        mov_l64_r0               0;
        mov_r0_l64               0;
        mov_l64_pFuncArg         0;
        mov_lptr_ptrFuncArg     16;
        add_l64_l64  0, 8;
        add_l64_imm  8, 10;
        sub_l64_l64  0, 8;
        sub_l64_imm  0, 0;
        mul_l64_imm  0, 0;
        mod_l64_imm  0, 1;
        mod_l64_l64  0, 8;
        div_l64_imm  0, 1;
        cmpEq_l64_l64 0, 8;
        cmpEq_l64_imm 0, 0;
        cmpG_l64_l64  0, 8;
        cmpG_l64_imm  0, 0;
        jmpRel_label Here;
        label Here;
        jmpRelIf_label Here2;
        label Here2;
        jmpRelNotIf_label Here3;
        label Here3;
        setPtrArg_lptr  16;
        setPArg_l64 0;
        ret_l64  0;
    }
}


function main {
	arg_size: 0;
	ret_size: 0;

	// x - 0
	// s - 8
	// i - 16
	// tmp - 24
	local_size: 8;

	code: {
		// x := input
		input_l64       0;

        label Loop;
            call_func run_every_opcode;
            call_func run_every_opcode;
            call_func run_every_opcode;
            call_func run_every_opcode;
            call_func run_every_opcode;

            sub_l64_imm 0, 1;
            cmpEq_l64_imm   0, 0;
            jmpRelNotIf_label  Loop;

		ret_imm         0;
	}

}
