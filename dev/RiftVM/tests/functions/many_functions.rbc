# Test check's if we can call two nested functions.
# Also if the stacks are seperate.
# output = input + 1110

function add1000 {
	arg_size: 8;
	next_arg_size: 0;
	ret_size: 0;
	local_size: 16;

	code: {
        mov_l64_imm    0,   1000;
        getFstArg_l64    		8;
        add_l64_l64         0, 8;
		ret_l64 		    0;
	}
}

function add1100 {
	arg_size: 8;
	next_arg_size: 8;
	ret_size: 0;
	local_size: 16;

	code: {
        mov_l64_imm    0,   100;
        getFstArg_l64    		8;
        
        setFstArg_l64       8;
        call_func           0;
        mov_l64_r0          8;

        add_l64_l64    0,   8;
		ret_l64 		    0;
	}
}

function add1110 {
	arg_size: 8;
	next_arg_size: 8;
	ret_size: 0;
	local_size: 16;

	code: {
        mov_l64_imm    0,   10;
        getFstArg_l64    		8;
        
        setFstArg_l64       8;
        call_func           1;
        mov_l64_r0          8;

        add_l64_l64    0,   8;
		ret_l64 		    0;
	}
}


function main {
	arg_size: 0;
	next_arg_size: 8;
	ret_size: 0;

	local_size: 8;

	code: {
        input_l64           0;
        setFstArg_l64       0;
		
        call_func          	2;
        
        mov_l64_r0          0;
        output_l64          0;

		ret_imm             0;
	}

}
