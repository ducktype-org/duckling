# Test's whether on function call the flag (result of the compare opcodes)
# is preserved after the call to another function.
# output == 1 <- test passed
# output == 0 <- test failed

function check {
	arg_size: 0;
	next_arg_size: 0;
	ret_size: 0;
	local_size: 8;

	code: {
        mov_l64_imm         0,   15;
        cmpEq_l64_imm       0,   14;
        ret_imm             0;
	}
}


function main {
	arg_size: 0;
	next_arg_size: 0;
	ret_size: 0;

	local_size: 16;

	code: {
        mov_l64_imm         0,  1;
        cmpEq_l64_imm       0,  1;
		
        call_func          	0;

        mov_l64_imm         0,  1;
        mov_l64_imm         8,  0;
        
        # flag from cmpEq should be on
        jmpRelIf_label      ok_label;

        # print "0" (failed)
        output_l64          8;
        ret_imm             0;

        label ok_label;
        # print "1" (passed)
        output_l64          0;
		ret_imm             0;
	}

}
