// output != 17 <- test failed

function check {
	arg_size: 0;
	ret_size: 0;
	local_size: 8;

	code: {
		ret_imm 		17;
	}
}


function main {
	arg_size: 0;
	ret_size: 0;

	local_size: 8;

	code: {
