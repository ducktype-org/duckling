type primitive: int64 8
type static_table: tableint64 int64 4

function main {
  arg_size: 0;
  ret_size: 0;

  // x - 0
  // i - 8
  // t - 16
  local_size: 40;

  code: {
    init_type int64; // [0,8)
    init_type int64; // [8,16)

    alloc_lptr_type     16, tableint64;

    // i := 0
    mov_l64_imm         8, 0;

    // x := 3 -> r0
    mov_l64_imm         0, 3;

    // t[i] := x (by idx)
    store_lptr_l64_ofs  16, 0;
    ext_l64             8;

    // x := 5 -> r0
    mov_l64_imm         0, 5;

    load_l64_lptr_ofs   0, 16;
    ext_l64             8;

    output_l64          8;

    free_lptr           16;

    deinit;
    deinit;

    ret_imm             0;
  }

}
