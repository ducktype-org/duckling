const D: i32 = A + (B + C);

const C: i32 = X;

namespace N {
	alias X = A;
}

alias H = NN.NNN.A;
const H2: i32 = H;

const A: i32 = 1;

const B: i32 = (X - 6) + (1 + A);

using N.*;

