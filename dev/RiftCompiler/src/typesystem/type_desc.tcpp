#pragma once

#include "implicit_coercibility.hpp"
#include "type_desc.hpp"

namespace ts {
	template<std::derived_from<TypeInfo> TYPE_INFO>
	bool TypeDesc<TYPE_INFO>::isDescImplicitlyCoercible(const TypeDesc<>& to) const {
		return isImplicitlyCoercible(typeInfo, to.typeInfo)
		    && valueCategory.contains(to.valueCategory);
	}
}
