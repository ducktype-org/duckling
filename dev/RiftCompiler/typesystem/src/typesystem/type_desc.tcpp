#pragma once

#include "implicit_coercibility.hpp"
#include "type_desc.hpp"

namespace ts {
	template<std::derived_from<TypeInfo> TYPE_INFO>
	bool TypeDesc<TYPE_INFO>::isDescImplicitlyCoercible(const TypeDesc<>& target) const {
		return isImplicitlyCoercible(typeInfo, target.getType())
		    && valueCategory.contains(target.getValueCategory());
	}
}
