import io;
import algo;

class Vec {
	var x, y: i64;
}

enum Direction { PG, PD, LG, LD }

class DivVec {
	var position: Vec;
	var dir: Direction;
}

class Flips {
	var x_flip = false;
	var y_flip = false;
}

class MirrorPoint {
	var position: Vec;
	var flips: Flips;
}

var mirrors: MirrorPoint[];

fun sign(x: i64) = if x > 0 then 1 else (if x < 0 then (-1) else 0);

fun dirToVec(d: Direction) -> Vec = {
	match (d) {
		case Direction.PG =
			return {1, 1};
		case Direction.PD =
			return {1, -1};
		case Direction.LG =
			return {-1, 1};
		case Direction.LD =
			return {-1, -1};
	}
}

fun getDirection(s: ref String) = {
	match (s) {
		case "PG" = return Direction.PG;
		case "PD" = return Direction.PD;
		case "LG" = return Direction.LG;
		case "LD" = return Direction.LD;
	}
	panic;
}

# PG - x no flip, y no flip
# PD - x no flip, y flip
# LG - x flip,    y no flip
# LD - x flip,    y flip

fun diagID(flip_x: bool, flip_y: bool, v: Vec) =
	(if flip_x then (v.x) else (-v.x)) - (if flip_y then (v.y) else (-v.y));

fun compareVecOnDiagonal(flip_x: bool, @unused flip_y: bool) =
	lambda[flip_x, flip_y](lhs: MirrorPoint, rhs: MirrorPoint) -> bool {
		if (flip_x) {
			return lhs.position.x > rhs.position.x;
		}
		else {
			return lhs.position.x < rhs.position.x;
		}
	};

fun flipDirection(d: Direction, mirror: MirrorPoint) = {
	# structural matching..?:
	var [x_flip, y_flip] = mirror.flips;
	let [x, y] = dirToVec(d);

	if (x_flip) x *= -1;
	if (y_flip) y *= -1;

	match (x, y) {
		case (1, 1) = return Direction.PG;
		case (1, -1) = return Direction.PD;
		case (-1, 1) = return Direction.LG;
		case (-1, -1) = return Direction.LD;
	}

	panic;
}

var from_to: DivVec->DivVec;


fun makeDiag(Direction diag_direction) = {
	# this are different flips:
	let flip_x = diag_direction == Direction.LG or diag_direction == Direction.LD;
	let flip_y = diag_direction == Direction.PD or diag_direction == Direction.LD;

	var mirror_per_diag: i64->MirrorPoint[];

	for (let mirror in mirrors) {
		let diag_id = diagID(flip_x, flip_y, mirror.position);
		mirror_per_diag[diag_id].append(mirror);
	}
		
	for (let [_, mirrors_on_diag] in mirror_per_diag) {
		std.sort(&mirrors_on_diag, cmp = compareVecOnDiagonal(flip_x, flip_y));

		for (let i in 0..(mirrors_on_diag.ssize() - 1)) {
			let from = mirrors_on_diag.at(i);
			let to = mirrors_on_diag.at(i + 1);

			from_to.insert({from.position, diag_direction}, {to.position, flipDirection(diag_direction, to)});
		}
	}
}
