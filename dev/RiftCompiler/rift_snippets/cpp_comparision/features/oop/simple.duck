class Car {
    brand, model: string; # we need to add this, cause wwiting the same type multiple times is very annoying

    mileage = 0;

    fun drive(distance: int) = {
        mileage += distance;
    }

    fun show_data() = {
        printLn(f"Brand: {brand}");
        printLn(f"Model: {model}");
        printLn(f"Distance driven: {mileage} miles");
    }
}

fun main() = {
    my_car: Car;

    my_car.brand = "Honda";
    my_car.model = "Accord";
    my_car.drive(50);

    my_car.show_data();
}
