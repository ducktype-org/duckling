fun DFS(node, adj: ref i32[][], visited: ref bool[]) = {
    visited[node] = true;
    print(node, " ");
    for (neighbor in adj[node]) {
        if (not visited[neighbor]) {
            DFS(neighbor, adj, visited);
        }
    }
}

fun main() = {
    var vertices: i32, edges: i32;
    print("Enter the number of vertices and the number of edges: ");
    scan(vertices,edges);
    let adj: i32[vertices][];

    println("enter edges (one edge in one line):");
    for (i in edges) {
        var u: i32, v: i32;
        scan(u,v);
        if (not (0 <= u < vertices and 0 <= v < vertices)) {
            printlnerr("Invalid edge: ", u, " ", v);
            return 1;
        }
        adj[u] += [v];
        adj[v] += [u];
    }
    let visited: bool[vertices];

    for (i in vertices) {
        if (not visited[i]) {
            print("DFS begins from the vertex ", i, ": ");
            DFS(i, adj, visited);
            println();
        }
    }
    return 0;
}