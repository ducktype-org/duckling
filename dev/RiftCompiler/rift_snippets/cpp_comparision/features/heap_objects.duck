class A {
	x: i32;
}

class B extends A {
	y: i32;
}

fun consumeOwner(a: box A) = {}; # pass?

template{T}
fun passOwner(p: box T) = move p;

class Owner {
	a: box? A;
	b: box? B;
}

fun main() {
	{
		# default inits can most likely be omitted:
		var p: box A; # = A();
	}
	{
		var p: box A; # = A();
		consumeOwner(move p);
	}
	{
		var p: box B; # = B();
		var p2: box A = passOwner(move p);
	}
	{
		var o: Owner;
		o.a = A();
		o.b = B();
	}
}