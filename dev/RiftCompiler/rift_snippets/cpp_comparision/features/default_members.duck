class Point {
    i32 x, y;

    fun distanceFrom(other: Point) -> f32 { # = {...}
        return std.sqrt((x - other.x) * (x - other.x) + (y - other.y) * (y - other.y));
    }
}

fun findClosestPoint(reference: Point, points: Point[]) -> Point = {
    var closestPoint: Point = points[0];
    var closestDistance: Point = reference.distanceFrom(closestPoint);

    for (point: Point in Points) {
        var currentDistance: Point = reference.distanceFrom(point);
        if (currentDistance < closestDistance) {
            closestPoint = point;
            closestDistance = currentDistance;
        }
    }

    return closestPoint;
}

fun main() = {
    let p1 = Point(3,4);
    let p2 = Point(1,2);
    let p3 = Point(5,6);
    let p4 = Point(1,2);

    if (p1 == p2) {
        println("p1 jest równy p2");
    } else {
        println("p1 nie równy p2");
    }

    if (p2 == p4) {
        println("p2 jest równy p4");
    }

    var points: Point[] = [p1, p1, p3, p4];
    std.sort(points);

    println("posortowane punkty:");
    for (p: Point in points) {
        println(p);
    }

    let closestPoint = findClosestPoint(p1, points);
    println("Najbliższy punkt do ", p1, " to ", closestPoint);
}