#{
# Program calculating n-th 
# fibbonacci number in O(n)
}#

include std.io;

struct A {

}

fun main() {
    n := io.getint(); # n-th fibb number
    a := 0;
    b := 1;
    _ := 123;
    for (i : 0..n) {
        a, b = b, a + b; #cool stuff
    }
    io.output(b);
    _abcdefghijklmnoprstuwxyx_ABCDEFGHIJKLMNOPRSTUWXYZ_0123456789;
    +-*/%&|^~?<>=;

}
