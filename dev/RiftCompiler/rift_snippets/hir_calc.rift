# Simple const calculations.

const D: i32 = A + (B + C);

const C: i32 = X;

namespace N {
	alias X = A;
}

alias H = NN.NNN.A;
const H2: i32 = H;

const A: i32 = 1;

const B: i32 = (X - 6) + (1 + A);

using N.*;

namespace NN {
	namespace NNN {
		const A: i32 = D;
	}
	alias A = NNN.A;
	# const Amb: i32 = A; # this is ambiguity error
}



const T0: i32 = 1;
const T1: i32 = T0 + 1;
const T2: i32 = T1 + 1;
const T3: i32 = T2 + 1;
const T4: i32 = T3 + 1;
const T5: i32 = T4 + 1;
const T6: i32 = T5 + 1;
const T7: i32 = T6 + 1;
const T8: i32 = T7 + 1;
const T9: i32 = T8 + 1;
