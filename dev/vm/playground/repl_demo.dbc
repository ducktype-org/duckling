type fun: winter { i64, i64, i64 } i64
function winter {
    # Calculates (a0 + a1) * a2
    init_lany_type sum_ret_val, i64;
    init_lany_type sum_a0, i64;
    init_lany_type sum_a1, i64;

    mov_l64_l64 sum_a0, arg0;
    mov_l64_l64 sum_a1, arg1;
    call_func summer;

    init_lany_type mul_arg0, i64;
    init_lany_type mul_arg1, i64;    
    mov_l64_l64 mul_arg0, sum_ret_val;
    mov_l64_l64 mul_arg1, arg2;
    call_func muller;

    mov_l64_l64 ret_val, sum_ret_val;
    ret;
}

type fun: summer { i64, i64 } i64
function summer {
    mov_l64_l64 ret_val, arg0;
    add_l64_l64 ret_val, arg1;
    deinit;
    deinit;
    ret;
}

type fun: muller { i64, i64 } i64
function muller {
    mov_l64_l64 ret_val, arg0;
    mul_l64_l64 ret_val, arg1;
    deinit;
    deinit;
    ret;
}

type fun: spring { i64, i64 } i64
function spring {
    # For given a, b calculates a * (a+b)

    mov_l64_l64 ret_val, arg0;
    init_lany_type sum_ret_val, i64;
    init_lany_type sum_a0, i64;
    init_lany_type sum_a1, i64;
    mov_l64_l64 sum_a0, arg0;
    mov_l64_l64 sum_a1, arg1;
    call_func summer;
    mul_l64_l64 ret_val, sum_ret_val;
    deinit; # sum_ret_val
    deinit; # arg1
    deinit; # arg0 
    ret;
}

type fun: hello {} void
function hello {
    init_lany_type x, i64;
    input_l64 x;
    add_l64_imm x, 1;
    output_l64 x;
    deinit;
    ret;
}

# Add a constant to global
type fun: addToGlobal {} void
function addToGlobal {
    init_lany_type x, i64;
    mov_l64_g64 x, g;
    add_l64_imm x, 5;
    mov_g64_l64 g, x;
    deinit;
    ret;
}