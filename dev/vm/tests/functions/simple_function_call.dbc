# Tests a simple function call.
# input = n
# output = n

type primitive: int64 8

function check {
	arg_size: 8;
	arg_count: 1;
	next_arg_size: 0;
	ret_size: 0;
	local_size: 8;

	code: {
        output_l64          0;
		ret;
	}
}


function main {
	arg_size: 0;
	arg_count: 0;
	next_arg_size: 8;
	ret_size: 8;
	local_size: 16;

	code: {
		# [0, 8) main ret_val

		init_type 			int64; # [8, 16) check() arg0
        input_l64           8;
		call_func          	check;

		ret;
	}

}
