# Tests a simple function call.
# input = n
# output = n

type fun: main {} i64
type fun: check { i64 } void

function check {
	output_l64          0;
	ret;
}

function main {
	# [0, 8) main ret_val
	init_type 			i64; # [8, 16) check() arg0
	input_l64           8;
	call_func          	check;

	mov_l64_imm			0, 42;
	ret;
}
