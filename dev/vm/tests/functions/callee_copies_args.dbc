# Tests is caller copies his parameters
# input = ""
# output = 12512

type primitive: int64 8

function foo {
    arg_size: 16;
    next_arg_size: 0;
    ret_size: 8;
    local_size:   32;

    code: {
        # [0, 8) -> ret_val
		# [8, 16) -> arg0
		# [16, 24) -> arg1

        output_l64      8;
        output_l64      16;

        # Trying to overwrite passed args
        mov_l64_imm     8, 3;
        mov_l64_imm     16, 4;

        mov_l64_imm     0, 5;
        ret;
    }
}


function main {
    arg_size: 0;
    next_arg_size: 16;
    ret_size: 0;

    local_size: 24;

    code: {
        init_type int64; # [0,8) foo ret_val
        init_type int64; # [8,16) foo arg0
        init_type int64; # [16,24) foo arg1

        mov_l64_imm 8, 1;    
        mov_l64_imm 16, 2;    
        call_func       foo;

        output_l64      0;
        output_l64      8;
        output_l64      16;

        ret;
    }
}