# Tests returning other values than i64
# input = n
# output = n

type primitive: int32 4

function check {
	arg_size: 0;
	next_arg_size: 0;
	ret_size: 0;
	local_size: 4;

	code: {
		input_l32       0;
		ret;
	}
}


function main {
	arg_size: 0;
	next_arg_size: 0;
	ret_size: 0;

	local_size: 4;

	code: {
		init_type 			int32; # place for check() ret_val
		call_func          	check;
		
		output_l32 			0;
		ret;
	}

}
