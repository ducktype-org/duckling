# Tests a function call with multiple parameters of diffrent sizes.
# input = "a b c"
# output = a * c

type primitive: int32 4
type primitive: int64 8

function check {
	arg_size: 20;
	arg_count: 3;
	ret_size: 0;
	local_size: 28;

	code: {
		# [0, 8) a
		# [8, 12) b
		# [12, 20) c

		init_type 			int64; # [20, 28)
		mov_l64_imm			20, 1; # acc := 1
		mul_l64_l64			20, 0; # acc *= a
		mul_l64_l64			20, 12; # acc *= c

		output_l64			20;
		ret;
	}
}


function main {
	arg_size: 0;
	arg_count: 0;
	ret_size: 8;
	local_size: 28;

	code: {
		init_type int64; # [0, 8) main ret_val
		init_type int64; # [8, 16)
		init_type int32; # [16, 20)
		init_type int64; # [20, 28)

		input_l64	8;
		input_l32	16;
		input_l64	20;
		call_func          	check;

		ret;
	}

}
