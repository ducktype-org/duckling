# Tests a function call with multiple parameters of diffrent sizes.
# input = "a b c"
# output = a * c

type primitive: int32 4
type primitive: int64 8
type primitive: void 0
type fun: main {} int64
type fun: check { int64, int32, int64 } void

function check {
	arg_size: 20;
	arg_count: 3;
	ret_size: 0;
	local_size: 28;

	code: {
		# [0, 8) arg0
		# [8, 12) arg1
		# [12, 20) arg2

		init_type 			int64; 	# [20, 28) temp
		mov_l64_imm			20, 1; 	# acc := 1
		mul_l64_l64			20, 0; 	# acc *= a
		mul_l64_l64			20, 12; # acc *= c

		output_l64			20;

		deinit; # temp
		deinit; # arg2
		deinit; # arg1
		deinit; # arg0
		ret;
	}
}


function main {
	arg_size: 0;
	arg_count: 0;
	ret_size: 8;
	local_size: 28;

	code: {
		# [0, 8) main ret_val
		init_type int64; # [8, 16) check() arg0
		init_type int32; # [16, 20) check() arg1
		init_type int64; # [20, 28) check() arg2

		input_l64	8;
		input_l32	16;
		input_l64	20;
		call_func          	check;

		ret;
	}

}
