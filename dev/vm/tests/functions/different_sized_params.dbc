# Tests a function call with multiple parameters of different sizes.
# input = "a b c"
# output = a * c

type fun: main { i64, ptr_argv } i64
type fun: check { i64, i32, i64 } void

function check {
	# [0, 8) arg0
	# [8, 12) arg1
	# [12, 20) arg2

	init_type 			i64; 	# [20, 28) acc
	mov_l64_imm			20, 1; 	# acc := 1
	mul_l64_l64			20, 0; 	# acc *= a
	mul_l64_l64			20, 12; # acc *= c

	output_l64			20;

	deinit; # acc
	deinit; # arg2
	deinit; # arg1
	deinit; # arg0
	ret;
}

function main {
    # [0, 8) ret_val
    # [8, 16) argc
    # [16, 32) *argv

	init_type i64; # [32, 40) check() arg0
	init_type i32; # [40, 44) check() arg1
	init_type i64; # [44, 52) check() arg2

	input_l64	32;
	input_l32	40;
	input_l64	44;
	call_func          	check;

	ret;
}
