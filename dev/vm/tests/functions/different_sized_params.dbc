# Tests a function call with multiple parameters of diffrent sizes.
# input = ""
# output = 321

type primitive: int32 4
type primitive: int64 8

function check {
	arg_size: 20;
	arg_count: 3;
	next_arg_size: 0;
	ret_size: 0;
	local_size: 20;

	code: {
        output_l64          0;
        output_l32          8;
        output_l64          12;
		ret;
	}
}


function main {
	arg_size: 0;
	arg_count: 0;
	next_arg_size: 20;
	ret_size: 8;
	local_size: 28;

	code: {
		# [0, 8) main ret_val
		init_type int64; # [8, 16)
		init_type int32; # [16, 20)
		init_type int64; # [20, 28)

        mov_l64_imm 8, 3;
        mov_l32_imm 16, 2;
        mov_l64_imm 20, 1;
		call_func          	check;

		ret;
	}

}
