# Tests for recurrence, but also for many function aspects
# (passing arguments, results, whether stacks are seperate).
# input = n
# output = n * (n + 1) / 2

type primitive: int64 8
type fun: main {} int64
type fun: sum { int64 } int64

function sum {
	arg_size: 8;
	arg_count: 1;
	ret_size: 8;
	local_size: 32;

	code: {
        # [0, 8) -> ret_val
        # [8, 16) -> arg0

        cmpEq_l64_imm       8,  0;
        jmpRelIf_label      ret_label;
        # if arg != 0:
            init_type           int64; # [16, 24) init a return value spot for sum()
            init_type           int64; # [24, 32) init an arg0 spot for sum()
            mov_l64_l64         24,  8;
            sub_l64_imm         24,  1;

            call_func           sum;

            mov_l64_l64         0, 16;
            add_l64_l64         0,  8;
            
            deinit; # sum() ret_val. arg0 was deinitialized by the call.
        label ret_label;
        
        deinit; # arg0
		ret;    # The result already is on the 0 offset
	}
}


function main {
	arg_size: 0;
	arg_count: 0;
	ret_size: 8;
	local_size: 24;

	code: {
        # [0, 8) main ret_val
        init_type           int64; # [8, 16) sum ret_val
        init_type           int64; # [16, 24) sum arg0
        input_l64           16;

        call_func          	sum;

        output_l64          8;

        deinit; # sum ret_val, sum arg0 is deinitialized by the call
		ret;
	}

}
