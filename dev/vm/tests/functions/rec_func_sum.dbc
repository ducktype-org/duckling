# Tests for recurrence, but also for many function aspects
# (passing arguments, results, whether stacks are seperate).
# input = n
# output = n * (n + 1) / 2

type fun: sum { i64 } i64

function sum {
    # [0, 8) -> ret_val
    # [8, 16) -> arg0

    cmpEq_l64_imm       8,  0;
    jmpIf_label      ret_label;
    # if arg != 0:
        init_type           i64; # [16, 24) init a return value spot for sum()
        init_type           i64; # [24, 32) init an arg0 spot for sum()
        mov_l64_l64         24,  8;
        sub_l64_imm         24,  1;

        call_func           sum;

        mov_l64_l64         0, 16;
        add_l64_l64         0,  8;

        deinit; # sum() ret_val. arg0 was deinitialized by the call.
    label ret_label;

    deinit; # arg0
    ret;    # The result already is on the 0 offset
}

function main {
    # [0, 8) ret_val
    # [8, 16) argc
    # [16, 32) *argv

    init_type           i64; # [32, 40) sum ret_val
    init_type           i64; # [40, 48) sum arg0
    input_l64           40;

    call_func          	sum;

    output_l64          32;

    deinit; # sum ret_val, sum arg0 is deinitialized by the call
    deinit; # *argv
    deinit; # argc
    ret;
}
