# Tests if call_func effectively deinit's it's parameters
# input = ""
# output = "42"

type primitive: int64 8
type fun: main {} int64

function main {
    arg_size: 0;
	arg_count: 0;
    ret_size: 8;
    local_size: 24;

    code: {
        init_type       int64; # [0, 8) main ret_val
        deinit;
        
        init_type       int64; # [0, 8)
        mov_l64_imm     0, 42;
        output_l64      0;

        ret;
    }
}