# Tests if call_func effectively deinit's it's parameters
# input = ""
# output = "42"

type fun: main { i64, ptr_argv } i64

function main {
    # [0, 8) ret_val
    # [8, 16) argc
    # [16, 32) *argv

    free_lptr 16;
    deinit; # argv_ptr
    deinit; # argc

    deinit; # main ret_val

    init_type       i64; # [0, 8)
    mov_l64_imm     0, 42;
    output_l64      0;

    ret;
}
