# Tests if call_func effectively deinit's it's parameters
# input = ""
# output = "42"

function main {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

    deinit; # argv_ptr
    deinit; # argc
    deinit; # main ret_val

    init_lany_type       x, i64;
    mov_l64_imm     x, 42;
    output_l64      x;

    ret;
}
