# Tests a function call with multiple parameters.
# input = ""
# output = 1234

type primitive: int64 8

function check {
	arg_size: 32;
	next_arg_size: 0;
	ret_size: 0;
	local_size: 32;

	code: {
        output_l64          0;
        output_l64          8;
        output_l64          16;
        output_l64          24;
		ret;
	}
}


function main {
	arg_size: 0;
	next_arg_size: 32;
	ret_size: 8;
	local_size: 40;

	code: {
		# [0, 8) main ret_val

		init_type int64; # [8, 16)
		init_type int64; # [16, 24)
		init_type int64; # [24, 32)
		init_type int64; # [32, 40)

        mov_l64_imm 8, 1;
        mov_l64_imm 16, 2;
        mov_l64_imm 24, 3;
        mov_l64_imm 32, 4;
		call_func          	check;

		ret;
	}

}
