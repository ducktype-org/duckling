# Tests if call_func effectively deinit's it's parameters
# input = ""
# output = "42"

type fun: main {} i64
type fun: foo { i64 } i64

function foo {
    # [0, 8) -> ret_val
    # [8, 16) -> arg0

    deinit; # arg0
    deinit; # ret_val

    init_type       i64; # ret_val
    mov_l64_imm     0, 42;

    ret;
}

function main {
    # [0, 8) main ret_val
    init_type       i64; # [8, 16) foo ret_val
    init_type       i64; # [16, 24) foo arg0

    call_func       foo;

    output_l64 8;

    deinit; # foo ret_val
    ret;
}
