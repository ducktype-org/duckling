# Tests if call_func effectively deinit's it's parameters
# input = ""
# output = "42"

type fun: main { i64, ptr_argv } i64
type fun: foo { i64 } i64

function foo {
    # [0, 8) -> ret_val
    # [8, 16) -> arg0

    deinit; # arg0
    deinit; # ret_val

    init_type       i64; # ret_val
    mov_l64_imm     0, 42;

    ret;
}

function main {
    # [0, 8) ret_val
    # [8, 16) argc
    # [16, 32) *argv

    init_type       i64; # [32, 40) foo ret_val
    init_type       i64; # [40, 48) foo arg0

    call_func       foo;

    output_l64 32;

    deinit; # foo ret_val
    ret;
}
