# Tests if values from functions are returned correctly.
# input = n
# output = n

type primitive: int64 8

function check {
	arg_size: 0;
	next_arg_size: 0;
	ret_size: 8;
	local_size: 8;

	code: {
        input_l64       0;
		ret;
	}
}


function main {
	arg_size: 0;
	next_arg_size: 0;
	ret_size: 0;
	local_size: 8;

	code: {
		init_type       int64; # [0, 8) init a place for check() return value
		call_func       check;
        output_l64      0;

		ret;
	}

}
