# Tests if values from functions are returned correctly.
# input = n
# output = n

type fun: check {} i64

function check {
	input_l64       ret_val;
	ret;
}

function main {
	# ret_val -> main ret_val
	# arg0 -> argc
	# arg1 -> *argv
	
	init_lany_type  check_ret_val, i64;
	call_func       check;
	output_l64      check_ret_val;

	deinit;
	deinit; # *argv
	deinit; # argc 
	ret;
}
