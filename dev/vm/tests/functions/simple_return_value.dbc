# Tests if values from functions are returned correctly.
# input = n
# output = n

type fun: check {} i64

function check {
	# [0, 8) check() ret_val
	input_l64       0;
	ret;
}

function main {
    # [0, 8) ret_val
    # [8, 16) argc
    # [16, 32) *argv
	
	init_type       i64; # [32, 40) check() ret_val
	call_func       check;
	output_l64      32;

	deinit;
	deinit; # *argv
	deinit; # argc 
