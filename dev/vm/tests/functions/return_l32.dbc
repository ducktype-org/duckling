# Tests returning other values than i64
# input = n
# output = n

type primitive: int32 4
type primitive: int64 8

function check {
	arg_size: 0;
	arg_count: 0;
	ret_size: 4;
	local_size: 4;

	code: {
		input_l32       0;
		ret;
	}
}


function main {
	arg_size: 0;
	arg_count: 0;
	ret_size: 8;
	local_size: 12;

	code: {
		init_type 			int64; # [0, 8) check() ret_val
		init_type 			int32; # [8, 12) check() ret_val
		call_func          	check;
		output_l32 			8;

		deinit;
		ret;
	}

}
