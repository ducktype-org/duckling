# Tests returning other values than i64
# input = n
# output = n

type primitive: int32 4
type primitive: int64 8
type fun: main {} int64
type fun: check {} int32


function check {
	input_l32       0;
	ret;
}


function main {
	# [0, 8) main ret_val
	init_type 			int32; # [8, 12) check() ret_val
	call_func          	check;
	output_l32 			8;

	deinit;
	ret;
}
