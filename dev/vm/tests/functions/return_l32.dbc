# Tests returning other values than i64
# input = n
# output = n

type fun: main { i64, ptr_argv } i64
type fun: check {} i32

function check {
	input_l32       0;
	ret;
}

function main {
	# [0, 8) main ret_val
	init_type 			i32; # [8, 12) check() ret_val
	call_func          	check;
	output_l32 			8;

	deinit;
	ret;
}
