# Tests returning other values than i64
# input = n
# output = n

type fun: check {} i32

function check {
	input_l32       ret_val;
	ret;
}

function main {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

	init_lany_type 			check_ret_val, i32;
	call_func          	check;
	output_l32 			check_ret_val;

	deinit;
	deinit; # *argv
	deinit; # argc
	ret;
}
