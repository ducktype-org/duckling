# Test's whether on function call the flag (result of the compare opcodes)
# is preserved after the call to another function.
# output == 1 <- test passed
# output == 0 <- test failed

type primitive: int64 8

function check {
	arg_size: 0;
	next_arg_size: 0;
	ret_size: 0;
	local_size: 8;

	code: {
		init_type 			int64;
		mov_l64_imm         0,   15;
		cmpEq_l64_imm       0,   14;
		ret;
	}
}


function main {
	arg_size: 0;
	next_arg_size: 0;
	ret_size: 0;

	local_size: 16;

	code: {
		init_type           int64; # [0, 8)
		init_type           int64; # [8, 16)

		mov_l64_imm         0,  1;
		cmpEq_l64_imm       0,  1;

		call_func          	check;

		mov_l64_imm         0,  1;
		mov_l64_imm         8,  0;

		# flag from cmpEq should be on
		jmpRelIf_label      ok_label;

		# print "0" (failed)
		output_l64          8;
		ret;

		label ok_label;
		# print "1" (passed)
		output_l64          0;
		ret;
	}
}
