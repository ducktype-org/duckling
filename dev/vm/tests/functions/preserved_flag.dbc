# Test's whether on function call the flag (result of the compare opcodes)
# is preserved after the call to another function.
# output == 1 <- test passed
# output == 0 <- test failed

type fun: check {} void

function check {
	init_type 			i64;
	mov_l64_imm         0,   15;
	cmpEq_l64_imm       0,   14;
	deinit;
	ret;
}

function main {
    # [0, 8) ret_val
    # [8, 16) argc
    # [16, 32) *argv

	init_type           i64; # [32, 40) local_1
	init_type           i64; # [40, 48) local_2

	mov_l64_imm         32,  1;
	cmpEq_l64_imm       32,  1;

	call_func          	check;

	mov_l64_imm         32,  1;
	mov_l64_imm         40,  0;

	# flag from cmpEq should be on
	jmpRelIf_label      ok_label;

	# print "0" (failed)
	output_l64          40;
	ret;

	label ok_label;
	# print "1" (passed)
	output_l64          32;

	deinit; # local_2
	deinit; # local_1
	deinit; # *argv
	deinit; # argc
	ret;
}
