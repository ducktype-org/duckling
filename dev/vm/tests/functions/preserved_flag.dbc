# Test's whether on function call the flag (result of the compare opcodes)
# is preserved after the call to another function.
# output == 1 <- test passed
# output == 0 <- test failed

type fun: main { i64, ptr_argv } i64
type fun: check {} void

function check {
	init_type 			i64;
	mov_l64_imm         0,   15;
	cmpEq_l64_imm       0,   14;
	deinit;
	ret;
}

function main {
	# [0, 8) main ret_val
	init_type           i64; # [8, 16) local_1
	init_type           i64; # [16, 24) local_2

	mov_l64_imm         8,  1;
	cmpEq_l64_imm       8,  1;

	call_func          	check;

	mov_l64_imm         8,  1;
	mov_l64_imm         16,  0;

	# flag from cmpEq should be on
	jmpRelIf_label      ok_label;

	# print "0" (failed)
	output_l64          16;
	ret;

	label ok_label;
	# print "1" (passed)
	output_l64          8;

	deinit;
	deinit;
	ret;
}
