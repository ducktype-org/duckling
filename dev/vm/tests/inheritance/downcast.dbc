type fun: main {} i64
type fun: print_flag {} void

inheritable Animal: abstract class {}
inheritable Dog: class {
    extends: Animal;
}
inheritable Cat: class {
    extends: Animal;
}

type pointer: AnimalPtr Animal
type pointer: DogPtr Dog
type pointer: CatPtr Cat

function main {
    init_type AnimalPtr;  # 8
    init_type CatPtr;     # 24
    init_type DogPtr;     # 40
    init_type i64;      # 56

    alloc_lptr_type 8, Dog;
    setVTable_lptr_type 8, Dog;

    downcast_lptr_lptr 24, 8;  # cat := static_cast<CatPtr>(animal)
    cmpNull_lptr 24;  # flag := cat != nullptr

    # Check if succeeded
    jmpRelNotIf_label notCat;
        add_l64_imm 56, 10;
    label notCat;

    downcast_lptr_lptr 40, 8;  # dog := static_cast<DogPtr>(animal)
    cmpNull_lptr 40;  # flag := cat != nullptr

    # Check if succeeded
    jmpRelNotIf_label notDog;
        add_l64_imm 56, 1;
    label notDog;

    output_l64 56;

    ret;
}
