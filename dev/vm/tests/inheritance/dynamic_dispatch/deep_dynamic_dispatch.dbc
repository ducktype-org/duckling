type pointer: pointer_Animal Animal
type pointer: pointer_Feline Feline
type pointer: pointer_Cat Cat

# ========== VIRTUAL METHOD DECLARATIONS ==============
type fun: method_Animal_void {pointer_Animal} void 
type fun: method_Feline_void {pointer_Feline} void
type fun: method_Cat_void {pointer_Cat} void

# ========== VIRTUAL METHOD IMPLEMENTATIONS ==============
type fun: Animal_makeSound_impl {pointer_Animal} void
type fun: Feline_hunt_impl {pointer_Feline} void
type fun: Feline_makeSound_impl {pointer_Feline} void
type fun: Cat_makeSound_impl {pointer_Cat} void
type fun: Cat_hunt_impl {pointer_Cat} void

# ============ CLASSES DEFINITIONS ============
type class: Animal {
    virtual_methods: {
        makeSound: method_Animal_void,
    };
    implementations: {
        makeSound: Animal_makeSound_impl,
    };
}

type class: Feline {
    extends: Animal;
    virtual_methods: { 
        makeSound: method_Feline_void, # should this be a Feline pointer or a Animal pointer
        hunt: method_Feline_void,
    };
    implementations: {
        makeSound: Feline_makeSound_impl,
        hunt: Feline_hunt_impl,
    };
    # Feline OVERRIDES 'makeSound' from Animal
    # Feline INTRODUCES 'hunt'
}

type class: Cat {
    extends: Feline;
    virtual_methods: { 
        makeSound: method_Animal_void,
        hunt: method_Feline_void,
    };
    implementations: {
        makeSound: Cat_makeSound_impl,
        hunt: Cat_hunt_impl,
    };
    # Cat OVERRIDES 'makeSound' (inherited from Animal, potentially through Feline)
    # Cat OVERRIDES 'hunt' (inherited from Feline)
}

# ============ METHODS IMPLEMENTATION ============ 
# Implementation for Animal.
function Animal_makeSound_impl {
    init_lany_type x, i64;
    mov_l64_imm x, 1;
    output_l64 x; 
    deinit;
    ret;
}

# Override for Feline
function Feline_makeSound_impl { 
    init_lany_type x, i64;
    mov_l64_imm x, 2;
    output_l64 x; 
    deinit;
    ret;
}

# Implementation for Feline.
function Feline_hunt_impl { 
    init_lany_type x, i64;
    mov_l64_imm x, 3;
    output_l64 x; 
    deinit;
    ret;
}

# Override for Cat.
function Cat_makeSound_impl { 
    init_lany_type x, i64;
    mov_l64_imm x, 4;
    output_l64 x; 
    deinit;
    ret;
}

# Override for Cat.
function Cat_hunt_impl { 
    init_lany_type x, i64;
    mov_l64_imm x, 5;
    output_l64 x; 
    deinit;
    ret;
}

function main {
    init_lany_type ptr_a, pointer_Animal;   # Animal pointer.
    init_lany_type ptr_f, pointer_Feline;   # Feline pointer.

    init_lany_type actual_animal_obj, pointer_Animal;
    init_lany_type actual_feline_obj, pointer_Feline;
    init_lany_type actual_cat_obj, pointer_Cat;

    # Method Identifiers - VM needs to know how to map these to VTable slots.
    # Assume:
    # method_id_Animal_makeSound -> corresponds to the slot for Animal::makeSound
    # method_id_Feline_hunt      -> corresponds to the slot for Feline::hunt

    # --------------------- Scenario 1: Cat object, Animal* pointer --------------------------
    alloc_lptr_type actual_cat_obj, Cat;
    setVTable_lptr_type actual_cat_obj, Cat;        
    upcast_lptr_lptr ptr_a, actual_cat_obj; # ptr_a = (Animal*)actual_cat_obj; (vptr doesn't change)

    # Call Animal::makeSound. Since the actual object is Cat,
    # Cat_makeSound_impl will be called.
    virtual_call_lptr_func ptr_a, method_id_Animal_makeSound; # Expected output: 4.

    # Cannot call ptr_a->hunt(), because Animal doesn't have a hunt() method.
    # This would be a static typing error in a higher-level language.
    # virtual_call_lptr_func ptr_a, method_id_Animal_hunt;

    # ---------------------- Scenario 2: Cat object, Feline* pointer ------------------
    # Using the same actual_cat_obj from above.
    upcast_lptr_lptr ptr_f, actual_cat_obj;                     # ptr_f = (Feline*)actual_cat_obj;
    virtual_call_lptr_func ptr_f, method_id_Animal_makeSound;   # Expected output: 4
    virtual_call_lptr_func ptr_f, method_id_Feline_hunt;         # Expected output: 5


    # ---------------------- Scenario 3: Feline object, Animal* pointer ------------------
    alloc_lptr_type actual_feline_obj, Feline;
    setVTable_lptr_type actual_feline_obj, Feline; 
    upcast_lptr_lptr ptr_a, actual_feline_obj;      # ptr_a = (Animal*)actual_feline_obj;
    # Call Animal::makeSound. Actual object is Feline.
    virtual_call_lptr_func ptr_a, method_id_Animal_makeSound;   # Expected output: 2(for "General feline sound")


    # ---------------------- Scenario 4: Feline object, Feline* pointer ------------------
    #  mov_lptr_lptr ptr_f, actual_feline_obj; // or upcast from itself
    upcast_lptr_lptr ptr_f, actual_feline_obj;

    # Call Animal::makeSound. Actual object is Feline.
    virtual_call_lptr_func ptr_f, method_id_Animal_makeSound;   # Expected output: 2 (for "General feline sound")

    # Call Feline::hunt. Actual object is Feline.
    virtual_call_lptr_func ptr_f, method_id_Feline_hunt;   # Expected output: 3 (for "Feline is hunting...")

    # ---------------------- Scenario 5: Animal object, Animal* pointer ------------------
    alloc_lptr_type actual_animal_obj, Animal;
    setVTable_lptr_type actual_animal_obj, Animal;   
    # mov_lptr_lptr ptr_a, actual_animal_obj;
    upcast_lptr_lptr ptr_a, actual_animal_obj;
    virtual_call_lptr_func ptr_a, method_id_Animal_makeSound; # Expected output: 1 (for "Generic animal sound")

    ret;
}