# All methods on the inheritance path are implemented. This should pass.
type pointer: pointer_A A
type pointer: pointer_B B
type pointer: pointer_C C

type fun: method_foo {pointer_A} void
type fun: method_bar {pointer_A} void
type fun: method_goo {pointer_A} void
type fun: method_gaa {pointer_A} void

type fun: method_foo_impl {pointer_A} void
type fun: method_bar_impl {pointer_A} void
type fun: method_goo_impl {pointer_A} void
type fun: method_gaa_impl {pointer_A} void

type class: A {
    abstract: true;
    virtual_methods: {
        foo: method_foo, 
        bar: method_bar,
    };
    implementations: {
        foo: method_foo_impl, 
    };
}

type class: B {
    extends: A;
    abstract: true;
    virtual_methods: {
        foo: method_foo, 
        bar: method_bar,
        goo: method_goo,
    };
    implementations: {
        foo: method_foo_impl, 
        bar: method_bar_impl, 
    };
}

type class: C {
    extends: B;
    virtual_methods: {
        foo: method_foo, 
        bar: method_bar,
        goo: method_goo,
        gaa: method_gaa,
    };
    implementations: {
        goo: method_goo_impl, 
        gaa: method_gaa_impl, 
    };
}