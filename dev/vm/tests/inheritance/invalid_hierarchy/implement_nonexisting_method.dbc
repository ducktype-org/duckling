# Virtual method for bar() doesn't exist.
type pointer: pointer_A A
type fun: method_foo {pointer_A} void
type fun: method_bar_impl {pointer_A} void

function method_bar_impl {
    init_lany_type x, i64;
    mov_l64_imm x, 0;
    output_l64 x;
    deinit;
    ret;
}

type class: A {
    abstract: false;
    fields: {};
    virtual_methods: {
        foo: method_foo, 
    };

    implementation: {
        bar: method_bar_impl, 
    }
}
