type pointer: pointer_A A
type fun: method_foo {pointer_A} void
type fun: method_bar {pointer_A} void
type fun: method_foo_impl {pointer_A} void

function method_foo_impl {
    init_lany_type x, i64;
    mov_l64_imm x, 0;
    output_l64 x;
    deinit;
    ret;
}

type class: A {
    abstract: true;
    virtual_methods: {
        foo: method_foo, 
        bar: method_bar,
    };
    implementations: {
        foo: method_foo_impl, 
        # bar() is unimplemented in an abstract class. This should pass.
    };
}