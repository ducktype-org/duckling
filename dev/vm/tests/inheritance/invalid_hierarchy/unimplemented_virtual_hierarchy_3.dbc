# All methods on the inheritance path are implemented. This should pass.
type pointer: pointer_A A

type fun: method_aaa {pointer_A} void
type fun: method_bbb {pointer_A} void
type fun: method_ccc {pointer_A} void
type fun: method_ddd {pointer_A} void
type fun: method_eee {pointer_A} void
type fun: method_fff {pointer_A} void

type fun: method_aaa_impl {pointer_A} void
type fun: method_bbb_impl {pointer_A} void
type fun: method_ccc_impl {pointer_A} void
type fun: method_ddd_impl {pointer_A} void
type fun: method_eee_impl {pointer_A} void
type fun: method_fff_impl {pointer_A} void

type interface: I1 {
    virtual_methods: {
        aaa: method_aaa,
        bbb: method_bbb,
    };
    implementations: {
        aaa: method_aaa_impl,
    };
}

type interface: I2 {
    virtual_methods: {
        ccc: method_ccc,
        ddd: method_ddd,
    };
    implementations: {
        ccc: method_ccc_impl,
    };
}

type class: A {
    abstract: true;
    fields: {};
    virtual_methods: {
        eee: method_eee, 
        fff: method_fff,
    };
    implementation: {
        eee: method_eee_impl, 
    }
}

type class: B {
    extends: A;
    abstract: false;
    implements: {I1, I2};
    fields: {};
    virtual_methods: {
        # First methods from the superclass are defined in the same order.
        # Then methods from interfaces in the order they are implemented -> I1.
        # Then methods from interfaces in the order they are implemented -> I2.

        eee: method_eee         # Implemented in A
        fff: method_fff         # Not implemented
        aaa: method_aaa         # Implemented in I1
        bbb: method_bbb         # Not implemented.
        ccc: method_ccc         # Implemented in I2
        ddd: method_ddd         # Not implemented.
    };
    implementation: {
        fff: method_fff_impl,
        # bbb: method_bbb_impl, # bbb() is unimplemented in an instantiable class.
        ddd: method_ddd_impl,
        aaa: method_aaa_impl, # Override implementation.
    };
}