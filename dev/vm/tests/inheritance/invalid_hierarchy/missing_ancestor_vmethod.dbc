type pointer: pointer_widget Widget
type fun: method_foo_widget {pointer_widget, i64} i64
type fun: method_bar_widget {pointer_widget} i64

type class: Widget {
    abstract: true;
    virtual_methods: {
        foo: method_foo_widget,
        bar: method_foo_widget,
    };
}

type class: Button {
    extends: Widget;
    virtual_methods: {
        foo: method_foo_widget,
        # Oh no, where is bar()
        # bar: method_foo_widget,
    };
}
