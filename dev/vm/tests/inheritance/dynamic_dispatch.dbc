type pointer: pointer_Shape Shape
type pointer: pointer_Line Line
type pointer: pointer_Triangle Triangle
type pointer: pointer_Rectangle Rectangle

type fun: method_Shape_void {pointer_Shape} void

type class: Shape {
    abstract: false;
    fields: {};
    virtual_methods: {
        vertexCount: method_Shape_void, // Metoda wirtualna
    };
    implementation: {
        vertexCount: Shape_vertexCount_impl 
    }
}

type fun: Shape_vertexCount_impl {pointer_Shape} void
function Shape_vertexCount_impl {
    init_lany_type count, i64;
    mov_l64_imm count, 0;
    output_l64 count;
    deinit;
    ret;
}

type class: Line {
    extends: Shape;
    abstract: false;
    implements: {};
    fields: {
        length: i64,
    };

    // Circle NADPISUJE (overrides) metodę 'draw' z Shape
    // VM musi wiedzieć, że funkcja 'Circle_draw_impl' jest implementacją 'Shape::draw' dla Circle
}

type class: Rectangle {
    extends: Shape;
    abstract: false;
    implements: {};
    fields: {
        width: i64,
        height: i64,
    };
    // Rectangle NADPISUJE (overrides) metodę 'draw' z Shape
    // VM musi wiedzieć, że funkcja 'Rectangle_draw_impl' jest implementacją 'Shape::draw' dla Rectangle
}

type class: Triangle {
    extends: Shape;
    abstract: false;
    implements: {};
    fields: {
        arm1_length: i64,
        arm2_length: i64,
        angle: i64,
    };
    // Triangle NADPISUJE (overrides) metodę 'draw' z Shape
    // VM musi wiedzieć, że funkcja 'Triangle_draw_impl' jest implementacją 'Shape::draw' dla Triangle
}

function Shape_vertexCount_impl {
    init_lany_type count, i64;
    mov_l64_imm count, 0;
    output_l64 count;
    deinit;
    ret;
}

function Line_vertexCount_impl {
    init_lany_type count, i64;
    mov_l64_imm count, 2;
    output_l64 count;
    deinit;
    ret;
}

function Triangle_vertexCount_impl {
    init_lany_type count, i64;
    mov_l64_imm count, 3;
    output_l64 count;
    deinit;
    ret;
}

function Rectangle_vertexCount_impl {
    init_lany_type count, i64;
    mov_l64_imm count, 4;
    output_l64 count;
    deinit;
    ret;
}

function main {
    init_lany_type shape_var, pointer_Shape;    // Wskaźnik bazowy
    init_lany_type line_obj, pointer_Line;  // Pomocniczy dla alokacji
    init_lany_type tri_obj, pointer_Triangle;  // Pomocniczy dla alokacji
    init_lany_type rect_obj, pointer_Rectangle; // Pomocniczy dla alokacji
    init_lany_type shape_obj, pointer_Shape;

    # 1) Call to Shape vertex count.
    alloc_lptr_type shape_obj, Shape;
    setVTable_lptr_type shape_obj, Shape; 
    mov_lptr_lptr shape_var, shape_obj;
    virtual_call_lptr_func shape_var, method_id_Shape_draw; // Powinno wywołać Shape_draw_impl

    # 2) Call to Line vertex count.
    alloc_lptr_type line_obj, Line;         // circle_obj wskazuje na nową instancję Circle
    setVTable_lptr_type line_obj, Line;     // Ustawia vptr w *circle_obj na VTable klasy Circle
    upcast_lptr_lptr shape_var, line_obj;     // shape_var = (Shape*)circle_obj;

    # 4. Wywołaj metodę wirtualną 'draw'
    #    VM musi wiedzieć, że 'draw' to np. pierwsza metoda wirtualna w VTable Shape.
    #    Potrzebujemy identyfikatora metody, np. globalnego ID lub pary (TypDefiniujący, NazwaMetody).
    #    Załóżmy, że `method_id_Shape_draw` to identyfikator `Shape::draw`.
    #    Instrukcja `virtual_call` robi:
    #      a. Pobierz vptr z obiektu wskazywanego przez shape_var.
    #      b. Użyj vptr do znalezienia adresu VTable.
    #      c. Użyj method_id_Shape_draw (i metadanych Shape) do znalezienia offsetu/indeksu metody 'draw' w VTable.
    #      d. Pobierz adres funkcji z VTable[offset_draw].
    #      e. Wywołaj tę funkcję, przekazując shape_var jako 'this'.
    virtual_call_lptr_func shape_var, method_id_Shape_draw; // Powinno wywołać Circle_draw_impl


    # 3) Call to triangle vertex count.
    alloc_lptr_type tri_obj, Triangle;
    setVTable_lptr_type tri_obj, Triangle;
    upcast_lptr_lptr shape_var, tri_obj;       // shape_var teraz wskazuje na obiekt Triangle.
    virtual_call_lptr_func shape_var, method_id_Shape_draw; // Powinno wywołać Rectangle_draw_impl

    # 4) Call to Rectangle vertex count.
    alloc_lptr_type rect_obj, Rectangle;
    setVTable_lptr_type rect_obj, Rectangle;
    upcast_lptr_lptr shape_var, rect_obj;       // shape_var teraz wskazuje na obiekt Rectangle
    virtual_call_lptr_func shape_var, method_id_Shape_draw; // Powinno wywołać Rectangle_draw_impl

    deinit; # shape_obj
    deinit; # rect_obj
    deinit; # tri_obj
    deinit; # line_obj
    deinit; # shape_var
    ret;
}