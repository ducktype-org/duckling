type primitive: i8 1
type variant: simple_variant { i64, i8 }

function main {
    init_lany_type v1, simple_variant;
    variantSetInner_lvnt_type v1, i64;

    init_lany_type value, i64;
    input_l64 value;

    init_lany_type ptr, ptr_i64;
    variantGetInner_lptr_lvnt ptr, v1;
    ext_type i64;

    store_lptr_lany ptr, value;
    ext_type i64;

    deinit; # ptr

    init_lany_type new_ptr, ptr_i64;
    variantGetInner_lptr_lvnt new_ptr, v1;
    ext_type i64;

    mov_l64_imm value, 0;
    load_lany_lptr value, new_ptr;
    ext_type i64;

    output_l64 value;

    ret;
}
