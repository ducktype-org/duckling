type fun: spring { i64, i64 } i64
function spring {
    # For given a, b calculates a * (a+b)

    mov_l64_l64 ret_val, arg0;
    init_lany_type sum_ret_val, i64;
    init_lany_type sum_a0, i64;
    init_lany_type sum_a1, i64;
    mov_l64_l64 sum_a0, arg0;
    mov_l64_l64 sum_a1, arg1;
    call_func summer;
    mul_l64_l64 ret_val, sum_ret_val;
    deinit; # sum_ret_val
    deinit; # arg1
    deinit; # arg0 
    ret;
}

type fun: summer { i64, i64 } i64
function summer {
    mov_l64_l64 ret_val, arg0;
    add_l64_l64 ret_val, arg1;
    deinit;
    deinit;
    ret;
}

type fun: hello {} void

function hello {
    init_lany_type x, i64;
    input_l64 x;
    add_l64_imm x, 1;
    output_l64 x;
    deinit;
    ret;
}