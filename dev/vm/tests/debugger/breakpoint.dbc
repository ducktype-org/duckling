function main {
	# [0, 8) main ret_val
	# [8, 16) -> argc
    # [16, 32) -> *argv

	init_type 		i64; # [32, 40) a
	init_type 		i64; # [40, 48) b
	init_type 		i64; # [48, 56) c
	mov_l64_imm  	32, 0;
	mov_l64_imm  	40, 0;
	breakpoint;
	mov_l64_imm  	32, 0;
	mov_l64_imm  	40, 0;
	mov_l64_imm 	48, 0;
	breakpoint;

	deinit; # c
	deinit; # b
	deinit; # a
	deinit; # *argv
	deinit; # argc
	ret;
}
