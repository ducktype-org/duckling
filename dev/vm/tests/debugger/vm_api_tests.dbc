type static_table: tablei64 i64 42

function main {
		# ret_val -> main ret_val
		# arg0 -> argc
		# arg1 -> *argv

	init_lany_type     x, i64;
	input_l64          x;
	mov_l64_imm        x, 1;
	deinit; # x
	
	init_lany_type     y, i64;
	output_l64         y;
	deinit; # y

	deinit; # *argv
	deinit; # argc

	ret;
}
