type fun: main {} i64

function main {
	# [0, 8) main ret_val
	init_type 		i64;
	init_type 		i64;
	init_type 		i64;

	mov_l64_imm   8, 10;
	mov_l64_imm   16, 0;
	mov_l64_imm   24, 1;

	label Loop;

	output_l64       16;
	add_l64_l64      16, 24;

	cmpEq_l64_l64    16, 8;
	jmpIfNot_label Loop;

	deinit;
	deinit;
	deinit;
	ret;
}
