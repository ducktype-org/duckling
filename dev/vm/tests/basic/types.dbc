type primitive: int64 8
type primitive: in64 8
type pointer: ptr_int64 int64

function main {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

    init_lany_type x, int64;
    init_lany_type y, in64;
    
    input_l64 x;
    input_l64 y;
    add_l64_l64 x, y;
