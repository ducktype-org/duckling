type primitive: int64 8
type pointer: p64 int64
type pointer: pp64 p64
type fun: main {} int64

function main {
    arg_size: 0;
    ret_size: 8;

    local_size: 56;

    code: {
        # [0, 8) main ret_val
        init_type int64;           # [8, 16) x
        init_type int64;           # [16, 24) y
        init_type p64;             # [24, 40) p

        # First let's check if it works for ints.
        ref_lptr_any 24, 8;        # p := &x
        mov_l64_imm 16, 42;         # y := 42
        store_lptr_l64_ofs 24, 16;  # *p := y
        output_l64 8;              # print(x)

        init_type pp64;            # [40, 56) q
        ref_lptr_any 40, 24;       # q := &p
        # There are no instructions to check if that worked,
        # so let's for now just check if it doesn't panic.
        deinit;                    # q
        deinit;                    # p
        deinit;                    # y
        deinit;                    # x

        ret;
    }
}
