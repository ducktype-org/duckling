type primitive: int64 8
type pointer: p64 int64
type pointer: pp64 p64

function main {
    arg_size: 0;
    next_arg_size: 0;
    ret_size: 0;
    
    # x - 0
    # y - 8
    # p - 16
    local_size: 48;
    
    code: {
        init_type int64;           # x
        init_type int64;           # y
        init_type p64;             # p

        # First let's check if it works for ints.
        ref_lptr_any 16, 0;        # p := &x
        mov_l64_imm 8, 42;         # y := 42
        store_lptr_l64_ofs 16, 8;  # *p := y
        output_l64 0;              # print(x)

        init_type pp64;            # q
        ref_lptr_any 32, 16;       # q := &p
        # There are no instructions to check if that worked,
        # so let's for now just check if it doesn't panic.
        deinit;                    # q
        deinit;                    # p
        deinit;                    # y
        deinit;                    # x

        ret_imm 0;
    }
}
