function main {
    # [0, 8) ret_val
    # [8, 16) argc
    # [16, 32) *argv

    init_type i64;           # [32, 40) x
    init_type i64;           # [40, 48) y
    init_type ptr_i64;       # [48, 64) p

    # First let's check if it works for ints.
    ref_lptr_any 48, 32;         # p := &x
    mov_l64_imm 40, 42;          # y := 42
    store_lptr_l64_ofs 48, 40;   # *p := y
    output_l64 32;               # print(x)

    init_type ptr_i64;          # [64, 80) q
    ref_lptr_any 64, 48;        # q := &p
    # There are no instructions to check if that worked,
    # so let's for now just check if it doesn't panic.
    deinit;                     # q
    deinit;                     # p
    deinit;                     # y
    deinit;                     # x
    deinit; # *argv
    deinit; # argc
    ret;
}
