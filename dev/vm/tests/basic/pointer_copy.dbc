function main {
    # [0, 8) ret_val
    # [8, 16) argc
    # [16, 32) *argv

    init_type           i64;        # [32, 40) x
    init_type           i64;        # [40, 48) y
    init_type           ptr_i64;    # [48, 64) p
    init_type           ptr_i64;    # [64, 80) q
    init_type           ptr_i64;    # [80, 96) r

    ref_lptr_any        48, 32;     # p := &x

    # from null to non-null
    mov_lptr_lptr       64, 48;     # q = p

    mov_l64_imm         40, 42;     # y = 42
    store_lptr_l64_ofs  64, 40;     # *q := y
    output_l64          32;         # print(x)

    # from non-null to null
    mov_lptr_lptr       48, 80;     # p = r

    deinit; # r
    deinit; # q
    deinit; # p
    deinit; # y
    deinit; # x
    deinit; # *argv
    deinit; # argc
    ret;
}
