type primitive: int64 8
type pointer: p64 int64

function main {
    arg_size: 0;
    next_arg_size: 0;
    ret_size: 0;
    
    # x - 0
    # y - 8
    # p - 16
    # q - 32
    # r - 48
    local_size: 64;
    
    code: {
        init_type int64;           # x
        init_type int64;           # y
        init_type p64;             # p
        init_type p64;             # q
        init_type p64;             # r

        ref_lptr_any 16, 0;        # p := &x
        # from null to non-null
        mov_lptr_lptr 32, 16;      # q = p
        
        mov_l64_imm 8, 42;         # y = 42
        store_lptr_l64_ofs 32, 8;  # *q := y
        output_l64 0;              # print(x)


        # from non-null to null
        mov_lptr_lptr 16, 48;      # p = r

        deinit;                    # r
        deinit;                    # q
        deinit;                    # p
        deinit;                    # y
        deinit;                    # x

        ret_imm 0;
    }
}
