type fun: main { i64, ptr_argv } i64

function main {
    # ret_val - 0
    # x - 8
    # y - 16
    # p - 24
    # q - 40
    # r - 56

    init_type i64;            # x
    init_type i64;            # y
    init_type ptr_i64;              # p
    init_type ptr_i64;              # q
    init_type ptr_i64;              # r

    ref_lptr_any 24, 8;         # p := &x
    # from null to non-null
    mov_lptr_lptr 40, 24;       # q = p

    mov_l64_imm 16, 42;         # y = 42
    store_lptr_l64_ofs 40, 16;  # *q := y
    output_l64 8;               # print(x)


    # from non-null to null
    mov_lptr_lptr 24, 56;       # p = r

    deinit;                     # r
    deinit;                     # q
    deinit;                     # p
    deinit;                     # y
    deinit;                     # x

    ret;
}
