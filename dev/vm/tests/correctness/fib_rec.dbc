type primitive: int64 8

function fib {
    arg_size: 8;
	next_arg_size: 8;
    ret_size: 8;

    # n - 8

    local_size: 32;

    code: {
        # n := argument

        # [0, 8) ret_val
        # [8, 16) arg0
        # output_l64          8;

        mov_l64_l64         0, 8;
        
        # if !(n > 1): end
        cmpG_l64_imm        8, 1;
        jmpRelNotIf_label   End;

        # fib(n - 1)
        init_type int64; # [16, 24) fib(n-1) ret_val
        init_type int64; # [24, 32) fib(n-1) arg0
        mov_l64_l64         24, 8;
        sub_l64_imm         24, 1;
        call_func           fib;

        mov_l64_l64         0, 16;

        # fib(n - 2)
        sub_l64_imm         24, 1;
        call_func           fib;


        # (fib(n - 1) + fib(n - 2)) % mod
        add_l64_l64         0, 16;
        mod_l64_imm         0, 8388449;

        label               End;

        ret;
    }
}

function main {
    arg_size: 0;
	next_arg_size: 8;
    ret_size: 8;

    # n - 8

    local_size: 16;

    code: {
        # n := argument
        init_type           int64; # [0, 8) fib() ret_val
        init_type           int64; # [8, 16) fib() arg0
        input_l64          8;

        call_func          fib;

        output_l64      0;
        ret;
    }
}
