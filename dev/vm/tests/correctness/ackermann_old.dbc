type primitive: int64 8

function ackermann {
    arg_size: 16;
    arg_count: 2;
    ret_size: 8;

    # m, nPtr
    local_size: 32;
    code: {
        # [0, 8) -> ret_val
        # [8, 16) -> arg0 -> m
        # [16, 24) -> arg1 -> nPtr

        init_type           int64;      # [24, 32) n
        load_l64_lptr_ofs   24, 16;     # n = *nPtr 

        # if m == 0
        cmpEq_l64_imm       8, 0;
        jmpRelIf_label      M0;

        # if n == 0
        cmpEq_l64_imm       24, 0;
        jmpRelIf_label      N0;

        # m, n > 0
        # return A(m-1, A(m, n-1))
        init_type           int64;      # [32, 40) A(m, n-1) ret_val
        init_type           int64;      # [40, 48) A(m, n-1) arg0 -> m
        init_type           int64;      # [48, 56) A(m, n-1) arg1 -> nPtr

        mov_l64_l64         40, 8;      # arg0 := m
        sub_l64_imm         24, 1;      # n := n-1
        alloc_lptr_type     48, int64;  # arg1 := alloc *int64
        store_lptr_l64_ofs  48, 24;     # arg1 := &n

        call_func           ackermann;  # A(m, n-1)
        mov_l64_l64         24, 32;     # n := A(m, n-1) (n used as a temp store)

        # [40, 48) and [48, 56) are deinitialized here

        free_lptr           48;

        init_type           int64;      # [40, 48) A(m-1, A(m, n-1)) arg0 -> m
        init_type           int64;      # [48, 56) A(m-1, A(m, n-1)) arg1 -> nPtr
        sub_l64_imm         8, 1;       # m := m-1
        mov_l64_l64         40, 8;      # arg0 := m
        alloc_lptr_type     48, int64;  # arg1 := alloc *int64
        store_lptr_l64_ofs  48, 24;     # arg1 := &A(m, n-1)
        call_func           ackermann;  # A(m-1, A(m, n-1))

        # [40, 48) and [48, 56) are deinitialized here

        free_lptr           48;
        mov_l64_l64         0, 32;      # ret_val = A(m-1, A(m, n-1))
        deinit; # A() ret_val
        deinit; # n
        deinit; # arg1
        deinit; # arg0
        ret;

        label N0;
        # return A(m-1, 1)
        init_type           int64;      # [32, 40) A(m-1, 1) ret_val
        init_type           int64;      # [40, 48) A(m-1, 1) arg0 -> m
        init_type           int64;      # [48, 56) A(m-1, 1) arg1 -> nPtr

        sub_l64_imm         8, 1;       # m := m-1
        mov_l64_l64         40, 8;      # arg0 := m
        mov_l64_imm         24, 1;      # n := 1
        alloc_lptr_type     48, int64;  # arg1 := alloc *int64
        store_lptr_l64_ofs  48, 24;     # arg1 := &n
        call_func           ackermann;  # A(m-1, 1)

        free_lptr           48;

        mov_l64_l64         0, 32;      # ret_val = A(m-1, A(m, n-1))
        
        deinit; # A() ret_val
        deinit; # n
        deinit; # arg1
        deinit; # arg0
        ret;

        label M0;
        # return n+1
        add_l64_imm         24, 1;      # n := n+1
        mov_l64_l64         0, 24;      # ret := n

        deinit; # n
        deinit; # arg1
        deinit; # arg0
        ret;
    }
}

function main {
    arg_size: 0;
    arg_count: 0;
    ret_size: 8;
    local_size: 40;

    code: {
        init_type           int64;      # [0, 8) main ret_val
        init_type           int64;      # [8, 16) temp
        init_type           int64;      # [16, 24) ackermann ret_val
        init_type           int64;      # [24, 32) ackermann arg0 -> m
        init_type           int64;      # [32, 40) ackermann arg2 -> nPtr

        input_l64           24;         # arg0 := m
        input_l64           8;          # temp := n
        alloc_lptr_type     32, int64;  # arg1 := alloc *int
        store_lptr_l64_ofs  32, 8;      # arg1 = &n

        call_func           ackermann;  # A(m, n, nPtr)

        free_lptr           32; # I think this is invalid bytecode, but works for now.
        output_l64          16;

        deinit; # A() ret_val
        deinit; # temp
        ret;
    }
}
