# For a given x the program calculates a collatz sequence 
# for each number from [1, x) and returns a maximum value
# reached in any of this sequences.
# For example, for x = 4:
# collatz(1) -> [1], max is 1
# collatz(2) -> [2, 1], max is 2.
# collatz(3) -> [3, 10, 5, 16, 8, 4, 2, 1], max is 16.
# Thus, the program should output 16.

type primitive: int64 8
type fun: main {} int64
type fun: collatz { int64 } int64


function collatz {
	arg_size: 8;
	ret_size: 8;
	local_size: 32;

	# ret_val - 0
	# n - 8 (value for which the collatz sequence is calculated)
	# max - 16 (maximum value in the caltulated collatz sequence)
	# tmp - 24

	code: {
		# [0, 8) ret_val
		# [8, 16) arg0 -> n

		init_type		int64; # [16, 24) max
		init_type		int64; # [24, 32) tmp
		
		mov_l64_l64		16, 8; # max := n

		# if n == 1: end
		cmpEq_l64_imm         8, 1;
		jmpRelIf_label        End;

		# do-while (n != 1):
		label WhileNneq0;
			# if n % 2 == 0:

			# if condition:
				mov_l64_l64         24, 8; # tmp := n
				mod_l64_imm         24, 2; # tmp %= 2
				cmpEq_l64_imm       24, 0;
				jmpRelIf_label      else;

			# if code:
				# n = 3n + 1;
				mul_l64_imm		    8, 3;
				add_l64_imm         8, 1;
				jmpRel_label        afterIf;

			# else
				label else;

				# else code:
					# n = n / 2
					div_l64_imm  8, 2;

			label afterIf;

			# if n > max:
			cmpG_l64_l64     	8, 16;
			cmov_l64_l64     	16, 8; # max := n

			# if n == 1
			cmpEq_l64_imm       8, 1;
			jmpRelNotIf_label   WhileNneq0;

			# cmpG_l64_imm       8, 1;
			# jmpRelIf_label   WhileNneq0;

		label End;

		# return max
		mov_l64_l64 	0, 16; # ret_val := max
		
		deinit; # tmp
		deinit; # max
		deinit; # arg0
		ret;
	}
}


function main {
	arg_size: 0;
	ret_size: 8;
	local_size: 56;

	# x - 8
	# max - 16
	# i - 24
	# tmp - 32
	code: {
		# [0, 8) main ret_val
		init_type 		int64; 	# [8, 16) x
		init_type 		int64; 	# [16, 24) max
		init_type 		int64; 	# [24, 32) i
		init_type 		int64; 	# [32, 40) tmp

		input_l64       8; 		# x := input
		mov_l64_imm     16, 0; 	# max := 0
		mov_l64_imm     24, 1; 	# i := 1

		# do-for (i < x; i++)
		label Loop;
			# tmp := collatz(i)
			init_type 			int64; 		# [40, 48) collatz(i) ret_val
			init_type 			int64; 		# [48, 56) collatz(i) arg0
			
			mov_l64_l64 		48, 24;		# arg0 := i
			call_func          	collatz;
			mov_l64_l64 		32, 40; 	# tmp := collatz(i)
			deinit; 						# deinit collatz(i) ret_val

			# if tmp > max:
			cmpG_l64_l64       	32, 16;
			jmpRelNotIf_label  	EndIF;
				mov_l64_l64    	16, 32; 	# max := tmp

			label EndIF;

			add_l64_imm      	24, 1; 		# i := i + 1

			# if x > i : end
			cmpG_l64_l64     	8, 24;
			jmpRelIf_label   	Loop;

		output_l64      16;

		# return i
		mov_l64_l64		0, 24;

		deinit; # tmp
		deinit;	# i
		deinit;	# max
		deinit;	# x
		ret;
	}

}
