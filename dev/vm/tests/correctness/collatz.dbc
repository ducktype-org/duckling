type primitive: int64 8

function collatz {
	arg_size: 8;
	next_arg_size: 0;
	ret_size: 8;

	# ret_val - 0
	# n - 8
	# j - 16
	# tmp1 - 24
	local_size: 32;

	code: {
		# [0, 8) ret_val
		# [8, 16) arg0

		# j := 0
		init_type		int64; # [16, 24)
		mov_l64_imm		16, 0;

		# if n == 1: end
		cmpEq_l64_imm         8, 1;
		jmpRelIf_label        End;

		# do-while (n != 1):
		label WhileNneq0;

			# if n % 2 == 0:

			# if condition:
				# tmp := n
				init_type			int64; # [24, 32)
				mov_l64_l64         24, 8;

				# tmp %= 2
				mod_l64_imm         24, 2;
				cmpEq_l64_imm       24, 0;
				jmpRelIf_label      else;

			# if code:
				# n = 3n + 1;
				mul_l64_imm		    8, 3;
				add_l64_imm         8, 1;
				jmpRel_label        afterIf;

			# else
				label else;

				# else code:
					# n = n / 2
					div_l64_imm  8, 2;

			label afterIf;

			# if n > j: # j := n
			cmpG_l64_l64     	8, 16;
			cmov_l64_l64     	16, 8;

			cmpEq_l64_imm       8, 1;
			jmpRelNotIf_label   WhileNneq0;

		label End;

		# return j
		mov_l64_l64 	0, 16;
		ret;
	}
}


function main {
	arg_size: 0;
	next_arg_size: 8;
	ret_size: 0;

	# x - 0
	# s - 8
	# i - 16
	# tmp - 24
	local_size: 48;

	code: {
		init_type 		int64; # [0, 8) x
		init_type 		int64; # [8, 16) s
		init_type 		int64; # [16, 24) i
		init_type 		int64; # [24, 32) tmp

		# x := input
		input_l64       0;

		# s := 0
		mov_l64_imm     8, 0;

		# i := 1
		mov_l64_imm     16, 1;

		# do-for (x > i; i++)
		label Loop;
			# output_l64         16;

			# tmp := collatz(i)

			init_type int64; # [32, 40) collatz(i) ret_val
			init_type int64; # [40, 48) collatz(i) arg0
			mov_l64_l64 		40, 16;
			call_func          	collatz;
			mov_l64_l64 		24, 32; # tmp := collatz(i)

			# if tmp > s:
			cmpG_l64_l64       24, 8;
			jmpRelNotIf_label  EndIF;
				mov_l64_l64    8, 24;

			label EndIF;

			# i++;
			add_l64_imm      16, 1;

			# output_l64       0;
			# output_l64       16;
			# if x > i : end
			cmpG_l64_l64     0, 16;
			jmpRelIf_label   Loop;

		output_l64      8;

		ret;
	}

}
