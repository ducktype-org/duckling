type fun: main { i64, ptr_argv } i64
type fun: dummy { i64 } i64

function dummy {
	# [0, 8) ret_val
	# [8, 16) arg0 -> n

	# if arg0 == 0: end
	cmpEq_l64_imm     8, 0;
	jmpRelIf_label    End;

	sub_l64_imm       8, 1;
	ret_tailcall_func      dummy;

	label End;

	mov_l64_l64       0, 8;

	deinit; # arg0
	ret;
}


function main {
	# [0, 8) main ret_val
	init_type i64; # [8, 16) dummy ret_val
	init_type i64; # [16, 24) dummy arg0

	input_l64          16; # arg0 := input
	call_func          dummy;

	output_l64         8;

	deinit; # dummy ret_val
	ret;
}
