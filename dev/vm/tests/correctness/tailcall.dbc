type fun: dummy { i64 } i64

function dummy {
	# [0, 8) ret_val
	# [8, 16) arg0 -> n

	# if arg0 == 0: end
	cmpEq_l64_imm     8, 0;
	jmpIf_label    End;

	sub_l64_imm       8, 1;
	ret_tailcall_func      dummy;

	label End;

	mov_l64_l64       0, 8;

	deinit; # arg0
	ret;
}


function main {
	# [0, 8) main ret_val
	# [8, 16) -> argc
    # [16, 32) -> *argv

	init_type i64; # [32, 40) dummy ret_val
	init_type i64; # [48, 48) dummy arg0

	input_l64          40; # arg0 := input
	call_func          dummy;

	output_l64         32;

	deinit; # dummy ret_val
    deinit;       # *argv
    deinit;       # argc
	ret;
}
