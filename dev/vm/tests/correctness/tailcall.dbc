type primitive: int64 8

type fun: main {} int64
type fun: dummy { int64 } int64


function dummy {
  arg_size: 8;
  arg_count: 1;
  ret_size: 8;
  local_size: 16;

  code: {
    # [0, 8) ret_val
    # [8, 16) arg0 -> n

    # if arg0 == 0: end
    cmpEq_l64_imm     8, 0;
    jmpRelIf_label    End;

    sub_l64_imm       8, 1;
    ret_tailcall      dummy;

    label End;

    mov_l64_l64       0, 8;
    
    deinit; # arg0
    ret;
  }
}


function main {
  arg_size: 0;
  arg_count: 0;
  ret_size: 8;
  local_size: 24;

  code: {
    # [0, 8) main ret_val
    init_type int64; # [8, 16) dummy ret_val
    init_type int64; # [16, 24) dummy arg0

    input_l64          16; # arg0 := input
    call_func          dummy;

    output_l64         8;

    deinit; # dummy ret_val
