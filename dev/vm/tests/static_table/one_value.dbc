type primitive: int64 8
type static_table: tableint64 int64 4

function main {
  arg_size: 0;
  arg_count: 0;
  ret_size: 0;

  # x - 0
  # i - 8
  # arrPtr - 16
  local_size: 48;

  code: {
    init_type           int64;          # [0, 8) main ret_val
    init_type           int64;          # [8,16)  # x
    init_type           int64;          # [16,24) # i
    init_type           int64;          # [24,32) # arrPtr 
    
    alloc_lptr_type     24, tableint64; # arrPtr := alloc *int[]
    mov_l64_imm         16, 0;          # i := 0
    mov_l64_imm         8, 3;           # x := 3

    # t[i] := x (by i)
    store_lptr_l64_ofs  24, 8;          # t[i] := x
    ext_l64             16;

    mov_l64_imm         8, 5;           # x := 5

    load_l64_lptr_ofs   0, 24;
    ext_l64             16;

    output_l64          16;

    free_lptr           24;

    deinit;
    deinit;
    deinit;

    ret;
  }

}
