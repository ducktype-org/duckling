type static_table: tablei64 i64 4
type fun: main { i64, ptr_argv } i64

function main {
	# [0, 8) main ret_val
	init_type           i64;          # [8,16)  # x
	init_type           i64;          # [16,24) # i
	init_type           i64;          # [24,32) # arrPtr

	alloc_lptr_type     24, tablei64; # arrPtr := alloc *int[]
	mov_l64_imm         16, 0;          # i := 0
	mov_l64_imm         8, 3;           # x := 3

	# t[i] := x (by i)
	store_lptr_l64_ofs  24, 8;          # t[i] := x
	ext_l64             16;

	mov_l64_imm         8, 5;           # x := 5

	load_l64_lptr_ofs   0, 24;
	ext_l64             16;

	output_l64          16;

	free_lptr           24;

	deinit;
	deinit;
	deinit;

	ret;
}
