type static_table: tablei64 i64 4
type fun: main { i64, ptr_argv } i64

function main {
	# [0, 8) main ret_val
	# [8, 16) argc
	# [16, 32) *argv

	init_type           i64;          # [32,40) # x
	init_type           i64;          # [40,48) # i
	init_type           i64;          # [48,56) # arrPtr

	alloc_lptr_type     48, tablei64; # arrPtr := alloc *int[]
	mov_l64_imm         40, 0;        # i := 0
	mov_l64_imm         32, 3;        # x := 3

	# t[i] := x (by i)
	store_lptr_l64_ofs  48, 32;       # t[i] := x
	ext_l64             40;

	mov_l64_imm         32, 5;        # x := 5

	load_l64_lptr_ofs   0, 48;
	ext_l64             40;

	output_l64          40;

	free_lptr           48;

	deinit;
	deinit;
	deinit;
	free_lptr   16; # free argv table
	deinit; # *argv
	deinit; # argc

	ret;
}
