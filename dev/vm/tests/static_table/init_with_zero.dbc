type static_table: tablei64 i64 2

function main {
    # [0, 8) main ret_val
    # [8, 16) argc
    # [16, 32) *argv

	init_type           i64; # [32, 40) x
	init_type           i64; # [40, 48) i
	init_type           i64; # [48, 56) y
	init_type           i64; # [56, 64) t

	mov_l64_imm         56, 42;
	mov_l64_imm         64, 42;

	alloc_lptr_type     56, tablei64;

	# x := t[0]
	mov_l64_imm         40, 0;
	load_l64_lptr_ofs   32, 56;
	ext_l64             40;

	mov_l64_l64         48, 32;

	# x := t[1]
	mov_l64_imm         40, 1;
	load_l64_lptr_ofs   32, 56;
	ext_l64             40;

	add_l64_l64         48, 32;

	output_l64          48;

	free_lptr           56;

	deinit;
	deinit;
	deinit;
	deinit;
	deinit; # *argv
	deinit; # argc
	ret;
}