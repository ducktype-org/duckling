type primitive: int64 8
type static_table: tableint64 int64 2
type fun: main {} int64

function main {
	# x - 0
	# i - 8
	# y - 16
	# t - 24

	# [0, 8) main ret_val
	init_type           int64; # [8, 16) x
	init_type           int64; # [16, 24) i
	init_type           int64; # [24, 32) y
	init_type           int64; # [32, 40) t

	mov_l64_imm         32, 42;
	mov_l64_imm         40, 42;

	alloc_lptr_type     32, tableint64;

	# x := t[0]
	mov_l64_imm         16, 0;
	load_l64_lptr_ofs   8, 32;
	ext_l64             16;

	mov_l64_l64         24, 8;

	# x := t[1]
	mov_l64_imm         16, 1;
	load_l64_lptr_ofs   8, 32;
	ext_l64             16;

	add_l64_l64         24, 8;

	output_l64          24;

	free_lptr           32;

	deinit;
	deinit;
	deinit;
	deinit;

	ret;
}
