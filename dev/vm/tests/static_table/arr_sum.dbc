type static_table: tablei64 i64 42
type fun: main { i64, ptr_argv } i64

function main {
    # [0, 8) main ret_val
    # [8, 16) argc
    # [16, 32) *argv

	init_type i64; # [32, 40) x
	init_type i64; # [40, 48) i
	init_type i64; # [48, 56) y
	init_type i64; # [56, 64) t

	# alloc t[42]
	alloc_lptr_type 56, tablei64;

	# i := 41
	mov_l64_imm         40, 42;

	# x := 1
	mov_l64_imm         32, 1;

	# populate table t with 1..42 sequence
	# while(x > 0)
	label Loop1;
		# i--
		sub_l64_imm         40, 1;

		# t[i] := x (by idx)
		store_lptr_l64_ofs  56, 32;
		ext_l64             40;

		# x++
		add_l64_imm         32, 1;

		# if i > 0 : end
		cmpG_l64_imm        40, 0;
		jmpRelIf_label      Loop1;

	# sum the sequence

	# i := 41
	mov_l64_imm         40, 42;

	# y := 0
	mov_l64_imm         48, 0;

	label Loop2;
		# i--
		sub_l64_imm         40, 1;

		load_l64_lptr_ofs   32, 56;
		ext_l64             40;

		# y += x
		add_l64_l64         48, 32;

		# if i > 0 : end
		cmpG_l64_imm        40, 0;
		jmpRelIf_label      Loop2;


	# should return 42*(42+1)/2=903
	output_l64          48;

	# free t
	free_lptr           56;

	deinit; # t
	deinit; # y
	deinit; # i
	deinit; # x
    free_lptr   16; # free argv table
    deinit; # *argv
    deinit; # argc

	ret;
}