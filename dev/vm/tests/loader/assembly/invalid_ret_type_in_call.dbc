# Checks verifying the type of ret_val space initialized by the caller on call.
type fun: check { i64 } i32

function check {
    mov_l32_imm     ret_val, 42;
    ret;
}

function main {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv
    
    init_lany_type      check_arg0, i64;
    mov_l64_imm         check_arg0, 30;
    call_func           check;

    mov_l64_imm         ret_val, 42;
	
    deinit;             # *argv
    deinit;             # argc
    ret;
}