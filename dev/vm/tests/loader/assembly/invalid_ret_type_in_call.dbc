# Checks verifying the type of ret_val space initialized by the caller on call.
type fun: main { i64, ptr_argv } i64
type fun: check { i64 } i32

function check {
    mov_l32_imm     0, 42;
    ret;
}

function main {
    # [0, 8) main ret_val
    # [8, 16) argc
    # [16, 32) *argv
    
    init_type           i64; # [32, 40) check() arg0
    mov_l64_imm         32, 30;
    call_func           check;

    mov_l64_imm         0, 42;
	
    free_lptr           16; # free argv table
    deinit;             # *argv
    deinit;             # argc
    ret;
}