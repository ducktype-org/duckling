# Checks verifying the types of arguments passed to a function.

type fun: check { i64 } void

function check {
    output_l64          arg0;
    ret;
}

function main {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv
    
    init_lany_type           check_arg0, i32;
    input_l64           check_arg0;
    call_func           check;

    mov_l64_imm         ret_val, 42;
    deinit;             # *argv
    deinit;             # argc
    ret;
}