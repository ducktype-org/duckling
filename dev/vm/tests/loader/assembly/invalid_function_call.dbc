# Checks verifying the types of arguments passed to a function.

type fun: check { i64 } void

function check {
    output_l64          0;
    ret;
}

function main {
    # [0, 8) main ret_val
    # [8, 16) argc
    # [16, 32) *argv
    
    init_type           i32; # [32, 36) check() arg0
    input_l64           32;
    call_func           check;

    mov_l64_imm         0, 42;
    deinit;             # *argv
    deinit;             # argc
    ret;
}