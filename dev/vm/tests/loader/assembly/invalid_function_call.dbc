# Checks verifying the types of arguments passed to a function.

type fun: main { i64, ptr_argv } i64
type fun: check { i64 } void

function check {
	output_l64          0;
	ret;
}

function main {
	# [0, 8) main ret_val
	init_type 			i32; # [8, 12) check() arg0
	input_l64           8;
	call_func          	check;

	mov_l64_imm			0, 42;
	ret;
}
