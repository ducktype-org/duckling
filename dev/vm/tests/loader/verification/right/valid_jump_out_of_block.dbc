type fun: main {} i64

function main {
	# [0, 8) -> main ret_val
	# [8, 16) -> x

	init_type       i64; # x
	input_l64       8;

	# if x == 0
	cmpEq_l64_imm       8, 0;
	jmpRelIf_label      OUT;
			output_l64      8;
			deinit; # x
			jmpRel_label      EXIT;


	label OUT;
			add_l64_imm 8, 10; # x += 10
			output_l64 8;
			deinit; # x

	label EXIT;
	ret;
}
