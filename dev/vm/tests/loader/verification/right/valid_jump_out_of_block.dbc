type fun: main { i64, ptr_argv } i64

function main {
    # [0, 8) -> main ret_val
    # [8, 16) -> argc
    # [16, 32) -> *argv
    # [32, 40) -> x

    init_type       i64; # x [32,40)
    input_l64       32;

    # if x == 0
    cmpEq_l64_imm   32, 0;
    jmpRelIf_label  OUT;
		output_l64  32;
		deinit;     # x
		jmpRel_label EXIT;

    label OUT;
		add_l64_imm 32, 10; # x += 10
		output_l64 32;
		deinit;     # x

    label EXIT;
    free_lptr   16; # free argv
    deinit;     # *argv
    deinit;     # argc
    ret;
}