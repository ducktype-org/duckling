type primitive: int64 8
type fun: main {} int64

function main {
  arg_size: 0;
  ret_size: 8;
  local_size: 16;

  code: {
    # [0, 8) -> main ret_val
    # [8, 16) -> x

    init_type       int64; # x
    input_l64       8;

    # if x == 0
    cmpEq_l64_imm       8, 0;
    jmpRelIf_label      OUT;
        output_l64      8;
        deinit; # x
        jmpRel_label      EXIT;
        

    label OUT;
        add_l64_imm 8, 10; # x += 10
        output_l64 8;
        deinit; # x

    label EXIT;
    ret;
  }
}
