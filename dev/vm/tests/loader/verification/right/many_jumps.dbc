function main {
    # [0, 8) -> main ret_val
    # [8, 16) -> argc
    # [16, 32) -> *argv
    # [32, 40) -> x

    jmp_label    A;

    init_type     i64; # [32,40) x
    jmp_label    B;
    label           B;
    deinit;         # [32,40) x
    jmp_label    A;

    label           A;

    init_type     i64; # [32,40) x

	label           C;
    jmp_label    C;

    deinit;         # [32,40) x

    jmp_label    A;

    deinit;         # *argv
    deinit;         # argc
    ret;
}
