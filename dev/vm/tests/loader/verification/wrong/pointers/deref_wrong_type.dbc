type primitive: int64 8
type primitive: uint64 8
type pointer: ptrint64 int64
type fun: main {} int64

function main {
  arg_size: 0;
  ret_size: 8;
  local_size: 40;

  code: {
    # [0, 8) -> main ret_val
    # [8, 24) -> x
    # [24, 32) -> y
    # [32, 40) -> z
    
    init_type ptrint64;
    init_type uint64;
    init_type int64;

    mov_l64_imm         32, 1;
    ref_lptr_any        8, 32;  # x = &z
    load_l64_lptr       24, 8;  # y = *x

    deinit;
    deinit;
    deinit;

    ret;
  }

}
