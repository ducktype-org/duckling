function main {
	# [0, 8) -> main ret_val
    # [8, 16) -> argc
    # [16, 32) -> *argv

	init_type prt_i64; 	# [32, 48) -> x
	init_type i64; 		# [48, 56) -> y

	mov_l64_imm         48, 1;
	ref_lptr_lany        32, 48;  # x = &y

	deinit; # y

	init_type i64; # [48, 56) -> z

	load_l64_lptr       48, 32;  # z = *x

	deinit;
	deinit;
    deinit;       # *argv
    deinit;       # argc
	ret;
}
