type primitive: int64 8
type pointer: ptrint64 int64
type fun: main {} int64

function main {
	# [0, 8) -> main ret_val
	# [8, 24) -> x
	# [24, 32) -> y

	init_type ptrint64;
	init_type int64;

	mov_l64_imm         24, 1;
	ref_lptr_any        8, 24;  # x = &y

	deinit;

	# [24, 32) -> z
	init_type int64;

	load_l64_lptr       24, 8;  # z = *x

	deinit;
	deinit;

	ret;
}
