function main {
    # ret_val -> main ret_val
    # arg0 -> argc
    # arg1 -> *argv

	init_lany_type 		x, ptr_i64;
	init_lany_type 		y, i64;

	mov_l64_imm         y, 1;
	ref_lptr_any        x, y;  # x = &y

	deinit; # y

	init_lany_type 		z, i64;

	load_l64_lptr       z, x;  # z = *x

	deinit; # z
	deinit; # x
    deinit; # *argv
    deinit; # argc
	ret;
}
