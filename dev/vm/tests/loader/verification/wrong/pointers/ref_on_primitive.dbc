type primitive: int128 16

function main {
	# [0, 8) -> main ret_val
    # [8, 16) -> argc
    # [16, 32) -> *argv

	# [32, 48) -> x
	# [48, 56) -> y
	# [56, 64) -> z

	init_type int128;
	init_type i64;
	init_type i64;

	mov_l64_imm         56, 1;
	ref_lptr_any        32, 56;  # x = &z
	load_l64_lptr       48, 32;  # y = *x

	deinit; # z
	deinit; # y
	deinit; # x
    deinit; # *argv
    deinit; # argc
	ret;
}
