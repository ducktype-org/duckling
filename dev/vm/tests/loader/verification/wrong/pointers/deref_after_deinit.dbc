function main {
	# [0, 8) -> main ret_val
    # [8, 16) -> argc
    # [16, 32) -> *argv

	init_type ptr_i64; # [32, 48) -> x
	init_type i64; # [48, 56) -> y
	init_type i64; # [56, 64) -> z

	mov_l64_imm         56, 1;
	ref_lptr_lany        32, 56;  # x = &z

	deinit;

	load_l64_lptr       48, 32;  # y = *x

	deinit;
	deinit;
    deinit;       # *argv
    deinit;       # argc
	ret;
}
