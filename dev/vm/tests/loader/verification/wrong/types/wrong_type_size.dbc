type fun: main { i64, ptr_argv } i64

function main {
	# [0, 8) -> main ret_val
    # [8, 16) -> argc
    # [16, 32) -> *argv

	# [32, 36) -> x

	init_type       i32; # x

	mov_l64_imm     32, 1;

	deinit; # x

	free_lptr     16;  # free argv
    deinit;       # *argv
    deinit;       # argc


	ret;
}
