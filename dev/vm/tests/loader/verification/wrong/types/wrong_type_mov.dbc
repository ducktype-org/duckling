
type primitive: ui64 8

function main {
	# [0, 8) -> main ret_val
    # [8, 16) -> argc
    # [16, 32) -> *argv
	# [32, 40) -> x
	# [40, 48) -> y

	init_type       i64; # x
	init_type       ui64; # y

	mov_l64_imm     32, 1;
	mov_l64_l64     32, 40;

	deinit; # y
	deinit; # x
    deinit;       # *argv
    deinit;       # argc
	ret;
}
