type primitive: int64 8
type fun: main {} int64

function main {
    # [0, 8) main ret_val
    init_type       int64;  # [8, 16) i
    input_l64       8;      # i := input
    init_type       int64;  # [16, 24) tmp
    mov_l64_imm     16, 0;

    label Loop;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;
        cmpEq_l64_imm   16,0;

        sub_l64_imm     8, 1; # i := i - 1
        cmpEq_l64_imm   8, 0; # if i == 0
        jmpRelNotIf_label Loop;

    ret;
}
