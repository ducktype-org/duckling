type fun: main { i64, ptr_argv } i64

function main {
    # [0, 8) main ret_val
    init_type       i64;  # [8, 16) i
    init_type       i64;  # [16, 24) temp
    input_l64       8;      # i := input
    mov_l64_imm     16, 0;

    label Loop;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;
        add_l64_imm   16, 0;

        sub_l64_imm     8, 1; # i := i-1
        cmpEq_l64_imm   8, 0; # if i == 0
        jmpRelNotIf_label Loop;

    deinit;
    deinit;
    ret;
}
