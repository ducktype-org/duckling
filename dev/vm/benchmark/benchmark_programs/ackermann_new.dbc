type primitive: int64 8
type fun: main {} int64
type fun: ackermann { int64, int64 } int64

function ackermann {
    arg_size: 16;
    ret_size: 8;

    # m, n
    local_size: 48;
    code: {
        # [0, 8) -> ret_val
        # [8, 16) -> arg0 -> m
        # [16, 24) -> arg1 -> n


        # if m == 0
        cmpEq_l64_imm       8, 0;
        jmpRelIf_label      M0;

        # if n == 0
        cmpEq_l64_imm       16, 0;
        jmpRelIf_label      N0;

        # m, n > 0
        # return A(m-1, A(m, n-1))
        init_type           int64;      # [24, 32) A(m, n-1) ret_val
        init_type           int64;      # [32, 40) A(m, n-1) arg0
        init_type           int64;      # [40, 48) A(m, n-1) arg1
        mov_l64_l64         32, 8;      # arg0 := m
        mov_l64_l64         40, 16;     # arg1 := n
        sub_l64_imm         40, 1;      # arg1 := n-1
        call_func           ackermann;  # A(m, n-1)

        # [32, 40) and [40, 48) are deinitialized here

        init_type           int64;      # [32, 40) A(m-1, A(m, n-1)) arg0
        init_type           int64;      # [40, 48) A(m-1, A(m, n-1)) arg1
        mov_l64_l64         32, 8;      # arg0 := m
        sub_l64_imm         32, 1;      # arg0 := m-1
        mov_l64_l64         40, 24;     # arg1 := A(m, n-1)
        call_func           ackermann;  # A(m-1, A(m, n-1))

        # [32, 40) and [40, 48) are deinitialized here

        mov_l64_l64         0, 24;
        deinit; # A() ret_val
        deinit; # arg1
        deinit; # arg0
        ret;

        label N0;
        # return A(m-1, 1)
        init_type           int64;      # [24, 32) A(m-1, 1) ret_val
        init_type           int64;      # [32, 40) A(m-1, 1) arg0
        init_type           int64;      # [40, 48) A(m-1, 1) arg1
        mov_l64_l64         32, 8;      # arg0 := m
        sub_l64_imm         32, 1;      # arg0 := m-1
        mov_l64_imm         40, 1;      # arg1 := 1
        call_func           ackermann;  # (m-1, 1)

        mov_l64_l64         0, 24;
        deinit; # A() ret_val
        deinit; # arg1
        deinit; # arg0
        ret;

        label M0;
        # return n+1
        mov_l64_l64         0, 16;  # ret := n
        add_l64_imm         0, 1;   # ret := n+1
        
        deinit; # arg1
        deinit; # arg0
        ret;
    }
}

function main {
    arg_size: 0;
    ret_size: 8;
    local_size: 32;

    # m, n
    code: {
        # [0, 8) main ret_val
        init_type           int64; # [8, 16) ackermann ret_val
        init_type           int64; # [16, 24) ackermann arg0
        init_type           int64; # [24, 32) ackermann arg1

        input_l64           16;
        input_l64           24;
        call_func           ackermann;

        output_l64          8;

        deinit; # A() ret_val
        ret;
    }
}
