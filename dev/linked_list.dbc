type pointer: LinkedList Node

type data: Node {
    head: i64,
    tail: LinkedList
}

type fun: cons {i64, LinkedList} LinkedList

function cons {
    # ret_val: result -- null
    # arg0: head -- 1
    # arg1: tail -- null

    # using LinkedList = *Node

    # ret_val = new Node()
    alloc_lptr_type ret_val, Node;

    structStore_lptr_lany ret_val, arg0;
    ext_type_field i64, Node.head;

    structStore_lptr_lany ret_val, arg1;
    ext_type_field LinkedList, Node.tail;

    ret;
}

# OPTIMISED!!!
type fun: tail {} LinkedList
function tail {
    structLoad_lany_lptr ret_val, ret_val;
    ext_type_field LinkedList, Node.tail;

    ret;
}

type fun: print_list {LinkedList} void
function print_list {
    # arg0: LinkedList

    cmpNull_lptr arg0;
    jmpIfNot_label non_empty;
    ret;
label non_empty;

    init_lany_type curr, i64;

    # curr = arg0->x
    structLoad_lany_lptr curr, arg0;
    ext_type_field i64, Node.head;

    output_l64 curr;

    deinit;  # curr
    call_func tail;

    ret_tailcall_func print_list;
}

function main {
    # INPUT: list_length
    #        x1 x2 ... xn

    init_lany_type length, i64;
    input_l64 length;

    # list = []  # aka NULL
    init_lany_type list, LinkedList;

label loop_begin;
    cmpEq_l64_imm length, 0;
    jmpIf_label loop_end;

    # curr = input()
    init_lany_type curr, i64;
    input_l64 curr;

    # list = cons(curr, list)
    init_lany_type tail, LinkedList;
    mov_lptr_lptr tail, list;
    call_func cons;

    sub_l64_imm length, 1;

    jmp_label loop_begin;
label loop_end;

    call_func print_list;
    ret;
}
