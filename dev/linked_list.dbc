type pointer: LinkedList Node
type pointer: LinkedListPtr LinkedList

type data: Node {
    head: i64,
    tail: LinkedList
}

type fun: cons {i64, LinkedList} LinkedList

function cons {
    # ret_val: result -- null
    # arg0: head -- 1
    # arg1: tail -- null

    # using LinkedList = *Node

    # ret_val = new Node()
    alloc_lptr_type ret_val, Node;

    # head_ptr = &(ret_val->head)
    init_lany_type head_ptr, ptr_i64;
    lea_lptr_lptr head_ptr, ret_val;
    ext_field Node.head;

    # *head_ptr = head
    store_lptr_lany head_ptr, arg0;
    ext_type i64;
    deinit;  # head_ptr

    # ret_val->tail = arg1
    init_lany_type tail_ptr, LinkedListPtr;
    lea_lptr_lptr tail_ptr, ret_val;
    ext_field Node.tail;

    store_lptr_lany tail_ptr, arg1;
    ext_type LinkedList;
    deinit;  # tail_ptr

    # return ret_val
    ret;
}

# OPTIMISED!!!
type fun: tail {} LinkedList
function tail {
    # ---- TABLE ----
    # tableLoad_lany_lptr_type_l64
    # ext_type_l64

    # tableStore_lptr_lany_type_l64
    # ext_type_l64

    # tableLea_lptr_lptr_l64  # dst = &src[l64]
    # lea_lptr_lptr_imm  #

    # ---- STRUCT ----
    # structLea_lptr_lptr_field # dst = &src->field; -- istnieje
    # structLoad_lany_lptr_type_field #   std::memset(dst, &src->field, sizeof(type));
    #                   alternatywnie --  dst = src->field

    # structStore_lptr_lany_type_field # dst->field = src

    # init_lany_type ptr_ptr_node, LinkedListPtr;
    # structLea_lptr_lptr_field ptr_ptr_node, ret_val;
    # ext_field Node.tail;


    init_lany_type ptr_ptr_node, LinkedListPtr;
    lea_lptr_lptr ptr_ptr_node, ret_val;
    ext_field Node.tail;

    load_lany_lptr ret_val, ptr_ptr_node;
    ext_type LinkedList;

    # lea:
    # &node->left;
    # lea-deref:
    # node = node->left;
    # leaDeref_lptr_lptr

    ret;
}

type static_table: table_i64 i64 5
type pointer: ptr_table_i64 table_i64;
type fun: print_table { ptr_i64 } void
function print_table {
    # prints all values in a table
    init_lany_type index, i64;
    mov_l64_imm index, 5;

    init_lany_type value, i64;

label loop;
    cmpEq_l64_imm index, 0;
    jmpIf_label end;
    # --- value = arg0[0];
    load_lany_ptr value, arg0;
    ext_type i64;

    # --- arg0 = &arg0[1];
    init_lany_type ppi64, ptr_ptr_i64;
    lea_lptr_lptr ppi64, arg0;
    ext_field table_i64.1;



    jmp_label loop;
label end;
    ret;
}

type fun: print_list {LinkedList} void
function print_list {
    # arg0: LinkedList

    cmpNull_lptr arg0;
    jmpIfNot_label non_empty;
    ret;
label non_empty;

    init_lany_type curr, i64;
    init_lany_type x_ptr, ptr_i64;

    # curr = arg0->x
    lea_lptr_lptr x_ptr, arg0;
    ext_field Node.head;
    load_lany_lptr curr, x_ptr;
    ext_type i64;
    deinit;  # x_ptr

    output_l64 curr;

    deinit;  # curr
    call_func tail;

    ret_tailcall_func print_list;
}

function main {
    # INPUT: list_length
    #        x1 x2 ... xn

    init_lany_type length, i64;
    input_l64 length;

    # list = []  # aka NULL
    init_lany_type list, LinkedList;

label loop_begin;
    cmpEq_l64_imm length, 0;
    jmpIf_label loop_end;

    # curr = input()
    init_lany_type curr, i64;
    input_l64 curr;

    # list = cons(curr, list)
    init_lany_type tail, LinkedList;
    mov_lptr_lptr tail, list;
    call_func cons;

    sub_l64_imm length, 1;

    jmp_label loop_begin;
label loop_end;

    call_func print_list;
    ret;
}
